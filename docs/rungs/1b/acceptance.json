    },
    {
      "id": "shot-exact",
      "done_when": 3,
      "description": "On ubuntu-24.04 (x64), `shot`'s decoded RGBA8 pixels equal the committed goldens exactly. The adapter is Mesa 25.2.7 lavapipe (gfx-rs/ci-build build26) with a fixed llvmpipe environment.",
      "command": "cargo xtask ci --job native (step shot-exact)",
      "checks": [
        {
          "job": "native",
          "target": "x86_64-unknown-linux-gnu",
          "step": "shot-exact"
