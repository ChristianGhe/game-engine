      "command": "cargo xtask selftest wgpu-outside-gpu && cargo xtask selftest winit-outside-platform && cargo xtask selftest rwh-outside-seam && cargo xtask selftest core-depends-on-gpu && cargo xtask selftest golden-edit",
      "checks": [
