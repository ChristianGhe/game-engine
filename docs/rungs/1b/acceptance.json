      "id": "crash-json",
      "done_when": 4,
      "description": "A panic in `run` and in `play` writes crash.json with every field (version stamp, thread, backtrace, last log lines, seed, tick, command line) and exits 12. The test job has no display, so it checks `run` only.",
      "command": "cargo test -p game-testbed --test crash_json",
      "checks": [
        {
          "job": "test",
          "target": "x86_64-unknown-linux-gnu",
          "step": "crash-json"
        },
        {
          "job": "test",
          "target": "aarch64-unknown-linux-gnu",
          "step": "crash-json"
