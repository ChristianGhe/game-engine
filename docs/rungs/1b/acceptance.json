{
  "version": 1,
  "rung": "1b",
  "name": "Windowed dot",
  "status": "approved by the owner on 2026-10-31: these criteria, the time-box and the AI budget (spec 2.2, touchpoint 2), as drafted in docs/rungs/1b/plan.md",
  "spec": "docs/superpowers/specs/2026-10-20-ai-built-engine-design.md, section 9.2",
  "time_box": {
    "start": "2026-10-31",
    "calendar_days": 14
  },
  "ai_budget": {
    "plan": "the owner's current Claude plan, nothing else (P1 default)",
    "max_agent_sessions": 30,
    "note": "Usage is logged per session in PROGRESS.md; each open-pulsar task counts as one session, including its reviewer subagent. The 30 cover tasks T0-T17, two rung reviews and a margin, so the 16 sessions logged before approval count. The pivot rule (spec 7.7) compares rungs 1a-3 against twice their time-boxes."
  },
  "features": [
    {
      "id": "native-build-test",
      "done_when": 1,
      "description": "The workspace builds and every test passes on the five native runners (ubuntu-24.04, ubuntu-24.04-arm, windows-2025, windows-11-arm, macos-26), and `cargo check --target x86_64-apple-darwin` passes on macos-26.",
      "command": "cargo xtask ci --job native",
      "checks": [
        {
          "job": "native",
          "target": "x86_64-unknown-linux-gnu",
          "step": "build"
        },
        {
          "job": "native",
          "target": "aarch64-unknown-linux-gnu",
          "step": "build"
        },
        {
          "job": "native",
          "target": "x86_64-pc-windows-msvc",
          "step": "build"
        },
        {
          "job": "native",
          "target": "aarch64-pc-windows-msvc",
          "step": "build"
        },
        {
          "job": "native",
          "target": "aarch64-apple-darwin",
          "step": "build"
        },
        {
          "job": "native",
          "target": "x86_64-unknown-linux-gnu",
          "step": "tests"
        },
        {
          "job": "native",
          "target": "aarch64-unknown-linux-gnu",
          "step": "tests"
        },
        {
          "job": "native",
          "target": "x86_64-pc-windows-msvc",
          "step": "tests"
        },
        {
          "job": "native",
          "target": "aarch64-pc-windows-msvc",
          "step": "tests"
        },
        {
          "job": "native",
          "target": "aarch64-apple-darwin",
          "step": "tests"
        },
        {
          "job": "native",
          "target": "aarch64-apple-darwin",
          "step": "check-intel-mac"
        }
      ]
    },
    {
      "id": "native-window",
      "done_when": [
        1,
        2
      ],
      "description": "`play --ticks 240 --seed 1 --input dot-square.input.toml --hashes h.txt` opens a real window (under xvfb on Linux), and h.txt equals the committed hashes/dot-square.seed1.txt.",
      "command": "cargo xtask ci --job native (step window)",
      "checks": [
        {
          "job": "native",
          "target": "x86_64-unknown-linux-gnu",
          "step": "window"
        },
        {
          "job": "native",
          "target": "aarch64-unknown-linux-gnu",
          "step": "window"
        },
        {
          "job": "native",
          "target": "x86_64-pc-windows-msvc",
          "step": "window"
        },
        {
          "job": "native",
          "target": "aarch64-pc-windows-msvc",
          "step": "window"
        },
        {
          "job": "native",
          "target": "aarch64-apple-darwin",
          "step": "window"
        }
      ]
    },
    {
      "id": "esc-quits",
      "done_when": 2,
      "description": "A running `play` gets Escape from xdotool through the real OS path and exits 0 within 5 s; a headless-twin test covers every target.",
      "command": "cargo xtask ci --job native (step esc on ubuntu-24.04, tests everywhere)",
      "checks": [
        {
          "job": "native",
          "target": "x86_64-unknown-linux-gnu",
          "step": "esc"
        },
        {
          "job": "native",
          "target": "x86_64-unknown-linux-gnu",
          "step": "tests"
        },
