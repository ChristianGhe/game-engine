+}
+
+#[test]
+fn the_report_carries_the_extra_keys() {
+    let mut extra = Map::new();
+    extra.insert(
+        "gpu".into(),
+        json!({"adapter": "Microsoft Basic Render Driver"}),
+    );
+    let report = crate::ci_report::report(
