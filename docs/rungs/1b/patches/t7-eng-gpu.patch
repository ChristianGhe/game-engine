diff --git a/crates/eng-gpu/src/pass.rs b/crates/eng-gpu/src/pass.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2c80f9c48b3e61761e00365d37a1e86e3b2d391e
--- /dev/null
+++ b/crates/eng-gpu/src/pass.rs
@@ -0,0 +1,339 @@
+//! Passes and how a graph runs them. A pass records commands into a
+//! [`PassRecorder`]; once every pass has recorded and each recording fits
+//! its declaration, the frame is encoded and submitted at once.
+
+use crate::error::GpuError;
+use crate::gpu::Gpu;
+use crate::graph::{Graph, GraphError, PassDecl, Resource};
+use crate::targets::Targets;
+
+/// The vertex stage of every fullscreen pass.
+const FULLSCREEN_WGSL: &str = include_str!("fullscreen.wgsl");
+
+/// A colour in linear, scene-referred units (AGENTS.md conventions). The
+/// scene holds values above 1.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct LinearRgba {
+    pub r: f32,
+    pub g: f32,
+    pub b: f32,
+    pub a: f32,
+}
+
+impl LinearRgba {
+    /// What a pass's target starts as unless the pass clears it.
+    pub const TRANSPARENT: Self = Self {
+        r: 0.0,
+        g: 0.0,
+        b: 0.0,
+        a: 0.0,
+    };
+}
+
+/// One pass of a graph. [`Graph::render`] runs it where the graph declares
+/// the same [`PassDecl`].
+pub trait Pass {
+    /// What the pass reads and writes.
+    fn decl(&self) -> PassDecl;
+    /// Records this frame's work. It reaches the GPU after every pass has
+    /// recorded.
+    fn record(&mut self, rec: &mut PassRecorder);
+}
+
+/// A fullscreen pass's fragment stage.
+pub struct FullscreenDesc<'a> {
+    /// Names the pipeline in errors and GPU debuggers.
+    pub label: &'a str,
+    /// A WGSL module with the fragment entry point. It takes
+    /// `@location(0) uv: vec2<f32>`, from (0, 0) at the top left to (1, 1) at
+    /// the bottom right, and may bind the pass's input as
+    /// `@group(0) @binding(0) var input: texture_2d<f32>` and
+    /// `@group(0) @binding(1) var input_sampler: sampler`, which samples the
+    /// nearest texel. Load it from a `.wgsl` file with `include_str!`, so
+    /// that the shader test checks it.
+    pub wgsl: &'a str,
+    /// The fragment entry point's name.
+    pub entry: &'a str,
+    /// What the pipeline draws into; it sets the colour format.
+    pub target: Resource,
+}
+
+/// A compiled fullscreen pipeline, for [`PassRecorder::fullscreen`]. Cheap
+/// to clone.
+#[derive(Clone, Debug)]
+pub struct FullscreenPipeline {
+    pipeline: wgpu::RenderPipeline,
+    target: Resource,
+}
+
+/// The commands a pass records for one frame.
+#[derive(Debug)]
+pub struct PassRecorder {
+    clear: LinearRgba,
+    commands: Vec<Command>,
+}
+
+#[derive(Debug)]
+enum Command {
+    Fullscreen(FullscreenPipeline),
+}
+
+impl PassRecorder {
+    fn new() -> Self {
+        Self {
+            clear: LinearRgba::TRANSPARENT,
+            commands: Vec::new(),
+        }
+    }
+
+    /// Starts the pass's target as `colour` rather than
+    /// [`LinearRgba::TRANSPARENT`].
+    pub fn clear(&mut self, colour: LinearRgba) {
+        self.clear = colour;
+    }
+
+    /// Draws `pipeline` over the whole target, with the pass's one read as
+    /// its input.
+    pub fn fullscreen(&mut self, pipeline: &FullscreenPipeline) {
+        self.commands.push(Command::Fullscreen(pipeline.clone()));
+    }
+
+    /// Whether the recording fits the pass's declaration.
+    fn check(&self, decl: &PassDecl) -> Result<(), GpuError> {
+        let fail = |message: String| GpuError::Pass {
+            pass: decl.name,
+            message,
+        };
+        for Command::Fullscreen(pipeline) in &self.commands {
+            if decl.reads.len() != 1 {
+                return Err(fail(format!(
+                    "a fullscreen draw takes the pass's one read as its input, but the pass reads {}",
+                    decl.reads.len()
+                )));
+            }
+            if decl.writes != [pipeline.target] {
+                return Err(fail(format!(
+                    "the pipeline draws into `{}`, but the pass writes `{}`",
+                    pipeline.target.name(),
+                    decl.writes.first().map_or("nothing", |r| r.name())
+                )));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Graph {
+    /// Records `passes`, one for each of the graph's declarations and in the
+    /// same order, then submits the frame. Each pass draws into the target
+    /// it writes; a later [`Targets::read_output`] sees the frame.
+    pub fn render(
+        &self,
+        gpu: &Gpu,
+        targets: &Targets,
+        passes: &mut [&mut dyn Pass],
+    ) -> Result<(), GpuError> {
+        if passes.len() != self.passes.len() {
+            return Err(GraphError::PassCount {
+                expected: self.passes.len(),
+                found: passes.len(),
+            }
+            .into());
+        }
+        let mut recorded = Vec::with_capacity(passes.len());
+        for (index, (decl, pass)) in self.passes.iter().zip(passes.iter_mut()).enumerate() {
+            let found = pass.decl();
+            if found != *decl {
+                return Err(GraphError::PassMismatch {
+                    index,
+                    expected: *decl,
+                    found,
+                }
+                .into());
+            }
+            let mut rec = PassRecorder::new();
+            pass.record(&mut rec);
+            rec.check(decl)?;
+            recorded.push(rec);
+        }
+        // Only a surface graph has the surface, and eng-gpu cannot render one
+        // yet. Each pass writes exactly one resource (Graph::new).
+        let mut views = Vec::with_capacity(recorded.len());
+        for decl in &self.passes {
+            let view = |r: Resource| {
+                targets.view(r).ok_or_else(|| GpuError::Pass {
+                    pass: decl.name,
+                    message: "eng-gpu renders offscreen only; it opens no surface yet".into(),
+                })
+            };
+            let input = decl.reads.first().map(|&r| view(r)).transpose()?;
+            views.push((view(decl.writes[0])?, input));
+        }
+        gpu.scoped(|| {
+            let mut encoder = gpu
+                .device
+                .create_command_encoder(&wgpu::CommandEncoderDescriptor {
+                    label: Some("frame"),
+                });
+            for ((decl, rec), (target, input)) in self.passes.iter().zip(&recorded).zip(&views) {
+                encode(gpu, &mut encoder, decl, rec, target, *input);
+            }
+            gpu.queue.submit([encoder.finish()]);
+        })
+        .map_err(GpuError::Wgpu)
+    }
+}
+
+fn encode(
+    gpu: &Gpu,
+    encoder: &mut wgpu::CommandEncoder,
+    decl: &PassDecl,
+    rec: &PassRecorder,
+    target: &wgpu::TextureView,
+    input: Option<&wgpu::TextureView>,
+) {
+    let clear = wgpu::Color {
+        r: f64::from(rec.clear.r),
+        g: f64::from(rec.clear.g),
+        b: f64::from(rec.clear.b),
+        a: f64::from(rec.clear.a),
+    };
+    let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+        label: Some(decl.name),
+        color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+            view: target,
+            depth_slice: None,
+            resolve_target: None,
+            ops: wgpu::Operations {
+                load: wgpu::LoadOp::Clear(clear),
+                store: wgpu::StoreOp::Store,
+            },
+        })],
+        depth_stencil_attachment: None,
+        timestamp_writes: None,
+        occlusion_query_set: None,
+        multiview_mask: None,
+    });
+    for Command::Fullscreen(pipeline) in &rec.commands {
+        // `check` made sure a fullscreen pass has its input.
+        let Some(input) = input else { continue };
+        let bind_group = gpu.shared.bind(&gpu.device, input);
+        pass.set_pipeline(&pipeline.pipeline);
+        pass.set_bind_group(0, &bind_group, &[]);
+        pass.draw(0..3, 0..1);
+    }
+}
+
+/// What every fullscreen pipeline shares: the vertex stage, the input's
+/// layout and its sampler.
+pub(crate) struct Shared {
+    vertex: wgpu::ShaderModule,
+    inputs: wgpu::BindGroupLayout,
+    layout: wgpu::PipelineLayout,
+    sampler: wgpu::Sampler,
+}
+
+impl Shared {
+    pub(crate) fn new(device: &wgpu::Device) -> Self {
+        let vertex = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("fullscreen"),
+            source: wgpu::ShaderSource::Wgsl(FULLSCREEN_WGSL.into()),
+        });
+        let inputs = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("fullscreen input"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("fullscreen"),
+            bind_group_layouts: &[Some(&inputs)],
+            immediate_size: 0,
+        });
+        // Nearest texel, clamped at the edges: a same-size pass copies texels
+        // exactly.
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("fullscreen input"),
+            ..wgpu::SamplerDescriptor::default()
+        });
+        Self {
+            vertex,
+            inputs,
+            layout,
+            sampler,
+        }
+    }
+
+    pub(crate) fn pipeline(
+        &self,
+        device: &wgpu::Device,
+        desc: &FullscreenDesc<'_>,
+        format: wgpu::TextureFormat,
+    ) -> FullscreenPipeline {
+        let fragment = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some(desc.label),
+            source: wgpu::ShaderSource::Wgsl(desc.wgsl.into()),
+        });
+        let pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some(desc.label),
+            layout: Some(&self.layout),
+            vertex: wgpu::VertexState {
+                module: &self.vertex,
+                entry_point: Some("fullscreen_vertex"),
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+                buffers: &[],
+            },
+            primitive: wgpu::PrimitiveState::default(),
+            depth_stencil: None,
+            multisample: wgpu::MultisampleState::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &fragment,
+                entry_point: Some(desc.entry),
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format,
+                    blend: None,
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+            }),
+            multiview_mask: None,
+            cache: None,
+        });
+        FullscreenPipeline {
+            pipeline,
+            target: desc.target,
+        }
+    }
+
+    fn bind(&self, device: &wgpu::Device, input: &wgpu::TextureView) -> wgpu::BindGroup {
+        device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("fullscreen input"),
+            layout: &self.inputs,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(input),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::Sampler(&self.sampler),
+                },
+            ],
+        })
+    }
+}
diff --git a/crates/eng-gpu/src/report.rs b/crates/eng-gpu/src/report.rs
new file mode 100644
index 0000000000000000000000000000000000000000..165f5dbdc8af7ddc72decfd516b911300d867f9c
--- /dev/null
+++ b/crates/eng-gpu/src/report.rs
@@ -0,0 +1,138 @@
+//! The capability report (spec 6.7, 6.13): which adapter renders, and what it
+//! could do beyond Tier 0. Plain data; reports carry it as their `gpu` object.
+
+/// The adapter a [`crate::Gpu`] runs on, and what it supports.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GpuReport {
+    /// The adapter's name, such as `Apple M2 Pro` or
+    /// `llvmpipe (LLVM 19.1.7, 256 bits)`.
+    pub adapter: String,
+    pub backend: Backend,
+    pub device_type: DeviceType,
+    /// The backend's vendor and device ids: PCI ids where it has them, else
+    /// 0 (Metal).
+    pub vendor: u32,
+    pub device: u32,
+    /// The driver's name and its version text, as the backend gives them;
+    /// empty where it gives none (Metal).
+    pub driver: String,
+    pub driver_info: String,
+    /// The capability tier the device runs at. Level 1 uses only Tier 0,
+    /// WebGPU's default features and limits (spec 6.7), whatever the adapter
+    /// supports.
+    pub tier: u8,
+    /// What the adapter supports. Tier 0 enables none of it.
+    pub capabilities: Capabilities,
+}
+
+/// Optional adapter features that later tiers or pass timing would use
+/// (spec 6.7).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Capabilities {
+    /// GPU timestamp queries. Pass timing reports `null` without them.
+    pub timestamp_queries: bool,
+    /// Arrays of textures in one binding (bindless).
+    pub binding_arrays: bool,
+    /// Indirect draws whose count comes from a buffer.
+    pub multi_draw_indirect_count: bool,
+    /// Ray queries in shaders.
+    pub ray_query: bool,
+    /// Task and mesh shaders.
+    pub mesh_shaders: bool,
+}
+
+/// The graphics API under the adapter.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Backend {
+    Vulkan,
+    Metal,
+    Dx12,
+    /// Anything else wgpu might report. Only the three above are built.
+    Other,
+}
+
+impl Backend {
+    /// `vulkan`, `metal`, `dx12` or `other`.
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Vulkan => "vulkan",
+            Self::Metal => "metal",
+            Self::Dx12 => "dx12",
+            Self::Other => "other",
+        }
+    }
+}
+
+/// What kind of device the adapter is.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DeviceType {
+    IntegratedGpu,
+    DiscreteGpu,
+    /// A virtual or hosted GPU, such as a CI runner's paravirtual device.
+    VirtualGpu,
+    /// Software rendering, such as lavapipe or WARP.
+    Cpu,
+    Other,
+}
+
+impl DeviceType {
+    /// `integrated-gpu`, `discrete-gpu`, `virtual-gpu`, `cpu` or `other`.
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::IntegratedGpu => "integrated-gpu",
+            Self::DiscreteGpu => "discrete-gpu",
+            Self::VirtualGpu => "virtual-gpu",
+            Self::Cpu => "cpu",
+            Self::Other => "other",
+        }
+    }
+}
+
+pub(crate) fn backend(backend: wgpu::Backend) -> Backend {
+    match backend {
+        wgpu::Backend::Vulkan => Backend::Vulkan,
+        wgpu::Backend::Metal => Backend::Metal,
+        wgpu::Backend::Dx12 => Backend::Dx12,
+        _ => Backend::Other,
+    }
+}
+
+pub(crate) fn device_type(device_type: wgpu::DeviceType) -> DeviceType {
+    match device_type {
+        wgpu::DeviceType::IntegratedGpu => DeviceType::IntegratedGpu,
+        wgpu::DeviceType::DiscreteGpu => DeviceType::DiscreteGpu,
+        wgpu::DeviceType::VirtualGpu => DeviceType::VirtualGpu,
+        wgpu::DeviceType::Cpu => DeviceType::Cpu,
+        wgpu::DeviceType::Other => DeviceType::Other,
+    }
+}
+
+/// One adapter in a message: `name (backend, device type)`.
+pub(crate) fn describe(info: &wgpu::AdapterInfo) -> String {
+    format!(
+        "{} ({}, {})",
+        info.name,
+        backend(info.backend).as_str(),
+        device_type(info.device_type).as_str()
+    )
+}
+
+pub(crate) fn report(info: &wgpu::AdapterInfo, features: wgpu::Features) -> GpuReport {
+    GpuReport {
+        adapter: info.name.clone(),
+        backend: backend(info.backend),
+        device_type: device_type(info.device_type),
+        vendor: info.vendor,
+        device: info.device,
+        driver: info.driver.clone(),
+        driver_info: info.driver_info.clone(),
+        tier: 0,
+        capabilities: Capabilities {
+            timestamp_queries: features.contains(wgpu::Features::TIMESTAMP_QUERY),
+            binding_arrays: features.contains(wgpu::Features::TEXTURE_BINDING_ARRAY),
+            multi_draw_indirect_count: features.contains(wgpu::Features::MULTI_DRAW_INDIRECT_COUNT),
+            ray_query: features.contains(wgpu::Features::EXPERIMENTAL_RAY_QUERY),
+            mesh_shaders: features.contains(wgpu::Features::EXPERIMENTAL_MESH_SHADER),
+        },
+    }
+}
diff --git a/crates/eng-gpu/src/targets.rs b/crates/eng-gpu/src/targets.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b55924dc3e9a92e764f48388573ff7dfdf1d154d
--- /dev/null
+++ b/crates/eng-gpu/src/targets.rs
@@ -0,0 +1,195 @@
+//! Offscreen targets and readback: the engine-owned textures a graph renders
+//! into, and the output's pixels read back for `shot`, `video` and goldens.
+
+use crate::Resource;
+use crate::error::GpuError;
+use crate::gpu::Gpu;
+
+/// The scene's format: linear, scene-referred HDR (spec 6.7).
+const SCENE_FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba16Float;
+
+/// The output's format. The GPU encodes sRGB on write, so tone mapping
+/// writes linear values (plan decision 2).
+const OUTPUT_FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba8UnormSrgb;
+
+/// The longest side a target may have: Tier 0's largest 2D texture.
+pub(crate) const MAX_SIDE: u32 = 8192;
+
+/// The texture format of an engine-owned resource; `None` for the surface.
+pub(crate) fn format(resource: Resource) -> Option<wgpu::TextureFormat> {
+    match resource {
+        Resource::Scene => Some(SCENE_FORMAT),
+        Resource::Output => Some(OUTPUT_FORMAT),
+        Resource::Surface => None,
+    }
+}
+
+/// The engine-owned textures of one size that a graph renders into: the
+/// [`Resource::Scene`] and the [`Resource::Output`].
+pub struct Targets {
+    width: u32,
+    height: u32,
+    scene: wgpu::TextureView,
+    output_texture: wgpu::Texture,
+    output: wgpu::TextureView,
+}
+
+impl Targets {
+    /// Targets of `width` by `height` pixels, each from 1 to 8,192.
+    pub fn new(gpu: &Gpu, width: u32, height: u32) -> Result<Self, GpuError> {
+        let fits = |side: u32| (1..=MAX_SIDE).contains(&side);
+        if !fits(width) || !fits(height) {
+            return Err(GpuError::Size { width, height });
+        }
+        let create = |label: &str, format: wgpu::TextureFormat, usage: wgpu::TextureUsages| {
+            gpu.device.create_texture(&wgpu::TextureDescriptor {
+                label: Some(label),
+                size: wgpu::Extent3d {
+                    width,
+                    height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage,
+                view_formats: &[],
+            })
+        };
+        let drawn = wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING;
+        let (scene, output_texture) = gpu
+            .scoped(|| {
+                (
+                    create("scene", SCENE_FORMAT, drawn),
+                    create(
+                        "output",
+                        OUTPUT_FORMAT,
+                        drawn | wgpu::TextureUsages::COPY_SRC,
+                    ),
+                )
+            })
+            .map_err(GpuError::Wgpu)?;
+        Ok(Self {
+            width,
+            height,
+            scene: scene.create_view(&wgpu::TextureViewDescriptor::default()),
+            output: output_texture.create_view(&wgpu::TextureViewDescriptor::default()),
+            output_texture,
+        })
+    }
+
+    /// Width and height in pixels.
+    pub fn size(&self) -> (u32, u32) {
+        (self.width, self.height)
+    }
+
+    /// The view a pass draws into or reads; `None` for the surface.
+    pub(crate) fn view(&self, resource: Resource) -> Option<&wgpu::TextureView> {
+        match resource {
+            Resource::Scene => Some(&self.scene),
+            Resource::Output => Some(&self.output),
+            Resource::Surface => None,
+        }
+    }
+
+    /// Copies the output back to the CPU, waiting for the GPU to finish the
+    /// frames submitted before.
+    pub fn read_output(&self, gpu: &Gpu) -> Result<Image, GpuError> {
+        let row = self.width * 4;
+        let stride =
+            row.div_ceil(wgpu::COPY_BYTES_PER_ROW_ALIGNMENT) * wgpu::COPY_BYTES_PER_ROW_ALIGNMENT;
+        let buffer = gpu
+            .scoped(|| {
+                let buffer = gpu.device.create_buffer(&wgpu::BufferDescriptor {
+                    label: Some("readback"),
+                    size: u64::from(stride) * u64::from(self.height),
+                    usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+                    mapped_at_creation: false,
+                });
+                let mut encoder =
+                    gpu.device
+                        .create_command_encoder(&wgpu::CommandEncoderDescriptor {
+                            label: Some("readback"),
+                        });
+                encoder.copy_texture_to_buffer(
+                    self.output_texture.as_image_copy(),
+                    wgpu::TexelCopyBufferInfo {
+                        buffer: &buffer,
+                        layout: wgpu::TexelCopyBufferLayout {
+                            offset: 0,
+                            bytes_per_row: Some(stride),
+                            rows_per_image: Some(self.height),
+                        },
+                    },
+                    wgpu::Extent3d {
+                        width: self.width,
+                        height: self.height,
+                        depth_or_array_layers: 1,
+                    },
+                );
+                gpu.queue.submit([encoder.finish()]);
+                buffer
+            })
+            .map_err(GpuError::Wgpu)?;
+        let (sender, receiver) = std::sync::mpsc::channel();
+        buffer.map_async(wgpu::MapMode::Read, .., move |mapped| {
+            // The receiver waits below, so a failed send cannot happen.
+            let _ = sender.send(mapped);
+        });
+        gpu.device
+            .poll(wgpu::PollType::wait_indefinitely())
+            .map_err(|e| GpuError::Wgpu(format!("waiting for the readback: {e}")))?;
+        receiver
+            .try_recv()
+            .map_err(|_| GpuError::Wgpu("the readback was not mapped after the wait".into()))?
+            .map_err(|e| GpuError::Wgpu(format!("mapping the readback: {e}")))?;
+        let mapped = buffer
+            .get_mapped_range(..)
+            .map_err(|e| GpuError::Wgpu(format!("reading the readback: {e}")))?;
+        let mut rgba8 = Vec::with_capacity(row as usize * self.height as usize);
+        for line in mapped.chunks_exact(stride as usize) {
+            rgba8.extend_from_slice(&line[..row as usize]);
+        }
+        drop(mapped);
+        buffer.unmap();
+        Ok(Image {
+            width: self.width,
+            height: self.height,
+            rgba8,
+        })
+    }
+}
+
+/// The output's pixels: RGBA8, sRGB-encoded as the output stores them, rows
+/// top first, with no padding.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Image {
+    pub width: u32,
+    pub height: u32,
+    /// `width * height * 4` bytes.
+    pub rgba8: Vec<u8>,
+}
+
+impl Image {
+    /// The pixel in column `x` and row `y`; (0, 0) is the top left.
+    ///
+    /// # Panics
+    ///
+    /// Outside the image.
+    pub fn pixel(&self, x: u32, y: u32) -> [u8; 4] {
+        assert!(
+            x < self.width && y < self.height,
+            "pixel ({x}, {y}) is outside a {}x{} image",
+            self.width,
+            self.height
+        );
+        let at = (y as usize * self.width as usize + x as usize) * 4;
+        [
+            self.rgba8[at],
+            self.rgba8[at + 1],
+            self.rgba8[at + 2],
+            self.rgba8[at + 3],
+        ]
+    }
+}
diff --git a/crates/eng-gpu/tests/graph.rs b/crates/eng-gpu/tests/graph.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b35a0708dcde02de05b43c6cef51485a32efe77d
--- /dev/null
+++ b/crates/eng-gpu/tests/graph.rs
@@ -0,0 +1,161 @@
+//! The fixed render graph's declarations (spec 6.3, 6.7; rung 1b plan,
+//! decision 1): what each pass reads and writes, and the checks that run when
+//! a graph is built. No GPU is needed.
+
+use eng_gpu::{DRAW, Graph, GraphError, PRESENT, PassDecl, Resource, TONEMAP, Target};
+
+fn names(graph: &Graph) -> Vec<&'static str> {
+    graph.passes().iter().map(|p| p.name).collect()
+}
+
+#[test]
+fn the_three_passes_declare_what_they_read_and_write() {
+    assert_eq!(DRAW.name, "draw");
+    assert_eq!(DRAW.reads, &[] as &[Resource]);
+    assert_eq!(DRAW.writes, &[Resource::Scene]);
+    assert_eq!(TONEMAP.name, "tonemap");
+    assert_eq!(TONEMAP.reads, &[Resource::Scene]);
+    assert_eq!(TONEMAP.writes, &[Resource::Output]);
+    assert_eq!(PRESENT.name, "present");
+    assert_eq!(PRESENT.reads, &[Resource::Output]);
+    assert_eq!(PRESENT.writes, &[Resource::Surface]);
+}
+
+#[test]
+fn the_fixed_graph_presents_only_to_a_surface() {
+    assert_eq!(
+        names(&Graph::fixed(Target::Surface)),
+        ["draw", "tonemap", "present"]
+    );
+    assert_eq!(names(&Graph::fixed(Target::Offscreen)), ["draw", "tonemap"]);
+    assert_eq!(Graph::fixed(Target::Offscreen).target(), Target::Offscreen);
+    assert_eq!(
+        Graph::new(&[DRAW, TONEMAP, PRESENT], Target::Surface),
+        Ok(Graph::fixed(Target::Surface))
+    );
+}
+
+#[test]
+fn a_read_must_follow_its_write() {
+    assert_eq!(
+        Graph::new(&[TONEMAP, DRAW], Target::Offscreen),
+        Err(GraphError::ReadBeforeWrite {
+            pass: "tonemap",
+            resource: Resource::Scene,
+        })
+    );
+    assert_eq!(
+        Graph::new(&[DRAW, PRESENT, TONEMAP], Target::Surface),
+        Err(GraphError::ReadBeforeWrite {
+            pass: "present",
+            resource: Resource::Output,
+        })
+    );
+}
+
+#[test]
+fn a_pass_writes_exactly_one_resource() {
+    let nothing = PassDecl {
+        name: "nothing",
+        reads: &[Resource::Scene],
+        writes: &[],
+    };
+    assert_eq!(
+        Graph::new(&[DRAW, nothing, TONEMAP], Target::Offscreen),
+        Err(GraphError::Writes {
+            pass: "nothing",
+            count: 0,
+        })
+    );
+    let both = PassDecl {
+        name: "both",
+        reads: &[],
+        writes: &[Resource::Scene, Resource::Output],
+    };
+    assert_eq!(
+        Graph::new(&[both], Target::Offscreen),
+        Err(GraphError::Writes {
+            pass: "both",
+            count: 2,
+        })
+    );
+}
+
+#[test]
+fn an_offscreen_graph_never_touches_the_surface() {
+    assert_eq!(
+        Graph::new(&[DRAW, TONEMAP, PRESENT], Target::Offscreen),
+        Err(GraphError::SurfaceOffscreen { pass: "present" })
+    );
+    // Reading it is as wrong as writing it.
+    let peek = PassDecl {
+        name: "peek",
+        reads: &[Resource::Surface],
+        writes: &[Resource::Output],
+    };
+    assert_eq!(
+        Graph::new(&[DRAW, peek], Target::Offscreen),
+        Err(GraphError::SurfaceOffscreen { pass: "peek" })
+    );
+}
+
+#[test]
+fn output_is_never_the_surface() {
+    // Tone mapping straight into the swapchain would leave screenshots
+    // nothing engine-owned to read (spec 6.7).
+    let direct = PassDecl {
+        name: "tonemap",
+        reads: &[Resource::Scene],
+        writes: &[Resource::Output, Resource::Surface],
+    };
+    assert_eq!(
+        Graph::new(&[DRAW, direct], Target::Surface),
+        Err(GraphError::OutputIsSurface { pass: "tonemap" })
+    );
+}
+
+#[test]
+fn output_must_be_written_and_a_surface_presented() {
+    assert_eq!(
+        Graph::new(&[DRAW], Target::Offscreen),
+        Err(GraphError::OutputNotWritten)
+    );
+    assert_eq!(
+        Graph::new(&[DRAW, TONEMAP], Target::Surface),
+        Err(GraphError::SurfaceNotWritten)
+    );
+}
+
+#[test]
+fn errors_name_the_pass_and_carry_the_tag() {
+    let e = Graph::new(&[TONEMAP, DRAW], Target::Offscreen).unwrap_err();
+    assert_eq!(
+        e.to_string(),
+        "[E-GRAPH] pass `tonemap` reads `scene` before any pass writes it"
+    );
+    let e = GraphError::PassMismatch {
+        index: 1,
+        expected: TONEMAP,
+        found: DRAW,
+    };
+    assert_eq!(
+        e.to_string(),
+        "[E-GRAPH] pass 1 is `draw`, but the graph declares `tonemap` there"
+    );
+    // The same name with other reads or writes.
+    let impostor = PassDecl {
+        name: "tonemap",
+        reads: &[Resource::Scene],
+        writes: &[Resource::Scene],
+    };
+    let e = GraphError::PassMismatch {
+        index: 1,
+        expected: TONEMAP,
+        found: impostor,
+    };
+    assert_eq!(
+        e.to_string(),
+        "[E-GRAPH] pass 1, `tonemap`, reads [scene] and writes [scene], \
+         but the graph declares it reading [scene] and writing [output]"
+    );
+}
diff --git a/crates/eng-gpu/tests/offscreen.rs b/crates/eng-gpu/tests/offscreen.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e1d715ea6fcb33f585176e273357b518a72cddb5
--- /dev/null
+++ b/crates/eng-gpu/tests/offscreen.rs
@@ -0,0 +1,319 @@
+//! Offscreen rendering on a real adapter (rung 1b, task T7): the fixed graph
+//! without a surface, a clear, a fullscreen pass and readback. Without an
+//! adapter each GPU test skips, unless `ENG_REQUIRE_GPU=1` (CI) makes it fail
+//! (plan decision 4).
+
+use eng_gpu::{
+    Backend, DRAW, DeviceType, FullscreenDesc, FullscreenPipeline, Gpu, GpuError, GpuOptions,
+    Graph, GraphError, Image, LinearRgba, Pass, PassDecl, PassRecorder, Resource, TONEMAP, Target,
+    Targets,
+};
+
+const CLAMP: &str = include_str!("wgsl/clamp.wgsl");
+const QUADRANTS: &str = include_str!("wgsl/quadrants.wgsl");
+const COPY_WGSL: &str = include_str!("wgsl/copy.wgsl");
+
+fn gpu() -> Option<Gpu> {
+    match Gpu::new(&GpuOptions::from_env()) {
+        Ok(gpu) => Some(gpu),
+        Err(e @ GpuError::NoAdapter { .. }) if !eng_gpu::gpu_required() => {
+            eprintln!("skipped: {e}");
+            None
+        }
+        Err(e) => panic!("{e}"),
+    }
+}
+
+/// A draw pass that only clears the scene.
+struct Clear(LinearRgba);
+
+impl Pass for Clear {
+    fn decl(&self) -> PassDecl {
+        DRAW
+    }
+    fn record(&mut self, rec: &mut PassRecorder) {
+        rec.clear(self.0);
+    }
+}
+
+/// Any pass that draws one fullscreen pipeline.
+struct Fullscreen(PassDecl, FullscreenPipeline);
+
+impl Pass for Fullscreen {
+    fn decl(&self) -> PassDecl {
+        self.0
+    }
+    fn record(&mut self, rec: &mut PassRecorder) {
+        rec.fullscreen(&self.1);
+    }
+}
+
+fn pipeline(gpu: &Gpu, wgsl: &str, entry: &str, target: Resource) -> FullscreenPipeline {
+    gpu.fullscreen_pipeline(&FullscreenDesc {
+        label: entry,
+        wgsl,
+        entry,
+        target,
+    })
+    .unwrap_or_else(|e| panic!("{e}"))
+}
+
+fn tonemap(gpu: &Gpu, wgsl: &str, entry: &str) -> Fullscreen {
+    Fullscreen(TONEMAP, pipeline(gpu, wgsl, entry, Resource::Output))
+}
+
+const BLACK: LinearRgba = LinearRgba {
+    r: 0.0,
+    g: 0.0,
+    b: 0.0,
+    a: 1.0,
+};
+
+#[test]
+fn a_cleared_scene_reads_back_tone_mapped_and_srgb_encoded() {
+    let Some(gpu) = gpu() else { return };
+    // The shot size of plan decision 3.
+    let targets = Targets::new(&gpu, 320, 240).unwrap_or_else(|e| panic!("{e}"));
+    // Linear and scene-referred. Red is above 1 and blue below 0, so both
+    // clamp; green 0.215861 is sRGB 128/255 decoded, half a step from either
+    // neighbour.
+    let mut draw = Clear(LinearRgba {
+        r: 4.0,
+        g: 0.215_861,
+        b: -1.0,
+        a: 1.0,
+    });
+    let mut map = tonemap(&gpu, CLAMP, "clamp_fragment");
+    Graph::fixed(Target::Offscreen)
+        .render(&gpu, &targets, &mut [&mut draw, &mut map])
+        .unwrap_or_else(|e| panic!("{e}"));
+    let image = targets.read_output(&gpu).unwrap_or_else(|e| panic!("{e}"));
+    assert_eq!((image.width, image.height), (320, 240));
+    assert_eq!(image.rgba8.len(), 320 * 240 * 4);
+    let (pixels, rest) = image.rgba8.as_chunks::<4>();
+    assert!(rest.is_empty());
+    assert!(
+        pixels.iter().all(|p| *p == [255, 128, 0, 255]),
+        "first pixel {:?}, last {:?}",
+        pixels.first(),
+        pixels.last()
+    );
+    assert_eq!(image.pixel(319, 239), [255, 128, 0, 255]);
+}
+
+#[test]
+fn readback_gives_rows_top_first_without_row_padding() {
+    let Some(gpu) = gpu() else { return };
+    // 100 pixels make a 400-byte row, which a copy pads to 512.
+    let targets = Targets::new(&gpu, 100, 60).unwrap_or_else(|e| panic!("{e}"));
+    let mut draw = Clear(BLACK);
+    let mut pattern = tonemap(&gpu, QUADRANTS, "quadrants_fragment");
+    Graph::fixed(Target::Offscreen)
+        .render(&gpu, &targets, &mut [&mut draw, &mut pattern])
+        .unwrap_or_else(|e| panic!("{e}"));
+    let image = targets.read_output(&gpu).unwrap_or_else(|e| panic!("{e}"));
+    assert_eq!(image.rgba8.len(), 100 * 60 * 4);
+    assert_pattern(&image);
+}
+
+/// What `quadrants.wgsl` draws: red on the left half, green on the top
+/// half, blue on alternate pixels.
+fn assert_pattern(image: &Image) {
+    let (width, height) = (image.width, image.height);
+    for y in 0..height {
+        for x in 0..width {
+            let on = |yes: bool| if yes { 255 } else { 0 };
+            let expected = [
+                on(x < width / 2),
+                on(y < height / 2),
+                on((x + y) % 2 == 1),
+                255,
+            ];
+            assert_eq!(image.pixel(x, y), expected, "pixel ({x}, {y})");
+        }
+    }
+}
+
+#[test]
+fn a_fullscreen_pass_samples_its_input_texel_for_texel() {
+    let Some(gpu) = gpu() else { return };
+    // An even size, so that no pixel centre lies on the pattern's halves.
+    let targets = Targets::new(&gpu, 90, 50).unwrap_or_else(|e| panic!("{e}"));
+    // The pattern goes into the output, is copied back into the scene by
+    // sampling, then tone mapped into the output again.
+    const PATTERN: PassDecl = PassDecl {
+        name: "pattern",
+        reads: &[Resource::Scene],
+        writes: &[Resource::Output],
+    };
+    const COPY: PassDecl = PassDecl {
+        name: "copy",
+        reads: &[Resource::Output],
+        writes: &[Resource::Scene],
+    };
+    let graph = Graph::new(&[DRAW, PATTERN, COPY, TONEMAP], Target::Offscreen)
+        .unwrap_or_else(|e| panic!("{e}"));
+    let mut draw = Clear(BLACK);
+    let mut pattern = Fullscreen(
+        PATTERN,
+        pipeline(&gpu, QUADRANTS, "quadrants_fragment", Resource::Output),
+    );
+    let mut copy = Fullscreen(
+        COPY,
+        pipeline(&gpu, COPY_WGSL, "copy_fragment", Resource::Scene),
+    );
+    let mut map = tonemap(&gpu, CLAMP, "clamp_fragment");
+    graph
+        .render(
+            &gpu,
+            &targets,
+            &mut [&mut draw, &mut pattern, &mut copy, &mut map],
+        )
+        .unwrap_or_else(|e| panic!("{e}"));
+    let image = targets.read_output(&gpu).unwrap_or_else(|e| panic!("{e}"));
+    assert_pattern(&image);
+}
+
+#[test]
+fn the_report_describes_the_adapter_at_tier_0() {
+    let Some(gpu) = gpu() else { return };
+    let report = gpu.report();
+    eprintln!("{report:?}");
+    assert_eq!(report.tier, 0);
+    assert!(!report.adapter.is_empty());
+    let native = if cfg!(target_os = "macos") {
+        Backend::Metal
+    } else if cfg!(windows) {
+        Backend::Dx12
+    } else {
+        Backend::Vulkan
+    };
+    assert_eq!(report.backend, native);
+    if report.adapter.contains("llvmpipe") {
+        assert_eq!(report.device_type, DeviceType::Cpu);
+    }
+    if let Some(wanted) = GpuOptions::from_env().adapter {
+        let name = report.adapter.to_lowercase();
+        assert!(name.contains(&wanted.to_lowercase()), "{name} for {wanted}");
+    }
+    assert_eq!(Backend::Metal.as_str(), "metal");
+    assert_eq!(DeviceType::DiscreteGpu.as_str(), "discrete-gpu");
+}
+
+#[test]
+fn an_adapter_name_that_matches_nothing_fails_with_e_no_adapter() {
+    let options = GpuOptions {
+        adapter: Some("no adapter is called this".into()),
+    };
+    match Gpu::new(&options) {
+        Err(e @ GpuError::NoAdapter { .. }) => {
+            let text = e.to_string();
+            assert!(text.starts_with("[E-NO-ADAPTER] "), "{text}");
+            assert!(text.contains("\"no adapter is called this\""), "{text}");
+        }
+        Err(e) => panic!("{e}"),
+        Ok(gpu) => panic!("picked {}", gpu.report().adapter),
+    }
+}
+
+#[test]
+fn a_broken_shader_is_an_error_not_a_panic() {
+    let Some(gpu) = gpu() else { return };
+    let broken = gpu.fullscreen_pipeline(&FullscreenDesc {
+        label: "broken",
+        wgsl: "@fragment fn broken( {",
+        entry: "broken",
+        target: Resource::Output,
+    });
+    match broken {
+        Err(e @ GpuError::Shader { .. }) => {
+            assert!(e.to_string().starts_with("[E-SHADER] broken: "), "{e}");
+        }
+        Err(e) => panic!("{e}"),
+        Ok(_) => panic!("a broken shader compiled"),
+    }
+    let missing = gpu.fullscreen_pipeline(&FullscreenDesc {
+        label: "missing entry",
+        wgsl: CLAMP,
+        entry: "no_such_entry",
+        target: Resource::Output,
+    });
+    assert!(
+        matches!(missing, Err(GpuError::Shader { .. })),
+        "{:?}",
+        missing.err()
+    );
+}
+
+#[test]
+fn passes_must_match_the_graph() {
+    let Some(gpu) = gpu() else { return };
+    let targets = Targets::new(&gpu, 8, 8).unwrap_or_else(|e| panic!("{e}"));
+    let graph = Graph::fixed(Target::Offscreen);
+    let mut draw = Clear(BLACK);
+    let mut map = tonemap(&gpu, CLAMP, "clamp_fragment");
+    assert_eq!(
+        graph.render(&gpu, &targets, &mut [&mut map, &mut draw]),
+        Err(GpuError::Graph(GraphError::PassMismatch {
+            index: 0,
+            expected: DRAW,
+            found: TONEMAP,
+        }))
+    );
+    assert_eq!(
+        graph.render(&gpu, &targets, &mut [&mut draw]),
+        Err(GpuError::Graph(GraphError::PassCount {
+            expected: 2,
+            found: 1,
+        }))
+    );
+}
+
+#[test]
+fn a_fullscreen_pass_needs_one_input_and_a_pipeline_for_its_target() {
+    let Some(gpu) = gpu() else { return };
+    let targets = Targets::new(&gpu, 8, 8).unwrap_or_else(|e| panic!("{e}"));
+    let graph = Graph::fixed(Target::Offscreen);
+    let mut map = tonemap(&gpu, CLAMP, "clamp_fragment");
+    // The draw pass reads nothing, so it has no input to draw from.
+    let mut no_input = Fullscreen(
+        DRAW,
+        pipeline(&gpu, CLAMP, "clamp_fragment", Resource::Scene),
+    );
+    match graph.render(&gpu, &targets, &mut [&mut no_input, &mut map]) {
+        Err(GpuError::Pass { pass: "draw", .. }) => {}
+        other => panic!("{other:?}"),
+    }
+    // A pipeline made for the scene's format cannot draw into the output.
+    let mut draw = Clear(BLACK);
+    let mut wrong = Fullscreen(
+        TONEMAP,
+        pipeline(&gpu, CLAMP, "clamp_fragment", Resource::Scene),
+    );
+    match graph.render(&gpu, &targets, &mut [&mut draw, &mut wrong]) {
+        Err(
+            e @ GpuError::Pass {
+                pass: "tonemap", ..
+            },
+        ) => {
+            assert!(e.to_string().starts_with("[E-GPU] pass `tonemap`: "), "{e}");
+        }
+        other => panic!("{other:?}"),
+    }
+}
+
+#[test]
+fn targets_have_a_tier_0_size() {
+    let Some(gpu) = gpu() else { return };
+    for (width, height) in [(0, 10), (10, 0), (8193, 1), (1, 8193)] {
+        assert!(
+            matches!(
+                Targets::new(&gpu, width, height),
+                Err(GpuError::Size { .. })
+            ),
+            "{width}x{height}"
+        );
+    }
+    let targets = Targets::new(&gpu, 8192, 1).unwrap_or_else(|e| panic!("{e}"));
+    assert_eq!(targets.size(), (8192, 1));
+}
diff --git a/crates/eng-gpu/tests/shaders.rs b/crates/eng-gpu/tests/shaders.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4261229493ccbbf1223110f1149e949db039c187
--- /dev/null
+++ b/crates/eng-gpu/tests/shaders.rs
@@ -0,0 +1,296 @@
+//! Shader checks (spec 6.7; rung 1b plan, decision 11; acceptance feature
+//! `shaders`): every WGSL file in the repo validates with naga and translates
+//! to SPIR-V, MSL and HLSL. A shader that only one backend accepts then fails
+//! on every runner, not only on the machines with that backend.
+//!
+//! The options are what eng-gpu's devices guarantee: Tier 0, which is
+//! WebGPU compliance (spec 6.7), on the lowest version of each backend.
+//! - Validation with the capabilities wgpu 30 gives naga for no features and
+//!   compliant downlevel flags (wgpu-naga-bridge's
+//!   `features_to_naga_capabilities`): naga's defaults plus half floats
+//!   packed in f32 (`quantizeToF16`, `pack2x16float`, `unpack2x16float`).
+//! - Pipeline-overridable constants take their defaults, as in a wgpu
+//!   pipeline that sets none.
+//! - SPIR-V 1.0, naga's default and the lowest a Vulkan device takes.
+//! - MSL 2.1: wgpu counts Metal below it as short of WebGPU compliance
+//!   (`DownlevelFlags::MSL2_1`).
+//! - HLSL shader model 5.1, the most FXC compiles. eng-gpu gives wgpu's DX12
+//!   backend FXC, which ships with Windows (decision 10).
+//!
+//! The rejected shaders below pin naga 30's behaviour, so a wgpu upgrade
+//! may need them changed too.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use naga::Module;
+use naga::back::{PipelineConstants, hlsl, msl, pipeline_constants, spv};
+use naga::valid::{Capabilities, ModuleInfo, ValidationFlags, Validator};
+
+fn repo_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../..")
+        .canonicalize()
+        .expect("the crate sits two levels below the repo root")
+}
+
+/// Every `*.wgsl` file below `root`, in path order. At the root only, it
+/// skips `target` and hidden directories (`.git`, and `.claude`, which may
+/// hold other checkouts); deeper down it looks everywhere.
+fn wgsl_files(root: &Path, out: &mut Vec<PathBuf>) {
+    walk(root, root, out);
+}
+
+fn walk(root: &Path, dir: &Path, out: &mut Vec<PathBuf>) {
+    let mut entries: Vec<PathBuf> = fs::read_dir(dir)
+        .unwrap_or_else(|e| panic!("{}: {e}", dir.display()))
+        .map(|entry| entry.expect("a directory entry").path())
+        .collect();
+    entries.sort();
+    for path in entries {
+        let name = path.file_name().unwrap_or_default().to_string_lossy();
+        if path.is_dir() {
+            if dir != root || (name != "target" && !name.starts_with('.')) {
+                walk(root, &path, out);
+            }
+        } else if path.extension().is_some_and(|ext| ext == "wgsl") {
+            out.push(path);
+        }
+    }
+}
+
+/// Tier 0's capabilities (see the top of this file).
+fn tier_0() -> Capabilities {
+    Capabilities::default() | Capabilities::SHADER_FLOAT16_IN_FLOAT32
+}
+
+fn validate(module: &Module, capabilities: Capabilities) -> Result<ModuleInfo, String> {
+    Validator::new(ValidationFlags::all(), capabilities)
+        .validate(module)
+        .map_err(|e| format!("validation: {e}"))
+}
+
+fn spirv(module: &Module, info: &ModuleInfo) -> Result<(), String> {
+    spv::write_vec(module, info, &spv::Options::default(), None)
+        .map(drop)
+        .map_err(|e| format!("SPIR-V: {e}"))
+}
+
+fn msl(module: &Module, info: &ModuleInfo) -> Result<(), String> {
+    let options = msl::Options {
+        lang_version: (2, 1),
+        ..msl::Options::default()
+    };
+    msl::write_string(module, info, &options, &msl::PipelineOptions::default())
+        .map(drop)
+        .map_err(|e| format!("MSL: {e}"))
+}
+
+fn hlsl(module: &Module, info: &ModuleInfo) -> Result<(), String> {
+    let options = hlsl::Options {
+        shader_model: hlsl::ShaderModel::V5_1,
+        ..hlsl::Options::default()
+    };
+    let mut source = String::new();
+    hlsl::Writer::new(&mut source, &options, &hlsl::PipelineOptions::default())
+        .write(module, info, None)
+        .map(drop)
+        .map_err(|e| format!("HLSL: {e}"))
+}
+
+/// Parses and validates `source`, gives its overridable constants their
+/// defaults, then translates it for each backend. The error starts with the
+/// step that failed: `WGSL`, `validation`, `overrides`, `SPIR-V`, `MSL` or
+/// `HLSL`.
+fn check(source: &str) -> Result<(), String> {
+    let module = naga::front::wgsl::parse_str(source)
+        .map_err(|e| format!("WGSL: {}", e.emit_to_string(source)))?;
+    let info = Validator::new(ValidationFlags::all(), tier_0())
+        .validate(&module)
+        .map_err(|e| format!("validation: {}", e.emit_to_string(source)))?;
+    let (module, info) =
+        pipeline_constants::process_overrides(&module, &info, None, &PipelineConstants::default())
+            .map_err(|e| format!("overrides: {e}"))?;
+    spirv(&module, &info)?;
+    msl(&module, &info)?;
+    hlsl(&module, &info)
+}
+
+/// The step `check` stopped at.
+fn failed_step(source: &str) -> String {
+    let error = check(source).expect_err("the shader should fail");
+    error.split(':').next().unwrap_or_default().to_string()
+}
+
+#[test]
+fn every_wgsl_file_validates_and_translates() {
+    let root = repo_root();
+    let mut files = Vec::new();
+    wgsl_files(&root, &mut files);
+    // The scan reaches the crates, where eng-gpu's own vertex stage lives.
+    assert!(
+        files.iter().any(|f| f.starts_with(root.join("crates"))),
+        "the scan of {} found no WGSL file under crates/: {files:?}",
+        root.display()
+    );
+    let failures: Vec<String> = files
+        .iter()
+        .filter_map(|file| {
+            let shown = file.strip_prefix(&root).unwrap_or(file).display();
+            match fs::read_to_string(file) {
+                Ok(source) => check(&source).err().map(|e| format!("{shown}: {e}")),
+                Err(e) => Some(format!("{shown}: {e}")),
+            }
+        })
+        .collect();
+    assert!(
+        failures.is_empty(),
+        "{} of {} WGSL files fail:\n{}",
+        failures.len(),
+        files.len(),
+        failures.join("\n")
+    );
+    eprintln!(
+        "shaders: {} WGSL files validate and translate to SPIR-V, MSL and HLSL",
+        files.len()
+    );
+}
+
+#[test]
+fn the_check_stops_at_the_step_that_rejects_a_shader() {
+    assert_eq!(failed_step("@fragment fn main( {"), "WGSL");
+    // Valid WGSL, but half floats are an optional feature, not Tier 0.
+    assert_eq!(
+        failed_step(
+            "enable f16;\n\
+             @fragment fn main() -> @location(0) vec4<f32> {\n\
+                 let x: f16 = 1.0h;\n\
+                 return vec4<f32>(f32(x));\n\
+             }"
+        ),
+        "validation"
+    );
+    // An overridable constant without a default needs a value from the
+    // pipeline, and a wgpu pipeline that sets none fails the same way.
+    assert_eq!(
+        failed_step(
+            "override scale: f32;\n\
+             @vertex fn main() -> @builtin(position) vec4<f32> {\n\
+                 return vec4<f32>(scale, 0.0, 0.0, 1.0);\n\
+             }"
+        ),
+        "overrides"
+    );
+    // Every step accepts these, which Tier 0 allows: instancing, an
+    // override with a default, `@invariant`, and half floats packed in f32.
+    assert_eq!(
+        check(
+            "override scale: f32 = 2.0;\n\
+             @vertex fn main(@builtin(instance_index) i: u32) -> @builtin(position) @invariant vec4<f32> {\n\
+                 let x = quantizeToF16(f32(i) * scale);\n\
+                 return vec4<f32>(x, unpack2x16float(pack2x16float(vec2<f32>(x))).x, 0.0, 1.0);\n\
+             }"
+        ),
+        Ok(())
+    );
+}
+
+/// A scratch tree outside the repo, removed when dropped.
+struct ScratchTree(PathBuf);
+
+impl ScratchTree {
+    fn new(files: &[&str]) -> Self {
+        let root = std::env::temp_dir().join(format!("eng-gpu-shader-scan-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&root);
+        for file in files {
+            let path = root.join(file);
+            fs::create_dir_all(path.parent().expect("a parent")).expect("a scratch directory");
+            fs::write(&path, "").expect("a scratch file");
+        }
+        Self(root)
+    }
+}
+
+impl Drop for ScratchTree {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn the_scan_skips_only_the_build_and_hidden_directories_at_the_root() {
+    let tree = ScratchTree::new(&[
+        "top.wgsl",
+        "notes.txt",
+        "target/debug/built.wgsl",
+        ".git/kept-by-git.wgsl",
+        ".claude/worktrees/other/crates/a/src/other.wgsl",
+        "crates/a/src/pass.wgsl",
+        "crates/a/src/target/included.wgsl",
+        "crates/a/.shaders/hidden.wgsl",
+    ]);
+    let mut found = Vec::new();
+    wgsl_files(&tree.0, &mut found);
+    let found: Vec<String> = found
+        .iter()
+        .map(|f| {
+            f.strip_prefix(&tree.0)
+                .expect("inside")
+                .display()
+                .to_string()
+        })
+        .collect();
+    assert_eq!(
+        found,
+        [
+            "crates/a/.shaders/hidden.wgsl",
+            "crates/a/src/pass.wgsl",
+            "crates/a/src/target/included.wgsl",
+            "top.wgsl",
+        ]
+    );
+}
+
+#[test]
+fn each_backend_reports_what_it_cannot_translate() {
+    // `check` resolves overridable constants first, as wgpu does for each
+    // pipeline; each backend refuses one left unresolved.
+    let source = "override scale: f32 = 2.0;\n\
+                  @vertex fn main() -> @builtin(position) vec4<f32> {\n\
+                      return vec4<f32>(scale, 0.0, 0.0, 1.0);\n\
+                  }";
+    let module = naga::front::wgsl::parse_str(source).expect("valid WGSL");
+    let info = validate(&module, tier_0()).expect("valid at Tier 0");
+    for (backend, result) in [
+        ("SPIR-V", spirv(&module, &info)),
+        ("MSL", msl(&module, &info)),
+        ("HLSL", hlsl(&module, &info)),
+    ] {
+        let error = result.expect_err(backend);
+        assert!(error.starts_with(&format!("{backend}: ")), "{error}");
+    }
+    // The floors, with features beyond Tier 0 so that validation passes:
+    // views need HLSL shader model 6.1, and primitive indices MSL 2.3.
+    let beyond = |source: &str| {
+        let module = naga::front::wgsl::parse_str(source).expect("valid WGSL");
+        let info = validate(&module, Capabilities::all()).expect("valid with every capability");
+        (module, info)
+    };
+    let (views, info) = beyond(
+        "@fragment fn main(@builtin(view_index) view: u32) -> @location(0) vec4<f32> {\n\
+             return vec4<f32>(f32(view));\n\
+         }",
+    );
+    assert!(spirv(&views, &info).is_ok());
+    let error = hlsl(&views, &info).expect_err("shader model 5.1 has no views");
+    assert!(error.starts_with("HLSL: "), "{error}");
+    let (primitives, info) = beyond(
+        "enable primitive_index;\n\
+         @fragment fn main(@builtin(primitive_index) p: u32) -> @location(0) vec4<f32> {\n\
+             return vec4<f32>(f32(p));\n\
+         }",
+    );
+    assert!(spirv(&primitives, &info).is_ok());
+    let error = msl(&primitives, &info).expect_err("MSL 2.1 has no primitive index");
+    assert!(error.starts_with("MSL: "), "{error}");
+}
