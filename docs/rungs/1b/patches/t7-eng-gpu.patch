diff --git a/crates/eng-gpu/src/error.rs b/crates/eng-gpu/src/error.rs
new file mode 100644
index 0000000000000000000000000000000000000000..530e3f6ef104741088b6e8c41a9b061bc0091d79
--- /dev/null
+++ b/crates/eng-gpu/src/error.rs
@@ -0,0 +1,70 @@
+//! The crate's error type.
+
+use std::fmt;
+
+use crate::GraphError;
+use crate::targets::MAX_SIDE;
+
+/// What went wrong on the GPU side. Each message starts with a log tag.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum GpuError {
+    /// No adapter, or none whose name contains `wanted` (`ENG_GPU_ADAPTER`).
+    /// `found` lists each adapter seen as `name (backend, device type)`.
+    /// `[E-NO-ADAPTER]`; the probe exits 64 with it (plan decision 4).
+    NoAdapter {
+        wanted: Option<String>,
+        found: Vec<String>,
+    },
+    /// The adapter could not open a Tier 0 device. `[E-GPU]`
+    Device(String),
+    /// A WGSL module or the pipeline made from it did not compile.
+    /// `[E-SHADER]`
+    Shader { label: String, message: String },
+    /// wgpu reported an error while rendering or reading back: validation,
+    /// out of memory or internal. `[E-GPU]`
+    Wgpu(String),
+    /// The graph, or the passes given to it. `[E-GRAPH]`
+    Graph(GraphError),
+    /// A pass recorded something its declaration does not allow. `[E-GPU]`
+    Pass { pass: &'static str, message: String },
+    /// A target side outside 1 to 8,192, Tier 0's largest texture. `[E-GPU]`
+    Size { width: u32, height: u32 },
+}
+
+impl fmt::Display for GpuError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NoAdapter { wanted, found } => {
+                match wanted {
+                    Some(name) => write!(
+                        f,
+                        "[E-NO-ADAPTER] no GPU adapter's name contains \"{name}\" (ENG_GPU_ADAPTER)"
+                    )?,
+                    None => f.write_str("[E-NO-ADAPTER] no GPU adapter")?,
+                }
+                if found.is_empty() {
+                    f.write_str("; none found")
+                } else {
+                    write!(f, "; found: {}", found.join("; "))
+                }
+            }
+            Self::Device(message) => write!(f, "[E-GPU] cannot open a Tier 0 device: {message}"),
+            Self::Shader { label, message } => write!(f, "[E-SHADER] {label}: {message}"),
+            Self::Wgpu(message) => write!(f, "[E-GPU] {message}"),
+            Self::Graph(error) => error.fmt(f),
+            Self::Pass { pass, message } => write!(f, "[E-GPU] pass `{pass}`: {message}"),
+            Self::Size { width, height } => write!(
+                f,
+                "[E-GPU] target size {width}x{height}: each side must be 1 to {MAX_SIDE} (Tier 0)"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for GpuError {}
+
+impl From<GraphError> for GpuError {
+    fn from(error: GraphError) -> Self {
+        Self::Graph(error)
+    }
+}
diff --git a/crates/eng-gpu/src/fullscreen.wgsl b/crates/eng-gpu/src/fullscreen.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..6d730277042809fc1b48d5dc0e8d1053735a7d16
--- /dev/null
+++ b/crates/eng-gpu/src/fullscreen.wgsl
@@ -0,0 +1,18 @@
+// The vertex stage of every fullscreen pass (eng-gpu): one triangle that
+// covers the target. `uv` runs from (0, 0) at the target's top left to (1, 1)
+// at its bottom right, so each pixel gets the uv of its centre.
+
+struct Fullscreen {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+}
+
+@vertex
+fn fullscreen_vertex(@builtin(vertex_index) index: u32) -> Fullscreen {
+    // Vertices 0, 1 and 2 at uv (0, 0), (2, 0) and (0, 2).
+    let uv = vec2<f32>(f32((index << 1u) & 2u), f32(index & 2u));
+    var out: Fullscreen;
+    out.position = vec4<f32>(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);
+    out.uv = uv;
+    return out;
+}
diff --git a/crates/eng-gpu/src/gpu.rs b/crates/eng-gpu/src/gpu.rs
new file mode 100644
index 0000000000000000000000000000000000000000..abf98ffdff050d6367a583c9b10f42fd5e6eaec1
--- /dev/null
+++ b/crates/eng-gpu/src/gpu.rs
@@ -0,0 +1,189 @@
+//! Opening the GPU: the instance, the adapter (plan decision 4), a Tier 0
+//! device, and what every fullscreen pass shares.
+
+use std::future::Future;
+use std::pin::pin;
+use std::sync::Arc;
+use std::task::{Context, Poll, Waker};
+
+use crate::error::GpuError;
+use crate::pass::{FullscreenDesc, FullscreenPipeline, Shared};
+use crate::report::{self, GpuReport};
+use crate::targets;
+
+/// One backend for each OS, the ones spec 8.3's adapters use: Metal on
+/// macOS, DX12 on Windows, Vulkan elsewhere. wgpu tries Vulkan first and
+/// sorts adapters only by device type, so with all three a Windows PC with a
+/// Vulkan driver would render through Vulkan, and machines would differ.
+const BACKENDS: wgpu::Backends = if cfg!(target_os = "macos") {
+    wgpu::Backends::METAL
+} else if cfg!(windows) {
+    wgpu::Backends::DX12
+} else {
+    wgpu::Backends::VULKAN
+};
+
+/// How [`Gpu::new`] picks its adapter.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct GpuOptions {
+    /// The first adapter whose name contains this text, ignoring case. With
+    /// `None`, wgpu prefers a discrete GPU, then an integrated one, and
+    /// software rendering last.
+    pub adapter: Option<String>,
+}
+
+impl GpuOptions {
+    /// `adapter` from `ENG_GPU_ADAPTER`; an empty value counts as unset.
+    pub fn from_env() -> Self {
+        Self {
+            adapter: std::env::var("ENG_GPU_ADAPTER")
+                .ok()
+                .filter(|name| !name.is_empty()),
+        }
+    }
+}
+
+/// Whether a missing adapter fails rather than skips: `ENG_REQUIRE_GPU=1`,
+/// which CI sets (plan decision 4).
+pub fn gpu_required() -> bool {
+    std::env::var("ENG_REQUIRE_GPU").is_ok_and(|value| value == "1")
+}
+
+/// A device on one adapter, at Tier 0: WebGPU's default features and limits
+/// (spec 6.7), whatever the adapter could do beyond them.
+///
+/// Errors that no call returns, which should not happen through this API,
+/// panic with `[E-GPU]`: validation errors are fatal (spec 6.7).
+pub struct Gpu {
+    pub(crate) device: wgpu::Device,
+    pub(crate) queue: wgpu::Queue,
+    pub(crate) shared: Shared,
+    report: GpuReport,
+}
+
+impl Gpu {
+    /// Opens a device on the adapter `options` names, or on wgpu's choice.
+    pub fn new(options: &GpuOptions) -> Result<Self, GpuError> {
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+            backends: BACKENDS,
+            // wgpu's release flags in every build, so tests run as the game
+            // does; `WGPU_DEBUG=1` and `WGPU_VALIDATION=1` add debug labels
+            // and the backend's validation layer when debugging. Debug builds
+            // used to add them by default, and Debian 13's Vulkan loader then
+            // hung or crashed now and then when several threads created and
+            // dropped devices at once (rung 1b, T7).
+            flags: wgpu::InstanceFlags::VALIDATION_INDIRECT_CALL.with_env(),
+            memory_budget_thresholds: wgpu::MemoryBudgetThresholds::default(),
+            backend_options: wgpu::BackendOptions {
+                // FXC ships with Windows, so no DLL goes next to the binary
+                // (plan decision 10). wgpu's default would take DXC when one
+                // is on the PATH, so machines would differ.
+                dx12: wgpu::Dx12BackendOptions {
+                    shader_compiler: wgpu::Dx12Compiler::Fxc,
+                    ..wgpu::Dx12BackendOptions::default()
+                },
+                ..wgpu::BackendOptions::default()
+            },
+            display: None,
+        });
+        let adapters = block_on(instance.enumerate_adapters(BACKENDS));
+        let adapter = match &options.adapter {
+            Some(wanted) => {
+                let wanted = wanted.to_lowercase();
+                adapters
+                    .iter()
+                    .find(|a| a.get_info().name.to_lowercase().contains(&wanted))
+                    .cloned()
+            }
+            None => block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
+                power_preference: wgpu::PowerPreference::HighPerformance,
+                ..wgpu::RequestAdapterOptions::default()
+            }))
+            .ok(),
+        };
+        let Some(adapter) = adapter else {
+            return Err(GpuError::NoAdapter {
+                wanted: options.adapter.clone(),
+                found: adapters
+                    .iter()
+                    .map(|a| report::describe(&a.get_info()))
+                    .collect(),
+            });
+        };
+        let (device, queue) = block_on(adapter.request_device(&wgpu::DeviceDescriptor {
+            label: Some("eng-gpu"),
+            required_features: wgpu::Features::empty(),
+            required_limits: wgpu::Limits::default(),
+            ..wgpu::DeviceDescriptor::default()
+        }))
+        .map_err(|e| GpuError::Device(e.to_string()))?;
+        device.on_uncaptured_error(Arc::new(|error| {
+            panic!("[E-GPU] wgpu error outside any call that returns one: {error}")
+        }));
+        let report = report::report(&adapter.get_info(), adapter.features());
+        let shared = Shared::new(&device);
+        Ok(Self {
+            device,
+            queue,
+            shared,
+            report,
+        })
+    }
+
+    /// The adapter and what it supports.
+    pub fn report(&self) -> &GpuReport {
+        &self.report
+    }
+
+    /// Compiles a fullscreen pass's fragment stage (`desc.wgsl`) behind
+    /// eng-gpu's vertex stage, for drawing into `desc.target`.
+    pub fn fullscreen_pipeline(
+        &self,
+        desc: &FullscreenDesc<'_>,
+    ) -> Result<FullscreenPipeline, GpuError> {
+        let shader_error = |message: String| GpuError::Shader {
+            label: desc.label.to_string(),
+            message,
+        };
+        let format = targets::format(desc.target).ok_or_else(|| {
+            shader_error(format!(
+                "eng-gpu has no `{}` to draw into yet",
+                desc.target.name()
+            ))
+        })?;
+        self.scoped(|| self.shared.pipeline(&self.device, desc, format))
+            .map_err(shader_error)
+    }
+
+    /// Runs `work`, then returns the first error wgpu reported meanwhile:
+    /// validation, internal or out of memory.
+    pub(crate) fn scoped<T>(&self, work: impl FnOnce() -> T) -> Result<T, String> {
+        let memory = self.device.push_error_scope(wgpu::ErrorFilter::OutOfMemory);
+        let internal = self.device.push_error_scope(wgpu::ErrorFilter::Internal);
+        let validation = self.device.push_error_scope(wgpu::ErrorFilter::Validation);
+        let value = work();
+        // Scopes pop in reverse order, each as soon as `pop` is called.
+        let popped = [validation.pop(), internal.pop(), memory.pop()];
+        let mut first = None;
+        for scope in popped {
+            if let Some(error) = block_on(scope) {
+                first.get_or_insert_with(|| error.to_string());
+            }
+        }
+        first.map_or(Ok(value), Err)
+    }
+}
+
+/// Drives a wgpu future to its end without an async runtime (plan decision
+/// 6). The native backends finish these at once; GPU work that takes time is
+/// waited for with `Device::poll` instead.
+pub(crate) fn block_on<F: Future>(future: F) -> F::Output {
+    let mut future = pin!(future);
+    let mut context = Context::from_waker(Waker::noop());
+    loop {
+        if let Poll::Ready(output) = future.as_mut().poll(&mut context) {
+            return output;
+        }
+        std::thread::yield_now();
+    }
+}
diff --git a/crates/eng-gpu/src/graph.rs b/crates/eng-gpu/src/graph.rs
new file mode 100644
index 0000000000000000000000000000000000000000..03d372d0af6b7396f319a36fdf613e816c8f906c
--- /dev/null
+++ b/crates/eng-gpu/src/graph.rs
@@ -0,0 +1,246 @@
+//! The fixed render graph (spec 6.3, 6.7; rung 1b plan, decision 1): passes
+//! declare the virtual resources they read and write, and building a graph
+//! checks the declarations. Ordering, culling and pooling come in rung 2.
+
+use std::fmt;
+
+/// A virtual resource that passes read and write.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Resource {
+    /// The scene: linear, scene-referred HDR colour (`Rgba16Float`).
+    Scene,
+    /// The tone-mapped image (`Rgba8UnormSrgb`). It is always an
+    /// engine-owned texture, never the surface: screenshots and golden tests
+    /// read it (spec 6.7).
+    Output,
+    /// The window's swapchain image, in the surface's preferred format. Only
+    /// a [`Target::Surface`] graph has one.
+    Surface,
+}
+
+impl Resource {
+    /// The name used in messages and reports.
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Scene => "scene",
+            Self::Output => "output",
+            Self::Surface => "surface",
+        }
+    }
+}
+
+/// What a pass reads and writes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PassDecl {
+    pub name: &'static str,
+    /// Each must be written by an earlier pass. A fullscreen pass draws from
+    /// its one read ([`crate::PassRecorder::fullscreen`]).
+    pub reads: &'static [Resource],
+    /// Exactly one: the pass's colour target.
+    pub writes: &'static [Resource],
+}
+
+/// Draws the scene. In 1b eng-render's top-down pass goes here (task T8).
+pub const DRAW: PassDecl = PassDecl {
+    name: "draw",
+    reads: &[],
+    writes: &[Resource::Scene],
+};
+
+/// Maps the scene into the output. In 1b the map is a clamp to [0, 1]
+/// (plan decision 2); the output's sRGB format does the encoding.
+pub const TONEMAP: PassDecl = PassDecl {
+    name: "tonemap",
+    reads: &[Resource::Scene],
+    writes: &[Resource::Output],
+};
+
+/// Blits the output into the surface's format, rather than copying, because
+/// swapchain textures cannot be relied on for copies (spec 6.7).
+pub const PRESENT: PassDecl = PassDecl {
+    name: "present",
+    reads: &[Resource::Output],
+    writes: &[Resource::Surface],
+};
+
+/// Where a graph's frames go.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Target {
+    /// Engine-owned textures only: `shot`, `video` and tests.
+    Offscreen,
+    /// A window: the output is also presented.
+    Surface,
+}
+
+/// A checked list of passes, run in order by [`Graph::render`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Graph {
+    pub(crate) passes: Vec<PassDecl>,
+    target: Target,
+}
+
+impl Graph {
+    /// Checks `passes`, in the order they will run:
+    /// - each read was written by an earlier pass;
+    /// - each pass writes exactly one resource;
+    /// - the output is written, never by the pass that writes the surface;
+    /// - an offscreen graph never uses the surface, and a surface graph
+    ///   writes it.
+    pub fn new(passes: &[PassDecl], target: Target) -> Result<Self, GraphError> {
+        let mut written: Vec<Resource> = Vec::new();
+        for pass in passes {
+            let uses_surface = pass
+                .reads
+                .iter()
+                .chain(pass.writes)
+                .any(|r| *r == Resource::Surface);
+            if uses_surface && target == Target::Offscreen {
+                return Err(GraphError::SurfaceOffscreen { pass: pass.name });
+            }
+            if let Some(&resource) = pass.reads.iter().find(|r| !written.contains(r)) {
+                return Err(GraphError::ReadBeforeWrite {
+                    pass: pass.name,
+                    resource,
+                });
+            }
+            // Before the count, so that the error names this rule: only a pass
+            // with two writes can break it while each pass writes one.
+            if pass.writes.contains(&Resource::Output) && pass.writes.contains(&Resource::Surface) {
+                return Err(GraphError::OutputIsSurface { pass: pass.name });
+            }
+            if pass.writes.len() != 1 {
+                return Err(GraphError::Writes {
+                    pass: pass.name,
+                    count: pass.writes.len(),
+                });
+            }
+            written.extend_from_slice(pass.writes);
+        }
+        if !written.contains(&Resource::Output) {
+            return Err(GraphError::OutputNotWritten);
+        }
+        if target == Target::Surface && !written.contains(&Resource::Surface) {
+            return Err(GraphError::SurfaceNotWritten);
+        }
+        Ok(Self {
+            passes: passes.to_vec(),
+            target,
+        })
+    }
+
+    /// Rung 1b's graph: [`DRAW`], [`TONEMAP`], then [`PRESENT`] for a surface.
+    pub fn fixed(target: Target) -> Self {
+        let passes: &[PassDecl] = match target {
+            Target::Offscreen => &[DRAW, TONEMAP],
+            Target::Surface => &[DRAW, TONEMAP, PRESENT],
+        };
+        Self::new(passes, target).expect("the fixed graph passes its own checks")
+    }
+
+    pub fn passes(&self) -> &[PassDecl] {
+        &self.passes
+    }
+
+    pub fn target(&self) -> Target {
+        self.target
+    }
+}
+
+/// A graph whose declarations do not fit together, or passes that do not
+/// match their graph.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum GraphError {
+    ReadBeforeWrite {
+        pass: &'static str,
+        resource: Resource,
+    },
+    Writes {
+        pass: &'static str,
+        count: usize,
+    },
+    OutputIsSurface {
+        pass: &'static str,
+    },
+    SurfaceOffscreen {
+        pass: &'static str,
+    },
+    OutputNotWritten,
+    SurfaceNotWritten,
+    /// [`Graph::render`] was given another number of passes.
+    PassCount {
+        expected: usize,
+        found: usize,
+    },
+    /// A pass given to [`Graph::render`] declares other reads or writes than
+    /// the graph has at its position.
+    PassMismatch {
+        index: usize,
+        expected: PassDecl,
+        found: PassDecl,
+    },
+}
+
+impl fmt::Display for GraphError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("[E-GRAPH] ")?;
+        match self {
+            Self::ReadBeforeWrite { pass, resource } => write!(
+                f,
+                "pass `{pass}` reads `{}` before any pass writes it",
+                resource.name()
+            ),
+            Self::Writes { pass, count } => write!(
+                f,
+                "pass `{pass}` writes {count} resources; a pass writes exactly one"
+            ),
+            Self::OutputIsSurface { pass } => write!(
+                f,
+                "pass `{pass}` writes the output into the surface; the output stays an engine-owned texture"
+            ),
+            Self::SurfaceOffscreen { pass } => write!(
+                f,
+                "pass `{pass}` uses the surface, but the graph renders offscreen"
+            ),
+            Self::OutputNotWritten => {
+                f.write_str("no pass writes `output`, which screenshots read")
+            }
+            Self::SurfaceNotWritten => {
+                f.write_str("no pass writes `surface`, so nothing would be presented")
+            }
+            Self::PassCount { expected, found } => write!(
+                f,
+                "the graph declares {expected} passes, but {found} were given"
+            ),
+            Self::PassMismatch {
+                index,
+                expected,
+                found,
+            } if expected.name != found.name => write!(
+                f,
+                "pass {index} is `{}`, but the graph declares `{}` there",
+                found.name, expected.name
+            ),
+            Self::PassMismatch {
+                index,
+                expected,
+                found,
+            } => write!(
+                f,
+                "pass {index}, `{}`, reads {} and writes {}, but the graph declares it reading {} and writing {}",
+                found.name,
+                names(found.reads),
+                names(found.writes),
+                names(expected.reads),
+                names(expected.writes)
+            ),
+        }
+    }
+}
+
+impl std::error::Error for GraphError {}
+
+/// Resources as `[scene, output]`.
+fn names(resources: &[Resource]) -> String {
+    let names: Vec<&str> = resources.iter().map(|r| r.name()).collect();
+    format!("[{}]", names.join(", "))
+}
