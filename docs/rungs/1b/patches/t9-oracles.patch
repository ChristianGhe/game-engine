@@ -2,11 +2,23 @@
 # owner approves changes.
 version = 1
 
-# Runner-independent simulation budgets, checked by `<game> run --budgets`.
+# Runner-independent simulation budgets, checked by `<game> run`, `shot` and
+# `video` with `--budgets`.
 [sim]
 max_state_bytes = 4096
 max_entities = 16
 
+# Runner-independent per-frame GPU counters (spec 6.13), checked by
+# `<game> shot` and `video` with `--budgets` on every frame they render.
+# About four times the testbed's top-down view with a window (rung 1b,
+# amendment 30): 3 draws, 3 pipeline switches, 2 bind-group switches, and
+# 32 bytes per shape in view (96 with one player, 384 with ten).
+[gpu]
+max_draws_per_frame = 12
+max_pipeline_switches_per_frame = 12
+max_bind_group_switches_per_frame = 8
+max_upload_bytes_per_frame = 2048
+
 # Read by cargo xtask.
 [ci]
 pr_tier_minutes = 15
