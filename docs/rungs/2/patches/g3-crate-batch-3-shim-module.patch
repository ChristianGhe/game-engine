+# objc2-game-controller (the GCMouse shim, a module of eng-platform-winit,
+# macOS only; `name:*` for its wrapper ban, as above).
 allow = [
   "autocfg",
   "bitflags",
@@ -255,6 +264,24 @@ allow = [
   "xkeysym",
   "zerocopy",
   "zerocopy-derive",
+  # Batch 3 (rung 2).
+  "bincode-next",
+  "derive_more",
+  "derive_more-impl",
+  "either-or-both",
+  "gungraun",
+  "gungraun-common",
+  "gungraun-macros",
+  "gungraun-runner",
+  "objc2-game-controller:*",
+  "pastey",
+  "proc-macro-error-attr3",
+  "proc-macro-error3",
+  "rapidhash",
+  "rustc_version",
+  "rustversion",
+  "semver",
+  "unty-next",
 ]
 
