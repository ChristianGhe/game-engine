       - uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27
         with:
           tool: cargo-deny@0.20.2,typos-cli@1.51.1
+      # The notices step (rung 2, decision 17). Its binary needs the `cli`
