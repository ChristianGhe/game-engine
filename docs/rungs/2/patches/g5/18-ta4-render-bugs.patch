+# The planted render bugs no general check catches, as the owner accepts
+# them (rung 2, plan addition A4; criterion `check-misses`: "every planted
+# bug fails a check that is not hard-coded to one scene, or is a known miss
+# the owner accepted"). PROTECTED: the owner's alone, like the rest of
+# xtask/.
+#
+# xtask's `selftest_render_bugs.rs` names each known miss and why it is one.
+# Until this file accepts it, its `render-bug-<n>` case fails, "awaiting the
+# owner's acceptance"; once accepted it passes, its console line reading
+# "ok (known miss)", and the room's own check must still catch it.
+#
+# An entry, one per accepted bug:
+#
+#   [[accepted]]
+#   patch = "03-texture-tag-linear.patch"   # the bug, as its patch is named
+#   reason = "..."                           # why the owner accepts the miss
+#   accepted = "YYYY-MM-DD"                  # the day
+#   accepted_by = "..."                      # who
+#
+# An entry for a bug that a general check catches, or that is not there,
+# fails every case. None is accepted yet: the owner decides at G5.
+version = 1
