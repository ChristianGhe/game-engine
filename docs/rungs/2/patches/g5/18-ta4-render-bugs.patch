diff --git a/xtask/src/selftest_render.rs b/xtask/src/selftest_render.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c461a201d06092918a6b5e604959a715292a53f7
--- /dev/null
+++ b/xtask/src/selftest_render.rs
@@ -0,0 +1,470 @@
+//! `cargo xtask selftest render-bug-<n>` (rung 2, addition A4, criterion
+//! `check-misses`): twelve planted render bugs, small mistakes a builder
+//! could make anywhere from the room's extraction to the palette, written by
+//! an agent that did not build the renderer. Each is a patch in
+//! `xtask/selftest/render-bugs/`, and exists nowhere else; [`BUGS`]
+//! (`selftest_render_bugs.rs`) lists them with the checks that catch them.
+//!
+//! A case copies the workspace to `target/selftest/render-bug-<n>/`,
+//! plants its bug there and runs the bug's checks in turn until one
+//! catches it: general checks, whose verdict comes from a CPU model or a
+//! rule that holds for every scene, not tests that know facts of the
+//! testbed's room. A check catches the bug only if it fails as a test with
+//! the message it is listed with (`expect`), and not on an adapter, shader
+//! or graph error; then, with the bug taken out again, the same check must
+//! pass (the control run). The case fails when no check catches its bug,
+//! when a check fails for another reason, or when the bug no longer
+//! applies: refresh its patch with the code it plants into (quick's xtask
+//! tests say so first).
+//!
+//! **Known misses.** A bug no general check catches is a known miss: its
+//! case runs the room's own check instead, and passes only once the owner
+//! accepts the miss in `xtask/selftest/render-bugs/known-misses.toml`
+//! (protected, the owner's). Until then it fails, awaiting the owner's
+//! acceptance; once accepted, its console line reads "ok (known miss)".
+//!
+//! GPU checks run with `ENG_REQUIRE_GPU=1` and Mesa's shader cache off; a
+//! case whose check finds no adapter could not run ([`NOT_RUN`]), a failure
+//! only in a strict run. The cases build into their own target directory,
+//! `target/selftest/render-target`, so no other case's copies can stand in
+//! for theirs, and theirs for no other's.
+
+use std::fs;
+use std::path::Path;
+use std::time::SystemTime;
+
+use serde::Deserialize;
+
+use crate::selftest::{KNOWN_MISS, NOT_RUN};
+use crate::util;
+
+#[path = "selftest_render_apply.rs"]
+mod patch_file;
+#[path = "selftest_render_bugs.rs"]
+mod table;
+pub(crate) use table::BUGS;
+
+/// Where the cases build.
+const TARGET_DIR: &str = "target/selftest/render-target";
+/// The owner's acceptances of known misses.
+const KNOWN_MISSES: &str = "xtask/selftest/render-bugs/known-misses.toml";
+/// Errors that stop a check before it judges anything: the check did not
+/// run, whatever its test says.
+const NOT_A_VERDICT: [&str; 3] = ["[E-GPU]", "[E-SHADER]", "[E-GRAPH]"];
+
+/// Where a check's test lives.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Target {
+    /// The package's library unit tests (`--lib`).
+    Lib,
+    /// An integration test target, `tests/<name>.rs` (`--test <name>`).
+    Test(&'static str),
+}
+
+/// What a check looks at: the code's own results, or what a frame shows.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Kind {
+    /// A unit test of the code the bug is in (CPU only).
+    Unit,
+    /// A check of what is drawn: rendered images, depth, `info` or records.
+    Seeing,
+}
+
+/// One test that catches a bug: `cargo test -p <package> <target> --
+/// --exact <test>`, failing with `expect` in its message.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Check {
+    pub kind: Kind,
+    pub package: &'static str,
+    pub target: Target,
+    /// The test's full name, as `--exact` matches it.
+    pub test: &'static str,
+    /// A piece of its failure message on this bug.
+    pub expect: &'static str,
+    /// What brings the check, when it is not on `main` yet.
+    pub needs: Option<&'static str>,
+}
+
+impl Check {
+    pub(crate) const fn lib(
+        kind: Kind,
+        package: &'static str,
+        test: &'static str,
+        expect: &'static str,
+    ) -> Self {
+        Self {
+            kind,
+            package,
+            target: Target::Lib,
+            test,
+            expect,
+            needs: None,
+        }
+    }
+
+    pub(crate) const fn test(
+        kind: Kind,
+        package: &'static str,
+        file: &'static str,
+        test: &'static str,
+        expect: &'static str,
+    ) -> Self {
+        Self {
+            kind,
+            package,
+            target: Target::Test(file),
+            test,
+            expect,
+            needs: None,
+        }
+    }
+}
+
+/// A planted bug and what catches it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Bug {
+    /// Its patch, in `xtask/selftest/render-bugs/`.
+    pub patch: &'static str,
+    /// What it breaks.
+    pub what: &'static str,
+    /// The checks the case runs, cheapest first: general ones, or for a
+    /// known miss the room's.
+    pub checks: &'static [Check],
+    /// Why no general check catches it, for a known miss.
+    pub known_miss: Option<&'static str>,
+}
+
+/// The bug of case `render-bug-<n>`, if `case` is one.
+pub(crate) fn bug(case: &str) -> Option<(usize, &'static Bug)> {
+    let n: usize = case.strip_prefix("render-bug-")?.parse().ok()?;
+    let bug = BUGS.get(n.checked_sub(1)?)?;
+    Some((n, bug))
+}
+
+/// Runs case `render-bug-<n>` in `ws`, a fresh copy of the workspace.
+pub(crate) fn run(root: &Path, ws: &Path, case: &str) -> Result<String, String> {
+    let (n, bug) = bug(case).ok_or_else(|| format!("unknown case {case}"))?;
+    let acceptance = match bug.known_miss {
+        Some(_) => accepted(root, bug.patch)?,
+        None => None,
+    };
+    keep_times(root, ws)?;
+    mark_planted(root, ws)?;
+    let planted = apply(root, ws, bug.patch)?;
+    let fail = |what: String| format!("render bug {n} ({}): {what}", bug.patch);
+    let mut passed = Vec::new();
+    for check in bug.checks {
+        match verdict(&run_check(root, ws, check)?, check) {
+            Verdict::Caught(why) => {
+                control(root, ws, &planted, check).map_err(fail)?;
+                return caught(bug, check, &why, acceptance.as_ref()).map_err(fail);
+            }
+            Verdict::Passed => passed.push(name(check)),
+            Verdict::NoAdapter(why) => {
+                return Err(format!(
+                    "{NOT_RUN} {case} could not run here: {} needs a GPU adapter ({why})",
+                    name(check)
+                ));
+            }
+            Verdict::DidNotRun(why) => {
+                let needs = check
+                    .needs
+                    .map_or(String::new(), |n| format!(" (the check comes with {n})"));
+                return Err(fail(format!("{} did not run{needs}: {why}", name(check))));
+            }
+        }
+    }
+    Err(fail(format!("{} passed {}", bug.what, passed.join(", "))))
+}
+
+/// What a case that caught its bug says, or why it still fails: a known
+/// miss passes only once the owner has accepted it.
+fn caught(
+    bug: &Bug,
+    check: &Check,
+    why: &str,
+    acceptance: Option<&Accepted>,
+) -> Result<String, String> {
+    let kind = match check.kind {
+        Kind::Unit => "unit test",
+        Kind::Seeing => "seeing check",
+    };
+    let check = name(check);
+    match (bug.known_miss, acceptance) {
+        (None, _) => Ok(format!("caught by a general {kind}: {check} ({why})")),
+        (Some(_), Some(a)) => Ok(format!(
+            "{KNOWN_MISS} accepted by {} on {} ({}); the room's {kind} {check} catches it ({why})",
+            a.accepted_by, a.accepted, a.reason
+        )),
+        (Some(miss), None) => Err(format!(
+            "awaiting the owner's acceptance of a known miss in {KNOWN_MISSES}: {miss}; \
+             meanwhile the room's {kind} {check} catches it ({why})"
+        )),
+    }
+}
+
+/// The control run: with the bug taken out of `ws` again, `check` must
+/// pass, or its failure was not the bug's.
+fn control(root: &Path, ws: &Path, planted: &[String], check: &Check) -> Result<(), String> {
+    for path in planted {
+        let original = fs::read(root.join(path)).map_err(|e| format!("{path}: {e}"))?;
+        fs::write(ws.join(path), original).map_err(|e| format!("{path}: {e}"))?;
+    }
+    match verdict(&run_check(root, ws, check)?, check) {
+        Verdict::Passed => Ok(()),
+        other => Err(format!(
+            "{} fails without the bug too, so its failure was not the bug's: {other:?}",
+            name(check)
+        )),
+    }
+}
+
+/// A check's name as the bug-by-check table gives it.
+fn name(check: &Check) -> String {
+    match check.target {
+        Target::Lib => format!("{} (lib) {}", check.package, check.test),
+        Target::Test(file) => format!("{} tests/{file}.rs {}", check.package, check.test),
+    }
+}
+
+/// The owner's `known-misses.toml`: which known misses they accepted.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct KnownMisses {
+    version: u32,
+    #[serde(default)]
+    accepted: Vec<Accepted>,
+}
+
+/// One known miss the owner accepted.
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Accepted {
+    /// The bug's patch, as [`BUGS`] names it.
+    pub patch: String,
+    /// Why it is acceptable, in the owner's words.
+    pub reason: String,
+    /// The day, `YYYY-MM-DD`.
+    pub accepted: String,
+    pub accepted_by: String,
+}
+
+/// The owner's acceptances, read strictly: each names a known miss of
+/// [`BUGS`] once, with a reason, a date and who accepted it.
+pub(crate) fn acceptances(text: &str) -> Result<Vec<Accepted>, String> {
+    let file: KnownMisses = toml::from_str(text).map_err(|e| format!("{KNOWN_MISSES}: {e}"))?;
+    if file.version != 1 {
+        return Err(format!("{KNOWN_MISSES}: version {}, not 1", file.version));
+    }
+    let mut seen = Vec::new();
+    for a in &file.accepted {
+        let bug = BUGS.iter().find(|b| b.patch == a.patch);
+        let problem = match bug {
+            None => Some("names no planted bug".to_string()),
+            Some(b) if b.known_miss.is_none() => {
+                Some("is caught by a general check, so it is no known miss".into())
+            }
+            Some(_) if seen.contains(&a.patch) => Some("is accepted twice".into()),
+            Some(_) if a.reason.trim().is_empty() || a.accepted_by.trim().is_empty() => {
+                Some("needs a reason and who accepted it".into())
+            }
+            Some(_) if !is_date(&a.accepted) => Some(format!(
+                "has `accepted = {:?}`, not a date YYYY-MM-DD",
+                a.accepted
+            )),
+            Some(_) => None,
+        };
+        if let Some(problem) = problem {
+            return Err(format!("{KNOWN_MISSES}: {} {problem}", a.patch));
+        }
+        seen.push(a.patch.clone());
+    }
+    Ok(file.accepted)
+}
+
+fn is_date(text: &str) -> bool {
+    let b = text.as_bytes();
+    b.len() == 10
+        && b[4] == b'-'
+        && b[7] == b'-'
+        && b.iter()
+            .enumerate()
+            .all(|(i, c)| i == 4 || i == 7 || c.is_ascii_digit())
+}
+
+/// The owner's acceptance of known miss `patch`, if there is one.
+fn accepted(root: &Path, patch: &str) -> Result<Option<Accepted>, String> {
+    let text =
+        fs::read_to_string(root.join(KNOWN_MISSES)).map_err(|e| format!("{KNOWN_MISSES}: {e}"))?;
+    Ok(acceptances(&text)?.into_iter().find(|a| a.patch == patch))
+}
+
+/// The text of `xtask/selftest/render-bugs/<patch>`.
+fn read_patch(root: &Path, patch: &str) -> Result<String, String> {
+    let file = root.join("xtask/selftest/render-bugs").join(patch);
+    fs::read_to_string(&file).map_err(|e| format!("{}: {e}", file.display()))
+}
+
+/// Gives each file of the copy `ws` the modification time of its original
+/// in `root`, as `fs::copy` does on macOS but not on Linux, so that on
+/// every OS a case rebuilds only the crates [`mark_planted`] marks, and
+/// what depends on them, not the whole workspace.
+fn keep_times(root: &Path, ws: &Path) -> Result<(), String> {
+    for copied in util::walk_all(ws) {
+        let rel = copied.strip_prefix(ws).map_err(|e| e.to_string())?;
+        let modified = fs::metadata(root.join(rel))
+            .and_then(|m| m.modified())
+            .map_err(|e| format!("{}: {e}", rel.display()))?;
+        fs::File::options()
+            .write(true)
+            .open(&copied)
+            .and_then(|f| f.set_modified(modified))
+            .map_err(|e| format!("{}: {e}", copied.display()))?;
+    }
+    Ok(())
+}
+
+/// Marks, in the copy `ws`, every file that any bug plants into as changed
+/// now. Cargo knows a workspace member by its path inside the workspace,
+/// not by where the copy is, so in the cases' shared target directory an
+/// earlier case's build of a crate, its bug in it, would otherwise pass for
+/// fresh wherever the copy has the tree's older times ([`keep_times`]).
+/// Only these files are ever planted into, so their crates are the only
+/// ones an earlier case can have built differently.
+fn mark_planted(root: &Path, ws: &Path) -> Result<(), String> {
+    let now = SystemTime::now();
+    for bug in &BUGS {
+        let text = read_patch(root, bug.patch)?;
+        for file in patch_file::parse(&text).map_err(|e| format!("{}: {e}", bug.patch))? {
+            let path = ws.join(&file.path);
+            fs::File::options()
+                .write(true)
+                .open(&path)
+                .and_then(|f| f.set_modified(now))
+                .map_err(|e| format!("{}: {e}", path.display()))?;
+        }
+    }
+    Ok(())
+}
+
+/// Plants `xtask/selftest/render-bugs/<patch>` in the copy `ws`
+/// (`selftest_render_apply.rs`); returns the files it changed.
+fn apply(root: &Path, ws: &Path, patch: &str) -> Result<Vec<String>, String> {
+    let text = read_patch(root, patch)?;
+    patch_file::apply(ws, &text).map_err(|e| {
+        format!("{patch} no longer applies (refresh it against the code it plants into): {e}")
+    })
+}
+
+/// Runs one check in `ws`; returns whether it passed and its output.
+fn run_check(root: &Path, ws: &Path, check: &Check) -> Result<(bool, String), String> {
+    let mut cmd = util::cargo(ws);
+    cmd.args(["test", "-p", check.package]);
+    match check.target {
+        Target::Lib => cmd.arg("--lib"),
+        Target::Test(file) => cmd.args(["--test", file]),
+    };
+    if util::on_ci() {
+        cmd.arg("--locked");
+    }
+    cmd.arg("--target-dir")
+        .arg(root.join(TARGET_DIR))
+        .args(["--", "--exact", check.test])
+        .env("ENG_REQUIRE_GPU", "1")
+        // As TA1's frame-record shots run: no cache can stand in for a
+        // shader the bug changed.
+        .env("MESA_SHADER_CACHE_DISABLE", "true");
+    let out = cmd
+        .output()
+        .map_err(|e| format!("cannot run cargo test: {e}"))?;
+    Ok((
+        out.status.success(),
+        format!(
+            "{}{}",
+            String::from_utf8_lossy(&out.stdout),
+            String::from_utf8_lossy(&out.stderr)
+        ),
+    ))
+}
+
+/// What one check's run says about the bug.
+#[derive(Debug, PartialEq, Eq)]
+enum Verdict {
+    /// The check failed as a test, with its bug's message: caught. Its
+    /// first lines.
+    Caught(String),
+    /// The check ran and passed.
+    Passed,
+    /// The check needs an adapter this machine lacks.
+    NoAdapter(String),
+    /// It judged nothing: no build, no such test, an adapter, shader or
+    /// graph error, or a failure without its bug's message.
+    DidNotRun(String),
+}
+
+fn verdict((succeeded, output): &(bool, String), check: &Check) -> Verdict {
+    let ran = format!("test {} ... ", check.test);
+    let line = output.lines().find(|l| l.starts_with(&ran));
+    match (succeeded, line) {
+        (true, Some(l)) if l.ends_with("ok") => Verdict::Passed,
+        (true, _) => Verdict::DidNotRun(format!("`{}` is not a test of its target", check.test)),
+        (false, Some(l)) if l.ends_with("FAILED") => {
+            let section = section(output, check.test);
+            if let Some(why) = output.lines().find(|l| l.contains("[E-NO-ADAPTER]")) {
+                return Verdict::NoAdapter(why.trim().to_string());
+            }
+            if let Some(tag) = NOT_A_VERDICT.iter().find(|t| section.contains(*t)) {
+                return Verdict::DidNotRun(format!(
+                    "it failed on {tag}, not on its bug: {}",
+                    panic_message(&section)
+                ));
+            }
+            if !section.contains(check.expect) {
+                return Verdict::DidNotRun(format!(
+                    "it failed, but without `{}`: {}",
+                    check.expect,
+                    panic_message(&section)
+                ));
+            }
+            Verdict::Caught(panic_message(&section))
+        }
+        (false, _) => match output.lines().find(|l| l.contains("no test target named")) {
+            Some(missing) => Verdict::DidNotRun(missing.trim().to_string()),
+            None => Verdict::DidNotRun(util::tail(output, 15)),
+        },
+    }
+}
+
+/// The output libtest gives `test` under `---- <test> stdout ----`.
+fn section(output: &str, test: &str) -> String {
+    let header = format!("---- {test} stdout ----");
+    output
+        .lines()
+        .skip_while(|l| l.trim() != header)
+        .skip(1)
+        .take_while(|l| !l.starts_with("---- ") && l.trim() != "failures:")
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// A failure's message after its `panicked at` line, on one line.
+fn panic_message(section: &str) -> String {
+    let message: Vec<&str> = section
+        .lines()
+        .skip_while(|l| !l.contains("panicked at"))
+        .skip(1)
+        .take_while(|l| !l.trim().is_empty() && !l.starts_with("note:"))
+        .take(2)
+        .collect();
+    let text = message.join(" ");
+    let text = text.trim();
+    if text.chars().count() > 160 {
+        format!("{}...", text.chars().take(160).collect::<String>())
+    } else {
+        text.to_string()
+    }
+}
