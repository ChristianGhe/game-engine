+//! How `selftest render-bug-<n>` plants its bug in the workspace copy: a
+//! unified diff applied in xtask, not by `git apply`, which run inside the
+//! copy would find the real tree's repository above it. Only what the bug
+//! patches need: changes to files that exist in a crate's `src/`, never a
+//! protected one, each hunk found by its exact old lines (context and
+//! removed), wherever they now are in the file, and only if they are there
+//! once.
+
+use std::fs;
+use std::path::{Component, Path};
+
+/// One file's changes: its path from the workspace root, and its hunks as
+/// (old lines, new lines), each line with its newline.
+#[derive(Debug, PartialEq, Eq)]
+pub(super) struct FilePatch {
+    pub path: String,
+    pub hunks: Vec<(String, String)>,
+}
+
+/// The files and hunks of `patch`, a `git diff` of changes to existing
+/// files in a crate's `src/` ([`check_path`]). Anything else (a new,
+/// deleted, renamed or binary file, a mode change, a line with no newline
+/// at the end of a file, a line that is not in a hunk's format) is refused.
+pub(super) fn parse(patch: &str) -> Result<Vec<FilePatch>, String> {
+    let mut files: Vec<FilePatch> = Vec::new();
+    let mut lines = patch.split_inclusive('\n').peekable();
+    while let Some(line) = lines.next() {
+        if let Some(path) = line.strip_prefix("+++ ") {
+            let path = path.trim_end();
+            let Some(path) = path.strip_prefix("b/") else {
+                return Err(format!("only changes to files that exist: +++ {path}"));
+            };
+            check_path(path)?;
+            files.push(FilePatch {
+                path: path.to_string(),
+                hunks: Vec::new(),
+            });
+        } else if line.starts_with("diff --git a/")
+            || line.starts_with("index ")
+            || line.starts_with("--- a/")
+        {
+            // A file's header, which `+++ b/` completes.
+        } else if let Some(header) = line.strip_prefix("@@ -") {
+            let file = files
+                .last_mut()
+                .ok_or("a hunk before its file's +++ line")?;
+            let (old_lines, new_lines) = counts(header).ok_or_else(|| {
+                format!(
+                    "{}: a hunk header that does not parse: {}",
+                    file.path,
+                    line.trim_end()
+                )
+            })?;
+            let (mut old, mut new) = (String::new(), String::new());
+            let (mut o, mut n) = (0, 0);
+            while o < old_lines || n < new_lines {
+                let body = lines
+                    .next()
+                    .ok_or_else(|| format!("{}: a hunk cut short", file.path))?;
+                // An empty context line may come as a bare newline.
+                let context = body.strip_prefix(' ').or((body == "\n").then_some("\n"));
+                if let Some(text) = context {
+                    old.push_str(text);
+                    new.push_str(text);
+                    (o, n) = (o + 1, n + 1);
+                } else if let Some(text) = body.strip_prefix('-') {
+                    old.push_str(text);
+                    o += 1;
+                } else if let Some(text) = body.strip_prefix('+') {
+                    new.push_str(text);
+                    n += 1;
+                } else {
+                    return Err(format!("{}: not a hunk's line: {body:?}", file.path));
+                }
+            }
+            if (o, n) != (old_lines, new_lines) || lines.next_if(|l| l.starts_with('\\')).is_some()
+            {
+                return Err(format!(
+                    "{}: a hunk unlike its header, or a line with no newline at its end",
+                    file.path
+                ));
+            }
+            if old.is_empty() {
+                return Err(format!("{}: a hunk with no old lines", file.path));
+            }
+            file.hunks.push((old, new));
+        } else {
+            return Err(format!(
+                "not a line of a patch to a file that exists: {:?}",
+                line.trim_end()
+            ));
+        }
+    }
+    if files.is_empty() || files.iter().any(|f| f.hunks.is_empty()) {
+        return Err("the patch changes no file".into());
+    }
+    Ok(files)
+}
+
+/// Whether a bug may plant into `path`: a plain relative path (each part a
+/// name, no `..`, `.` or root) to a file in a crate's `src/`, and not a
+/// protected one (`protected.toml`).
+pub(super) fn check_path(path: &str) -> Result<(), String> {
+    let parts: Vec<Component> = Path::new(path).components().collect();
+    let plain = parts.iter().all(|c| matches!(c, Component::Normal(_)));
+    let names: Vec<&str> = path.split('/').collect();
+    let in_src = names.len() >= 4
+        && names[0] == "crates"
+        && names[2] == "src"
+        && names.iter().all(|n| !matches!(*n, "" | "." | ".."));
+    if !plain || !in_src || path.contains('\\') {
+        return Err(format!(
+            "{path}: a bug plants only into a crate's source, crates/<crate>/src/..."
+        ));
+    }
+    if crate::guard::protected()?.matches(path) {
+        return Err(format!("{path}: a protected path"));
+    }
+    Ok(())
+}
+
+/// The old and new line counts of a hunk header after its `@@ -`:
+/// `2,3 +2,4 @@ ...`, a count of 1 when it has no comma.
+fn counts(header: &str) -> Option<(usize, usize)> {
+    let mut parts = header.split(' ');
+    let count = |range: &str| match range.split_once(',') {
+        Some((_, n)) => n.parse().ok(),
+        None => range.parse::<usize>().ok().map(|_| 1),
+    };
+    let old = count(parts.next()?)?;
+    let new = count(parts.next()?.strip_prefix('+')?)?;
+    (parts.next() == Some("@@")).then_some((old, new))
+}
+
+/// `text` with `hunks` applied in turn: each one's old lines must appear in
+/// it exactly once, starting a line.
+pub(super) fn apply_hunks(
+    path: &str,
+    text: &str,
+    hunks: &[(String, String)],
+) -> Result<String, String> {
+    let mut text = text.to_string();
+    for (at, (old, new)) in hunks.iter().enumerate() {
+        let starts: Vec<usize> = text
+            .match_indices(old.as_str())
+            .map(|(i, _)| i)
+            .filter(|&i| i == 0 || text.as_bytes()[i - 1] == b'\n')
+            .collect();
+        match starts.as_slice() {
+            [start] => text.replace_range(*start..start + old.len(), new),
+            [] => return Err(format!("{path}: hunk {} no longer matches", at + 1)),
+            many => {
+                return Err(format!(
+                    "{path}: hunk {} matches {} places",
+                    at + 1,
+                    many.len()
+                ));
+            }
+        }
+    }
+    Ok(text)
+}
+
+/// Applies `patch` to the files under `ws`; returns the paths it changed.
+pub(super) fn apply(ws: &Path, patch: &str) -> Result<Vec<String>, String> {
+    let files = parse(patch)?;
+    let mut changed = Vec::new();
+    // Every file is patched in memory first, so that a refused hunk leaves
+    // the copy as it was.
+    let mut writes = Vec::new();
+    for file in &files {
+        let at = ws.join(&file.path);
+        let text = fs::read_to_string(&at).map_err(|e| format!("{}: {e}", file.path))?;
+        let patched = apply_hunks(&file.path, &text, &file.hunks)?;
+        if patched == text {
+            return Err(format!("{}: the patch leaves it as it was", file.path));
+        }
+        writes.push((at, patched));
+        changed.push(file.path.clone());
+    }
+    for (at, patched) in writes {
+        fs::write(&at, patched).map_err(|e| format!("{}: {e}", at.display()))?;
+    }
+    Ok(changed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{apply_hunks, check_path, parse};
+
+    const PATCH: &str = "\
+diff --git a/crates/x/src/lib.rs b/crates/x/src/lib.rs
+index 1111111..2222222 100644
+--- a/crates/x/src/lib.rs
++++ b/crates/x/src/lib.rs
+@@ -2,3 +2,3 @@ fn a() {
+     let b = 1;
+-    let c = b + 1;
++    let c = b - 1;
+     c
+";
+
+    #[test]
+    fn a_hunk_is_its_old_and_new_lines() {
+        let files = parse(PATCH).unwrap();
+        assert_eq!(files.len(), 1);
+        assert_eq!(files[0].path, "crates/x/src/lib.rs");
+        assert_eq!(
+            files[0].hunks,
+            [(
+                "    let b = 1;\n    let c = b + 1;\n    c\n".to_string(),
+                "    let b = 1;\n    let c = b - 1;\n    c\n".to_string()
+            )]
+        );
+    }
+
+    #[test]
+    fn a_hunk_applies_where_its_old_lines_now_are() {
+        let hunks = &parse(PATCH).unwrap()[0].hunks;
+        // Two lines above it moved it from the line the header names.
+        let text = "// moved\n// down\nfn a() {\n    let b = 1;\n    let c = b + 1;\n    c\n}\n";
+        let done = apply_hunks("x", text, hunks).unwrap();
+        assert_eq!(done, text.replace("b + 1", "b - 1"));
+    }
+
+    #[test]
+    fn a_hunk_that_matches_nowhere_or_twice_is_refused() {
+        let hunks = &parse(PATCH).unwrap()[0].hunks;
+        let gone = apply_hunks("x", "fn a() {\n    let c = 2;\n}\n", hunks).unwrap_err();
+        assert_eq!(gone, "x: hunk 1 no longer matches");
+        let block = "    let b = 1;\n    let c = b + 1;\n    c\n";
+        let twice = apply_hunks("x", &format!("{block}{block}"), hunks).unwrap_err();
+        assert_eq!(twice, "x: hunk 1 matches 2 places");
+        // Inside a longer line is not a match.
+        let inside = format!("//{block}");
+        assert!(apply_hunks("x", &inside, hunks).is_err());
+    }
+
+    #[test]
+    fn only_changes_to_files_that_exist_are_taken() {
+        let new_file = "--- /dev/null\n+++ b/crates/x/src/new.rs\n@@ -0,0 +1 @@\n+fn n() {}\n";
+        assert!(
+            parse(new_file)
+                .unwrap_err()
+                .contains("not a line of a patch")
+        );
+        let no_newline = PATCH.replace("     c\n", "     c\n\\ No newline at end of file\n");
+        assert!(parse(&no_newline).unwrap_err().contains("no newline"));
+        // Header lines `git diff` writes for anything but a plain change.
+        for header in [
+            "new file mode 100644",
+            "deleted file mode 100644",
+            "old mode 100644",
+        ] {
+            let odd = PATCH.replacen("index ", &format!("{header}\nindex "), 1);
+            assert!(
+                parse(&odd).unwrap_err().contains("not a line of a patch"),
+                "{header}"
+            );
+        }
+        assert!(parse("just text\n").is_err());
+    }
+
+    /// A bug plants only into a crate's own source, never a protected file.
+    #[test]
+    fn only_a_crates_source_takes_a_bug() {
+        assert_eq!(check_path("crates/eng-render/src/light.wgsl"), Ok(()));
+        assert_eq!(
+            check_path("crates/eng-render/src/first_person/sprites.rs"),
+            Ok(())
+        );
+        for outside in [
+            "crates/eng-render/tests/light_model.rs",
+            "crates/eng-render/Cargo.toml",
+            "xtask/src/selftest.rs",
+            "crates/eng-render/src/../../../xtask/src/main.rs",
+            "crates/./eng-render/src/lib.rs",
+            "/crates/eng-render/src/lib.rs",
+            "crates//src/lib.rs",
+            "crates/eng-render/src",
+        ] {
+            assert!(
+                check_path(outside).unwrap_err().contains("only into"),
+                "{outside}"
+            );
+        }
+        // A protected path in a crate's source (`protected.toml`).
+        let err = check_path("crates/eng-platform-api/src/conformance.rs").unwrap_err();
+        assert!(err.contains("a protected path"), "{err}");
+        let patch = PATCH.replace("crates/x/src/lib.rs", "crates/x/tests/golden.rs");
+        assert!(parse(&patch).unwrap_err().contains("only into"));
+    }
+}
