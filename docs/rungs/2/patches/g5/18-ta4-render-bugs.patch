+use std::collections::BTreeSet;
+use std::fs;
+use std::time::{Duration, SystemTime};
+
+use super::{
+    Accepted, BUGS, Check, KNOWN_MISSES, Kind, Verdict, acceptances, bug, caught, keep_times,
+    patch_file, verdict,
+};
+use crate::selftest::{CASES, KNOWN_MISS};
+use crate::util;
+
+const CHECK: Check = Check::test(
+    Kind::Seeing,
+    "eng-render",
+    "light_model",
+    "the_light_model_is_the_cpus_on_every_unambiguous_pixel",
+    "(albedo, lit and the output each count)",
+);
+
+/// Every `render-bug-<n>` case has its bug, and every bug its case, its
+/// patch, checks with what they fail with, and a known miss its reason;
+/// every file in the directory is a bug's patch or the owner's list.
+#[test]
+fn each_case_has_its_bug_its_patch_and_its_checks() {
+    let cases: Vec<&str> = CASES
+        .iter()
+        .copied()
+        .filter(|c| c.starts_with("render-bug-"))
+        .collect();
+    assert_eq!(cases.len(), BUGS.len());
+    for (i, case) in cases.iter().enumerate() {
+        let (n, found) = bug(case).unwrap_or_else(|| panic!("{case} has no bug"));
+        assert_eq!((n, found), (i + 1, &BUGS[i]), "{case}");
+    }
+    assert_eq!(bug("render-bug-0"), None);
+    assert_eq!(bug("render-bug-13"), None);
+    let dir = util::root().unwrap().join("xtask/selftest/render-bugs");
+    let on_disk: BTreeSet<String> = fs::read_dir(&dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    let mut named: BTreeSet<String> = BUGS.iter().map(|b| b.patch.to_string()).collect();
+    named.insert("known-misses.toml".into());
+    assert_eq!(on_disk, named, "the files in {}", dir.display());
+    for (i, bug) in BUGS.iter().enumerate() {
+        assert!(
+            bug.patch.starts_with(&format!("{:02}-", i + 1)),
+            "{}",
+            bug.patch
+        );
+        assert!(!bug.checks.is_empty(), "{}", bug.patch);
+        assert!(
+            bug.checks.iter().all(|c| !c.expect.is_empty()),
+            "{}",
+            bug.patch
+        );
+        assert!(
+            bug.known_miss.is_none_or(|why| !why.is_empty()),
+            "{}",
+            bug.patch
+        );
+    }
+}
+
+/// Each bug still plants into the tree as it is: applied in memory, its
+/// hunks find their lines once and change the file. A change to the code a
+/// bug plants into fails here, in quick, before the case does on CI.
+#[test]
+fn every_bug_still_plants_into_the_tree() {
+    let root = util::root().unwrap();
+    for bug in &BUGS {
+        let text =
+            fs::read_to_string(root.join("xtask/selftest/render-bugs").join(bug.patch)).unwrap();
+        let files = patch_file::parse(&text).unwrap_or_else(|e| panic!("{}: {e}", bug.patch));
+        for file in files {
+            let original = fs::read_to_string(root.join(&file.path))
+                .unwrap_or_else(|e| panic!("{}: {}: {e}", bug.patch, file.path));
+            let planted = patch_file::apply_hunks(&file.path, &original, &file.hunks)
+                .unwrap_or_else(|e| panic!("{} no longer applies; refresh it: {e}", bug.patch));
+            assert_ne!(planted, original, "{}: {}", bug.patch, file.path);
+        }
+    }
+}
+
+/// The owner's list as shipped reads strictly.
+#[test]
+fn the_owners_list_of_known_misses_reads() {
+    let root = util::root().unwrap();
+    let text = fs::read_to_string(root.join(KNOWN_MISSES)).unwrap();
+    acceptances(&text).unwrap();
+}
+
+const ENTRY: &str = r#"
+[[accepted]]
+patch = "03-texture-tag-linear.patch"
+reason = "goldens see it"
+accepted = "2026-11-20"
+accepted_by = "the owner"
+"#;
+
+#[test]
+fn an_acceptance_names_a_known_miss_once_with_its_reason_date_and_owner() {
+    assert_eq!(acceptances("version = 1\n"), Ok(Vec::new()));
+    let one = acceptances(&format!("version = 1\n{ENTRY}")).unwrap();
+    assert_eq!(one.len(), 1);
+    assert_eq!(one[0].patch, "03-texture-tag-linear.patch");
+    let refused = |text: String, why: &str| {
+        let err = acceptances(&text).unwrap_err();
+        assert!(err.contains(why), "{err}");
+    };
+    refused(format!("version = 1\n{ENTRY}{ENTRY}"), "accepted twice");
+    refused(
+        format!(
+            "version = 1\n{}",
+            ENTRY.replace("03-texture-tag-linear", "12-palette-cell-rounded")
+        ),
+        "no known miss",
+    );
+    refused(
+        format!(
+            "version = 1\n{}",
+            ENTRY.replace("03-texture-tag-linear", "13-none")
+        ),
+        "names no planted bug",
+    );
+    refused(
+        format!(
+            "version = 1\n{}",
+            ENTRY.replace("2026-11-20", "20 November")
+        ),
+        "not a date",
+    );
+    refused(
+        format!("version = 1\n{}", ENTRY.replace("goldens see it", " ")),
+        "needs a reason",
+    );
+    refused(format!("version = 1\n{ENTRY}extra = 1\n"), "unknown field");
+    refused(format!("version = 2\n{ENTRY}"), "version 2");
+}
+
+/// A general catch passes; a known miss passes only once the owner
+/// accepted it, and then says so on its console line.
+#[test]
+fn a_known_miss_waits_for_the_owner() {
+    let general = &BUGS[11];
+    let ok = caught(general, &general.checks[0], "why", None).unwrap();
+    assert!(ok.starts_with("caught by a general seeing check: eng-render tests/look_checks.rs"));
+    let miss = BUGS.iter().find(|b| b.known_miss.is_some()).unwrap();
+    let waiting = caught(miss, &miss.checks[0], "left: (64, Linear)", None).unwrap_err();
+    assert!(
+        waiting.starts_with("awaiting the owner's acceptance of a known miss"),
+        "{waiting}"
+    );
+    let accepted = Accepted {
+        patch: miss.patch.into(),
+        reason: "goldens see it".into(),
+        accepted: "2026-11-20".into(),
+        accepted_by: "the owner".into(),
+    };
+    let ok = caught(miss, &miss.checks[0], "left: (64, Linear)", Some(&accepted)).unwrap();
+    assert!(ok.starts_with(KNOWN_MISS), "{ok}");
+    assert!(ok.contains("accepted by the owner on 2026-11-20"), "{ok}");
+}
+
+const CAUGHT: &str = "\
+running 1 test
+test the_light_model_is_the_cpus_on_every_unambiguous_pixel ... FAILED
+
+failures:
+
+---- the_light_model_is_the_cpus_on_every_unambiguous_pixel stdout ----
+
+thread 'the_light_model_is_the_cpus_on_every_unambiguous_pixel' panicked at crates/eng-render/tests/light_model.rs:180:9:
+banding true: 4914 differences over 52728 pixels (albedo, lit and the output each count), first:
+(167, 179) face 10: lit [1.8184, 39.0625, 1.8184], the CPU [0.2274, 4.8854, 0.2274] at step 18
+note: run with `RUST_BACKTRACE=1` environment variable to display a backtrace
+
+
+failures:
+    the_light_model_is_the_cpus_on_every_unambiguous_pixel
+
+test result: FAILED. 0 passed; 1 failed; 0 ignored; 0 measured; 9 filtered out
+";
+
+const PANIC: &str = "banding true: 4914 differences over 52728 pixels (albedo, lit and the output each count), first:";
+
+fn run(succeeded: bool, output: &str) -> Verdict {
+    verdict(&(succeeded, output.to_string()), &CHECK)
+}
+
+#[test]
+fn a_check_that_fails_with_its_bugs_message_catches_it() {
+    match run(false, CAUGHT) {
+        Verdict::Caught(why) => assert!(why.starts_with("banding true: 4914 differences"), "{why}"),
+        other => panic!("{other:?}"),
+    }
+    let passed = "test the_light_model_is_the_cpus_on_every_unambiguous_pixel ... ok\n\
+        test result: ok. 1 passed; 0 failed";
+    assert_eq!(run(true, passed), Verdict::Passed);
+}
+
+/// A failure for another reason is no catch: an adapter, shader or graph
+/// error, or a message without the bug's.
+#[test]
+fn a_failure_for_another_reason_is_not_a_catch() {
+    for tag in ["[E-GPU]", "[E-SHADER]", "[E-GRAPH]"] {
+        // Even with the bug's message beside it.
+        let output = CAUGHT.replace(PANIC, &format!("{tag} creating the pipeline: {PANIC}"));
+        match run(false, &output) {
+            Verdict::DidNotRun(why) => assert!(why.contains(tag), "{why}"),
+            other => panic!("{tag}: {other:?}"),
+        }
+    }
+    let other = CAUGHT.replace(PANIC, "assertion `left == right` failed");
+    match run(false, &other) {
+        Verdict::DidNotRun(why) => assert!(why.contains("but without"), "{why}"),
+        other => panic!("{other:?}"),
+    }
+    let no_adapter = CAUGHT.replace(
+        PANIC,
+        "ENG_REQUIRE_GPU=1: [E-NO-ADAPTER] no GPU adapter matches ENG_GPU_ADAPTER=none",
+    );
+    assert!(matches!(
+        run(false, &no_adapter),
+        Verdict::NoAdapter(why) if why.contains("[E-NO-ADAPTER]")
+    ));
+    let no_build = "error[E0425]: cannot find value `width` in this scope\n\
+        error: could not compile `eng-render` (lib) due to 1 previous error";
+    assert!(matches!(
+        run(false, no_build),
+        Verdict::DidNotRun(why) if why.contains("could not compile")
+    ));
+    // A check whose test file is not there yet (`needs`).
+    let missing = "error: no test target named `scene_rules` in `game-testbed` package\n\n\
+        help: available test targets:\n    crash_json\n    exit_codes\n";
+    assert_eq!(
+        run(false, missing),
+        Verdict::DidNotRun(
+            "error: no test target named `scene_rules` in `game-testbed` package".into()
+        )
+    );
+    // `--exact` with a name that is no test runs nothing, and passes.
+    let none = "running 0 tests\n\ntest result: ok. 0 passed; 0 failed; 0 ignored";
+    assert!(matches!(run(true, none), Verdict::DidNotRun(_)));
+}
