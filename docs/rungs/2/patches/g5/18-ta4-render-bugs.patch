+/// A bug's patch applies to the copy and changes only what it names.
+#[test]
+fn a_bug_is_planted_in_the_copy_only() {
+    let ws = std::env::temp_dir().join(format!("xtask-render-bug-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&ws);
+    let file = ws.join("crates/x/src/lib.rs");
+    fs::create_dir_all(file.parent().unwrap()).unwrap();
+    fs::write(
+        &file,
+        "fn a() {\n    let b = 1;\n    let c = b + 1;\n    c\n}\n",
+    )
+    .unwrap();
+    let patch = "\
+--- a/crates/x/src/lib.rs
++++ b/crates/x/src/lib.rs
+@@ -2,3 +2,3 @@ fn a() {
+     let b = 1;
+-    let c = b + 1;
++    let c = b - 1;
+     c
+";
+    assert_eq!(
+        patch_file::apply(&ws, patch).unwrap(),
+        ["crates/x/src/lib.rs"]
+    );
+    assert_eq!(
+        fs::read_to_string(&file).unwrap(),
+        "fn a() {\n    let b = 1;\n    let c = b - 1;\n    c\n}\n"
+    );
+    // Applied twice, its old lines are gone: refused, and nothing written.
+    let again = patch_file::apply(&ws, patch).unwrap_err();
+    assert_eq!(again, "crates/x/src/lib.rs: hunk 1 no longer matches");
+    // A hunk whose new lines are its old ones changes nothing: refused.
+    let same = patch.replace("+    let c = b - 1;", "+    let c = b + 1;");
+    fs::write(
+        &file,
+        "fn a() {\n    let b = 1;\n    let c = b + 1;\n    c\n}\n",
+    )
+    .unwrap();
+    let err = patch_file::apply(&ws, &same).unwrap_err();
+    assert!(err.contains("leaves it as it was"), "{err}");
+    let outside = patch.replace("crates/x/", "../x/");
+    assert!(
+        patch_file::apply(&ws, &outside)
+            .unwrap_err()
+            .contains("only into")
+    );
+    let _ = fs::remove_dir_all(&ws);
+}
+
+/// The copy's files get their originals' times, which `fs::copy` keeps on
+/// macOS but not on Linux.
+#[test]
+fn the_copy_keeps_the_trees_times() {
+    let base = std::env::temp_dir().join(format!("xtask-render-times-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&base);
+    let (root, ws) = (base.join("root"), base.join("ws"));
+    let then = SystemTime::UNIX_EPOCH + Duration::from_secs(1_700_000_000);
+    for dir in [&root, &ws] {
+        fs::create_dir_all(dir.join("crates/x")).unwrap();
+        fs::write(dir.join("crates/x/lib.rs"), "fn a() {}\n").unwrap();
+    }
+    let original = fs::File::options()
+        .write(true)
+        .open(root.join("crates/x/lib.rs"))
+        .unwrap();
+    original.set_modified(then).unwrap();
+    keep_times(&root, &ws).unwrap();
+    let copied = fs::metadata(ws.join("crates/x/lib.rs")).unwrap();
+    assert_eq!(copied.modified().unwrap(), then);
+    let _ = fs::remove_dir_all(&base);
+}
