+    /// The tokens' texts, in order.
+    fn texts(src: &str) -> Vec<String> {
+        super::tokens(src).into_iter().map(|t| t.text).collect()
+    }
+
+    /// Found in a security review of T19's skip scan: `'\''` ended at its
+    /// escaped quote, so its real closing quote opened a new literal and
+    /// the rest of the line was read out of step (a `"` after it opened a
+    /// string), which could hide a `mutants::skip` or an
+    /// `allow(unsafe_code)` that followed on the same line.
+    #[test]
+    fn char_literals_with_escapes_end_where_rustc_ends_them() {
+        let one = |src: &str| texts(src) == ["'"];
+        for literal in [
+            "'\\''",
+            "'\\\\'",
+            "'\\n'",
+            "'\\t'",
+            "'\\r'",
+            "'\\0'",
+            "'\\\"'",
+            "'\"'",
+            "'x'",
+            "'\\x7f'",
+            "'\\u{1F600}'",
+            "'é'",
+        ] {
+            assert!(one(literal), "{literal} is one token: {:?}", texts(literal));
+        }
+        assert_eq!(texts("b'\\''"), ["b", "'"]);
+        assert_eq!(texts("'\\'' '\"' x"), ["'", "'", "x"]);
+        // With no space, the old lexer took `','` for a literal and the `"`
+        // after it for a string's start.
+        assert_eq!(texts("['\\'','\"'] x"), ["[", "'", ",", "'", "]", "x"]);
+        assert_eq!(
+            texts("fn f<'a>(x: &'a str)"),
+            [
+                "fn", "f", "<", "'", "a", ">", "(", "x", ":", "&", "'", "a", "str", ")"
+            ]
+        );
+        assert_eq!(texts("&'static str"), ["&", "'", "static", "str"]);
+        assert_eq!(
+            texts("'outer: loop {}"),
+            ["'", "outer", ":", "loop", "{", "}"]
+        );
+    }
+
+    /// What follows such a literal on its line is still found, by the
+    /// core scan and by T19's `mutants::skip` scan.
+    #[test]
+    fn what_follows_an_escaped_quote_is_still_scanned() {
+        for literal in ["'\\''", "'\\\\'", "'\\u{1F600}'", "b'\\''", "'\\x27'"] {
+            for gap in ["; const D: char = ", ","] {
+                let src =
+                    format!("const Q = [{literal}{gap}'\"']; #[allow(unsafe_code)] fn f() {{}}");
+                assert_eq!(messages(&src), [1], "{src}");
+                let src = format!("const Q = [{literal}{gap}'\"']; #[mutants::skip] fn f() {{}}");
+                assert_eq!(crate::mutants_skip::skips(&src), [1], "{src}");
+            }
+            let src = format!(
+                "fn g<'a>(s: &'a str) -> char {{ {literal} }} #[mutants::skip] fn f() {{}}"
+            );
+            assert_eq!(crate::mutants_skip::skips(&src), [1], "{src}");
+        }
+        // A real string after the literals still hides what is inside it.
+        assert!(
+            messages("const Q: char = '\\''; const S: &str = \"#[allow(unsafe_code)]\";")
+                .is_empty()
+        );
+    }
+
+    /// Found in T21's review: a string's escaped line end (`\` then a
+    /// newline) was skipped uncounted, so later findings named the line
+    /// before theirs; and `r#unsafe_code` lost its `#` and read as
+    /// `runsafe_code`.
+    #[test]
+    fn escaped_line_ends_count_and_raw_identifiers_are_their_names() {
+        let src = "const S: &str = \"a\\\nb\";\n#[allow(unsafe_code)]\nfn f() {}";
+        assert_eq!(messages(src), [3]);
+        let src = "const S: &[u8] = b\"a\\\n\\\nb\";\nextern crate std;";
+        assert_eq!(messages(src), [4]);
+        assert_eq!(texts("r#unsafe_code r#fn x"), ["unsafe_code", "fn", "x"]);
+        assert_eq!(messages("#[allow(r#unsafe_code)] fn f() {}"), [1]);
+        assert_eq!(messages("#![expect(clippy::r#style)]"), [1]);
+        assert_eq!(texts("r#\"x\"# r\"y\" br#\"z\"#"), ["\"\"", "\"\"", "\"\""]);
+    }
