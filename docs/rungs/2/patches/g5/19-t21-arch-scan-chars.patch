+/// Where the token that starts with the `'` at `at` ends. A char literal
+/// is `'`, one character or an escape, then `'`; an escape is `\` and one
+/// character (`\'`, `\\`, `\n`, `\t`, `\r`, `\0`, `\"`), `\x` and two hex
+/// digits, or `\u{...}` up to its `}`. Anything else is a lifetime or a
+/// label, whose name the caller reads next as an identifier. Anything that
+/// does not close where a literal must (which rustc would refuse) is read
+/// as a lone `'`, so what follows it is still tokenized.
+fn char_literal_end(chars: &[char], at: usize) -> usize {
+    let get = |k: usize| chars.get(k).copied();
+    let close = if get(at + 1) == Some('\\') {
+        match get(at + 2) {
+            Some('x') => at + 5,
+            Some('u') if get(at + 3) == Some('{') => {
+                let mut k = at + 4;
+                while get(k).is_some_and(|c| c != '}' && c != '\'' && c != '\n') {
+                    k += 1;
+                }
+                k + 1
+            }
+            _ => at + 3,
+        }
+    } else {
+        at + 2
+    };
+    let on_one_line = chars.get(at + 1..close).is_some_and(|s| !s.contains(&'\n'));
+    if get(close) == Some('\'') && on_one_line {
+        close + 1
+    } else {
+        at + 1
+    }
+}
