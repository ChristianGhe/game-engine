--- /dev/null
+++ b/xtask/src/arch_unsafe.rs
@@ -0,0 +1,379 @@
+//! `arch-check`'s confinement of `unsafe` (ADR-0021, rung 2 criterion 20),
+//! over every Rust file of every workspace crate (its `src`, `tests`,
+//! `examples`, `benches` and build script, `xtask` too), each finding an
+//! `[E-ARCH-UNSAFE]`:
+//!
+//! - **`unsafe_code` only in `deny(…)` or `forbid(…)`.** Any other use of
+//!   the name, in an `allow`, `warn` or `expect` (`cfg_attr` forms too) or
+//!   as a macro's argument that a macro could put in one, fails; so does a
+//!   `$` in an attribute that names `allow`, `warn` or `expect` at any
+//!   depth, in an attribute that is itself a macro variable (`#[$meta]`),
+//!   or in such a list outside an attribute, where a macro could put any
+//!   lint. The one exception is the file `architecture.toml` names for
+//!   the GCMouse shim (`unsafe_file`), whose leading inner attribute may be
+//!   `#![allow(unsafe_code)]`, and nothing else there.
+//! - **That file stays its own text.** It declares no module and no macro
+//!   (`macro_rules!` or `macro`, which could hand its `allow` to code
+//!   elsewhere), and has no `#[path]` or `include!`.
+//! - **No code from outside the scan.** `include` fails everywhere, by
+//!   any path or alias (`use core::include as inc;`). A `#[path]` must
+//!   name, relative to its file's directory, a `.rs` file of a workspace
+//!   crate, which this scan reads too, and never the exempt file; it may
+//!   have no backslash (rustc decodes escapes before the path), and may
+//!   not sit inside an inline module, where rustc looks in a subdirectory
+//!   of the module's name instead.
+//!
+//! The workspace lint denies `unsafe_code` everywhere and core crates
+//! forbid it; this scan stops the escapes the compiler allows in a crate
+//! that only denies it. The selftest `unsafe-outside-shim` plants each.
+//! A proc-macro crate could still build the lint's name from a string; a
+//! review of `eng-derive` covers that (ADR-0021).
+
+use std::collections::BTreeSet;
+use std::fs;
+use std::path::Path;
+
+use super::Model;
+use crate::arch_scan::{self, Token};
+use crate::util;
+
+/// A file's path from the repo root and its text.
+type Source = (String, String);
+
+/// A finding in one file: its line and what it is.
+type Finding = (usize, String);
+
+/// A crate's Rust files under `src` (the core scan's), then every one in
+/// its directory (this scan's), each `(path from the root, text)`. Every
+/// directory counts, those named `target` too, which a `mod target;` can
+/// reach.
+pub fn crate_files(root: &Path, dir: &Path) -> (Vec<Source>, Vec<Source>) {
+    let (mut sources, mut all) = (Vec::new(), Vec::new());
+    for file in util::walk_all(dir) {
+        if file.extension().is_some_and(|e| e == "rs") {
+            let path = util::rel(root, &file);
+            let text = fs::read_to_string(&file).unwrap_or_default();
+            if file.starts_with(dir.join("src")) {
+                sources.push((path.clone(), text.clone()));
+            }
+            all.push((path, text));
+        }
+    }
+    (sources, all)
+}
+
+fn text(toks: &[Token], i: usize) -> &str {
+    toks.get(i).map_or("", |t| t.text.as_str())
+}
+
+/// Whether the tokens open with the inner attribute
+/// `#![allow(unsafe_code)]`, comments aside.
+fn leads_with_the_allow(toks: &[Token]) -> bool {
+    let lead = ["#", "!", "[", "allow", "(", "unsafe_code", ")", "]"];
+    lead.iter().enumerate().all(|(i, t)| text(toks, i) == *t)
+}
+
+/// An attribute's tokens, `#` to its closing `]`: whether it names
+/// `allow`, `warn` or `expect` anywhere, at any depth, or is itself a macro
+/// variable (`#[$meta]`).
+struct Attribute {
+    start: usize,
+    end: usize,
+    lints: bool,
+    variable: bool,
+}
+
+/// Every attribute (`#[…]` and `#![…]`) in the tokens.
+fn attributes(toks: &[Token]) -> Vec<Attribute> {
+    let mut out = Vec::new();
+    for i in 0..toks.len() {
+        if text(toks, i) != "#" {
+            continue;
+        }
+        let open = if text(toks, i + 1) == "!" {
+            i + 2
+        } else {
+            i + 1
+        };
+        if text(toks, open) != "[" {
+            continue;
+        }
+        let (mut depth, mut end) = (0, open);
+        while end < toks.len() {
+            match text(toks, end) {
+                "[" => depth += 1,
+                "]" => {
+                    depth -= 1;
+                    if depth == 0 {
+                        break;
+                    }
+                }
+                _ => {}
+            }
+            end += 1;
+        }
+        let inside = open + 1..end.min(toks.len());
+        out.push(Attribute {
+            start: i,
+            end,
+            lints: inside
+                .clone()
+                .any(|k| matches!(text(toks, k), "allow" | "warn" | "expect")),
+            variable: text(toks, open + 1) == "$",
+        });
+    }
+    out
+}
+
+/// Every `unsafe_code` outside `deny(…)` or `forbid(…)`, and every `$` a
+/// macro could fill with a lint: in an attribute that names `allow`,
+/// `warn` or `expect` at any depth (`#[allow $x]` too), in an attribute
+/// that is itself a macro variable (`#[$meta]`), or in an `allow`, `warn`
+/// or `expect` list outside an attribute. Each `(line, what)`. In the
+/// exempt file (`exempt`) the leading `#![allow(unsafe_code)]` is no
+/// finding.
+pub(super) fn unsafe_code_uses(toks: &[Token], exempt: bool) -> Vec<Finding> {
+    let mut out = Vec::new();
+    let attrs = attributes(toks);
+    // The token before each open `(`, innermost last.
+    let mut opened: Vec<&str> = Vec::new();
+    let lead = exempt && leads_with_the_allow(toks);
+    for (i, tok) in toks.iter().enumerate() {
+        match tok.text.as_str() {
+            "(" => opened.push(text(toks, i.wrapping_sub(1))),
+            ")" => {
+                opened.pop();
+            }
+            "unsafe_code" if lead && i == 5 => {}
+            "unsafe_code" => match opened.last().copied() {
+                Some("deny" | "forbid") => {}
+                Some("allow" | "warn" | "expect") => {
+                    out.push((tok.line, "allows unsafe_code".to_string()));
+                }
+                _ => out.push((
+                    tok.line,
+                    "names unsafe_code outside deny(…) or forbid(…), where a macro could \
+                     allow it"
+                        .to_string(),
+                )),
+            },
+            "$" => {
+                let attr = attrs.iter().find(|a| a.start < i && i < a.end);
+                let fills = match attr {
+                    Some(attr) => attr.lints || attr.variable,
+                    None => opened
+                        .last()
+                        .is_some_and(|t| matches!(*t, "allow" | "warn" | "expect")),
+                };
+                if fills {
+                    out.push((
+                        tok.line,
+                        "a `$` in a lint attribute or list, or an attribute that is a macro \
+                         variable, where a macro could put any lint"
+                            .to_string(),
+                    ));
+                }
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// A `#[path = "…"]` (also inside `cfg_attr`): its line, its string, and
+/// whether it sits inside an inline module (`mod m { … }`).
+pub(super) struct PathAttribute {
+    pub line: usize,
+    pub value: Option<String>,
+    pub inline: bool,
+}
+
+/// Every `#[path]` in the tokens.
+pub(super) fn path_attributes(toks: &[Token]) -> Vec<PathAttribute> {
+    let mut out = Vec::new();
+    // For each open `{`: whether it opens an inline module.
+    let mut braces: Vec<bool> = Vec::new();
+    for (i, tok) in toks.iter().enumerate() {
+        match tok.text.as_str() {
+            "{" => braces.push(i >= 2 && text(toks, i - 2) == "mod"),
+            "}" => {
+                braces.pop();
+            }
+            "#" => {
+                let open = if text(toks, i + 1) == "!" {
+                    i + 2
+                } else {
+                    i + 1
+                };
+                if text(toks, open) != "[" {
+                    continue;
+                }
+                let (mut depth, mut j) = (0, open);
+                while j < toks.len() {
+                    match text(toks, j) {
+                        "[" => depth += 1,
+                        "]" => {
+                            depth -= 1;
+                            if depth == 0 {
+                                break;
+                            }
+                        }
+                        "path" if text(toks, j + 1) == "=" => out.push(PathAttribute {
+                            line: toks[j].line,
+                            value: toks.get(j + 2).and_then(|t| t.value.clone()),
+                            inline: braces.iter().any(|m| *m),
+                        }),
+                        _ => {}
+                    }
+                    j += 1;
+                }
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// The line of each `include`, the macro by any path or alias
+/// (`include!`, `core::include!`, `use core::include as inc;`).
+pub(super) fn includes(toks: &[Token]) -> Vec<usize> {
+    (0..toks.len())
+        .filter(|&i| text(toks, i) == "include")
+        .map(|i| toks[i].line)
+        .collect()
+}
+
+/// What would let the exempt file's text reach beyond it: a module
+/// declaration or a macro definition, each `(line, what)`.
+pub(super) fn declarations(toks: &[Token]) -> Vec<Finding> {
+    let mut out = Vec::new();
+    for (i, tok) in toks.iter().enumerate() {
+        let what = match tok.text.as_str() {
+            "mod" => format!("`mod {}`", text(toks, i + 1)),
+            "macro_rules" if text(toks, i + 1) == "!" => "`macro_rules!`".to_string(),
+            "macro" => "`macro`".to_string(),
+            _ => continue,
+        };
+        out.push((tok.line, what));
+    }
+    out
+}
+
+/// `rel` from the directory `dir` (both from the repo root, `/`-separated),
+/// with `.` and `..` resolved; `None` if it is absolute, has a backslash
+/// (refused before this) or leaves the root.
+pub(super) fn resolve(dir: &str, rel: &str) -> Option<String> {
+    if rel.starts_with('/') || rel.contains([':', '\\']) {
+        return None;
+    }
+    let mut parts: Vec<&str> = dir.split('/').filter(|p| !p.is_empty()).collect();
+    for part in rel.split('/') {
+        match part {
+            "" | "." => {}
+            ".." => {
+                parts.pop()?;
+            }
+            name => parts.push(name),
+        }
+    }
+    Some(parts.join("/"))
+}
+
+/// Adds a finding to `out` for each rule above that a workspace file
+/// breaks.
+pub fn violations(model: &Model, out: &mut Vec<String>) {
+    let mut exempt = Vec::new();
+    for (name, rule) in &model.rules.crates {
+        let (Some(file), Some(pkg)) = (&rule.unsafe_file, model.packages.get(name)) else {
+            continue;
+        };
+        let path = if pkg.dir.is_empty() {
+            file.clone()
+        } else {
+            format!("{}/{file}", pkg.dir)
+        };
+        if !pkg.rust_files.iter().any(|(f, _)| *f == path) {
+            out.push(format!(
+                "[E-ARCH-UNSAFE] architecture.toml lets {path} allow unsafe_code, but {name} has \
+                 no such Rust file"
+            ));
+        }
+        exempt.push(path);
+    }
+    if exempt.len() > 1 {
+        out.push(format!(
+            "[E-ARCH-UNSAFE] architecture.toml lets {} files allow unsafe_code ({}); ADR-0021 \
+             allows one",
+            exempt.len(),
+            exempt.join(", ")
+        ));
+    }
+    let only = exempt.first().map_or_else(
+        || "no file may".to_string(),
+        |path| format!("only {path} may"),
+    );
+    let workspace: Vec<_> = model.packages.values().filter(|p| p.workspace).collect();
+    let scanned: BTreeSet<&str> = workspace
+        .iter()
+        .flat_map(|p| p.rust_files.iter().map(|(f, _)| f.as_str()))
+        .collect();
+    for (file, text) in workspace.iter().flat_map(|p| &p.rust_files) {
+        let toks = arch_scan::tokens(text);
+        let is_exempt = exempt.contains(file);
+        let mut found = Vec::new();
+        for (line, what) in unsafe_code_uses(&toks, is_exempt) {
+            found.push((line, format!("{what}; {only} (ADR-0021)")));
+        }
+        for line in includes(&toks) {
+            found.push((
+                line,
+                "`include!` (by any name) brings in text no scan reads; use a module (ADR-0021)"
+                    .into(),
+            ));
+        }
+        let dir = file.rsplit_once('/').map_or("", |(dir, _)| dir);
+        for path in path_attributes(&toks) {
+            let value = path.value.as_deref();
+            let named = value.and_then(|v| resolve(dir, v));
+            let why = match &named {
+                _ if is_exempt => "is in the one file that may allow unsafe_code".to_string(),
+                _ if value.is_some_and(|v| v.contains('\\')) => {
+                    "has a backslash, which rustc reads as an escape before the path".to_string()
+                }
+                _ if path.inline => "is inside an inline module, so its file is not \
+                                     where this scan looks"
+                    .to_string(),
+                None => "names no file in the repository".to_string(),
+                Some(target) if exempt.contains(target) => {
+                    format!("mounts {target}, the one file that may allow unsafe_code")
+                }
+                Some(target) if !target.ends_with(".rs") || !scanned.contains(target.as_str()) => {
+                    format!("names {target}, which is no workspace crate's Rust file")
+                }
+                Some(_) => continue,
+            };
+            found.push((path.line, format!("`#[path]` {why} (ADR-0021)")));
+        }
+        if is_exempt {
+            for (line, what) in declarations(&toks) {
+                found.push((
+                    line,
+                    format!(
+                        "{what} in the one file that may allow unsafe_code; the exception \
+                         covers this file's text only (ADR-0021)"
+                    ),
+                ));
+            }
+        }
+        found.sort();
+        out.extend(
+            found
+                .into_iter()
+                .map(|(line, what)| format!("[E-ARCH-UNSAFE] {file}:{line}: {what}")),
+        );
+    }
+}
