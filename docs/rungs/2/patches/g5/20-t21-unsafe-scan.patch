+            "crates/eng-gpu/src/x.rs",
+            "#[warn(unsafe_code)]",
+        )
+    });
+    assert_eq!(
+        violations(&m),
+        ["[E-ARCH-UNSAFE] crates/eng-gpu/src/x.rs:1: allows unsafe_code; no file may (ADR-0021)"]
+    );
+}
+
+#[test]
+fn the_exempt_file_pulls_in_no_code_and_must_exist() {
+    for (text, why) in [
+        ("mod more;", "`mod more` in the one file"),
+        (
+            "macro_rules! m { () => {} }",
+            "`macro_rules!` in the one file",
+        ),
+        ("pub macro n() {}", "`macro` in the one file"),
+        (
+            "#[path = \"x.rs\"]\nfn f() {}",
+            "`#[path]` is in the one file",
+        ),
+        (
+            "include!(\"x.rs\");",
+            "`include!` (by any name) brings in text",
+        ),
+        ("#[allow(unsafe_code)] fn g() {}", "allows unsafe_code"),
+    ] {
+        let m = shim_model(|p| {
+            let shim = p.get_mut("eng-std").unwrap();
+            shim.rust_files[1].1.push_str(text);
+        });
+        let found = violations(&m);
+        assert_eq!(found.len(), 1, "{text}: {found:?}");
+        assert!(
+            found[0].starts_with("[E-ARCH-UNSAFE] crates/eng-std/src/ffi.rs:3: ")
+                && found[0].contains(why),
+            "{text}: {found:?}"
+        );
+    }
+    let m = shim_model(|p| {
+        p.get_mut("eng-std").unwrap().rust_files.remove(1);
+    });
+    assert_eq!(
+        violations(&m),
