+
+/// The files a plant names that it also writes.
+const UNSAFE_FILES: [(&str, &str); 1] =
+    [("crates/eng-app/src/hidden.txt", "#![allow(unsafe_code)]\n")];
+
+/// Each line of `found` matched to one expected `(file, what)` and each
+/// expected one to one line: the lines no plant explains, then the
+/// findings no line gave.
+fn unmatched(found: &str, expected: &[(&str, &str)]) -> (Vec<String>, Vec<String>) {
+    let mut used = vec![false; expected.len()];
+    let mut extra = Vec::new();
+    for line in found.lines() {
+        let hit = expected.iter().enumerate().position(|(k, (file, what))| {
+            !used[k] && line.starts_with(&format!("[E-ARCH-UNSAFE] {file}:")) && line.contains(what)
+        });
+        match hit {
+            Some(k) => used[k] = true,
+            None => extra.push(line.to_string()),
+        }
+    }
+    let missing = expected
+        .iter()
+        .zip(&used)
+        .filter(|(_, used)| !**used)
+        .map(|((file, what), _)| format!("{file}: {what}"))
+        .collect();
+    (extra, missing)
+}
+
+/// `unsafe-outside-shim`: the plants, in one copy, each give their own
+/// `[E-ARCH-UNSAFE]` findings at their file, and nothing else is found.
+pub(super) fn unsafe_outside_shim(root: &Path, case: &str) -> Result<String, String> {
+    let ws = copy_workspace(root, case)?;
+    for (file, plant, _) in UNSAFE_PLANTS {
+        let path = ws.join(file);
+        let mut text = fs::read_to_string(&path).map_err(|e| format!("{file}: {e}"))?;
+        text.push_str(plant);
+        fs::write(&path, text).map_err(|e| format!("{file}: {e}"))?;
+    }
+    for (file, text) in UNSAFE_FILES {
+        fs::write(ws.join(file), text).map_err(|e| format!("{file}: {e}"))?;
+    }
+    let found = match arch::check_unlocked(&ws) {
+        Ok(_) => return Err("arch-check accepted every plant".into()),
+        Err(found) => found,
+    };
+    let expected: Vec<(&str, &str)> = UNSAFE_PLANTS
+        .iter()
+        .flat_map(|(file, _, whats)| whats.iter().map(move |what| (*file, *what)))
+        .collect();
+    match unmatched(&found, &expected) {
+        (extra, missing) if extra.is_empty() && missing.is_empty() => Ok(format!(
+            "rejected: [E-ARCH-UNSAFE] for each of {} plants ({} findings), {EXEMPT} exempt",
+            UNSAFE_PLANTS.len(),
+            expected.len()
+        )),
+        (extra, missing) => Err(format!(
+            "arch-check's findings differ from the plants'.\nmissing: {missing:#?}\nunplanted: \
+             {extra:#?}\n{found}"
+        )),
+    }
+}
+
+/// `gcmouse-outside-shim`: eng-platform-winit, the shim's one user, takes
+/// the binding itself; `arch-check`'s `[floor]` (and nothing else) and
+/// cargo-deny's wrapper ban must both refuse it.
+pub(super) fn gcmouse_outside_shim(root: &Path, case: &str) -> Result<String, String> {
+    const BINDING: &str = "objc2-game-controller";
+    let floor = format!(
+        "[E-ARCH-FLOOR] eng-platform-winit depends on {BINDING}; only eng-platform-gcmouse may"
+    );
+    let ws = copy_workspace(root, case)?;
+    add_dependency(&ws, "eng-platform-winit", BINDING)?;
+    match arch::check_unlocked(&ws) {
+        Err(found) if found.trim() == floor => {}
+        Err(found) => return Err(format!("arch-check did not say only {floor}:\n{found}")),
+        Ok(_) => return Err("arch-check accepted the violation".into()),
+    }
+    let banned = deny_rejects(root, case, (BINDING, "eng-platform-winit"), |ws| {
+        add_dependency(ws, "eng-platform-winit", BINDING)
+    })?;
+    Ok(format!("{floor}; {banned}"))
+}
+/// Whether `cargo deny check bans` refused `banned` because `parent`, its
+/// direct user, is not one of its wrappers.
+pub(super) fn deny_verdict(
+    succeeded: bool,
+    output: &str,
+    banned: &str,
+    parent: &str,
+) -> Result<String, String> {
+    let ban = format!("error[banned]: crate '{banned} = ");
+    let user = format!("direct parent '{parent} = ");
+    let of = format!("of banned crate '{banned} = ");
+    let named = output
+        .lines()
+        .any(|line| line.contains(&user) && line.contains(&of));
+    if succeeded {
+        Err("cargo-deny accepted the violation".into())
+    } else if output.contains(&ban) && named {
+        Ok(format!(
+            "rejected: error[banned] {banned}, used by {parent}"
+        ))
+    } else {
+        Err(format!(
+            "failed, but not with error[banned] for {banned} used by {parent}:\n{}",
+            util::tail(output, 15)
+        ))
+    }
+}
+
+/// `cargo deny check bans` on a fresh copy changed by `mutate`: it must
+/// refuse `banned` because `parent` is not one of its wrappers.
+pub(super) fn deny_rejects(
+    root: &Path,
+    case: &str,
+    (banned, parent): (&str, &str),
+    mutate: impl FnOnce(&Path) -> Result<(), String>,
+) -> Result<String, String> {
+    let ws = copy_workspace(root, case)?;
+    mutate(&ws)?;
+    let installed = util::cargo(&ws)
+        .args(["deny", "--version"])
+        .output()
+        .is_ok_and(|o| o.status.success());
+    if !installed {
+        return Err(format!(
+            "{NOT_RUN} {case} could not run: cargo-deny is not installed \
+             (cargo install --locked cargo-deny@0.20.2, as CI's lint job has it)"
+        ));
+    }
+    let out = util::cargo(&ws)
+        .args(["deny", "check", "bans"])
+        .output()
+        .map_err(|e| format!("cannot run cargo-deny: {e}"))?;
+    let text = format!(
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    deny_verdict(out.status.success(), &text, banned, parent)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::unmatched;
+
+    /// A finding no plant explains fails the case as one missing does.
+    #[test]
+    fn each_finding_needs_its_plant_and_each_plant_its_finding() {
+        let expected = [("a.rs", "allows"), ("a.rs", "mounts"), ("b.rs", "allows")];
+        let found = "[E-ARCH-UNSAFE] a.rs:1: allows x\n[E-ARCH-UNSAFE] a.rs:2: mounts y\n\
+                     [E-ARCH-UNSAFE] b.rs:3: allows z";
+        let (extra, missing) = unmatched(found, &expected);
+        assert!(
+            extra.is_empty() && missing.is_empty(),
+            "{extra:?} {missing:?}"
+        );
+        let more = format!("{found}\n[E-ARCH-UNSAFE] c.rs:4: allows w");
+        assert_eq!(
+            unmatched(&more, &expected).0,
+            ["[E-ARCH-UNSAFE] c.rs:4: allows w"]
+        );
+        let twice = "[E-ARCH-UNSAFE] a.rs:1: allows x\n[E-ARCH-UNSAFE] a.rs:9: allows x";
+        let (extra, missing) = unmatched(twice, &expected[..1]);
+        assert_eq!((extra.len(), missing.len()), (1, 0));
+        let (_, missing) = unmatched("[E-ARCH-UNSAFE] a.rs:1: allows x", &expected);
+        assert_eq!(missing, ["a.rs: mounts", "b.rs: allows"]);
+    }
+}
