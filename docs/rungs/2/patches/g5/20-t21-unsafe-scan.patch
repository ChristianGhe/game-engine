+//! Rung 2's confinement cases (criterion 20, ADR-0021) and the cargo-deny
+//! wrapper bans they share with rung 1b's `rwh-outside-seam` (ADR-0016):
+//! `unsafe-outside-shim`, where `arch-check` must refuse each way of
+//! allowing `unsafe_code` outside the GCMouse shim's one file, and
+//! `gcmouse-outside-shim`, where `arch-check`'s `[floor]` and cargo-deny's
+//! wrapper ban must refuse `objc2-game-controller` used by any crate but
+//! the shim. Both fail on a finding they did not plant as well as on one
+//! missing.
+
+use std::fs;
+use std::path::Path;
+
+use super::{NOT_RUN, add_dependency, arch, copy_workspace, util};
+
+/// The shim's one file that may allow `unsafe_code` (`architecture.toml`).
+const EXEMPT: &str = "crates/eng-platform-gcmouse/src/macos.rs";
+
+/// What `arch-check` says of an allow outside the exempt file.
+const ALLOWS: &str = "allows unsafe_code; only crates/eng-platform-gcmouse/src/macos.rs may";
+
+/// Each plant of `unsafe-outside-shim`: the file, the text appended to it,
+/// and what each of its findings says there.
+const UNSAFE_PLANTS: [(&str, &str, &[&str]); 13] = [
+    // A crate that only denies `unsafe_code`, where an allow compiles.
+    (
+        "crates/game-testbed/src/main.rs",
+        "\n#[allow(unsafe_code)]\nfn planted() {}\n",
+        &[ALLOWS],
+    ),
+    // A test file, outside `src`, in a `cfg_attr`.
+    (
+        "crates/eng-render/tests/camera.rs",
+        "\n#[cfg_attr(all(), expect(unsafe_code))]\nfn planted() {}\n",
+        &[ALLOWS],
+    ),
+    // The shim's own safe module.
+    (
+        "crates/eng-platform-gcmouse/src/shim.rs",
+        "\n#[warn(unsafe_code)]\nfn planted() {}\n",
+        &[ALLOWS],
+    ),
+    // The exempt file declares a module, so its exception would cover
+    // another file's text.
+    (
+        EXEMPT,
+        "\nmod planted;\n",
+        &["`mod planted` in the one file that may allow unsafe_code"],
+    ),
+    // The exempt file hands its allow to code elsewhere through a macro
+    // (T21's review), an allow that is not its leading attribute.
+    (
+        EXEMPT,
+        "\nmacro_rules! planted_m { ($($t:tt)*) => { #[allow(unsafe_code)] $($t)* } }\n",
+        &["`macro_rules!` in the one file that may allow", ALLOWS],
+    ),
+    // A `#[path]` to a file no scan reads, which could allow anything.
+    (
+        "crates/eng-app/src/lib.rs",
+        "\n#[path = \"hidden.txt\"]\nmod hidden;\n",
+        &["`#[path]` names crates/eng-app/src/hidden.txt, which is no workspace crate's"],
+    ),
+    // Another crate mounts the exempt file itself.
+    (
+        "crates/eng-platform-winit/src/lib.rs",
+        "\n#[path = \"../../eng-platform-gcmouse/src/macos.rs\"]\nmod stolen;\n",
+        &["`#[path]` mounts crates/eng-platform-gcmouse/src/macos.rs"],
+    ),
+    // `include!` of text no scan reads.
+    (
+        "crates/eng-cli/build.rs",
+        "\ninclude!(\"hidden.txt\");\n",
+        &["`include!` (by any name) brings in text"],
+    ),
+    // A macro whose lint list takes an argument...
+    (
+        "crates/eng-cli/src/lib.rs",
+        "\nmacro_rules! planted { ($l:ident) => { #[allow($l)] fn g() {} } }\n",
+        &["a `$` in a lint attribute or list"],
+    ),
+    // ...and the lint's name handed to one.
+    (
+        "crates/game-testbed-client/src/lib.rs",
+        "\nplanted!(unsafe_code);\n",
+        &["names unsafe_code outside deny(…) or forbid(…)"],
+    ),
+    // T21's second review: an attribute that is itself a macro variable,
+    // which a macro could fill with any lint...
+    (
+        "crates/eng-gpu/src/lib.rs",
+        "\nmacro_rules! planted { ($m:meta) => { #[$m] fn h() {} } }\n",
+        &["a `$` in a lint attribute or list, or an attribute that is a macro variable"],
+    ),
+    // ...`include!` by an alias...
+    (
+        "crates/eng-render/src/lib.rs",
+        "\nuse core::include as planted_include;\n",
+        &["`include!` (by any name) brings in text"],
+    ),
+    // ...and a `#[path]` whose escape rustc decodes before the path.
+    (
+        "crates/eng-input/tests/input.rs",
+        "\n#[path = \"look_rig\\\\mod.rs\"]\nmod planted;\n",
+        &["`#[path]` has a backslash"],
+    ),
