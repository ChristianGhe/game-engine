+pub(crate) fn lints(toks: &[Token], open: usize) -> Vec<String> {
+    let text = |i: usize| toks.get(i).map_or("", |t| t.text.as_str());
+    let (mut depth, mut j, mut inner) = (0, open, String::new());
+    while j < toks.len() {
