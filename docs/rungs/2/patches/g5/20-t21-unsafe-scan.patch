+/// T21's review: a `#[path]` anywhere must name a workspace crate's Rust
+/// file, which the scan reads, and never the exempt one; `include!` and
+/// a lint list a macro fills fail anywhere.
+#[test]
+fn no_file_pulls_in_text_the_scan_does_not_read() {
+    let gpu = "crates/eng-gpu/src/lib.rs";
+    let one = |text: &str| {
+        let m = shim_model(|p| {
+            let pkg = p.get_mut("eng-gpu").unwrap();
+            pkg.dir = "crates/eng-gpu".into();
+            pkg.rust_files = vec![
+                (gpu.into(), text.into()),
+                ("crates/eng-gpu/src/ok.rs".into(), String::new()),
+            ];
+        });
+        violations(&m)
+    };
+    assert_eq!(one("#[path = \"ok.rs\"] mod ok;"), Vec::<String>::new());
+    assert_eq!(
+        one("#[path = \"../../eng-std/src/lib.rs\"] mod other;"),
+        Vec::<String>::new()
+    );
+    for (text, why) in [
+        (
+            "#[path = \"hidden.txt\"] mod h;",
+            "names crates/eng-gpu/src/hidden.txt, which is no",
+        ),
+        (
+            "#[path = \"../../eng-std/src/ffi.rs\"] mod f;",
+            "mounts crates/eng-std/src/ffi.rs",
+        ),
+        (
+            "#[path = \"../../../../x.rs\"] mod x;",
+            "names no file in the repository",
+        ),
+        (
+            "mod m {\n#[path = \"ok.rs\"] mod ok;\n}",
+            "is inside an inline module",
+        ),
+        (
+            "include!(\"ok.rs\");",
+            "`include!` (by any name) brings in text",
+        ),
+        // T21's second review: an alias, a backslash, a macro variable.
+        (
+            "use core::include as inc;",
+            "`include!` (by any name) brings in text",
+        ),
+        (
+            "#[path = \"ok\\\\x.rs\"] mod x;",
+            "`#[path]` has a backslash",
+        ),
+        (
+            "macro_rules! m { ($m:meta) => { #[$m] fn h() {} } }",
+            "a `$` in a lint attribute",
+        ),
+        (
+            "macro_rules! m { ($l:ident) => { #[allow($l)] fn g() {} } }",
+            "a `$` in a lint attribute",
+        ),
+        (
+            "m!(unsafe_code);",
+            "names unsafe_code outside deny(…) or forbid(…)",
+        ),
+    ] {
+        let found = one(text);
+        assert_eq!(found.len(), 1, "{text}: {found:?}");
