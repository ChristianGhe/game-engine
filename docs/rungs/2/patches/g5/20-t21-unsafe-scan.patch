+//! The unsafe scan's helpers (`arch_unsafe.rs`), on made-up sources.
+
+use super::*;
+
+fn uses(src: &str, exempt: bool) -> Vec<usize> {
+    let toks = arch_scan::tokens(src);
+    unsafe_code_uses(&toks, exempt)
+        .into_iter()
+        .map(|(line, _)| line)
+        .collect()
+}
+
+#[test]
+fn unsafe_code_is_named_only_in_deny_or_forbid() {
+    assert_eq!(uses("#![allow(unsafe_code)]\nfn f() {}", false), [1]);
+    assert_eq!(
+        uses("fn f() {}\n#[allow(dead_code, unsafe_code)]", false),
+        [2]
+    );
+    assert_eq!(
+        uses("#![cfg_attr(\n test,\n expect(\n unsafe_code))]", false),
+        [4]
+    );
+    assert_eq!(uses("#[warn(unsafe_code)] fn f() {}", false), [1]);
+    assert_eq!(uses("#[allow(r#unsafe_code)] fn f() {}", false), [1]);
+    // A macro's argument, and a lint list a macro fills.
+    assert_eq!(uses("m!(unsafe_code);", false), [1]);
+    assert_eq!(
+        uses(
+            "macro_rules! m {\n ($l:ident) => { #[allow($l)] fn g() {} }\n}",
+            false
+        ),
+        [2]
+    );
+    assert!(
+        uses(
+            "#![forbid(unsafe_code)]\n#![deny(dead_code, unsafe_code)]",
+            false
+        )
+        .is_empty()
+    );
+    assert!(
+        uses(
+            "// allow(unsafe_code)\nconst S: &str = \"allow(unsafe_code)\";",
+            false
+        )
+        .is_empty()
+    );
+    assert!(uses("#[allow(unsafe_op_in_unsafe_fn)] fn f() {}", false).is_empty());
+    // T21's second review: a `$` anywhere in a lint attribute, and an
+    // attribute that is itself a macro variable.
+    assert_eq!(
+        uses("#[cfg_attr(x, allow(dead_code, $l))] fn f() {}", false),
+        [1]
+    );
+    assert_eq!(
+        uses("#[cfg_attr($c, warn(dead_code))] fn f() {}", false),
+        [1]
+    );
+    assert_eq!(uses("#[allow $x] fn f() {}", false), [1]);
+    assert_eq!(
+        uses(
+            "macro_rules! m { ($m:meta) => {\n #[$m] fn h() {} } }",
+            false
+        ),
+        [2]
+    );
+    assert_eq!(uses("#![$m]", false), [1]);
+    assert_eq!(uses("m!(allow($l));", false), [1]);
+    assert!(
+        uses(
+            "macro_rules! d { ($d:literal $x:expr) => { #[doc = $d] fn f() { $x; } } }",
+            false
+        )
+        .is_empty()
+    );
+    // The exempt file: its leading inner attribute only.
+    assert!(uses("//! Doc.\n#![allow(unsafe_code)]\nfn f() {}", true).is_empty());
+    assert_eq!(
+        uses(
+            "#![allow(unsafe_code)]\n#[allow(unsafe_code)] fn f() {}",
+            true
+        ),
+        [2]
+    );
+    assert_eq!(
+        uses("#![allow(dead_code)]\n#![allow(unsafe_code)]", true),
+        [2]
+    );
+}
+
+#[test]
+fn paths_includes_and_declarations_are_found() {
+    let toks = arch_scan::tokens(
+        "#[path = \"a.rs\"]\nmod a;\nmod b {\n #[cfg_attr(x, path = r\"c.rs\")]\n mod c;\n}\n\
+         #[path = \"d.rs\"] mod d;\ninclude!(\"e.rs\");\nconst T: &str = include_str!(\"t\");",
+    );
+    let paths: Vec<_> = path_attributes(&toks)
+        .into_iter()
+        .map(|p| (p.line, p.value.unwrap_or_default(), p.inline))
+        .collect();
+    assert_eq!(
+        paths,
+        [
+            (1, "a.rs".into(), false),
+            (4, "c.rs".into(), true),
+            (7, "d.rs".into(), false)
+        ]
+    );
+    assert_eq!(includes(&toks), [8]);
+    let alias =
+        arch_scan::tokens("use core::include as inc;\ninc!(\"x.txt\");\n::std::include!(\"y\");");
+    assert_eq!(includes(&alias), [1, 3]);
+    let found: Vec<usize> = declarations(&toks).into_iter().map(|(l, _)| l).collect();
+    assert_eq!(found, [2, 3, 5, 7]);
+    let toks = arch_scan::tokens("macro_rules! m { () => {} }\npub macro n() {}");
+    assert_eq!(declarations(&toks).len(), 2);
+}
+
+#[test]
+fn paths_resolve_from_their_file_s_directory() {
+    let dir = "crates/eng-bench/benches/collision";
+    assert_eq!(
+        resolve(dir, "../../../eng-collision-grid/tests/oracle/brute.rs").as_deref(),
+        Some("crates/eng-collision-grid/tests/oracle/brute.rs")
+    );
+    assert_eq!(
+        resolve("xtask/src", "./ci_harness.rs").as_deref(),
+        Some("xtask/src/ci_harness.rs")
+    );
+    assert_eq!(resolve("a", "../../x.rs"), None);
+    assert_eq!(resolve("a", "/etc/x.rs"), None);
+    assert_eq!(resolve("a", "C:\\x.rs"), None);
+    assert_eq!(resolve("a", "b\\x.rs"), None);
+}
