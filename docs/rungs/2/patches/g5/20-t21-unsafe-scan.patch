+/// ADR-0021: eng-std plays the GCMouse shim, whose `src/ffi.rs` alone may
+/// allow `unsafe_code`.
+fn shim_model(edit: impl FnOnce(&mut BTreeMap<String, Package>)) -> Model {
+    let mut m = model(|p| {
+        let shim = p.get_mut("eng-std").unwrap();
+        shim.dir = "crates/eng-std".into();
+        shim.rust_files = vec![
+            ("crates/eng-std/src/lib.rs".into(), "mod ffi;\n".into()),
+            (
+                "crates/eng-std/src/ffi.rs".into(),
+                "//! FFI.\n#![allow(unsafe_code)]\n".into(),
+            ),
+        ];
+        edit(p);
+    });
+    let exempt = "[crates.eng-std]\nlayer = \"L1\"\nunsafe_file = \"src/ffi.rs\"\n";
+    m.rules = toml::from_str(&RULES.replace("[crates.eng-std]\nlayer = \"L1\"\n", exempt)).unwrap();
+    m
+}
+
+fn file(p: &mut BTreeMap<String, Package>, krate: &str, path: &str, text: &str) {
+    let pkg = p.get_mut(krate).unwrap();
+    pkg.rust_files.push((path.into(), text.into()));
+}
+
+#[test]
+fn unsafe_code_is_allowed_in_the_exempt_file_only() {
+    assert_eq!(violations(&shim_model(|_| {})), Vec::<String>::new());
+    // Any crate, any directory: a test, an example, a build script.
+    for (krate, path) in [
+        ("eng-gpu", "crates/eng-gpu/tests/t.rs"),
+        ("eng-gpu", "crates/eng-gpu/examples/e.rs"),
+        ("eng-std", "crates/eng-std/build.rs"),
+        ("eng-std", "crates/eng-std/src/other.rs"),
+    ] {
+        let m = shim_model(|p| {
+            let text = "fn a() {}\n#![cfg_attr(test, allow(dead_code, unsafe_code))]\n";
+            file(p, krate, path, text);
+        });
+        assert_eq!(
+            violations(&m),
+            [format!(
+                "[E-ARCH-UNSAFE] {path}:2: allows unsafe_code; only crates/eng-std/src/ffi.rs \
