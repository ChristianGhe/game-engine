diff --git a/xtask/src/ci_verdicts_fps.rs b/xtask/src/ci_verdicts_fps.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3898be3bf691a5ff70401053775e2e8725e0c380
--- /dev/null
+++ b/xtask/src/ci_verdicts_fps.rs
@@ -0,0 +1,345 @@
+//! What rung 2's first-person native steps conclude from the files they
+//! read (`ci_native_fps.rs`, T21): pure functions, as in `ci_verdicts.rs`,
+//! so each verdict is tested without a GPU or a window.
+
+use serde_json::Value;
+
+use crate::util::Done;
+
+/// A JSON value as text: a string as it is, anything else as JSON.
+fn text(value: &Value) -> String {
+    value
+        .as_str()
+        .map_or_else(|| value.to_string(), String::from)
+}
+
+/// The keys criterion 10 needs in a first-person `play`'s `window` report:
+/// the grab asked and granted, fullscreen asked and granted, and the
+/// refresh rate (`null` when unknown, as under Xvfb).
+const WINDOW_KEYS: [&str; 6] = [
+    "grab_asked",
+    "grab",
+    "grab_at_end",
+    "fullscreen_asked",
+    "fullscreen",
+    "refresh_rate_mhz",
+];
+
+/// The `window-room` step's verdict beyond the window's (criteria 1 and
+/// 10): the report's `window` is a first-person one and names the cursor
+/// grab, fullscreen and the refresh rate. A scripted run never grabs
+/// (T15), so the grab asked is `false` here; the grab itself is checked
+/// by hand (criterion 10's live run).
+pub fn window_room(report: &Value) -> Result<String, String> {
+    let window = &report["window"];
+    if !window.is_object() {
+        return Err("[E-WINDOW] the room's play report has no `window`".into());
+    }
+    if window["view"] != "first-person" {
+        return Err(format!(
+            "[E-WINDOW] the room's window view is {}, not first-person",
+            window["view"]
+        ));
+    }
+    let missing: Vec<&str> = WINDOW_KEYS
+        .iter()
+        .copied()
+        .filter(|key| window.get(*key).is_none())
+        .collect();
+    if !missing.is_empty() {
+        return Err(format!(
+            "[E-WINDOW] the room's window report has no {}",
+            missing.join(", ")
+        ));
+    }
+    let grabs = ["none", "confined", "locked"];
+    for key in ["grab", "grab_at_end"] {
+        if !grabs.contains(&window[key].as_str().unwrap_or_default()) {
+            return Err(format!("[E-WINDOW] window.{key} is {}", window[key]));
+        }
+    }
+    let rate = &window["refresh_rate_mhz"];
+    if !rate.is_u64() && !rate.is_null() {
+        return Err(format!("[E-WINDOW] window.refresh_rate_mhz is {rate}"));
+    }
+    Ok(format!(
+        "window: grab asked {}, grab {} (at the end {}), fullscreen asked {}, fullscreen {}, \
+         refresh rate {} mHz",
+        window["grab_asked"],
+        text(&window["grab"]),
+        text(&window["grab_at_end"]),
+        window["fullscreen_asked"],
+        window["fullscreen"],
+        rate
+    ))
+}
+
+/// The four per-frame counters and their `[gpu.first_person]` limits.
+const COUNTERS: [(&str, &str); 4] = [
+    ("draws", "max_draws_per_frame"),
+    ("pipeline_switches", "max_pipeline_switches_per_frame"),
+    ("bind_group_switches", "max_bind_group_switches_per_frame"),
+    ("upload_bytes", "max_upload_bytes_per_frame"),
+];
+
+/// Holds a report's `per_frame` peaks to `[gpu.first_person]`'s limits.
+fn hold(per_frame: &Value, limits: &[(&str, u64)], what: &str) -> Result<(), String> {
+    let over: Vec<String> = limits
+        .iter()
+        .filter_map(|&(counter, limit)| match per_frame[counter].as_u64() {
+            Some(used) if used <= limit => None,
+            Some(used) => Some(format!("{counter} {used} > {limit}")),
+            None => Some(format!("{counter} missing")),
+        })
+        .collect();
+    if over.is_empty() {
+        Ok(())
+    } else {
+        Err(format!(
+            "[E-BUDGET] the {what}'s frame exceeds budgets.toml [gpu.first_person]: {}",
+            over.join(", ")
+        ))
+    }
+}
+
+/// Criterion 21's keys in a shot's `gpu`: `pass_times`, each pass that ran
+/// with whole nanoseconds or `null`, a list whenever the adapter has
+/// timestamp queries (every CI adapter has), and `transient_textures`.
+fn pass_times(gpu: &Value) -> Result<String, String> {
+    let pool = gpu["transient_textures"]
+        .as_u64()
+        .ok_or("[E-GPU-REPORT] the room shot's report has no gpu.transient_textures")?;
+    let times = &gpu["pass_times"];
+    let timed = gpu["capabilities"]["timestamp_queries"] == true;
+    let Some(list) = times.as_array() else {
+        if times.is_null() && !timed {
+            return Ok(format!(
+                "no pass times (no timestamp queries), {pool} pooled textures"
+            ));
+        }
+        return Err(format!(
+            "[E-GPU-REPORT] gpu.pass_times is {times}, with timestamp queries {timed}"
+        ));
+    };
+    let mut named = Vec::new();
+    for time in list {
+        let ns = &time["nanoseconds"];
+        match time["pass"].as_str() {
+            Some(pass) if ns.is_u64() || ns.is_null() => named.push(format!("{pass} {ns}")),
+            _ => return Err(format!("[E-GPU-REPORT] a pass time is {time}")),
+        }
+    }
+    if named.is_empty() {
+        return Err("[E-GPU-REPORT] gpu.pass_times lists no pass".into());
+    }
+    Ok(format!(
+        "pass times (ns) {}; {pool} pooled textures",
+        named.join(", ")
+    ))
+}
+
+/// The `gpu-budgets` step's first-person half (criterion 21): the room
+/// shot's report ran with `budgets.toml`'s `[gpu.first_person]` table
+/// (the report's `budgets.first_person`, `null` without it), its frame is
+/// within those limits, and its `gpu` has the per-pass times and pool size;
+/// so are the room window's presented frames (a window's frame adds the
+/// present pass). Without `window-room`'s report, or with one that
+/// presented nothing, only the shot is held: pending, never a pass.
+pub fn first_person_budgets(shot: &Value, window: Option<&Value>) -> Result<Done, String> {
+    if shot["exit"] != "ok" {
+        return Err(format!("the room shot exited {}", shot["exit"]));
+    }
+    let table = &shot["budgets"]["first_person"];
+    if !table.is_object() {
+        return Err(
+            "[E-BUDGET] budgets.toml has no [gpu.first_person] (the room shot's report \
+                    has budgets.first_person null)"
+                .into(),
+        );
+    }
+    let limits = COUNTERS
+        .iter()
+        .map(|&(counter, key)| {
+            table[key]
+                .as_u64()
+                .map(|limit| (counter, limit))
+                .ok_or_else(|| format!("[E-BUDGET] budgets.toml [gpu.first_person] has no {key}"))
+        })
+        .collect::<Result<Vec<_>, String>>()?;
+    let gpu = &shot["gpu"];
+    if !gpu["per_frame"].is_object() {
+        return Err("[E-BUDGET] the room shot's report has no per-frame counters".into());
+    }
+    hold(&gpu["per_frame"], &limits, "room shot")?;
+    let times = pass_times(gpu)?;
+    let held = format!(
+        "the room shot's frame {} within budgets.toml [gpu.first_person]; {times}",
+        gpu["per_frame"]
+    );
+    Ok(match window {
+        Some(report) if report["gpu"]["frames"].as_u64().unwrap_or(0) > 0 => {
+            hold(&report["gpu"]["per_frame"], &limits, "room window")?;
+            Done::Pass(format!(
+                "{held}; the room window's frames too ({})",
+                report["gpu"]["per_frame"]
+            ))
+        }
+        Some(_) => Done::Pending(format!(
+            "pending, not a pass: the window-room step's window presented no frame, so only \
+             the room shot is held; {held}"
+        )),
+        None => Done::Pending(format!(
+            "pending, not a pass: no report from the window-room step \
+             (target/ci/window-room.json), so only the room shot is held; {held}"
+        )),
+    })
+}
+
+/// The `frame-record` step's verdict (plan addition A1) from
+/// `target/frame-candidates/frames.json`, which `tests/frame_record.rs`
+/// writes: compared exactly on the pinned configuration (`exact`), within
+/// tolerances elsewhere; a pass only if every shot's record passed, pending
+/// while any has no reference yet (the owner commits `golden/frames/` at
+/// G6) or is marked `golden = "pending"`.
+pub fn frames(summary: &str, exact: bool) -> Result<Done, String> {
+    let summary: Value =
+        serde_json::from_str(summary).map_err(|e| format!("[E-GOLDEN] frames.json: {e}"))?;
+    let config = &summary["configuration"];
+    let adapter = format!(
+        "`{}` `{}`",
+        text(&config["adapter"]),
+        text(&config["driver_info"])
+    );
+    let wanted = if exact { "exact" } else { "tolerances" };
+    let mode = summary["mode"].as_str().unwrap_or_default();
+    if mode != wanted {
+        return Err(format!(
+            "[E-GOLDEN] the frame records were compared by {mode:?}, not {wanted}, on {adapter}"
+        ));
+    }
+    if exact && config["pinned"] != true {
+        return Err(format!(
+            "[E-GOLDEN] frame-record needs the pinned configuration here, not {adapter}"
+        ));
+    }
+    let shots = summary["shots"]
+        .as_array()
+        .filter(|shots| !shots.is_empty())
+        .ok_or("[E-GOLDEN] frames.json names no shot")?;
+    let (mut failed, mut pending) = (Vec::new(), Vec::new());
+    for shot in shots {
+        let name = text(&shot["name"]);
+        match shot["status"].as_str() {
+            Some("pass") => {}
+            Some(status @ ("no-reference" | "pending")) => pending.push(format!("{name} {status}")),
+            other => failed.push(format!("{name}: [E-GOLDEN] status {other:?}")),
+        }
+    }
+    if !failed.is_empty() {
+        return Err(failed.join("\n"));
+    }
+    let count = shots.len();
+    Ok(if pending.is_empty() {
+        Done::Pass(format!("{count} frame records pass ({mode}) on {adapter}"))
+    } else {
+        Done::Pending(format!(
+            "pending, not a pass, until the owner commits golden/frames/ (G6): {}; {count} \
+             records ({mode}) on {adapter}; candidates in target/frame-candidates/",
+            pending.join(", ")
+        ))
+    })
+}
+
+/// The `scene-rules` step's verdict (plan addition A2) from
+/// `target/scene-rules/rules.json`: the committed rules were read (never
+/// `ENG_RULES_DIR`), and no rule failed on any shot.
+pub fn scene_rules(summary: &str) -> Result<String, String> {
+    let summary: Value =
+        serde_json::from_str(summary).map_err(|e| format!("[E-SCENE-RULE] rules.json: {e}"))?;
+    let dir = text(&summary["rules_dir"]).replace('\\', "/");
+    if !dir.ends_with("crates/game-testbed/scenes") {
+        return Err(format!(
+            "[E-SCENE-RULE] the rules came from {dir:?}, not the committed scenes/"
+        ));
+    }
+    let failures = summary["failures"]
+        .as_array()
+        .ok_or("[E-SCENE-RULE] rules.json has no failures list")?
+        .len();
+    if failures > 0 {
+        return Err(format!(
+            "[E-SCENE-RULE] {failures} findings failed: {}",
+            summary["failures"]
+        ));
+    }
+    let shots = summary["shots"].as_array().map_or(0, Vec::len);
+    if shots == 0 {
+        return Err("[E-SCENE-RULE] rules.json judged no shot".into());
+    }
+    Ok(format!(
+        "{shots} shots judged by the committed rules, none failed, on `{}`",
+        text(&summary["configuration"]["adapter"])
+    ))
+}
+
+/// The `poses` step's verdict (plan addition A3) from the shot harness's
+/// `shots.json` and `shots.toml` (`manifest`): the poses the views name
+/// are exactly the manifest's `[pose]` keys, each such view's camera came
+/// from its pose, and no shot failed (marked shots are pending there,
+/// which is no failure).
+pub fn poses(shots_json: &str, manifest: &str) -> Result<String, String> {
+    let summary: Value =
+        serde_json::from_str(shots_json).map_err(|e| format!("[E-GOLDEN] shots.json: {e}"))?;
+    let manifest: toml::Table = manifest
+        .parse()
+        .map_err(|e: toml::de::Error| format!("shots.toml: {e}"))?;
+    let mut named: Vec<String> = manifest
+        .get("pose")
+        .and_then(toml::Value::as_table)
+        .map(|poses| poses.keys().cloned().collect())
+        .unwrap_or_default();
+    named.sort();
+    if named.is_empty() {
+        return Err("[E-POSE] shots.toml names no [pose]".into());
+    }
+    let views = summary["views"]
+        .as_array()
+        .ok_or("[E-POSE] shots.json has no views")?;
+    let mut drawn = Vec::new();
+    for view in views.iter().filter(|v| !v["pose"].is_null()) {
+        let pose = text(&view["pose"]);
+        if view["camera_from"] != "pose" {
+            return Err(format!(
+                "[E-POSE] shot {} names pose {pose}, but its camera came from {}",
+                text(&view["name"]),
+                view["camera_from"]
+            ));
+        }
+        drawn.push(pose);
+    }
+    drawn.sort();
+    drawn.dedup();
+    if drawn != named {
+        return Err(format!(
+            "[E-POSE] the views drew poses {drawn:?}, but shots.toml names {named:?}"
+        ));
+    }
+    let failed: Vec<String> = summary["shots"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|shot| shot["status"] == "fail")
+        .map(|shot| text(&shot["message"]))
+        .collect();
+    if !failed.is_empty() {
+        return Err(failed.join("\n"));
+    }
+    Ok(format!(
+        "poses {} each drawn from its own camera, no shot failed",
+        named.join(", ")
+    ))
+}
+
