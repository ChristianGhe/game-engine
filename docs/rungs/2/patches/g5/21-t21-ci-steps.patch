new file mode 100644
index 0000000000000000000000000000000000000000..0b548b75b223dbc29e496ddb93dc013d5de79540
--- /dev/null
+++ b/xtask/src/ci_native_mac.rs
@@ -0,0 +1,54 @@
+//! The macOS runner's own native steps: the Intel Mac's compile check
+//! (rung 1b) and the GCMouse shim's clippy (rung 2, ADR-0021).
+
+use std::path::Path;
+use std::process::Command;
+
+use super::pass;
+use crate::ci;
+use crate::util::{self, Done};
+
+const INTEL_MAC: &str = "x86_64-apple-darwin";
+
+/// The Intel Mac is compile-checked only (spec 8.2, criterion 1). The
+/// workflow adds the target in the macOS job only.
+pub(super) fn check_intel_mac(root: &Path) -> Result<Done, String> {
+    let mut libdir = Command::new("rustc");
+    libdir
+        .current_dir(root)
+        .args(["--print", "target-libdir", "--target", INTEL_MAC]);
+    let libdir = util::run_quiet(root, "native-intel-libdir", &mut libdir)?;
+    if !Path::new(libdir.trim()).is_dir() {
+        return Err(format!(
+            "[E-NO-TARGET] {INTEL_MAC}'s standard library is not installed: `rustup target add \
+             {INTEL_MAC}` (the macos-26 job does)"
+        ));
+    }
+    let args = [
+        "check",
+        "--workspace",
+        "--all-targets",
+        "--target",
+        INTEL_MAC,
+    ];
+    pass(ci::cargo_step(root, "native-check-intel-mac", &args))
+}
+
+/// ADR-0021: clippy on the GCMouse shim where its `unsafe` module is
+/// compiled, macOS (the lint job's Linux compiles it out), so a block
+/// without its `// SAFETY:` comment fails on CI too.
+pub(super) fn clippy_shim(root: &Path) -> Result<Done, String> {
+    let args = [
+        "clippy",
+        "-p",
+        "eng-platform-gcmouse",
+        "--all-targets",
+        "--",
+        "-D",
+        "warnings",
+    ];
+    ci::cargo_step(root, "native-clippy-shim", &args)?;
+    pass(Ok(
+        "eng-platform-gcmouse, src/macos.rs included: no warning".into(),
+    ))
+}
