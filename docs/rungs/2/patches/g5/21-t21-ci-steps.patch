+
+/// The verdict of [`job_tier`] from `jobs` (as for [`native_duration`],
+/// with the conclusion read): how long each run of `job` (named `job`, or
+/// `job (<value>)` for a matrix) took, the slowest held to
+/// `budget_minutes`. Going over is reported, never failed. A job this event
+/// skipped (bench on the weekly schedule, by its `if`) is pending, since
+/// nothing ran to measure; a run missing or unfinished fails.
+pub fn job_duration(jobs: &str, job: &str, budget_minutes: i64, key: &str) -> Result<Done, String> {
+    let matrix = format!("{job} (");
+    let (mut took, mut skipped, mut unfinished) = (Vec::new(), 0, Vec::new());
+    for line in jobs.lines() {
+        let fields: Vec<&str> = line.split('\t').collect();
+        let name = fields[0];
+        if name != job && !name.starts_with(&matrix) {
+            continue;
+        }
+        if fields.get(3) == Some(&"skipped") {
+            skipped += 1;
+            continue;
+        }
+        let start = fields.get(1).and_then(|t| unix_seconds(t));
+        let end = fields.get(2).and_then(|t| unix_seconds(t));
+        match start
+            .zip(end)
+            .and_then(|(start, end)| end.checked_sub(start))
+        {
+            Some(seconds) => took.push((name, seconds)),
+            None => unfinished.push(name),
+        }
+    }
+    if !unfinished.is_empty() {
+        return Err(format!(
+            "[E-DURATION] unfinished: {}",
+            unfinished.join(", ")
+        ));
+    }
+    if took.is_empty() {
+        return if skipped > 0 {
+            Ok(Done::Pending(format!(
+                "{job} was skipped on this event: nothing to measure"
+            )))
+        } else {
+            Err(format!("[E-DURATION] this run has no {job} job"))
+        };
+    }
+    let minutes = |seconds: u64| format!("{:.1} min", seconds as f64 / 60.0);
+    let list: Vec<String> = took
+        .iter()
+        .map(|&(name, seconds)| format!("{name} {}", minutes(seconds)))
+        .collect();
+    let &(slowest, seconds) = took
+        .iter()
+        .max_by_key(|&&(_, seconds)| seconds)
+        .expect("took is not empty");
+    let within = i64::try_from(seconds).is_ok_and(|s| s <= budget_minutes.saturating_mul(60));
+    let verdict = if within { "within" } else { "OVER" };
+    Ok(Done::Pass(format!(
+        "{}; the slowest, {slowest}, took {} ({verdict} the {budget_minutes} min budget, \
+         budgets.toml [ci] {key})",
+        list.join(", "),
+        minutes(seconds)
+    )))
+}
