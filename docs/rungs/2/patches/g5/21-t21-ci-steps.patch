+//! The first-person native steps' verdicts, from made-up reports in the
+//! shapes the probe and the harnesses write.
+
+use serde_json::{Value, json};
+
+use super::*;
+
+fn window() -> Value {
+    json!({"window": {
+        "view": "first-person", "grab_asked": false, "grab": "none", "grab_at_end": "none",
+        "fullscreen_asked": false, "fullscreen": false, "refresh_rate_mhz": null,
+    }})
+}
+
+#[test]
+fn the_room_window_names_grab_fullscreen_and_refresh_rate() {
+    let ok = window_room(&window()).unwrap();
+    assert!(ok.contains("grab asked false, grab none"), "{ok}");
+    assert!(ok.contains("refresh rate null mHz"), "{ok}");
+    let mut with_rate = window();
+    with_rate["window"]["refresh_rate_mhz"] = json!(60_000);
+    assert!(window_room(&with_rate).is_ok());
+    for key in WINDOW_KEYS {
+        let mut report = window();
+        report["window"].as_object_mut().unwrap().remove(key);
+        let err = window_room(&report).unwrap_err();
+        assert!(err.contains(&format!("has no {key}")), "{err}");
+    }
+    let mut top = window();
+    top["window"]["view"] = json!("top-down");
+    assert!(window_room(&top).unwrap_err().contains("not first-person"));
+    let mut odd = window();
+    odd["window"]["grab"] = json!("held");
+    assert!(window_room(&odd).unwrap_err().contains("window.grab is"));
+    assert!(window_room(&json!({"exit": "ok"})).is_err());
+}
+
+fn room_shot() -> Value {
+    json!({
+        "exit": "ok",
+        "budgets": {"first_person": {
+            "max_draws_per_frame": 28, "max_pipeline_switches_per_frame": 28,
+            "max_bind_group_switches_per_frame": 60, "max_upload_bytes_per_frame": 2944,
+        }},
+        "gpu": {
+            "capabilities": {"timestamp_queries": true},
+            "per_frame": {"draws": 7, "pipeline_switches": 7, "bind_group_switches": 15,
+                          "upload_bytes": 736},
+            "pass_times": [{"pass": "opaque", "nanoseconds": 62125},
+                           {"pass": "sprites", "nanoseconds": null}],
+            "transient_textures": 5,
+        },
+    })
+}
+
+#[test]
+fn the_room_shot_is_held_to_the_first_person_table_with_its_new_keys() {
+    let window = json!({"gpu": {"frames": 9, "per_frame": {"draws": 8, "pipeline_switches": 7,
+        "bind_group_switches": 16, "upload_bytes": 736}}});
+    let Ok(Done::Pass(ok)) = first_person_budgets(&room_shot(), Some(&window)) else {
+        panic!("the shot and the window's frames held");
+    };
+    assert!(
+        ok.contains("opaque 62125, sprites null; 5 pooled textures"),
+        "{ok}"
+    );
+    assert!(ok.contains("the room window's frames too"), "{ok}");
+    // T21's review: without the window's frames, never a pass.
+    for (report, why) in [
+        (None, "no report from the window-room step"),
+        (Some(json!({"gpu": {"frames": 0}})), "presented no frame"),
+    ] {
+        let Ok(Done::Pending(text)) = first_person_budgets(&room_shot(), report.as_ref()) else {
+            panic!("pending: {why}");
+        };
+        assert!(text.contains(why), "{text}");
+    }
+    let mut no_table = room_shot();
+    no_table["budgets"]["first_person"] = Value::Null;
+    let err = first_person_budgets(&no_table, None).unwrap_err();
+    assert!(err.contains("has no [gpu.first_person]"), "{err}");
+    let mut over = room_shot();
+    over["gpu"]["per_frame"]["bind_group_switches"] = json!(61);
+    let err = first_person_budgets(&over, None).unwrap_err();
+    assert!(err.contains("bind_group_switches 61 > 60"), "{err}");
+    let mut busy = window.clone();
+    busy["gpu"]["per_frame"]["draws"] = json!(29);
+    let err = first_person_budgets(&room_shot(), Some(&busy)).unwrap_err();
+    assert!(err.contains("the room window's frame exceeds"), "{err}");
+    let mut untimed = room_shot();
+    untimed["gpu"]["pass_times"] = Value::Null;
+    let err = first_person_budgets(&untimed, None).unwrap_err();
+    assert!(
+        err.contains("gpu.pass_times is null, with timestamp queries true"),
+        "{err}"
+    );
+    untimed["gpu"]["capabilities"]["timestamp_queries"] = json!(false);
+    assert!(first_person_budgets(&untimed, None).is_ok());
+    let mut no_pool = room_shot();
+    no_pool["gpu"]
+        .as_object_mut()
+        .unwrap()
+        .remove("transient_textures");
+    assert!(
+        first_person_budgets(&no_pool, None)
+            .unwrap_err()
+            .contains("transient_textures")
+    );
+    let mut bad = room_shot();
+    bad["gpu"]["pass_times"] = json!([{"pass": "opaque", "nanoseconds": -1}]);
+    assert!(
+        first_person_budgets(&bad, None)
+            .unwrap_err()
+            .contains("a pass time is")
+    );
+    let mut stopped = room_shot();
+    stopped["exit"] = json!("budget-exceeded");
+    assert!(first_person_budgets(&stopped, None).is_err());
+}
+
+fn frames_json(mode: &str, pinned: bool, statuses: &[&str]) -> String {
+    let shots: Vec<Value> = statuses
+        .iter()
+        .enumerate()
+        .map(|(i, s)| json!({"name": format!("shot-{i}"), "status": s}))
+        .collect();
+    json!({"configuration": {"adapter": "llvmpipe", "driver_info": "Mesa", "pinned": pinned},
+           "mode": mode, "shots": shots})
+    .to_string()
+}
+
+#[test]
+fn frame_records_pass_only_when_every_record_has_its_reference() {
+    let all = frames_json("exact", true, &["pass", "pass"]);
+    assert!(matches!(frames(&all, true), Ok(Done::Pass(_))));
+    let waiting = frames_json("exact", true, &["pass", "no-reference", "pending"]);
+    let Ok(Done::Pending(why)) = frames(&waiting, true) else {
+        panic!("pending until G6");
+    };
+    assert!(why.contains("shot-1 no-reference, shot-2 pending"), "{why}");
+    let failed = frames_json("tolerances", false, &["fail"]);
+    assert!(frames(&failed, false).is_err());
+    let elsewhere = frames_json("tolerances", false, &["pass"]);
+    assert!(frames(&elsewhere, true).unwrap_err().contains("not exact"));
+    let unpinned = frames_json("exact", false, &["pass"]);
+    assert!(
+        frames(&unpinned, true)
+            .unwrap_err()
+            .contains("pinned configuration")
+    );
+    assert!(frames(&frames_json("exact", true, &[]), true).is_err());
+}
+
+#[test]
+fn scene_rules_must_come_from_the_committed_scenes() {
+    let ok = json!({"configuration": {"adapter": "Apple M2 Pro"},
+        "rules_dir": "/x/crates/game-testbed/scenes", "shots": [{}, {}], "failures": []});
+    assert!(
+        scene_rules(&ok.to_string())
+            .unwrap()
+            .contains("2 shots judged")
+    );
+    let mut elsewhere = ok.clone();
+    elsewhere["rules_dir"] = json!("/tmp/weaker");
+    assert!(
+        scene_rules(&elsewhere.to_string())
+            .unwrap_err()
+            .contains("not the committed")
+    );
+    let mut failed = ok.clone();
+    failed["failures"] = json!(["[E-SCENE-RULE] room-spawn: rule 1"]);
+    assert!(scene_rules(&failed.to_string()).is_err());
+    // T21's review: no failures list is no verdict, not none failed.
+    let mut unlisted = ok.clone();
+    unlisted.as_object_mut().unwrap().remove("failures");
+    let err = scene_rules(&unlisted.to_string()).unwrap_err();
+    assert!(err.contains("has no failures list"), "{err}");
+    let mut none = ok;
+    none["shots"] = json!([]);
+    assert!(scene_rules(&none.to_string()).is_err());
+}
+
+const MANIFEST: &str = "[[shot]]\nname = \"a\"\n[pose]\nledge = \"9,3.5,1.6,-90,-15\"\n\
+                        overview = \"0.5,8.5,1.6,-30,15\"\n";
+
+fn shots_json(views: Value, statuses: &[&str]) -> String {
+    let shots: Vec<Value> = statuses
+        .iter()
+        .map(|s| json!({"name": "x", "status": s, "message": "x: failed"}))
+        .collect();
+    json!({"views": views, "shots": shots}).to_string()
+}
+
+#[test]
+fn every_named_pose_is_drawn_from_its_own_camera() {
+    let view = |pose: Value, from: &str| json!({"name": "s", "pose": pose, "camera_from": from});
+    let both = json!([
+        view(json!("ledge"), "pose"),
+        view(json!("overview"), "pose"),
+        view(Value::Null, "game"),
+    ]);
+    let ok = poses(&shots_json(both.clone(), &["pass", "no-golden"]), MANIFEST).unwrap();
+    assert!(ok.contains("ledge, overview"), "{ok}");
+    let one = json!([view(json!("ledge"), "pose")]);
+    assert!(
+        poses(&shots_json(one, &[]), MANIFEST)
+            .unwrap_err()
+            .contains("names [\"ledge\", \"overview\"]")
+    );
+    let game = json!([
+        view(json!("ledge"), "game"),
+        view(json!("overview"), "pose")
+    ]);
+    assert!(
+        poses(&shots_json(game, &[]), MANIFEST)
+            .unwrap_err()
+            .contains("camera came from")
+    );
+    assert!(
+        poses(&shots_json(both, &["fail"]), MANIFEST)
+            .unwrap_err()
+            .contains("x: failed")
+    );
+    assert!(poses(&shots_json(json!([]), &[]), "[[shot]]\nname = \"a\"\n").is_err());
+}
