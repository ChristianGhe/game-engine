@@ -0,0 +1,120 @@
+//! The native `dist` step's readers of the unpacked binary: ELF section
+//! names, PE's COFF symbol count and Mach-O's debug map and local symbols,
+//! on made-up files and on this test binary (moved from `dist_tests.rs`,
+//! which grew past 500 lines, at G5).
+
+use std::fs;
+
+use crate::dist_check::{elf_sections, elf_unstripped, macho_symbols, pe_symbols};
+
+/// A minimal ELF64 file: the null section, `names` and the section-name
+/// table last.
+fn elf(names: &[&str]) -> Vec<u8> {
+    let mut table = vec![0u8];
+    let mut offsets = vec![0u32];
+    for name in names.iter().chain([&".shstrtab"]) {
+        offsets.push(table.len() as u32);
+        table.extend(name.as_bytes());
+        table.push(0);
+    }
+    let count = offsets.len();
+    let shoff = 64 + table.len();
+    let mut bytes = vec![0u8; shoff + 64 * count];
+    bytes[..6].copy_from_slice(b"\x7fELF\x02\x01");
+    bytes[0x28..0x30].copy_from_slice(&(shoff as u64).to_le_bytes());
+    bytes[0x3a..0x3c].copy_from_slice(&64u16.to_le_bytes());
+    bytes[0x3c..0x3e].copy_from_slice(&(count as u16).to_le_bytes());
+    bytes[0x3e..0x40].copy_from_slice(&((count - 1) as u16).to_le_bytes());
+    bytes[64..shoff].copy_from_slice(&table);
+    for (i, name) in offsets.iter().enumerate() {
+        let at = shoff + 64 * i;
+        bytes[at..at + 4].copy_from_slice(&name.to_le_bytes());
+    }
+    let last = shoff + 64 * (count - 1);
+    bytes[last + 0x18..last + 0x20].copy_from_slice(&64u64.to_le_bytes());
+    bytes[last + 0x20..last + 0x28].copy_from_slice(&(table.len() as u64).to_le_bytes());
+    bytes
+}
+
+#[test]
+fn elf_section_names_are_read() {
+    let names = elf_sections(&elf(&[".text", ".gnu_debuglink"])).unwrap();
+    assert_eq!(names, ["", ".text", ".gnu_debuglink", ".shstrtab"]);
+    assert!(elf_sections(b"MZ not elf").is_err());
+    assert!(elf_sections(&elf(&[".text"])[..80]).is_err(), "cut short");
+}
+
+#[test]
+fn a_stripped_elf_binary_keeps_no_symbols_or_debug_info() {
+    let names = |list: &[&str]| list.iter().map(|s| (*s).to_string()).collect::<Vec<_>>();
+    // What objcopy --strip-all leaves of a Rust binary (aarch64 Linux).
+    let stripped = names(&[".text", ".debug_gdb_scripts", ".gnu_debuglink", ".shstrtab"]);
+    assert!(elf_unstripped(&stripped).is_empty());
+    let full = names(&[".text", ".symtab", ".strtab", ".debug_info", ".zdebug_line"]);
+    assert_eq!(
+        elf_unstripped(&full),
+        [".symtab", ".debug_info", ".zdebug_line"]
+    );
+}
+
+/// A PE file's COFF symbol count, the 4 bytes 16 past the `PE\0\0` that
+/// offset 0x3c points at.
+#[test]
+fn pe_coff_symbols_are_counted() {
+    let pe = |symbols: u32| {
+        let mut bytes = vec![0u8; 0x80];
+        bytes[..2].copy_from_slice(b"MZ");
+        bytes[0x3c..0x40].copy_from_slice(&0x40u32.to_le_bytes());
+        bytes[0x40..0x44].copy_from_slice(b"PE\0\0");
+        bytes[0x50..0x54].copy_from_slice(&symbols.to_le_bytes());
+        bytes
+    };
+    assert_eq!(pe_symbols(&pe(0)).unwrap(), 0);
+    assert_eq!(pe_symbols(&pe(7)).unwrap(), 7);
+    let mut not_pe = pe(0);
+    not_pe[0x40] = b'X';
+    assert!(pe_symbols(&not_pe).is_err());
+    assert!(pe_symbols(b"MZ").is_err(), "cut short");
+}
+
+/// A minimal Mach-O file with one `LC_SYMTAB` over `kinds` (`n_type`s).
+fn macho(kinds: &[u8]) -> Vec<u8> {
+    let symbols = 32 + 24;
+    let mut bytes = vec![0u8; symbols + 16 * kinds.len()];
+    bytes[..4].copy_from_slice(&0xfeed_facfu32.to_le_bytes());
+    bytes[16..20].copy_from_slice(&1u32.to_le_bytes());
+    bytes[32..36].copy_from_slice(&2u32.to_le_bytes());
+    bytes[36..40].copy_from_slice(&24u32.to_le_bytes());
+    bytes[40..44].copy_from_slice(&(symbols as u32).to_le_bytes());
+    bytes[44..48].copy_from_slice(&(kinds.len() as u32).to_le_bytes());
+    for (i, kind) in kinds.iter().enumerate() {
+        bytes[symbols + 16 * i + 4] = *kind;
+    }
+    bytes
+}
+
+#[test]
+fn macho_debug_maps_and_local_symbols_are_counted() {
+    // N_OSO and N_FUN stabs; a local N_SECT; an external N_SECT; undefined.
+    assert_eq!(
+        macho_symbols(&macho(&[0x66, 0x24, 0x0e, 0x0f, 0x01])).unwrap(),
+        (2, 1)
+    );
+    assert_eq!(macho_symbols(&macho(&[0x0f, 0x01])).unwrap(), (0, 0));
+    assert!(macho_symbols(b"\x7fELF").is_err());
+}
+
+/// The readers on this test binary, which is neither stripped nor split:
+/// an ELF one keeps `.symtab` and DWARF, a Mach-O one its debug map.
+#[test]
+fn this_unstripped_test_binary_reads_as_unstripped() {
+    let bytes = fs::read(std::env::current_exe().unwrap()).unwrap();
+    if bytes.starts_with(b"\x7fELF") {
+        let names = elf_sections(&bytes).unwrap();
+        assert!(names.iter().any(|n| n == ".symtab"), "{names:?}");
+        assert!(names.iter().any(|n| n == ".text"), "{names:?}");
+    } else if bytes.starts_with(&0xfeed_facfu32.to_le_bytes()) {
+        let (stabs, locals) = macho_symbols(&bytes).unwrap();
+        assert!(stabs > 0 && locals > 0, "{stabs} stabs, {locals} locals");
+    }
+}
