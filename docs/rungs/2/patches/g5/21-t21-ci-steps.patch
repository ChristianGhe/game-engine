diff --git a/xtask/src/ci_native_fps.rs b/xtask/src/ci_native_fps.rs
new file mode 100644
index 0000000000000000000000000000000000000000..63eab9fb8fb0be7467dc56d106baccc2487696cf
--- /dev/null
+++ b/xtask/src/ci_native_fps.rs
@@ -0,0 +1,202 @@
+//! Rung 2's native steps (T21, gate G5): the room in a real window, the
+//! look checks, the frame records, the scene rules and the poses, with
+//! `gpu-budgets`' and `proof-video`'s room halves. Each names the
+//! acceptance check it serves; the verdicts are `ci_verdicts_fps.rs`'s.
+
+use std::path::Path;
+
+use super::{arg, offscreen_adapter, pass, probe, read_json, read_text, testbed};
+use crate::util::{self, Done};
+use crate::{ci, ci_verdicts as verdicts, ci_verdicts_fps as fps, replay};
+
+/// The room's scripted walk and its committed stream (criterion 1).
+const ROOM_SCRIPT: &str = "crates/game-testbed/scenarios/room-walk.input.toml";
+const ROOM_STREAM: &str = "crates/game-testbed/hashes/room-walk.seed1.txt";
+
+/// A `cargo test` of `targets`, each `(package, test target)`, with a GPU
+/// required, on the pinned lavapipe on Linux x64 (as the shots are), and
+/// `ENG_SHOT_MODE=exact` there when `exact`, or unset.
+fn gpu_tests(
+    root: &Path,
+    log: &str,
+    targets: &[(&str, &str)],
+    exact: bool,
+) -> Result<String, String> {
+    let mut args = vec!["test"];
+    for &(package, target) in targets {
+        args.extend(["-p", package, "--test", target]);
+    }
+    let mut cmd = ci::cargo_command(root, &args);
+    cmd.env("ENG_REQUIRE_GPU", "1")
+        .env("MESA_SHADER_CACHE_DISABLE", "true")
+        .env_remove("ENG_SHOT_MODE");
+    if let Some(adapter) = offscreen_adapter(&replay::host_triple(root)?) {
+        cmd.env("ENG_GPU_ADAPTER", adapter);
+        if exact {
+            cmd.env("ENG_SHOT_MODE", "exact");
+        }
+    }
+    util::run_quiet(root, log, &mut cmd)
+}
+
+/// Criterion 1 (`room-window`) and 10 (`cursor-fullscreen`): `play --map
+/// room --windowed` with the room's walk presents first-person frames in
+/// a real window, gives the committed stream, and reports the grab,
+/// fullscreen and refresh rate.
+pub(super) fn window_room(root: &Path) -> Result<Done, String> {
+    let binary = testbed(root)?;
+    let (hashes, report) = (
+        arg(root, "target/ci/window-room.txt"),
+        arg(root, "target/ci/window-room.json"),
+    );
+    let script = arg(root, ROOM_SCRIPT);
+    let args = [
+        "play",
+        "--map",
+        "room",
+        "--windowed",
+        "--ticks",
+        "600",
+        "--seed",
+        "1",
+        "--input",
+        &script,
+        "--hashes",
+        &hashes,
+        "--report",
+        &report,
+    ];
+    util::run_quiet(root, "native-window-room", &mut probe(root, &binary, &args))?;
+    let stream = read_text(&root.join("target/ci/window-room.txt"))?;
+    let committed = read_text(&root.join(ROOM_STREAM))?;
+    let report = read_json(&root.join("target/ci/window-room.json"))?;
+    let presented = verdicts::window(&stream, &committed, &report)?;
+    let window = fps::window_room(&report)?;
+    pass(Ok(format!("{presented}; {window}")))
+}
+
+/// Criteria 7 (`look-stack`) and 8 (`sprites`): decision 13's exact look
+/// checks, each look pass off alone, and the sprites drawn with depth, in
+/// eng-render's tests and through the binary (`tests/look.rs`).
+pub(super) fn look(root: &Path) -> Result<Done, String> {
+    let targets = [
+        ("eng-render", "look_checks"),
+        ("eng-render", "look_fog_tone"),
+        ("eng-render", "sprites"),
+        ("eng-render", "sprites_look"),
+        ("game-testbed", "look"),
+    ];
+    gpu_tests(root, "native-look", &targets, false)?;
+    let names: Vec<&str> = targets.iter().map(|t| t.1).collect();
+    pass(Ok(format!("{} passed with a GPU", names.join(", "))))
+}
+
+/// Plan addition A1 (`frame-record`): every shot's frame record, exact on
+/// the pinned lavapipe (Linux x64) and within tolerances elsewhere, and
+/// the planted bugs each change it. Pending until the owner commits the
+/// reference records (G6); CI's records are the candidates.
+pub(super) fn frame_record(root: &Path) -> Result<Done, String> {
+    let summary = root.join("target/frame-candidates/frames.json");
+    let _ = std::fs::remove_file(&summary);
+    let targets = [
+        ("game-testbed", "frame_record"),
+        ("game-testbed", "frame_bugs"),
+    ];
+    let exact = offscreen_adapter(&replay::host_triple(root)?).is_some();
+    gpu_tests(root, "native-frame-record", &targets, exact)?;
+    let text = read_text(&summary)
+        .map_err(|e| format!("[E-GOLDEN] the frame-record harness wrote no frames.json: {e}"))?;
+    fps::frames(&text, exact)
+}
+
+/// Plan addition A2 (`scene-rules`): the committed `*.rules.toml` hold on
+/// every first-person shot. `ENG_RULES_DIR` is never set here.
+pub(super) fn scene_rules(root: &Path) -> Result<Done, String> {
+    let summary = root.join("target/scene-rules/rules.json");
+    let _ = std::fs::remove_file(&summary);
+    let args = ["test", "-p", "game-testbed", "--test", "scene_rules"];
+    let mut cmd = ci::cargo_command(root, &args);
+    cmd.env("ENG_REQUIRE_GPU", "1")
+        .env("MESA_SHADER_CACHE_DISABLE", "true")
+        .env_remove("ENG_RULES_DIR");
+    if let Some(adapter) = offscreen_adapter(&replay::host_triple(root)?) {
+        cmd.env("ENG_GPU_ADAPTER", adapter);
+    }
+    util::run_quiet(root, "native-scene-rules", &mut cmd)?;
+    let text = read_text(&summary)
+        .map_err(|e| format!("[E-SCENE-RULE] the scene-rules test wrote no rules.json: {e}"))?;
+    pass(fps::scene_rules(&text))
+}
+
+/// Plan addition A3 (`fps-poses`): the shot harness's `shots.json`, which
+/// `shot-exact` or `shot-flip` wrote just before, drew every pose
+/// `shots.toml` names from its own camera, and no shot failed.
+pub(super) fn poses(root: &Path) -> Result<Done, String> {
+    let summary = read_text(&root.join("target/golden-candidates/shots.json")).map_err(|e| {
+        format!("[E-POSE] no shots.json from this job's shot-exact or shot-flip step: {e}")
+    })?;
+    let manifest = read_text(&root.join("crates/game-testbed/shots.toml"))?;
+    pass(fps::poses(&summary, &manifest))
+}
+
+/// The `gpu-budgets` step's first-person half (criterion 21): a room shot
+/// held by the probe to `budgets.toml [gpu.first_person]` (exit 13 over),
+/// with its pass times and pool size, and the room window's frames; with
+/// `dots`, the top-down half's verdict. Pending without the room window's
+/// frames.
+pub(super) fn with_room_budgets(root: &Path, binary: &Path, dots: &str) -> Result<Done, String> {
+    Ok(match room_budgets(root, binary)? {
+        Done::Pass(room) => Done::Pass(format!("{dots}; {room}")),
+        Done::Pending(room) => Done::Pending(format!("{room}; {dots}")),
+    })
+}
+
+/// The room shot, and its verdict with `window-room`'s report.
+fn room_budgets(root: &Path, binary: &Path) -> Result<Done, String> {
+    let (png, report) = (
+        arg(root, "target/ci/room-shot.png"),
+        arg(root, "target/ci/room-shot.json"),
+    );
+    let budgets = arg(root, "budgets.toml");
+    let args = [
+        "shot",
+        "--map",
+        "room",
+        "--at-tick",
+        "60",
+        "--budgets",
+        &budgets,
+        "--report",
+        &report,
+        "--out",
+        &png,
+    ];
+    let mut cmd = super::offscreen(root, binary, &args)?;
+    util::run_quiet(root, "native-gpu-budgets-room", &mut cmd)?;
+    let shot = read_json(&root.join("target/ci/room-shot.json"))?;
+    let window = read_json(&root.join("target/ci/window-room.json")).ok();
+    fps::first_person_budgets(&shot, window.as_ref())
+}
+
+/// The `proof-video` step's room half (criterion 22): `room.apng`, the
+/// 600-tick room walk, 601 frames.
+pub(super) fn room_video(root: &Path, binary: &Path) -> Result<String, String> {
+    let (apng, report) = (
+        arg(root, "target/ci/room.apng"),
+        arg(root, "target/ci/room.json"),
+    );
+    let script = arg(root, ROOM_SCRIPT);
+    let args = [
+        "video", "--map", "room", "--ticks", "600", "--seed", "1", "--input", &script, "--out",
+        &apng, "--report", &report,
+    ];
+    let mut cmd = super::offscreen(root, binary, &args)?;
+    util::run_quiet(root, "native-proof-video-room", &mut cmd)?;
+    let bytes =
+        std::fs::read(root.join("target/ci/room.apng")).map_err(|e| format!("{apng}: {e}"))?;
+    let report = read_json(&root.join("target/ci/room.json"))?;
+    let named = |text: String| text.replacen("proof.apng", "room.apng", 1);
+    verdicts::video(&bytes, &report, 601)
+        .map(named)
+        .map_err(named)
+}
