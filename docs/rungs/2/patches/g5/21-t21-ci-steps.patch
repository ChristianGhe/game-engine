+/// The `bench-duration` and `mutants-duration` steps (rung 2): each run of
+/// `job` on GitHub (every shard of a matrix), the slowest held to
+/// `budgets.toml [ci] <key>`.
+pub fn job_tier(root: &Path, job: &str, key: &str) -> Result<Done, String> {
+    let (repo, run) = github_run(&format!("the {job} job's duration"))?;
+    let budget =
+        ci_budget(root, key).ok_or_else(|| format!("[E-BUDGET] budgets.toml has no [ci] {key}"))?;
+    let jobs = run_jobs(root, &repo, &run)?;
+    job_duration(&jobs, job, budget, key)
