+//! The `test` job's named harness steps (`ci.rs`): each criterion's test
+//! files, run on their own so the job's report has a step per criterion.
+
+use std::path::Path;
+
+use super::cargo_step;
+
+/// The `test` job's named harness steps, in order: the step's name, then
+/// the test files it runs, each as a package and a test target
+/// (`crates/<package>/tests/<target>.rs`); one `cargo test` runs a target
+/// in each package of the step that has one, so the step lists each of
+/// those. `tests` runs them as well; a
+/// step of their own gives each its own entry in the job's report, where
+/// acceptance checks find steps by name, and its own log. They build on the
+/// dev profile: `crash_json` looks for the `eng_cli::run::run` frame, which
+/// a release build without debug info can inline away. Like every cargo
+/// command here, they get the stamp's four values from `util::cargo`
+/// (`stamp.rs`), so `version` checks a stamp with all of them set.
+pub(super) const HARNESSES: [(&str, &[(&str, &str)]); 13] = [
+    ("known-answers", &[("eng-math", "known_answers")]),
+    ("exit-codes", &[("game-testbed", "exit_codes")]),
+    ("crash-json", &[("game-testbed", "crash_json")]),
+    ("version", &[("game-testbed", "version")]),
+    ("live-input", &[("eng-input", "live_input")]),
+    // Criterion 11: the wire format's golden vectors, decoders that never
+    // panic, and a session that hashes the same as stepping the sim.
+    (
+        "wire-session",
+        &[
+            ("eng-net-wire", "golden"),
+            ("eng-net-wire", "never_panic"),
+            ("eng-session", "hash_equality"),
+        ],
+    ),
+    // Criterion 10: every WGSL file validates and translates for each
+    // backend.
+    ("shaders", &[("eng-gpu", "shaders")]),
+    // Rung 2, criterion 3 (`collision-grid`): the collision contract and
+    // conformance suite, the brute-force oracle's traces on proptest maps,
+    // the pass-through cases, limits and found traces; the check's own
+    // bad worlds.
+    (
+        "collision",
+        &[
+            ("eng-collision-grid", "contract"),
+            ("eng-collision-grid", "oracle"),
+            ("eng-collision-grid", "corners"),
+            ("eng-collision-grid", "vertices"),
+            ("eng-collision-grid", "limits"),
+            ("eng-collision-grid", "found"),
+            ("eng-collision-api", "room"),
+        ],
+    ),
+    // Criterion 4 (`ground-movement`): Q2's steps, snapping, gravity and
+    // slopes, and the flat-ground proptest over the grid (`ground`).
+    (
+        "movement",
+        &[
+            ("kit-fps", "ground"),
+            ("kit-fps", "slopes"),
+            ("kit-fps", "boxes"),
+            ("kit-fps", "steps"),
+        ],
+    ),
+    // Criterion 5 (`sim-data`): constant resources outside the state, the
+    // sim-data hash's known answer and the room's snapshot size, the room's
+    // pinned values, and the hash in reports, recordings and streams.
+    (
+        "sim-data",
+        &[
+            ("eng-ecs", "constants"),
+            ("eng-sim", "sim_data"),
+            ("game-testbed-sim", "sim_data"),
+            ("game-testbed-sim", "room"),
+            ("game-testbed", "maps"),
+            ("game-testbed", "room"),
+        ],
+    ),
+    // Criterion 6 (`render-graph`): Q1's oracles that need no GPU; the
+    // native job's `tests` runs `bypass_render` and `transients`.
+    (
+        "render-graph",
+        &[
+            ("eng-gpu", "graph_order"),
+            ("eng-gpu", "graph_errors"),
+            ("eng-gpu", "pool"),
+            ("eng-gpu", "bypass"),
+        ],
+    ),
+    // Criterion 8 (`sprites`): Q4's rotations against the f64 oracle; the
+    // native job's `look` draws them.
+    ("sprites", &[("eng-render", "sprite_rotation")]),
+    // Criterion 9 (`mouse-look`): Q3's oracle and model, and T15's angles
+    // between ticks.
+    (
+        "mouse-look",
+        &[
+            ("eng-input", "mouse_look"),
+            ("eng-input", "mouse_look_exact"),
+            ("eng-input", "mouse_look_model"),
+            ("eng-input", "look_between_ticks"),
+        ],
+    ),
+];
+
+/// One step from `HARNESSES`, logged under the step's name: a single
+/// `cargo test` that names each of its packages and test targets.
+pub(super) fn harness(root: &Path, step: &str, files: &[(&str, &str)]) -> Result<String, String> {
+    let mut args = vec!["test"];
+    for &(package, target) in files {
+        args.extend(["-p", package, "--test", target]);
+    }
+    cargo_step(root, step, &args)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::path::Path;
+
+    use super::HARNESSES;
+
+    /// Whether `package` has a test target named `target`: a file
+    /// `tests/<target>.rs` or `tests/<target>/main.rs`, or a `[[test]]` of
+    /// that name in its manifest.
+    fn has_test_target(root: &Path, package: &str, target: &str) -> bool {
+        let dir = root.join("crates").join(package);
+        let tests = dir.join("tests");
+        if tests.join(format!("{target}.rs")).is_file()
+            || tests.join(target).join("main.rs").is_file()
+        {
+            return true;
+        }
+        let manifest: toml::Table = std::fs::read_to_string(dir.join("Cargo.toml"))
+            .ok()
+            .and_then(|text| text.parse().ok())
+            .unwrap_or_default();
+        manifest
+            .get("test")
+            .and_then(toml::Value::as_array)
+            .is_some_and(|list| {
+                list.iter()
+                    .any(|t| t.get("name").and_then(toml::Value::as_str) == Some(target))
+            })
+    }
+
+    /// Every named step runs test files that exist, under a name of its
+    /// own, so renaming a harness fails here and not only on CI. A step's
+    /// one `cargo test` runs a target in each package it names that has
+    /// one, so the step lists the target for each of those packages.
+    #[test]
+    fn every_harness_step_names_existing_test_files() {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR"))
+            .parent()
+            .expect("xtask sits in the repo root");
+        for (step, files) in HARNESSES {
+            assert!(!files.is_empty(), "step {step} runs nothing");
+            for &(package, target) in files {
+                let path = root
+                    .join("crates")
+                    .join(package)
+                    .join("tests")
+                    .join(format!("{target}.rs"));
+                assert!(path.is_file(), "step {step}: no {}", path.display());
+                for &(other, _) in files.iter().filter(|f| f.0 != package) {
+                    assert!(
+                        !has_test_target(root, other, target) || files.contains(&(other, target)),
+                        "step {step} also runs {other}'s test target {target}"
+                    );
+                }
+            }
+        }
+        // With the job's other two steps.
+        let mut names: Vec<&str> = HARNESSES.iter().map(|h| h.0).collect();
+        names.extend(["tests", "replay"]);
+        names.sort_unstable();
+        let repeated: Vec<&str> = names
+            .windows(2)
+            .filter(|w| w[0] == w[1])
+            .map(|w| w[0])
+            .collect();
+        assert!(repeated.is_empty(), "step names repeat: {repeated:?}");
+    }
+
+    /// Every `test` and `selftest` check of the current rung's acceptance
+    /// list names a step those jobs run, as `ci_native_tests.rs` holds the
+    /// native checks (rung 2, T21: the six new test steps and the
+    /// selftest's cases).
+    #[test]
+    fn every_test_and_selftest_check_names_a_step() {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR"))
+            .parent()
+            .expect("xtask sits in the repo root");
+        let rung = std::fs::read_to_string(root.join("docs/rungs/current.txt")).unwrap();
+        let path = root
+            .join("docs/rungs")
+            .join(rung.trim())
+            .join("acceptance.json");
+        let text = std::fs::read_to_string(path).unwrap();
+        let doc: serde_json::Value = serde_json::from_str(&text).unwrap();
+        let mut steps: Vec<&str> = HARNESSES.iter().map(|h| h.0).collect();
+        steps.extend(["tests", "replay"]);
+        let checks = doc["features"].as_array().unwrap().iter();
+        let checks = checks.flat_map(|f| f["checks"].as_array().into_iter().flatten());
+        for check in checks {
+            let step = check["step"].as_str().unwrap();
+            match check["job"].as_str().unwrap() {
+                "test" => assert!(steps.contains(&step), "the test job has no step {step}"),
+                "selftest" => {
+                    let case = step.strip_prefix("violation:").unwrap_or_default();
+                    assert!(
+                        crate::selftest::CASES.contains(&case),
+                        "the selftest job has no step {step}"
+                    );
+                }
+                _ => {}
+            }
+        }
+    }
+}
