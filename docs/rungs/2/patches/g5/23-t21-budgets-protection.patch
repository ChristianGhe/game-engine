diff --git a/budgets.toml b/budgets.toml
index 892b23e7666a2de20b72ff4c7632d6d564f57aab..db48a0313d58ff1a9f99f07f70559be20e18d601 100644
--- a/budgets.toml
+++ b/budgets.toml
@@ -19,8 +19,30 @@ max_pipeline_switches_per_frame = 12
 max_bind_group_switches_per_frame = 8
 max_upload_bytes_per_frame = 2048
 
+# First-person frames (rung 2, criterion 21), which hold these in place of
+# [gpu]'s. About four times the room's shot, as [gpu] is for the top-down
+# view: one chunk and three things through the look's graph, 7 draws, 7
+# pipeline switches, 15 bind-group switches and 736 bytes offscreen (T11,
+# T12); `play`'s presented frame adds the present pass, 8/7/16. Each sprite
+# adds 1 draw, 1 pipeline switch, 2 bind-group switches and 32 bytes; each
+# chunk 16 bytes.
+[gpu.first_person]
+max_draws_per_frame = 28
+max_pipeline_switches_per_frame = 28
+max_bind_group_switches_per_frame = 60
+max_upload_bytes_per_frame = 2944
+
 # Read by cargo xtask. `native_job_minutes` is measured against the slowest
-# native job (rung 1b criterion 13); going over is reported, not failed.
+# native job (rung 1b criterion 13), `bench_job_minutes` and
+# `mutants_job_minutes` against the bench job and the slowest mutants shard
+# (rung 2, the summary's bench-duration and mutants-duration); going over
+# is reported, not failed. `bench_job_minutes` and `mutants_job_minutes`
+# are placeholders, measured on no CI run yet: T24 sets them from the first
+# runs after G5. `mutants_shard_minutes` is each mutants shard's time box: a
+# shard that reaches it stops and fails (rung 2, decision 15).
 [ci]
 pr_tier_minutes = 15
 native_job_minutes = 25
+bench_job_minutes = 15
+mutants_job_minutes = 35
+mutants_shard_minutes = 20
