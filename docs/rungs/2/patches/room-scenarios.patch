diff --git a/crates/game-testbed/scenarios/room-corner.assert.toml b/crates/game-testbed/scenarios/room-corner.assert.toml
new file mode 100644
index 0000000000000000000000000000000000000000..ea4445410d8cc8d3f7456e7ee2f795c441866e96
--- /dev/null
+++ b/crates/game-testbed/scenarios/room-corner.assert.toml
@@ -0,0 +1,76 @@
+# PROTECTED ORACLE: semantic assertions for room-corner. Only the owner
+# approves changes (AGENTS.md, "Protected paths"). The alcove is x 12-14,
+# y 1-3 (game-testbed-sim's src/room/layout.rs): the hull, 0.25 m in half
+# width with its centre 0.875 m above the floor, stops exactly on its back
+# and south walls, at x = 13.75 and y = 1.25, as dot-corner's does.
+version = 1
+
+[[assert]]
+id = "reaches-the-back-wall"
+by_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/x"
+op = "=="
+value = 13.75
+
+[[assert]]
+id = "reaches-the-south-wall"
+by_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/y"
+op = "=="
+value = 1.25
+
+[[assert]]
+id = "wall-bump-reported"
+by_tick = 300
+pointer = "/events/testbed.WallBump/0/entity/index"
+op = "=="
+value = 0
+
+[[assert]]
+id = "on-the-floor-over-the-seam"
+always = true
+pointer = "/entities/0/components/kit_fps.MoveState/pos/z"
+op = "=="
+value = 0.875
+
+[[assert]]
+id = "never-past-the-back-wall"
+always = true
+pointer = "/entities/0/components/kit_fps.MoveState/pos/x"
+op = "<="
+value = 13.75
+
+[[assert]]
+id = "never-past-the-south-wall"
+always = true
+pointer = "/entities/0/components/kit_fps.MoveState/pos/y"
+op = ">="
+value = 1.25
+
+[[assert]]
+id = "in-the-corner-x"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/x"
+op = "=="
+value = 13.75
+
+[[assert]]
+id = "in-the-corner-y"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/y"
+op = "=="
+value = 1.25
+
+[[assert]]
+id = "stopped-in-the-corner-x"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/vel/x"
+op = "=="
+value = 0.0
+
+[[assert]]
+id = "stopped-in-the-corner-y"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/vel/y"
+op = "=="
+value = 0.0
diff --git a/crates/game-testbed/scenarios/room-ledge.assert.toml b/crates/game-testbed/scenarios/room-ledge.assert.toml
new file mode 100644
index 0000000000000000000000000000000000000000..25647859664b2657092883b710b3f1bc69bfd890
--- /dev/null
+++ b/crates/game-testbed/scenarios/room-ledge.assert.toml
@@ -0,0 +1,62 @@
+# PROTECTED ORACLE: semantic assertions for room-ledge. Only the owner
+# approves changes (AGENTS.md, "Protected paths"). The ledge is x 7-11,
+# y 0-1, 0.6 m tall (game-testbed-sim's src/room/layout.rs): more than a
+# step, so the hull, 0.25 m in half width with its centre 0.875 m above the
+# floor, stops on its north face at y = 1.25 and stays on the floor.
+version = 1
+
+[[assert]]
+id = "blocked-by-the-ledge"
+by_tick = 150
+pointer = "/entities/0/components/kit_fps.MoveState/pos/y"
+op = "=="
+value = 1.25
+
+[[assert]]
+id = "ledge-bump-reported"
+by_tick = 150
+pointer = "/events/testbed.WallBump/0/normal/y"
+op = "=="
+value = 1.0
+
+[[assert]]
+id = "never-climbs-the-ledge"
+always = true
+pointer = "/entities/0/components/kit_fps.MoveState/pos/z"
+op = "=="
+value = 0.875
+
+[[assert]]
+id = "never-into-the-ledge"
+always = true
+pointer = "/entities/0/components/kit_fps.MoveState/pos/y"
+op = ">="
+value = 1.25
+
+[[assert]]
+id = "at-the-ledge-west"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/x"
+op = ">="
+value = 6.75
+
+[[assert]]
+id = "at-the-ledge-east"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/x"
+op = "<="
+value = 11.25
+
+[[assert]]
+id = "still-on-its-face"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/pos/y"
+op = "=="
+value = 1.25
+
+[[assert]]
+id = "stopped-against-the-ledge"
+at_tick = 300
+pointer = "/entities/0/components/kit_fps.MoveState/vel/y"
+op = "=="
+value = 0.0
