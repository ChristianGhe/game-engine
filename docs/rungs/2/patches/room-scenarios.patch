+++ b/crates/game-testbed/scenarios/scenarios.toml
@@ -17,3 +17,31 @@ input = "dot-corner.input.toml"
 assert = "dot-corner.assert.toml"
 ticks = 300
 seeds = [1, 7]
+
+# Rung 2's room, a map with sim data (`--map room`; its layout is in
+# game-testbed-sim's src/room/layout.rs). Its streams' headers end with
+# `map=room sim_data=0x...`. The seed changes only the gameplay random
+# stream: the room's spawns are fixed.
+[[scenario]]
+name = "room-walk"
+map = "room"
+input = "room-walk.input.toml"
+assert = "room-walk.assert.toml"
+ticks = 600
+seeds = [1, 2]
+
+[[scenario]]
+name = "room-ledge"
+map = "room"
+input = "room-ledge.input.toml"
+assert = "room-ledge.assert.toml"
+ticks = 300
+seeds = [1]
+
+[[scenario]]
+name = "room-corner"
+map = "room"
+input = "room-corner.input.toml"
+assert = "room-corner.assert.toml"
+ticks = 300
+seeds = [1]
