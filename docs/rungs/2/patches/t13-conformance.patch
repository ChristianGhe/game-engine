diff --git a/crates/eng-platform-winit/tests/requests.rs b/crates/eng-platform-winit/tests/requests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c6d8667c485adbf5fd0f8a1c89f040c0cd058b6e
--- /dev/null
+++ b/crates/eng-platform-winit/tests/requests.rs
@@ -0,0 +1,389 @@
+//! The request suite (ADR-0022, `conformance::requests`) on winit, with
+//! real windows (rung 2, T13: "the new suite passes on winit where a
+//! display exists"), and the window's refresh rate.
+//!
+//! Like `tests/conformance.rs` (whose reasons it shares: winit's event
+//! loop needs the main thread and exists once per process), this file is
+//! its own harness (`harness = false`), speaking the part of libtest's
+//! command line that `cargo test` and cargo-nextest use. Without a display
+//! the windowed checks skip, unless `ENG_REQUIRE_DISPLAY=1` makes them
+//! fail.
+//!
+//! Two checks are ignored, to be run by hand (`-- --ignored`) on a desktop
+//! with the screen unlocked: `grab_with_focus` needs the window to get
+//! focus, which a locked screen and Xvfb without a window manager never
+//! give, and `fullscreen` needs a window manager and takes seconds on
+//! macOS, which animates it. Each fails, saying why, if what it waits for
+//! never comes.
+
+use std::process::ExitCode;
+use std::sync::Arc;
+use std::time::Duration;
+
+use eng_platform_api::conformance::requests;
+use eng_platform_api::window::Window;
+use eng_platform_api::{
+    App, Control, CursorGrab, Instant, PhysicalSize, Platform, PlatformEvent, Wake,
+};
+use eng_platform_winit::{WinitPlatform, display_required};
+
+const TITLE: &str = "eng-platform-winit requests";
+
+/// Far longer than the checks take.
+const WATCHDOG: Duration = Duration::from_secs(60);
+
+/// How long the ignored checks wait for focus or for fullscreen to land.
+const PATIENCE: Duration = Duration::from_secs(8);
+
+/// A check, and whether it is ignored unless asked for.
+struct Check {
+    name: &'static str,
+    run: fn(&mut WinitPlatform),
+    ignored: bool,
+}
+
+const CHECKS: &[Check] = &[
+    Check {
+        name: "requests",
+        run: passes_the_request_suite,
+        ignored: false,
+    },
+    Check {
+        name: "refresh_rate",
+        run: the_window_tells_its_refresh_rate,
+        ignored: false,
+    },
+    Check {
+        name: "grab_with_focus",
+        run: a_grab_asked_for_in_window_takes_with_focus,
+        ignored: true,
+    },
+    Check {
+        name: "fullscreen",
+        run: fullscreen_asked_for_in_window_lands_and_leaves,
+        ignored: true,
+    },
+];
+
+/// T13's done-when: the request suite on real windows.
+fn passes_the_request_suite(platform: &mut WinitPlatform) {
+    requests::check(platform);
+}
+
+/// Reads the refresh rate in `window` and in the first frame, then exits.
+#[derive(Default)]
+struct Rates {
+    in_window: Option<Option<u32>>,
+    in_frame: Option<Option<u32>>,
+    window: Option<Arc<dyn Window>>,
+}
+
+impl App for Rates {
+    fn window(&mut self, _ctx: &mut dyn Control, window: Arc<dyn Window>) {
+        self.in_window = Some(window.refresh_rate());
+        self.window = Some(window);
+    }
+
+    fn frame(&mut self, ctx: &mut dyn Control) -> Wake {
+        self.in_frame = Some(self.window.as_ref().and_then(|w| w.refresh_rate()));
+        ctx.exit();
+        Wake::OnEvent
+    }
+
+    fn stop(&mut self, _ctx: &dyn Control) {
+        self.window = None;
+    }
+}
+
+/// The window's monitor's refresh rate, once the window shows: in
+/// millihertz, between 1 Hz and 1 kHz. macOS and Windows always know it;
+/// X11 and Wayland may not (it is printed, for the record).
+fn the_window_tells_its_refresh_rate(platform: &mut WinitPlatform) {
+    let mut app = Rates::default();
+    assert_eq!(platform.run(&mut app), Ok(()));
+    let in_window = app.in_window.expect("the app got the window");
+    let in_frame = app.in_frame.expect("the app framed");
+    println!("refresh rate: {in_window:?} mHz in App::window, {in_frame:?} in the first frame");
+    for rate in [in_window, in_frame].into_iter().flatten() {
+        assert!((1_000..=1_000_000).contains(&rate), "{rate} mHz");
+    }
+    if cfg!(any(target_os = "macos", windows)) {
+        assert!(
+            in_frame.is_some(),
+            "a shown window's monitor has a rate here"
+        );
+    }
+}
+
+/// Asks for a grab in `window`, then again when focus comes; frees the
+/// cursor a moment later and exits.
+#[derive(Default)]
+struct Grabber {
+    in_window: Option<CursorGrab>,
+    with_focus: Option<CursorGrab>,
+    freed: Option<CursorGrab>,
+    focus_at: Option<Instant>,
+    timed_out: bool,
+}
+
+impl App for Grabber {
+    fn window(&mut self, ctx: &mut dyn Control, _window: Arc<dyn Window>) {
+        self.in_window = Some(ctx.grab_cursor(true));
+    }
+
+    fn event(&mut self, ctx: &mut dyn Control, event: PlatformEvent) {
+        if event == PlatformEvent::FocusGained && self.with_focus.is_none() {
+            self.with_focus = Some(ctx.grab_cursor(true));
+            self.focus_at = Some(ctx.now());
+        }
+    }
+
+    fn frame(&mut self, ctx: &mut dyn Control) -> Wake {
+        let now = ctx.now();
+        if let Some(at) = self.focus_at {
+            let free_at = at + Duration::from_millis(300);
+            if now < free_at {
+                return Wake::At(free_at);
+            }
+            self.freed = Some(ctx.grab_cursor(false));
+            ctx.exit();
+            return Wake::OnEvent;
+        }
+        let give_up = Instant::ZERO + PATIENCE;
+        if now >= give_up {
+            self.timed_out = true;
+            ctx.exit();
+            return Wake::OnEvent;
+        }
+        Wake::At(give_up)
+    }
+}
+
+/// ADR-0022: a grab asked for in `App::window` waits for focus, then holds
+/// (`Locked` on macOS, Windows and Wayland, `Confined` on X11); asked again
+/// with focus, it answers the grab in force; freeing answers `None`.
+fn a_grab_asked_for_in_window_takes_with_focus(platform: &mut WinitPlatform) {
+    let mut app = Grabber::default();
+    assert_eq!(platform.run(&mut app), Ok(()));
+    assert!(
+        !app.timed_out,
+        "no focus came in {PATIENCE:?}: is the screen locked, or is there no window manager?"
+    );
+    assert_eq!(app.in_window, Some(CursorGrab::None), "it waits for focus");
+    let grab = app.with_focus.expect("focus came");
+    let want = if cfg!(all(unix, not(target_os = "macos")))
+        && std::env::var_os("WAYLAND_DISPLAY").is_none()
+    {
+        CursorGrab::Confined
+    } else {
+        CursorGrab::Locked
+    };
+    assert_eq!(grab, want);
+    assert_eq!(app.freed, Some(CursorGrab::None));
+}
+
+/// What `Fullscreen` is waiting for.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Stage {
+    Entering,
+    /// Fullscreen, until macOS's animation has surely ended: a change
+    /// asked for during it can be lost there.
+    Settling(Instant),
+    Leaving,
+    Done,
+}
+
+/// How long `Fullscreen` lets the window settle before it leaves.
+const SETTLE: Duration = Duration::from_secs(2);
+
+/// Asks for fullscreen in `window`, waits for the window to grow and
+/// settle, asks to leave, waits for it to shrink back, and exits.
+struct Fullscreen {
+    took: Option<bool>,
+    first: PhysicalSize,
+    largest: PhysicalSize,
+    last: PhysicalSize,
+    stage: Stage,
+    left: Option<bool>,
+    deadline: Instant,
+    window: Option<Arc<dyn Window>>,
+}
+
+impl Fullscreen {
+    const fn new() -> Self {
+        Self {
+            took: None,
+            first: PhysicalSize::new(0, 0),
+            largest: PhysicalSize::new(0, 0),
+            last: PhysicalSize::new(0, 0),
+            stage: Stage::Entering,
+            left: None,
+            deadline: Instant::ZERO,
+            window: None,
+        }
+    }
+}
+
+const fn area(size: PhysicalSize) -> u64 {
+    size.width as u64 * size.height as u64
+}
+
+impl App for Fullscreen {
+    fn window(&mut self, ctx: &mut dyn Control, window: Arc<dyn Window>) {
+        self.first = window.size();
+        self.last = self.first;
+        self.took = Some(ctx.set_fullscreen(true));
+        self.deadline = ctx.now() + PATIENCE;
+        self.window = Some(window);
+    }
+
+    fn event(&mut self, _ctx: &mut dyn Control, event: PlatformEvent) {
+        if let PlatformEvent::Resized(size) = event {
+            self.last = size;
+            if area(size) > area(self.largest) {
+                self.largest = size;
+            }
+        }
+    }
+
+    fn frame(&mut self, ctx: &mut dyn Control) -> Wake {
+        let now = ctx.now();
+        let size = self.window.as_ref().map_or(self.last, |w| w.size());
+        match self.stage {
+            Stage::Entering if area(size) > area(self.first) * 2 => {
+                self.stage = Stage::Settling(now + SETTLE);
+                self.deadline = now + SETTLE + PATIENCE;
+            }
+            Stage::Settling(at) if now >= at => {
+                self.left = Some(ctx.set_fullscreen(false));
+                self.stage = Stage::Leaving;
+            }
+            Stage::Leaving if area(size) <= area(self.first) => self.stage = Stage::Done,
+            _ => {}
+        }
+        if self.stage == Stage::Done || now >= self.deadline {
+            ctx.exit();
+            return Wake::OnEvent;
+        }
+        Wake::At(now + Duration::from_millis(50))
+    }
+
+    fn stop(&mut self, _ctx: &dyn Control) {
+        self.window = None;
+    }
+}
+
+/// ADR-0022: fullscreen asked for in `App::window` lands once the window
+/// shows (the window grows past twice its first area), and leaving it
+/// brings the window back.
+fn fullscreen_asked_for_in_window_lands_and_leaves(platform: &mut WinitPlatform) {
+    let mut app = Fullscreen::new();
+    assert_eq!(platform.run(&mut app), Ok(()));
+    assert_eq!(app.took, Some(true), "the platform takes the request");
+    println!(
+        "fullscreen: {:?}, then {:?} at its largest, then {:?}",
+        app.first, app.largest, app.last
+    );
+    assert_ne!(
+        app.stage,
+        Stage::Entering,
+        "the window never went fullscreen in {PATIENCE:?}: is the screen locked, or is there \
+         no window manager?"
+    );
+    assert_eq!(app.left, Some(true));
+    assert_eq!(
+        app.stage,
+        Stage::Done,
+        "the window never came back from fullscreen"
+    );
+}
+
+/// The part of libtest's command line that cargo and nextest use.
+#[derive(Default)]
+struct Cli {
+    list: bool,
+    ignored: bool,
+    include_ignored: bool,
+    exact: bool,
+    filters: Vec<String>,
+    skips: Vec<String>,
+}
+
+impl Cli {
+    fn parse(args: impl IntoIterator<Item = String>) -> Self {
+        let mut cli = Cli::default();
+        let mut args = args.into_iter();
+        while let Some(arg) = args.next() {
+            match arg.as_str() {
+                "--list" => cli.list = true,
+                "--ignored" => cli.ignored = true,
+                "--include-ignored" => cli.include_ignored = true,
+                "--exact" => cli.exact = true,
+                "--skip" => cli.skips.extend(args.next()),
+                // libtest's flags that take a value; the value means nothing here.
+                "--format" | "--color" | "--test-threads" | "--logfile" | "--shuffle-seed"
+                | "-Z" => {
+                    args.next();
+                }
+                flag if flag.starts_with('-') => {}
+                filter => cli.filters.push(filter.to_string()),
+            }
+        }
+        cli
+    }
+
+    fn selects(&self, check: &Check) -> bool {
+        let hit = |f: &String| {
+            if self.exact {
+                check.name == f
+            } else {
+                check.name.contains(f.as_str())
+            }
+        };
+        let kind = self.include_ignored || check.ignored == self.ignored;
+        kind && (self.filters.is_empty() || self.filters.iter().any(hit))
+            && !self.skips.iter().any(hit)
+    }
+}
+
+fn main() -> ExitCode {
+    let cli = Cli::parse(std::env::args().skip(1));
+    if cli.list {
+        for check in CHECKS.iter().filter(|c| cli.selects(c)) {
+            println!("{}: test", check.name);
+        }
+        return ExitCode::SUCCESS;
+    }
+    std::thread::spawn(|| {
+        std::thread::sleep(WATCHDOG);
+        eprintln!("[E-TIMEOUT] the windowed checks took more than {WATCHDOG:?}: a run never ended");
+        std::process::exit(1);
+    });
+    let chosen: Vec<&Check> = CHECKS.iter().filter(|c| cli.selects(c)).collect();
+    let mut platform = None;
+    if !chosen.is_empty() {
+        match WinitPlatform::new(TITLE) {
+            Ok(made) => platform = Some(made),
+            Err(e) if display_required() => {
+                eprintln!("[E-NO-DISPLAY] {e}; ENG_REQUIRE_DISPLAY=1 needs a display");
+                return ExitCode::FAILURE;
+            }
+            Err(e) => println!("no display, so the windowed checks skip: {e}"),
+        }
+    }
+    for check in &chosen {
+        match platform.as_mut() {
+            None => println!("test {} ... skipped", check.name),
+            Some(platform) => {
+                (check.run)(platform);
+                println!("test {} ... ok", check.name);
+            }
+        }
+    }
+    let ignored = CHECKS.len() - chosen.len();
+    println!(
+        "test result: ok. {} checks; {ignored} not chosen",
+        chosen.len()
+    );
+    ExitCode::SUCCESS
+}
