+            image: targets.read_output(gpu).unwrap_or_else(|e| panic!("{e}")),
+            info: read(self.renderer.read_info(gpu, targets)),
+            depth: read(self.renderer.read_depth(gpu, targets)),
+        }
+    }
+}
+
+/// The ray through pixel (`x`, `y`)'s centre, its part ahead 1.
+pub fn ray(scene: &FirstPersonScene, x: u32, y: u32) -> [f64; 3] {
+    let view = scene.camera.view_proj(W as f32 / H as f32).unwrap();
+    let ndc_x = (x as f32 + 0.5) / W as f32 * 2.0 - 1.0;
+    let ndc_y = 1.0 - (y as f32 + 0.5) / H as f32 * 2.0;
+    let r = view.ray(ndc_x, ndc_y);
+    [f64::from(r.x), f64::from(r.y), f64::from(r.z)]
+}
+
+/// The distance from the eye of the surface at pixel (`x`, `y`): `near /
+/// depth` ahead, along the pixel centre's ray (as fog and falloff measure
+/// it), cast on the CPU.
+pub fn distance(scene: &FirstPersonScene, frame: &Frame, x: u32, y: u32) -> f64 {
+    let ray = ray(scene, x, y);
+    let length = eng_math::sqrt_f64(ray.iter().map(|r| r * r).sum());
+    let ahead = f64::from(scene.camera.near) / f64::from(frame.depth.depth(x, y));
+    ahead * length
+}
+
+/// An f16's value.
+fn half(bits: u16) -> f64 {
+    let sign = if bits & 0x8000 != 0 { -1.0 } else { 1.0 };
+    let exponent = i32::from((bits >> 10) & 0x1f);
+    let fraction = f64::from(bits & 0x3ff);
+    assert!(exponent != 31, "not finite");
+    let (mantissa, power) = match exponent {
+        0 => (fraction, -24),
+        e => (1024.0 + fraction, e - 25),
+    };
+    let mut scale = 1.0;
+    for _ in 0..power.unsigned_abs() {
+        scale *= 2.0;
+    }
+    sign * if power < 0 {
+        mantissa / scale
+    } else {
+        mantissa * scale
+    }
+}
+
+/// The RGB of an `Rgba16Float` texel.
+pub fn rgb16(texels: &Texels, x: u32, y: u32) -> [f64; 3] {
+    let t = texels.texel(x, y);
+    [0, 1, 2].map(|c| half(u16::from_le_bytes([t[2 * c], t[2 * c + 1]])))
+}
