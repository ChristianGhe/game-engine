+pub fn scene_of(sim: &Sim, pose: Option<&str>, look: Look) -> FirstPersonScene {
+    let mut scene = room::scene(&FirstPersonFrame {
+        previous: sim,
+        current: sim,
+        alpha: 1.0,
+        width: W,
+        height: H,
