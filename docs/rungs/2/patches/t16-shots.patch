@@ -0,0 +1,414 @@
+//! The room's look on a real adapter (rung 2, T16; plan decision 13's
+//! structured look checks, criterion 7), through the testbed's own `shot`
+//! where an image is enough and in-process where a check needs the frame's
+//! `info`, depth or light: the room's world and scene are
+//! `game-testbed-client`'s, as `shot --map room` draws them (`look/mod.rs`),
+//! and every check compares the adapter with itself or tests a property,
+//! so it is exact on every adapter. eng-render's `look_checks.rs` and
+//! `look_fog_tone.rs` make the same checks on a test room; these make them
+//! on the room the shots show:
+//! - every look switch off (`looks/off.look.toml`) gives the plain
+//!   pipeline's image, byte for byte, and each switch alone changes it;
+//! - with the palette on, every pixel is one of `palettes/room.gpl`'s;
+//! - on a flat material, banding gives at most 32 levels per region;
+//! - the alcove's fog grows toward its colour with distance from the eye
+//!   (decision 13 as T10 proposed to word it), as `1 - e^(-density d)`;
+//! - the tone curve is within one 8-bit level of eng-render's CPU
+//!   reference (`eng-render/tests/tone/mod.rs`) on every pixel;
+//! - the room is closed: every pixel that shows the sky (`info`'s
+//!   `SurfaceClass::None`) looks out through the skylight's opening, from
+//!   every spawn and pose tried;
+//! - the marker shows the frame its rotation toward the eye names (frame 0
+//!   in `room-spawn`, 6 in `room-sprites`), and the binary draws that frame.
+//!
+//! Without an adapter each test skips, unless `ENG_REQUIRE_GPU=1` (CI)
+//! makes it fail.
+
+#[path = "look/mod.rs"]
+mod support;
+#[path = "../../eng-render/tests/tone/mod.rs"]
+mod tone;
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use eng_render::{FirstPersonScene, Look, SurfaceClass};
+use game_testbed_client::{palette, room};
+use game_testbed_sim::room::layout::ROOF;
+use support::{
+    Frame, H, Room, W, distance, look_file, off_look, ray, rgb16, scene_of, scratch, shot, shot_at,
+    sim_at,
+};
+
+/// From spawn 0 at tick 0, looking east, as the `room-spawn` shot.
+const SPAWN: Option<&str> = None;
+/// `shots.toml`'s `overview`: the sky, the alcove's fog, the things and
+/// walls of both facings.
+const OVERVIEW: Option<&str> = Some("0.5,8.5,1.6,-30,15");
+/// Into the alcove from the hall, 4 to 6 m from its back wall.
+const ALCOVE: Option<&str> = Some("8,2,1.6,0,0");
+/// Under the skylight, looking up its shaft.
+const SKY: Option<&str> = Some("4,7,1.6,200,60");
+
+/// The skylight's opening at the top of its shaft (`layout.rs`): x 3 to
+/// 5, y 6 to 8, at the roof.
+const SKYLIGHT: [(f64, f64); 2] = [(3.0, 5.0), (6.0, 8.0)];
+
+/// The alcove's region, whose fog is `room::FOG`'s green.
+const ALCOVE_REGION: u16 = 2;
+
+/// The look's switches, as a look file names them.
+const SWITCHES: [&str; 7] = [
+    "falloff",
+    "banding",
+    "contrast",
+    "sky_gradient",
+    "fog",
+    "palette",
+    "dither",
+];
+
+#[test]
+fn every_switch_off_gives_the_plain_image_and_each_switch_alone_changes_the_room() {
+    let dir = scratch("switches");
+    let Some(on) = shot(&dir, "overview-on", OVERVIEW, None) else {
+        return;
+    };
+    // The same shot twice is the same image, so a switch's change below is
+    // the switch's, not noise.
+    let again = shot(&dir, "overview-on-again", OVERVIEW, None).unwrap();
+    assert!(again == on, "the same shot twice gave two images");
+    let room = Room::new().expect("an adapter, as for the shot");
+    let world = room.world(None);
+    // Through the binary, every switch off is the plain pipeline's image of
+    // the same view, rendered here: byte for byte, from each view.
+    for (name, pose) in [("spawn", SPAWN), ("overview", OVERVIEW), ("sky", SKY)] {
+        let off = shot(&dir, &format!("{name}-off"), pose, Some(&off_look())).unwrap();
+        let plain = room.render(&world, &room.scene(pose, Look::ON), true);
+        assert!(
+            off == plain.image.rgba8,
+            "{name}: every switch off is not the plain image"
+        );
+    }
+    let off = shot(&dir, "overview-off", OVERVIEW, Some(&off_look())).unwrap();
+    assert!(on != off);
+    // Each switch alone: off from all on, and on from all off, changes the
+    // overview. Two need another switch on to show: dither the palette, and
+    // banding falloff, since the room's light levels (160, 192 and 112) are
+    // whole steps and 255 clamps to step 31, so only falloff leaves a
+    // fraction for banding to round away.
+    for switch in SWITCHES {
+        let without = shot(&dir, switch, OVERVIEW, Some(&look_file(&dir, &[switch])));
+        assert!(
+            without.unwrap() != on,
+            "switching {switch} off alone changed nothing"
+        );
+        let others: Vec<&str> = SWITCHES.into_iter().filter(|s| *s != switch).collect();
+        let base = match switch {
+            "dither" => Some("palette"),
+            "banding" => Some("falloff"),
+            _ => None,
+        };
+        let (base, with) = match base {
+            Some(needed) => {
+                let with: Vec<&str> = others.iter().copied().filter(|s| *s != needed).collect();
+                let without = [with.clone(), vec![switch]].concat();
+                let name = format!("{needed}-alone");
+                let base = shot(&dir, &name, OVERVIEW, Some(&look_file(&dir, &without)));
+                (base.unwrap(), look_file(&dir, &with))
+            }
+            None => (off.clone(), look_file(&dir, &others)),
+        };
+        let with = shot(&dir, &format!("{switch}-alone"), OVERVIEW, Some(&with)).unwrap();
+        assert!(with != base, "switching {switch} on alone changed nothing");
+    }
+}
+
+#[test]
+fn with_the_palette_on_every_pixel_is_a_room_palette_colour() {
+    let dir = scratch("palette");
+    let colours: BTreeSet<[u8; 3]> = palette::colours()
+        .colours
+        .iter()
+        .map(|c| [c.r, c.g, c.b])
+        .collect();
+    assert_eq!(colours.len(), 256);
+    let used = |rgba8: &[u8]| -> BTreeSet<[u8; 3]> {
+        rgba8.chunks(4).map(|p| [p[0], p[1], p[2]]).collect()
+    };
+    for (name, pose) in [
+        ("spawn", SPAWN),
+        ("overview", OVERVIEW),
+        ("alcove", ALCOVE),
+        ("sky", SKY),
+    ] {
+        let Some(image) = shot(&dir, name, pose, None) else {
+            return;
+        };
+        assert!(image.chunks(4).all(|p| p[3] == 255), "{name}: opaque");
+        let shown = used(&image);
+        let strays: Vec<_> = shown.difference(&colours).collect();
+        assert!(strays.is_empty(), "{name}: no palette colours {strays:?}");
+        assert!(shown.len() >= 16, "{name}: only {} colours", shown.len());
+    }
+    // The check can fail: the palette off shows colours the palette lacks.
+    let raw = shot(&dir, "raw", OVERVIEW, Some(&look_file(&dir, &["palette"]))).unwrap();
+    assert!(!used(&raw).is_subset(&colours));
+}
+
+/// The distinct output colours per region, over the pixels that show a
+/// surface.
+fn levels_per_region(frame: &Frame) -> BTreeMap<u16, BTreeSet<[u8; 4]>> {
+    let mut levels: BTreeMap<u16, BTreeSet<[u8; 4]>> = BTreeMap::new();
+    for y in 0..H {
+        for x in 0..W {
+            let info = frame.info(x, y);
+            if info.class != SurfaceClass::None {
+                let colours = levels.entry(info.region).or_default();
+                colours.insert(frame.image.pixel(x, y));
+            }
+        }
+    }
+    levels
+}
+
+#[test]
+fn on_a_flat_material_banding_gives_at_most_32_levels_per_region() {
+    let Some(room) = Room::new() else { return };
+    let world = room.world(Some([180, 160, 140]));
+    // Falloff, contrast and banding on; no fog or palette to add levels.
+    let banded = Look {
+        fog: false,
+        palette: false,
+        ..Look::ON
+    };
+    let smooth = Look {
+        banding: false,
+        ..banded
+    };
+    let mut most = 0;
+    for pose in [SPAWN, OVERVIEW, ALCOVE] {
+        let frame = room.render(&world, &room.scene(pose, banded), false);
+        for (region, colours) in levels_per_region(&frame) {
+            let levels = colours.len();
+            assert!(levels <= 32, "{pose:?}: region {region} shows {levels}");
+        }
+        let frame = room.render(&world, &room.scene(pose, smooth), false);
+        let levels = levels_per_region(&frame);
+        most = most.max(levels.values().map(BTreeSet::len).max().unwrap_or(0));
+    }
+    // The check can fail: without banding, falloff gives far more.
+    assert!(most > 32, "at most {most} levels without banding");
+}
+
+#[test]
+fn the_alcoves_fog_grows_with_distance_from_the_eye() {
+    let Some(room) = Room::new() else { return };
+    let world = room.world(None);
+    let scene = room.scene(ALCOVE, Look::ON);
+    let frame = room.render(&world, &scene, false);
+    let (gpu, targets) = (&room.gpu, &room.targets);
+    let lit = room.renderer.read_lit(gpu, targets).unwrap();
+    let fogged = room.renderer.read_fogged(gpu, targets).unwrap();
+    let alcove = scene.regions[usize::from(ALCOVE_REGION)];
+    let fog = [alcove.fog.r, alcove.fog.g, alcove.fog.b].map(f64::from);
+    let density = f64::from(alcove.fog_density);
+    assert!(density > 0.0);
+    let (mut probes, mut climbed) = (0, 0.0);
+    for y in (20..H - 20).step_by(20) {
+        // The row's alcove pixels, nearest first, with the fog's share of
+        // the way from `lit` to its colour in the channel that moves most.
+        let mut row: Vec<(f64, f64, f64)> = (0..W)
+            .filter(|&x| frame.info(x, y).region == ALCOVE_REGION)
+            .filter(|&x| frame.info(x, y).class != SurfaceClass::None)
+            .map(|x| {
+                let (l, f) = (rgb16(&lit, x, y), rgb16(&fogged, x, y));
+                let c = (0..3)
+                    .max_by(|&a, &b| (fog[a] - l[a]).abs().total_cmp(&(fog[b] - l[b]).abs()))
+                    .unwrap_or(1);
+                let span = fog[c] - l[c];
+                // Half floats, rounded once each: 2^-11 relative, twice.
+                let tolerance = 2.0 * (f[c].abs() + l[c].abs()) / 2048.0 / span.abs();
+                let d = distance(&scene, &frame, x, y);
+                ((f[c] - l[c]) / span, tolerance, d)
+            })
+            .collect();
+        row.sort_by(|a, b| a.2.total_cmp(&b.2));
+        for (share, tolerance, d) in &row {
+            // The fog's law, to within the half floats and f32's exp.
+            let want = 1.0 - f64::from(eng_math::exp(-(density * d) as f32));
+            assert!(
+                (share - want).abs() <= tolerance + 2e-3,
+                "row {y}: a share of {share} at {d} m, not {want}"
+            );
+        }
+        for pair in row.windows(2) {
+            let [(share, tol, near), (next, next_tol, far)] = [pair[0], pair[1]];
+            assert!(
+                far <= near * (1.0 + 1e-4) || next >= share - tol - next_tol,
+                "row {y}: the fog's share falls from {share} at {near} m to {next} at {far} m"
+            );
+        }
+        if let (Some(first), Some(last)) = (row.first(), row.last()) {
+            climbed = eng_math::max_f64(climbed, last.0 - first.0);
+        }
+        probes += row.len();
+    }
+    assert!(probes >= 300, "only {probes} probes in the alcove");
+    assert!(climbed > 0.05, "the fog climbs only {climbed} along a row");
+}
+
+#[test]
+fn the_tone_curve_is_within_one_level_of_the_cpu_reference_on_the_room() {
+    let Some(room) = Room::new() else { return };
+    let world = room.world(None);
+    let ev100 = f64::from(room::EV100.0);
+    let look = Look {
+        palette: false,
+        ..Look::ON
+    };
+    for pose in [SPAWN, OVERVIEW, ALCOVE, SKY] {
+        let frame = room.render(&world, &room.scene(pose, look), false);
+        let fogged = (room.renderer)
+            .read_fogged(&room.gpu, &room.targets)
+            .unwrap();
+        let mut levels = BTreeSet::new();
+        for y in 0..H {
+            for x in 0..W {
+                let want = tone::toned_codes(rgb16(&fogged, x, y), ev100);
+                let got = frame.image.pixel(x, y);
+                assert!(
+                    tone::within_one(got, want),
+                    "{pose:?} ({x}, {y}): {got:?}, not {want:?}"
+                );
+                levels.insert(got[1]);
+            }
+        }
+        assert!(levels.len() >= 32, "{pose:?}: only {} levels", levels.len());
+    }
+}
+
+/// The pixels of `frame` that show the sky but do not look out through
+/// the skylight's opening: none, if the room is closed.
+fn leaks(scene: &FirstPersonScene, frame: &Frame) -> Vec<(u32, u32)> {
+    let eye = scene.camera.eye;
+    let margin = 0.02;
+    let [(x0, x1), (y0, y1)] = SKYLIGHT;
+    let mut found = Vec::new();
+    for y in 0..H {
+        for x in 0..W {
+            if frame.info(x, y).class != SurfaceClass::None {
+                continue;
+            }
+            let [rx, ry, rz] = ray(scene, x, y);
+            let out = rz > 0.0 && {
+                let t = (ROOF - eye.z) / rz;
+                let (px, py) = (eye.x + rx * t, eye.y + ry * t);
+                (x0 - margin..=x1 + margin).contains(&px)
+                    && (y0 - margin..=y1 + margin).contains(&py)
+            };
+            if !out {
+                found.push((x, y));
+            }
+        }
+    }
+    found
+}
+
+#[test]
+fn the_room_is_closed_the_sky_shows_only_through_the_skylight() {
+    let Some(room) = Room::new() else { return };
+    let world = room.world(None);
+    // The four spawns' eyes, the poses above, the platform and the alcove.
+    let eyes = [
+        (1.5, 4.5, 1.6),
+        (1.5, 3.0, 1.6),
+        (1.5, 6.0, 1.6),
+        (1.5, 1.5, 1.6),
+        (0.5, 8.5, 1.6),
+        (8.0, 2.0, 1.6),
+        (4.0, 7.0, 1.6),
+        (10.5, 6.5, 2.0),
+        (13.5, 2.0, 1.6),
+    ];
+    let (mut frames, mut sky) = (0, 0);
+    for (x, y, z) in eyes {
+        for yaw in (0..360).step_by(45) {
+            for pitch in [-60, -20, 0, 30, 70] {
+                let pose = format!("{x},{y},{z},{yaw},{pitch}");
+                let scene = room.scene(Some(&pose), Look::ON);
+                let frame = room.render(&world, &scene, false);
+                let leaks = leaks(&scene, &frame);
+                let first = &leaks[..leaks.len().min(8)];
+                assert!(leaks.is_empty(), "{pose}: the sky shows at {first:?}");
+                sky += (0..H)
+                    .flat_map(|y| (0..W).map(move |x| (x, y)))
+                    .filter(|&(x, y)| frame.info(x, y).class == SurfaceClass::None)
+                    .count();
+                frames += 1;
+            }
+        }
+    }
+    assert!(
+        sky >= 10_000,
+        "the sky showed in only {sky} pixels of {frames} frames"
+    );
+    // The check can fail: from above the roof, the sky is everywhere.
+    let above = room.scene(Some("6,4.5,6,0,-30"), Look::ON);
+    let frame = room.render(&world, &above, false);
+    assert!(leaks(&above, &frame).len() > 1_000);
+}
+
+/// The marker: thing 0, as `room::sprites` numbers the things in entity
+/// order, and its sprite's id at its pixels in `info`.
+const MARKER: u32 = 0;
+
+/// T11's check on the shots (`shots.toml`'s `room-spawn` and
+/// `room-sprites`): the marker turns once every 8 s, so from spawn 0 it
+/// shows rotation (8 - s) % 8 at whole second s, and its eight-frame sheet
+/// draws that rotation's frame, unmirrored. `Sprite::frame_toward(eye)`
+/// names the frame; forcing every rotation to that frame's material leaves
+/// the image as it is, so the frame drawn is that one (forcing the next
+/// frame changes it, so the check can fail); and the binary's shot is this
+/// very image.
+#[test]
+fn the_shots_show_the_markers_frame_its_rotation_names() {
+    let dir = scratch("marker");
+    let Some(room) = Room::new() else { return };
+    let world = room.world(None);
+    for (name, tick, want) in [("room-spawn", 0, 0_u8), ("room-sprites", 120, 6)] {
+        let sim = sim_at(tick);
+        let scene = scene_of(&sim, None, Look::ON);
+        let at = (scene.sprites.iter())
+            .position(|sprite| sprite.id == MARKER)
+            .expect("the marker is a sprite");
+        let marker = scene.sprites[at];
+        let frame = marker.frame_toward(scene.camera.eye);
+        assert_eq!((frame.frame, frame.mirrored), (want, false), "{name}");
+        let drawn = room.render(&world, &scene, false);
+        let pixels = (0..H)
+            .flat_map(|y| (0..W).map(move |x| (x, y)))
+            .map(|(x, y)| drawn.info(x, y))
+            .filter(|info| info.class == SurfaceClass::Sprite && info.id == MARKER)
+            .count();
+        assert!(pixels >= 800, "{name}: {pixels} marker pixels");
+        let force = |frame: usize| {
+            let mut forced = scene.clone();
+            forced.sprites[at].materials = [marker.materials[frame]; 8];
+            room.render(&world, &forced, false).image
+        };
+        assert!(
+            force(usize::from(want)) == drawn.image,
+            "{name}: the marker shows another frame than {want}"
+        );
+        let next = (usize::from(want) + 1) % 8;
+        assert!(
+            force(next) != drawn.image,
+            "{name}: frame {next} looks the same"
+        );
+        let shot = shot_at(&dir, name, tick, None, None).expect("an adapter, as in-process");
+        assert!(
+            shot == drawn.image.rgba8,
+            "{name}: the binary drew another image"
+        );
+    }
+}
