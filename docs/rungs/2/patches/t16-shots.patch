@@ -0,0 +1,432 @@
+//! The harness's rung 2 parts (T16 and plan addition A3), tested without
+//! a GPU beside `parts.rs`: the owner's `golden = "pending"` marker, the
+//! manifest `shots.toml` (`manifest.rs`), the per-shot `[flip.<shot>]`
+//! limits, and the views the probe reports.
+
+use std::path::Path;
+
+use serde_json::{Value, json};
+
+use super::compare::{Mode, SIZE, Status, Thresholds, check, read_limits, read_thresholds};
+use super::manifest::{self, Shot, parse, poses, view_of};
+use super::parts::{THRESHOLDS, picture, pinned_config, png_of, scratch, taken};
+use super::{Taken, judge, shot_command, shots};
+
+fn summary(candidates: &Path) -> Value {
+    let text = std::fs::read(candidates.join("shots.json")).unwrap();
+    serde_json::from_slice(&text).unwrap()
+}
+
+fn marked(name: &str, png: Vec<u8>) -> Taken<'_> {
+    Taken {
+        pending: true,
+        ..taken(name, png)
+    }
+}
+
+#[test]
+fn a_marked_shot_has_no_golden_yet_whatever_the_others_have() {
+    let (refs, candidates) = scratch("marker");
+    let config = pinned_config();
+    let golden = png_of(&picture(SIZE.0, SIZE.1, 10));
+    std::fs::write(refs.join("a-shot.png"), &golden).unwrap();
+    // Another shot has its golden, and in ENG_GOLDEN_DIR (`explicit`) every
+    // shot needs one; the marked shot passes as "no golden yet" either way
+    // and leaves its candidate.
+    let shots = [
+        taken("a-shot", golden.clone()),
+        marked("new", golden.clone()),
+    ];
+    for explicit in [false, true] {
+        let failures = judge(&shots, &config, Mode::Exact, (&refs, explicit), &candidates);
+        assert!(failures.is_empty(), "{explicit}: {failures:?}");
+        let summary = summary(&candidates);
+        let (first, new) = (&summary["shots"][0], &summary["shots"][1]);
+        assert_eq!(
+            (&first["status"], &first["pending"]),
+            (&json!("pass"), &json!(false))
+        );
+        assert_eq!(
+            (&new["status"], &new["pending"]),
+            (&json!("no-golden"), &json!(true))
+        );
+        let message = new["message"].as_str().unwrap();
+        assert!(
+            message.starts_with("new: [W-NO-GOLDEN] no golden yet"),
+            "{message}"
+        );
+        assert!(message.ends_with("(golden = \"pending\" in shots.toml)"));
+        assert!(candidates.join("new.png").is_file(), "its candidate");
+    }
+    // Unmarked, the same shot fails: all or nothing, as before.
+    let unmarked = [
+        taken("a-shot", golden.clone()),
+        taken("new", golden.clone()),
+    ];
+    let failures = judge(&unmarked, &config, Mode::Exact, (&refs, false), &candidates);
+    assert_eq!(failures.len(), 1, "{failures:?}");
+    assert!(failures[0].ends_with("is missing; other shots have theirs"));
+
+    // A golden for the marked shot, here unlike it: in ENG_GOLDEN_DIR it is
+    // measured but not judged, so a copy of another runner's candidates
+    // gives the owner numbers before the marker goes.
+    std::fs::write(refs.join("new.png"), &golden).unwrap();
+    let changed = png_of(&picture(SIZE.0, SIZE.1, 11));
+    let shots = [
+        taken("a-shot", golden.clone()),
+        marked("new", changed.clone()),
+    ];
+    for mode in [Mode::Exact, Mode::Flip] {
+        let failures = judge(&shots, &config, mode, (&refs, true), &candidates);
+        assert!(failures.is_empty(), "{failures:?}");
+        let new = &summary(&candidates)["shots"][1];
+        assert_eq!(new["status"], "no-golden");
+        let message = new["message"].as_str().unwrap();
+        let says = "measured against ENG_GOLDEN_DIR, not judged: 21 of 76800 pixels differ";
+        assert!(message.contains(says) || mode == Mode::Flip, "{message}");
+        // Nothing failed, so no `[E-GOLDEN]`, which selftest golden-edit
+        // reads as a shot's failure.
+        assert!(!message.contains("[E-GOLDEN]"), "{message}");
+        assert_eq!(new["differing_pixels"], 21, "{message}");
+        assert_eq!(std::fs::read(candidates.join("new.png")).unwrap(), changed);
+    }
+    // In `golden/` itself it fails, matching or not: the marker goes in the
+    // commit that adds the golden.
+    for png in [changed, golden.clone()] {
+        let shots = [taken("a-shot", golden.clone()), marked("new", png)];
+        let failures = judge(&shots, &config, Mode::Exact, (&refs, false), &candidates);
+        assert_eq!(failures.len(), 1, "{failures:?}");
+        assert!(failures[0].starts_with("new: [E-GOLDEN]"), "{failures:?}");
+        assert!(failures[0].ends_with("clear the marker in the commit that adds the golden"));
+        assert!(candidates.join("new.png").is_file());
+    }
+}
+
+/// The marker excuses a missing or differing golden, never the shot's own
+/// fault: a marked shot that is not opaque (or not 320x240, or does not
+/// decode) fails as it says, with a golden or without, in `golden/` and in
+/// `ENG_GOLDEN_DIR`.
+#[test]
+fn a_marked_shot_still_fails_for_its_own_faults() {
+    let (refs, candidates) = scratch("marker-faults");
+    let config = pinned_config();
+    let golden = png_of(&picture(SIZE.0, SIZE.1, 10));
+    std::fs::write(refs.join("a-shot.png"), &golden).unwrap();
+    let mut clear = picture(SIZE.0, SIZE.1, 10);
+    clear.rgba8[3] = 254;
+    let wide = png_of(&picture(SIZE.0 + 1, SIZE.1, 10));
+    let faults = [
+        (png_of(&clear), "the shot is not opaque"),
+        (wide, "the shot is 321x240, not 320x240"),
+        (b"not a png".to_vec(), "the shot does not decode"),
+    ];
+    for with_golden in [false, true] {
+        if with_golden {
+            std::fs::write(refs.join("new.png"), &golden).unwrap();
+        }
+        for (png, says) in &faults {
+            for explicit in [false, true] {
+                let shots = [taken("a-shot", golden.clone()), marked("new", png.clone())];
+                for mode in [Mode::Exact, Mode::Flip] {
+                    let failures = judge(&shots, &config, mode, (&refs, explicit), &candidates);
+                    let what = format!("golden {with_golden}, explicit {explicit}: {failures:?}");
+                    assert_eq!(failures.len(), 1, "{what}");
+                    assert!(failures[0].starts_with("new: [E-GOLDEN] "), "{what}");
+                    assert!(failures[0].contains(says), "{what}");
+                    assert!(!failures[0].contains("pending"), "{what}");
+                    let new = &summary(&candidates)["shots"][1];
+                    assert_eq!(new["status"], "fail", "{what}");
+                    assert!(candidates.join("new.png").is_file(), "its candidate");
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn the_manifest_keeps_rung_1bs_four_shots_unmarked_and_renders_every_pose() {
+    let shots = shots();
+    let first: Vec<(&str, u32, u32, Option<&str>)> = shots[..4]
+        .iter()
+        .map(|s| (s.name.as_str(), s.tick, s.players, s.input.as_deref()))
+        .collect();
+    let square = Some("scenarios/dot-square.input.toml");
+    assert_eq!(
+        first,
+        [
+            ("dot-square-0", 0, 1, square),
+            ("dot-square-120", 120, 1, square),
+            ("dot-square-240", 240, 1, square),
+            ("ten-dots-0", 0, 10, None),
+        ]
+    );
+    for shot in &shots[..4] {
+        assert!(!shot.pending && shot.map.is_none() && shot.pose.is_none());
+        assert!(shot.look.is_none(), "{shot:?}");
+    }
+    // Each pose is a shot's, so it renders whenever the shots do.
+    assert!(!poses(&shots).is_empty());
+    for shot in &shots {
+        let command = shot_command(shot, Path::new("out"));
+        let args: Vec<String> = (command.get_args())
+            .map(|arg| arg.to_string_lossy().into_owned())
+            .collect();
+        // Each flag the manifest asks for, once, with its value.
+        let value = |flag: &str| {
+            let at = args.iter().position(|arg| arg == flag)?;
+            let count = args.iter().filter(|arg| *arg == flag).count();
+            assert_eq!(count, 1, "{args:?}");
+            Some(args[at + 1].clone())
+        };
+        assert_eq!(value("--map"), shot.map, "{args:?}");
+        assert_eq!(value("--pose"), shot.pose.clone().map(|(_, pose)| pose));
+        let ends = |flag: &str, file: &Option<String>| match (value(flag), file) {
+            (Some(path), Some(file)) => Path::new(&path).ends_with(file),
+            (got, file) => got.is_none() && file.is_none(),
+        };
+        assert!(ends("--input", &shot.input), "{args:?}");
+        assert!(ends("--look", &shot.look), "{args:?}");
+    }
+}
