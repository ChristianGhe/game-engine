+    pub fn scene(&self, pose: Option<&str>, look: Look) -> FirstPersonScene {
+        scene_of(&self.sim, pose, look)
+    }
+
+    /// One frame: the look's graph, or the plain pipeline's.
+    pub fn render(&self, world: &GpuWorld, scene: &FirstPersonScene, plain: bool) -> Frame {
+        let (gpu, targets) = (&self.gpu, &self.targets);
+        if plain {
+            self.renderer.render_plain(gpu, targets, world, scene)
+        } else {
+            self.renderer.render(gpu, targets, world, scene)
+        }
+        .unwrap_or_else(|e| panic!("{e}"));
+        let read = |texels: Result<Texels, _>| texels.unwrap_or_else(|e| panic!("{e}"));
