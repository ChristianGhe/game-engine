index 0000000000000000000000000000000000000000..67604efa484d6c0426a45f0216fad9a96edd5194
--- /dev/null
+++ b/crates/game-testbed/tests/shots/manifest.rs
@@ -0,0 +1,241 @@
+//! `shots.toml`, the shots' manifest (rung 2, T16; plan decision 12 and
+//! addition A3), read strictly: every shot the harness renders, the poses
+//! it names, and the owner's `golden = "pending"` markers. Its tests, which
+//! need no GPU, are in `marker.rs`.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Component, Path};
+
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+/// One shot: `shot --at-tick <tick> --seed 1 --players <players>`, with
+/// `--map`, `--input`, `--pose` and `--look` when it names them.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Shot {
+    pub(crate) name: String,
+    /// `--map`; the game's first map without it.
+    pub(crate) map: Option<String>,
+    pub(crate) tick: u32,
+    pub(crate) players: u32,
+    /// An input script, from the manifest's directory.
+    pub(crate) input: Option<String>,
+    /// The pose's name, and its `X,Y,Z,YAW,PITCH` for `--pose`.
+    pub(crate) pose: Option<(String, String)>,
+    /// A look file, from the manifest's directory.
+    pub(crate) look: Option<String>,
+    /// The owner's `golden = "pending"`: no golden yet, by choice.
+    pub(crate) pending: bool,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct File {
+    version: u32,
+    shot: Vec<Entry>,
+    #[serde(default)]
+    pose: BTreeMap<String, String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Entry {
+    name: String,
+    map: Option<String>,
+    tick: u32,
+    players: Option<u32>,
+    input: Option<String>,
+    pose: Option<String>,
+    look: Option<String>,
+    golden: Option<Golden>,
+}
+
+/// The only marker there is.
+#[derive(Deserialize, PartialEq)]
+#[serde(rename_all = "lowercase")]
+enum Golden {
+    Pending,
+}
+
+/// A shot's, pose's or map's name: lowercase letters, digits and `-`, as
+/// golden files and `[flip.<shot>]` tables are named.
+pub(crate) fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+}
+
+/// A path the manifest names: relative, inside its directory.
+fn valid_path(path: &str) -> bool {
+    let path = Path::new(path);
+    !path.as_os_str().is_empty()
+        && path
+            .components()
+            .all(|component| matches!(component, Component::Normal(_)))
+}
+
+/// The shots `text` lists, in its order, or an `[E-GOLDEN]` error naming
+/// the problem. Strict: `version = 1`; at least one shot; unique, valid
+/// names; 1 to 255 players; relative paths; each pose one that `[pose]`
+/// names, which the probe's `--pose` accepts; every pose some shot's.
+pub(crate) fn parse(text: &str) -> Result<Vec<Shot>, String> {
+    let fail = |message: String| format!("[E-GOLDEN] shots.toml: {message}");
+    let file: File = toml::from_str(text).map_err(|e| fail(e.to_string().trim_end().into()))?;
+    if file.version != 1 {
+        return Err(fail(format!("version {}, not 1", file.version)));
+    }
+    if file.shot.is_empty() {
+        return Err(fail("no [[shot]]".into()));
+    }
+    for (name, pose) in &file.pose {
+        if !valid_name(name) {
+            return Err(fail(format!(
+                "pose {name:?}: names are lowercase letters, digits and '-'"
+            )));
+        }
+        eng_cli::Pose::parse(pose).map_err(|e| fail(format!("pose {name:?}: {e}")))?;
+    }
+    let mut shots: Vec<Shot> = Vec::new();
+    for entry in file.shot {
+        let name = entry.name;
+        let what = |message: &str| fail(format!("shot {name:?}: {message}"));
+        if !valid_name(&name) {
+            return Err(what("names are lowercase letters, digits and '-'"));
+        }
+        if shots.iter().any(|shot| shot.name == name) {
+            return Err(what("named twice"));
+        }
+        if entry.map.as_deref().is_some_and(|map| !valid_name(map)) {
+            return Err(what("a map's name is lowercase letters, digits and '-'"));
+        }
+        let players = entry.players.unwrap_or(1);
+        if !(1..=255).contains(&players) {
+            return Err(what("players is 1 to 255"));
+        }
+        let paths = [entry.input.as_deref(), entry.look.as_deref()];
+        if paths.into_iter().flatten().any(|path| !valid_path(path)) {
+            return Err(what(
+                "input and look are paths inside the manifest's directory",
+            ));
+        }
+        let pose = match entry.pose {
+            Some(pose) => match file.pose.get(&pose) {
+                Some(value) => Some((pose, value.clone())),
+                None => return Err(what(&format!("pose {pose:?} is not in [pose]"))),
+            },
+            None => None,
+        };
+        shots.push(Shot {
+            name,
+            map: entry.map,
+            tick: entry.tick,
+            players,
+            input: entry.input,
+            pose,
+            look: entry.look,
+            pending: entry.golden == Some(Golden::Pending),
+        });
+    }
+    let used = poses(&shots);
+    if let Some(unused) = file.pose.keys().find(|name| !used.contains(name.as_str())) {
+        return Err(fail(format!(
+            "pose {unused:?} is no shot's: every named pose must render"
+        )));
+    }
+    Ok(shots)
+}
+
+/// The manifest at `path`, parsed, with every file it names present.
+pub(crate) fn load(path: &Path) -> Result<Vec<Shot>, String> {
+    let text =
+        std::fs::read_to_string(path).map_err(|e| format!("[E-GOLDEN] {}: {e}", path.display()))?;
+    let shots = parse(&text)?;
+    let dir = path.parent().unwrap_or(Path::new("."));
+    for shot in &shots {
+        for file in [&shot.input, &shot.look].into_iter().flatten() {
+            if !dir.join(file).is_file() {
+                return Err(format!(
+                    "[E-GOLDEN] shots.toml: shot {:?}: {} does not exist",
+                    shot.name,
+                    dir.join(file).display()
+                ));
+            }
+        }
+    }
+    Ok(shots)
+}
+
+/// The names of the poses the shots use.
+pub(crate) fn poses(shots: &[Shot]) -> BTreeSet<&str> {
+    shots
+        .iter()
+        .filter_map(|shot| shot.pose.as_ref().map(|(name, _)| name.as_str()))
+        .collect()
+}
+
+/// The view `shot`'s report says the probe drew, as `shots.json`'s `views`
+/// lists it, or an `[E-GOLDEN]` error if it is not the one the shot asked
+/// for: the map, the pose (to the bit) and whether a look file was read.
+pub(crate) fn view_of(shot: &Shot, report: &Value) -> Result<Value, String> {
+    let view = &report["view"];
+    let fail = |what: &str| {
+        Err(format!(
+            "{}: [E-GOLDEN] the probe drew {what}: map {}, view {view}",
+            shot.name, report["map"]
+        ))
+    };
+    let kind = view["kind"].as_str().unwrap_or_default();
+    if !["top-down", "first-person"].contains(&kind) {
+        return fail("no view it names");
+    }
+    if let Some(map) = &shot.map
+        && report["map"] != map.as_str()
+    {
+        return fail("another map");
+    }
+    let posed = view["camera_from"] == "pose";
+    match &shot.pose {
+        Some((_, pose)) => {
+            let want = eng_cli::Pose::parse(pose).map_err(|e| e.to_string())?;
+            let eye = [want.eye.x, want.eye.y, want.eye.z];
+            let asked = &view["pose"];
+            let same = posed
+                && asked["eye"] == json!(eye)
+                && asked["yaw_deg"] == json!(want.yaw_deg)
+                && asked["pitch_deg"] == json!(want.pitch_deg);
+            if !same {
+                return fail("another pose");
+            }
+            // And the camera drawn is the pose's, not only the pose echoed:
+            // its eye exactly, its angles to within the binary angle's
+            // rounding (2^-32 of a turn, under 1e-7 degrees).
+            let camera = &view["camera"];
+            let angle = |key: &str, want: f64| {
+                let got = camera[key].as_f64().unwrap_or(f64::NAN);
+                let apart = (got - want).rem_euclid(360.0);
+                apart <= 1e-6 || apart >= 360.0 - 1e-6
+            };
+            let drawn = camera["eye"] == json!(eye)
+                && angle("yaw_deg", want.yaw_deg)
+                && angle("pitch_deg", want.pitch_deg);
+            if !drawn {
+                return fail("a camera other than the pose's");
+            }
+        }
+        None if posed => return fail("a pose it did not ask for"),
+        None => {}
+    }
+    if shot.look.is_some() == view["look"].is_null() {
+        return fail("another look");
+    }
+    Ok(json!({
+        "name": shot.name,
+        "map": report["map"],
+        "kind": kind,
+        "pose": shot.pose.as_ref().map(|(name, _)| name),
+        "look": shot.look,
+        "camera_from": view["camera_from"],
+        "camera": view["camera"],
+    }))
+}
