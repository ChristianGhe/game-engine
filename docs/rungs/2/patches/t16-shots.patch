+const ONE: &str = "version = 1\n[[shot]]\nname = \"a\"\ntick = 3\n";
+
+#[test]
+fn the_manifest_is_read_strictly() {
+    let posed = format!(
+        "{ONE}map = \"room\"\npose = \"p\"\nlook = \"looks/off.look.toml\"\n\
+         golden = \"pending\"\n[pose]\np = \"1,2,1.6,90,-10\"\n"
+    );
+    assert_eq!(
+        parse(&posed),
+        Ok(vec![Shot {
+            name: "a".into(),
+            map: Some("room".into()),
+            tick: 3,
+            players: 1,
+            input: None,
+            pose: Some(("p".into(), "1,2,1.6,90,-10".into())),
+            look: Some("looks/off.look.toml".into()),
+            pending: true,
+        }])
+    );
+    let two = format!("{ONE}[[shot]]\nname = \"b\"\ntick = 0\nplayers = 4\n");
+    assert_eq!(parse(&two).map(|s| s.len()), Ok(2));
+    for (bad, why) in [
+        (ONE.replace("version = 1", "version = 2"), "version 2"),
+        ("version = 1\n".into(), "shot"),
+        (format!("{ONE}colour = \"red\"\n"), "colour"),
+        (format!("{ONE}golden = \"done\"\n"), "done"),
+        (format!("{ONE}golden = true\n"), "golden"),
+        (ONE.replace("\"a\"", "\"A shot\""), "lowercase"),
+        (ONE.replace("\"a\"", "\"a_b\""), "lowercase"),
+        (
+            format!("{ONE}[[shot]]\nname = \"a\"\ntick = 1\n"),
+            "named twice",
+        ),
+        (format!("{ONE}players = 0\n"), "players"),
+        (format!("{ONE}players = 256\n"), "players"),
+        (format!("{ONE}map = \"Room\"\n"), "map"),
+        (format!("{ONE}input = \"../x.toml\"\n"), "inside"),
+        (format!("{ONE}look = \"/looks/off.look.toml\"\n"), "inside"),
+        (format!("{ONE}pose = \"p\"\n"), "not in [pose]"),
+        (
+            format!("{ONE}pose = \"p\"\n[pose]\np = \"1,2,3\"\n"),
+            "--pose needs",
+        ),
+        (
+            format!("{ONE}pose = \"p\"\n[pose]\np = \"0,0,1,0,91\"\n"),
+            "--pose needs",
+        ),
+        (format!("{ONE}[pose]\np = \"0,0,1,0,0\"\n"), "no shot's"),
+        (
+            format!("{ONE}pose = \"P\"\n[pose]\nP = \"0,0,1,0,0\"\n"),
+            "lowercase",
+        ),
+    ] {
+        let err = parse(&bad).unwrap_err();
+        assert!(err.starts_with("[E-GOLDEN] shots.toml: "), "{bad}: {err}");
+        assert!(err.contains(why), "{bad}: {err}");
+    }
+    // Files it names must exist beside it.
+    let (refs, _) = scratch("manifest-files");
+    let path = refs.join("shots.toml");
+    std::fs::write(&path, format!("{ONE}input = \"missing.toml\"\n")).unwrap();
+    let err = manifest::load(&path).unwrap_err();
+    assert!(err.contains("missing.toml does not exist"), "{err}");
+    std::fs::write(refs.join("missing.toml"), "").unwrap();
+    assert!(manifest::load(&path).is_ok());
+}
