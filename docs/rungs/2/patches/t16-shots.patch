+//! What the room's look checks share (`../look.rs`): the room's shot
+//! through the binary, look files, and the room's world, scene and frames
+//! in-process, as `shot --map room` draws them, with readbacks.
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use eng_cli::{FirstPersonFrame, Pose};
+use eng_core::{PlayerCommand, Tick};
+use eng_gpu::{Gpu, GpuError, GpuOptions, Image, Targets, Texels};
+use eng_render::{FirstPersonRenderer, FirstPersonScene, GpuWorld, Info, Look};
+use eng_sim::{Sim, SimConfig};
+use game_testbed_client::room;
+
+pub const W: u32 = 320;
+pub const H: u32 = 240;
+
+fn gpu() -> Option<Gpu> {
+    match Gpu::new(&GpuOptions::from_env()) {
+        Ok(gpu) => Some(gpu),
+        Err(e @ GpuError::NoAdapter { .. }) if !eng_gpu::gpu_required() => {
+            eprintln!("skipped: {e}");
+            None
+        }
+        Err(e) => panic!("{e}"),
+    }
+}
+
+pub fn scratch(name: &str) -> PathBuf {
+    let dir = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("look")
+        .join(name);
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+/// How long a shot may take.
+const LIMIT: Duration = Duration::from_secs(120);
+
+/// The room at tick 0 as `shot --map room --seed 1 --at-tick 0` draws it
+/// from `pose` (player 0's camera without one), with `look` (`None`: every
+/// switch on), as decoded RGBA8; `None` without an adapter, unless one is
+/// required.
+pub fn shot(dir: &Path, name: &str, pose: Option<&str>, look: Option<&Path>) -> Option<Vec<u8>> {
+    shot_at(dir, name, 0, pose, look)
+}
+
+/// [`shot`] at `tick`, player 0 idle until then. Each run is killed after
+/// [`LIMIT`].
+pub fn shot_at(
+    dir: &Path,
+    name: &str,
+    tick: u64,
+    pose: Option<&str>,
+    look: Option<&Path>,
+) -> Option<Vec<u8>> {
+    let out = dir.join(format!("{name}.png"));
+    let tick = tick.to_string();
+    let mut command = Command::new(env!("CARGO_BIN_EXE_game-testbed"));
+    command.args(["shot", "--map", "room", "--at-tick", &tick, "--seed", "1"]);
+    command.args(["--size", "320x240", "--out"]).arg(&out);
+    if let Some(pose) = pose {
+        command.args(["--pose", pose]);
+    }
+    if let Some(look) = look {
+        command.arg("--look").arg(look);
+    }
+    command.env("ENG_AGENT_LOG_DIR", dir.join("logs"));
+    let mut child = (command.stdin(Stdio::null()))
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("run game-testbed");
+    let start = Instant::now();
+    while child.try_wait().unwrap().is_none() {
+        if start.elapsed() > LIMIT {
+            let _ = child.kill();
+            panic!("{name}: killed after {LIMIT:?}");
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let output = child.wait_with_output().unwrap();
+    let text = String::from_utf8_lossy(&output.stderr).into_owned()
+        + &String::from_utf8_lossy(&output.stdout);
+    if output.status.code() == Some(64) && text.contains("[E-NO-ADAPTER]") {
+        assert!(!eng_gpu::gpu_required(), "ENG_REQUIRE_GPU=1: {text}");
+        eprintln!("skipped: {text}");
+        return None;
+    }
+    assert_eq!(output.status.code(), Some(0), "{name}: {text}");
+    let bytes = std::fs::read(&out).unwrap();
+    let mut reader = png::Decoder::new(std::io::Cursor::new(&bytes[..]))
+        .read_info()
+        .unwrap();
+    let mut rgba8 = vec![0; reader.output_buffer_size().unwrap()];
+    let info = reader.next_frame(&mut rgba8).unwrap();
+    assert_eq!((info.width, info.height), (W, H));
+    assert_eq!(
