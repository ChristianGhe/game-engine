+pub fn sim_at(ticks: u64) -> Sim {
+    let config = SimConfig {
+        tick_rate: game_testbed_sim::TICK_RATE,
+        players: 1,
+        seed: 1,
+    };
+    let mut sim = game_testbed_sim::room::build(config).unwrap();
