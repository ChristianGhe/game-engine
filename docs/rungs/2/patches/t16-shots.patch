+/// A shot report's `view`, as the probe writes it (eng-cli's `shot_view`).
+fn report(map: &str, view: Value) -> Value {
+    json!({"map": map, "view": view})
+}
+
+#[test]
+fn a_shot_must_show_the_view_it_asked_for() {
+    let room = |pose: Option<(&str, &str)>, look: bool| Shot {
+        name: "room-x".into(),
+        map: Some("room".into()),
+        tick: 0,
+        players: 1,
+        input: None,
+        pose: pose.map(|(name, value)| (name.into(), value.into())),
+        look: look.then(|| "looks/off.look.toml".into()),
+        pending: true,
+    };
+    let camera = json!({"eye": [9.0, 3.5, 1.6], "yaw_deg": 270.0, "pitch_deg": -15.0});
+    let posed = json!({
+        "kind": "first-person", "camera_from": "pose",
+        "pose": {"eye": [9.0, 3.5, 1.6], "yaw_deg": -90.0, "pitch_deg": -15.0},
+        "look": {"fog": false}, "camera": camera,
+    });
+    let shot = room(Some(("ledge", "9,3.5,1.6,-90,-15")), true);
+    let view = view_of(&shot, &report("room", posed.clone())).unwrap();
+    assert_eq!(
+        view,
+        json!({
+            "name": "room-x", "map": "room", "kind": "first-person", "pose": "ledge",
+            "look": "looks/off.look.toml", "camera_from": "pose", "camera": camera,
+        })
+    );
+    let game = json!({
+        "kind": "first-person", "camera_from": "game", "pose": null, "look": null,
+        "camera": camera,
+    });
+    assert!(view_of(&room(None, false), &report("room", game.clone())).is_ok());
+    let top = json!({"kind": "top-down", "camera_from": "game", "pose": null, "look": null,
+        "camera": null});
+    let dots = Shot {
+        map: None,
+        ..room(None, false)
+    };
+    assert_eq!(
+        view_of(&dots, &report("dots", top)).unwrap()["kind"],
+        "top-down"
+    );
+    // What the probe drew must be what the shot asked for.
+    // The camera drawn may differ from the pose by the binary angle's
+    // rounding, and reads its angles from 0 to 360 or signed.
+    let mut rounded = posed.clone();
+    rounded["camera"]["pitch_deg"] = json!(-15.000_000_027_939_677);
+    rounded["camera"]["yaw_deg"] = json!(-90.000_000_01);
+    assert!(view_of(&shot, &report("room", rounded)).is_ok());
+    let mut other_pose = posed.clone();
+    other_pose["pose"]["yaw_deg"] = json!(-89.0);
+    // A capture that echoes the pose but draws the game's camera.
+    let mut ignored = posed.clone();
+    ignored["camera"]["eye"] = json!([1.5, 4.5, 1.6]);
+    let mut turned = posed.clone();
+    turned["camera"]["yaw_deg"] = json!(270.001);
+    let mut tilted = posed.clone();
+    tilted["camera"]["pitch_deg"] = json!(0.0);
+    let mut none = posed.clone();
+    none["camera"] = json!(null);
+    for (shot, map, view) in [
+        (shot.clone(), "room", other_pose),
+        (shot.clone(), "room", ignored),
+        (shot.clone(), "room", turned),
+        (shot.clone(), "room", tilted),
+        (shot.clone(), "room", none),
+        (shot.clone(), "dots", posed.clone()),
+        (shot.clone(), "room", game.clone()),
+        (room(None, true), "room", game.clone()),
+        (room(None, false), "room", posed),
+        (room(None, false), "room", json!(null)),
+        (room(None, false), "room", json!({"kind": "isometric"})),
+    ] {
+        let err = view_of(&shot, &report(map, view.clone())).unwrap_err();
+        assert!(
+            err.starts_with("room-x: [E-GOLDEN] the probe drew"),
+            "{view}: {err}"
+        );
+    }
+    // `shots.json` lists every view read, in the shots' order.
+    let (refs, candidates) = scratch("views");
+    let png = png_of(&picture(SIZE.0, SIZE.1, 10));
+    let mut first = marked("room-x", png.clone());
+    first.view = view;
+    let shots = [first, marked("room-y", png)];
+    let failures = judge(
+        &shots,
+        &pinned_config(),
+        Mode::Exact,
+        (&refs, false),
+        &candidates,
+    );
+    assert!(failures.is_empty(), "{failures:?}");
+    let summary = summary(&candidates);
+    assert_eq!(summary["views"].as_array().map(Vec::len), Some(1));
+    assert_eq!(summary["views"][0]["pose"], "ledge");
+    assert_eq!(summary["files_read"], json!({"shots": 1}));
+}
