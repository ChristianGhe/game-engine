+#[test]
+fn a_shots_own_flip_limits_replace_flips_for_it_alone() {
+    let (refs, candidates) = scratch("per-shot");
+    let golden = png_of(&picture(SIZE.0, SIZE.1, 10));
+    let nudged = png_of(&picture(SIZE.0, SIZE.1, 14));
+    for name in ["a-shot", "b-shot"] {
+        std::fs::write(refs.join(format!("{name}.png")), &golden).unwrap();
+    }
+    // `[flip]` passes nothing that differs; `b-shot` allows anything.
+    let strict = "version = 1\n[flip]\nmean = 0.0\np99 = 0.0\np999 = 0.0\n";
+    let own = "[flip.b-shot]\nmean = 1.0\np99 = 1.0\np999 = 1.0\n";
+    std::fs::write(refs.join("thresholds.toml"), format!("{strict}{own}")).unwrap();
+    let limits = read_limits(&refs).unwrap().unwrap();
+    let all = Thresholds {
+        mean: 0.0,
+        p99: 0.0,
+        p999: 0.0,
+    };
+    assert_eq!(limits.for_shot("a-shot"), (all, false));
+    assert!(limits.for_shot("b-shot").1, "its own");
+    assert_eq!(read_thresholds(&refs), Ok(Some(all)), "[flip]'s alone");
+    let a = check("a-shot", &nudged, Mode::Flip, &refs, &candidates);
+    assert_eq!(a.status, Status::Fail, "{a:?}");
+    assert!(a.message.contains("the limits ([flip]) are"), "{a:?}");
+    let b = check("b-shot", &nudged, Mode::Flip, &refs, &candidates);
+    assert_eq!(b.status, Status::Pass, "{b:?}");
+    // Its own limits hold it too.
+    let tight = format!("{strict}[flip.b-shot]\nmean = 0.0\np99 = 1.0\np999 = 1.0\n");
+    std::fs::write(refs.join("thresholds.toml"), tight).unwrap();
+    let b = check("b-shot", &nudged, Mode::Flip, &refs, &candidates);
+    assert_eq!(b.status, Status::Fail, "{b:?}");
+    assert!(
+        b.message.contains("the limits ([flip.b-shot]) are mean 0,"),
+        "{b:?}"
+    );
+
+    // Limits no shot has fail, as a golden no shot names does.
+    let stale = format!("{THRESHOLDS}[flip.gone]\nmean = 0.5\np99 = 0.5\np999 = 0.5\n");
+    std::fs::write(refs.join("thresholds.toml"), stale).unwrap();
+    let config = pinned_config();
+    let shots = [taken("a-shot", golden.clone()), taken("b-shot", golden)];
+    let failures = judge(&shots, &config, Mode::Exact, (&refs, false), &candidates);
+    assert_eq!(failures.len(), 1, "{failures:?}");
+    assert!(failures[0].starts_with("gone: [E-GOLDEN]"), "{failures:?}");
+    assert!(
+        failures[0].ends_with("[flip.gone] names no shot"),
+        "{failures:?}"
+    );
+    assert_eq!(
+        summary(&candidates)["files_read"],
+        json!({"shots": 1, "thresholds": 1})
+    );
+
+    // As strict as `[flip]`.
+    for bad in [
+        format!("{THRESHOLDS}[flip.a-shot]\nmean = 0.5\np99 = 0.5\n"),
+        format!("{THRESHOLDS}[flip.a-shot]\nmean = 0.5\np99 = 0.5\np999 = 2.0\n"),
+        format!("{THRESHOLDS}[flip.a-shot]\nmean = 0.5\np99 = 0.5\np999 = 0.5\np95 = 0\n"),
+        format!("{THRESHOLDS}[flip.A_shot]\nmean = 0.5\np99 = 0.5\np999 = 0.5\n"),
+        THRESHOLDS.replace("p999 = 0.5", "p999 = 0.5\np95 = 0.1"),
+        THRESHOLDS.replace("p999 = 0.5", "p999 = 0.5\nshot = \"a\""),
+    ] {
+        std::fs::write(refs.join("thresholds.toml"), &bad).unwrap();
+        let err = read_limits(&refs).unwrap_err();
+        let named = err.starts_with("[E-GOLDEN]") && err.contains("thresholds.toml");
+        assert!(named, "{bad}: {err}");
+    }
+}
