+//! `cargo xtask bench [--base REV]` and `cargo xtask ci --job bench` (rung 2,
+//! decision 14 and criterion 15): gungraun's instruction counts for the
+//! pushed head and for the push's base, built and run on one runner, and
+//! compared benchmark by benchmark. There is no stored baseline.
+//!
+//! **The design limit.** The gate is a check that catches regressions on
+//! agent branches. It is not a security boundary against code that runs in
+//! the same job: the head's benchmarks run here with the job's rights. The
+//! owner's push to `main` (ADR-0018) remains the gate. What the verdict
+//! trusts is still read before any of the head's code runs (`Trusted`).
+//!
+//! - **The base** (`bench_git.rs`): `--base REV` if given. Off `main`, the
+//!   merge base of `HEAD` with `origin/main` (or `main`): the push's
+//!   `before` is the branch's own previous tip, so a second push could hide
+//!   the first one's regression. On `main`, `ENG_BENCH_BASE`, which the
+//!   workflow sets to the push's `before`, if it is an ancestor of `HEAD`;
+//!   else (all zeros, missing, a force-push) that merge base. Never `HEAD`'s
+//!   parent. A base that is `HEAD`, with no change in the working tree,
+//!   leaves nothing to compare: `base` and `bench` are pending.
+//! - **Each is built** in its own target directory, `target/bench/head` or
+//!   `/base` (cargo hashes a workspace's crates by their path inside it, so
+//!   two checkouts sharing one take each other's binaries for fresh). The
+//!   head is the working tree, the base a detached worktree at
+//!   `target/bench/tree`, removed afterwards. Each runs `cargo bench -p
+//!   eng-bench` with `GUNGRAUN_OUTPUT_FORMAT=json`: one JSON summary per
+//!   benchmark on stdout, whose callgrind `Ir` is the count, named by its
+//!   gungraun `module_path` and `id` (`sim::tick::room::walk`). A base
+//!   without `crates/eng-bench/benches/` has no counts; a tree that has them
+//!   and prints no summary fails.
+//! - **The verdict** (the `bench` step): a head count more than 5% above the
+//!   base's (`head * 100 > base * 105`, in integers) fails, and so does a
+//!   benchmark the base has and the head lacks, unless the push adds a
+//!   performance ADR that names it: a `docs/adr/NNNN-*.md` that
+//!   `git diff --diff-filter=A <base> HEAD` lists as added, whose status
+//!   line reads `- **Status:** Accepted` and whose text holds the name in
+//!   backticks (`` `sim::tick::room::walk` ``). Both are read from text an
+//!   agent cannot have written (`bench_adr.rs`): the pushed file on a run for
+//!   `main` (CI's `GITHUB_REF`, or the branch checked out), which only the
+//!   owner pushes (ADR-0018); elsewhere `origin/main`'s copy. Off `main`, an
+//!   ADR whose pushed text alone excuses makes the step pending, excused
+//!   once the owner accepts it on `main`; one not marked Accepted fails,
+//!   saying so. Each excuse prints a `[W-BENCH-EXCUSED]` line. A benchmark
+//!   new in the head passes. A base that does not build or run fails.
+//! - **Pending** where it cannot run: off Linux, or without valgrind or
+//!   `gungraun-runner` 0.20.0, which must equal eng-bench's gungraun. On CI
+//!   a missing tool on Linux fails instead, since the workflow installs both.
+//!
+//! The report (`target/ci/reports/bench-<host>.json`) adds a `bench` key
+//! with both commits and every benchmark's counts and verdict.
+
+use std::path::Path;
+use std::process::Command;
+use std::time::Instant;
+
+use serde_json::{Map, Value, json};
+
+use crate::bench_adr::{Adr, Excuse, accepted, excuse, push_adrs};
+use crate::bench_git::{self, ADRS};
+use crate::util::{self, Done, Steps};
+use crate::{ci, ci_report};
+
+/// The steps, in order: what each tree counts, then the comparison.
+pub const STEPS: [&str; 3] = ["head", "base", "bench"];
+/// Over this much more than the base fails (decision 14).
+pub const LIMIT_PERCENT: u64 = 5;
+/// `gungraun-runner` must be the version of the library eng-bench uses.
+pub const RUNNER_VERSION: &str = "0.20.0";
+const PACKAGE: &str = "eng-bench";
+const BENCHES: &str = "crates/eng-bench/benches";
+const USAGE: &str = "usage: cargo xtask bench [--base REV]";
+const SAME: &str = "nothing to compare: the base is HEAD";
+
+/// `cargo xtask bench [--base REV]`'s arguments: the base, if given.
+pub fn parse(args: &[&str]) -> Result<Option<String>, String> {
+    match args {
+        [] => Ok(None),
+        ["--base", rev] if !rev.starts_with('-') => Ok(Some((*rev).to_string())),
+        _ => Err(USAGE.into()),
+    }
+}
+
+/// `cargo xtask bench`: the bench job's steps and report.
+pub fn run(root: &Path, base: Option<&str>) -> Result<String, String> {
+    let started = Instant::now();
+    let mut steps = Steps::default();
+    let extra = steps_into(root, base, &mut steps);
+    ci_report::finish(root, "bench", steps, started, extra)
+}
+
+/// A benchmark's instruction count.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Count {
+    pub name: String,
+    pub instructions: u64,
+}
+
+/// Why the job cannot run here, if it cannot: `os` is
+/// `std::env::consts::OS`, the tools' `--version` lines as found.
+pub fn missing(os: &str, valgrind: Option<&str>, runner: Option<&str>) -> Option<String> {
+    if os != "linux" {
+        return Some(format!(
+            "instruction counts need valgrind's callgrind, on Linux; this is {os}"
+        ));
+    }
+    if valgrind.is_none() {
+        return Some("valgrind is not installed (apt-get install valgrind)".into());
+    }
+    let install = format!("cargo install --locked gungraun-runner@{RUNNER_VERSION}");
+    match runner {
+        None => Some(format!("gungraun-runner is not installed ({install})")),
+        Some(line) if !line.split_whitespace().any(|w| w == RUNNER_VERSION) => Some(format!(
+            "eng-bench's gungraun needs gungraun-runner {RUNNER_VERSION}, not {:?} ({install} --force)",
+            line.trim()
+        )),
+        Some(_) => None,
+    }
+}
+
+/// The first line a tool prints for `--version`, if it runs.
+fn tool_version(program: &str) -> Option<String> {
+    let out = Command::new(program).arg("--version").output().ok()?;
+    let text = String::from_utf8_lossy(&out.stdout);
+    out.status
+        .success()
+        .then(|| text.lines().next().unwrap_or_default().to_string())
+}
+
+/// The counts in `cargo bench`'s stdout with `GUNGRAUN_OUTPUT_FORMAT=json`:
+/// one summary per line; lines that are not a summary are skipped.
+pub fn parse_counts(stdout: &str) -> Result<Vec<Count>, String> {
+    let mut counts: Vec<Count> = Vec::new();
+    for line in stdout.lines().map(str::trim).filter(|l| l.starts_with('{')) {
+        let Ok(summary) = serde_json::from_str::<Value>(line) else {
+            continue;
+        };
+        let Some(path) = summary["module_path"].as_str() else {
+            continue;
+        };
+        let name = match summary["id"].as_str() {
+            Some(id) => format!("{path}::{id}"),
+            None => path.to_string(),
+        };
+        let instructions = instructions(&summary)
+            .ok_or_else(|| format!("[E-BENCH] {name}: no callgrind Ir in its summary"))?;
+        if counts.iter().any(|c| c.name == name) {
+            return Err(format!("[E-BENCH] two benchmarks are named {name}"));
+        }
+        counts.push(Count { name, instructions });
+    }
+    Ok(counts)
+}
+
+/// This run's callgrind `Ir` in a summary (schema version 7): the Callgrind
+/// profile's `data.total.metrics.Ir.values.new`. gungraun's own comparison
+/// with its previous run (`old`) is not used.
+fn instructions(summary: &Value) -> Option<u64> {
+    let profiles = summary["profiles"].as_array()?;
+    let callgrind = profiles.iter().find(|p| p["tool"] == "Callgrind")?;
+    callgrind["data"]["total"]["metrics"]["Ir"]["values"]["new"].as_u64()
+}
+
+/// One benchmark compared.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Row {
+    pub name: String,
+    pub head: Option<u64>,
+    pub base: Option<u64>,
+    /// Over the limit, or gone from the head; with what the ADRs say.
+    pub flagged: bool,
+    pub excuse: Option<Excuse>,
+}
+
+impl Row {
+    fn verdict(&self) -> String {
+        let why = match (self.head, self.base) {
+            (Some(_), None) => return "new".into(),
+            (None, _) => "removed",
+            (Some(_), Some(_)) if self.flagged => "over",
+            (Some(_), Some(_)) => return "within".into(),
+        };
+        match &self.excuse {
+            Some(Excuse::Accepted(adr)) => format!("{why}, excused by {adr}"),
+            Some(Excuse::Unconfirmed(adr)) => {
+                format!("{why}, excused once the owner accepts {adr} on main")
+            }
+            Some(Excuse::NotAccepted(adr)) => {
+                format!("{why}; {adr} names it but is not Accepted: the owner must accept it")
+            }
+            None => why.into(),
+        }
+    }
+
+    fn change_percent(&self) -> Option<f64> {
+        let (head, base) = (self.head? as f64, self.base? as f64);
+        (base > 0.0).then(|| (head - base) / base * 100.0)
+    }
+
+    fn change(&self) -> String {
+        match (self.head, self.change_percent()) {
+            (None, _) => "removed".into(),
+            (Some(_), Some(p)) => format!("{p:+.2}%"),
+            (Some(_), None) => "new".into(),
+        }
+    }
+
+    fn failed(&self) -> bool {
+        let excused = matches!(
+            self.excuse,
+            Some(Excuse::Accepted(_) | Excuse::Unconfirmed(_))
+        );
+        self.flagged && !excused
+    }
+
+    fn line(&self) -> String {
+        let count = |c: Option<u64>| c.map_or_else(|| "-".into(), |c| c.to_string());
+        let change = match self.change_percent() {
+            Some(p) => format!(" ({p:+.2}%)"),
+            None => String::new(),
+        };
+        let (base, head) = (count(self.base), count(self.head));
+        format!(
+            "{}: {base} -> {head}{change}, {}",
+            self.name,
+            self.verdict()
+        )
+    }
+}
+
+/// Whether `head` is more than [`LIMIT_PERCENT`] over `base`.
+pub fn over_limit(head: u64, base: u64) -> bool {
+    u128::from(head) * 100 > u128::from(base) * u128::from(100 + LIMIT_PERCENT)
+}
+
+/// Compares the head's counts with the base's, head order first, then what
+/// only the base has; a flagged benchmark gets what `adrs` say for it.
+pub fn compare(head: &[Count], base: &[Count], adrs: &[Adr]) -> Vec<Row> {
+    let find =
+        |list: &[Count], name: &str| list.iter().find(|c| c.name == name).map(|c| c.instructions);
+    let row = |name: &str, head: Option<u64>, base: Option<u64>| {
+        let flagged = match (head, base) {
+            (Some(h), Some(b)) => over_limit(h, b),
+            (None, Some(_)) => true,
+            _ => false,
+        };
+        let excuse = if flagged { excuse(adrs, name) } else { None };
+        Row {
+            name: name.to_string(),
+            head,
+            base,
+            flagged,
+            excuse,
+        }
+    };
+    let mut rows: Vec<Row> = head
+        .iter()
+        .map(|c| row(&c.name, Some(c.instructions), find(base, &c.name)))
+        .collect();
+    rows.extend(
+        base.iter()
+            .filter(|c| find(head, &c.name).is_none())
+            .map(|c| row(&c.name, None, Some(c.instructions))),
+    );
+    rows
+}
+
+/// A `[W-BENCH-EXCUSED]` line for each benchmark an ADR excuses, or will
+/// once the owner accepts it on `main`.
+pub fn warnings(rows: &[Row]) -> Vec<String> {
+    rows.iter()
+        .filter(|r| r.flagged)
+        .filter_map(|r| {
+            let by = match r.excuse.as_ref()? {
+                Excuse::Accepted(adr) => format!("by {adr}"),
+                Excuse::Unconfirmed(adr) => format!("once the owner accepts {adr} on main"),
+                Excuse::NotAccepted(_) => return None,
+            };
+            Some(format!(
+                "[W-BENCH-EXCUSED] {} {} excused {by}",
+                r.name,
+                r.change()
+            ))
+        })
+        .collect()
+}
+
+/// The `bench` step's verdict over `rows`, the excuses last: failed if any
+/// flagged benchmark has no excuse, pending if one waits for the owner's
+/// acceptance on `main`, else passed.
+pub fn verdict(rows: &[Row]) -> Result<Done, String> {
+    let mut lines: Vec<String> = rows.iter().map(Row::line).collect();
+    lines.extend(warnings(rows));
+    let names = |pick: fn(&Row) -> bool| -> Vec<&str> {
+        rows.iter()
+            .filter(|r| pick(r))
+            .map(|r| r.name.as_str())
+            .collect()
+    };
+    let failed = names(Row::failed);
+    let waiting = names(|r| r.flagged && matches!(r.excuse, Some(Excuse::Unconfirmed(_))));
+    let (n, lines) = (rows.len(), lines.join("\n"));
+    if !failed.is_empty() {
+        return Err(format!(
+            "[E-BENCH] more than {LIMIT_PERCENT}% over the base, or gone from the head: {}. \
+             A performance ADR added in this push ({ADRS}NNNN-*.md) that names the \
+             benchmark in backticks, Accepted by the owner on main, lets it pass\n{lines}",
+            failed.join(", ")
+        ));
+    }
+    if !waiting.is_empty() {
+        return Ok(Done::Pending(format!(
+            "{n} benchmarks; {} excused once the owner accepts their ADR on main\n{lines}",
+            waiting.join(", ")
+        )));
+    }
+    Ok(Done::Pass(format!(
+        "{n} benchmarks, none more than {LIMIT_PERCENT}% over the base unexcused\n{lines}"
+    )))
+}
+
+/// `cargo bench -p eng-bench` in `tree`, built in `target/bench/<label>`;
+/// a run that prints no summary fails.
+fn measure(root: &Path, tree: &Path, label: &str) -> Result<Vec<Count>, String> {
+    let target = root.join("target/bench").join(label);
+    let mut cmd = ci::cargo_command(tree, &["bench", "-p", PACKAGE]);
+    cmd.env("CARGO_TARGET_DIR", &target)
+        .env("GUNGRAUN_HOME", target.join("gungraun"))
+        .env("GUNGRAUN_OUTPUT_FORMAT", "json");
+    let stdout = util::run_quiet(root, &format!("bench-{label}"), &mut cmd)?;
+    let counts = parse_counts(&stdout)?;
+    if counts.is_empty() {
+        return Err(format!(
+            "[E-BENCH] the {label}'s `cargo bench -p {PACKAGE}` printed no summary"
+        ));
+    }
+    Ok(counts)
+}
+
+/// The base's counts: `None` if it has no benchmarks.
+fn measure_base(root: &Path, sha: &str) -> Result<Option<Vec<Count>>, String> {
+    bench_git::in_worktree(root, sha, |tree| {
+        if tree.join(BENCHES).is_dir() {
+            measure(root, tree, "base").map(Some)
+        } else {
+            Ok(None)
+        }
+    })
+}
+
+fn short(sha: &str) -> &str {
+    sha.get(..12).unwrap_or(sha)
+}
+
+fn listed(counts: &[Count]) -> String {
+    let lines: Vec<String> = counts
+        .iter()
+        .map(|c| format!("{}: {}", c.name, c.instructions))
+        .collect();
+    format!("{} benchmarks\n{}", counts.len(), lines.join("\n"))
+}
+
+/// Runs the job's three steps into `steps` and returns the report's `bench`
+/// key.
+pub fn steps_into(root: &Path, base_arg: Option<&str>, steps: &mut Steps) -> Map<String, Value> {
+    let mut extra = Map::new();
+    let valgrind = tool_version("valgrind");
+    let runner = tool_version("gungraun-runner");
+    if let Some(why) = missing(std::env::consts::OS, valgrind.as_deref(), runner.as_deref()) {
+        let fail = util::on_ci() && std::env::consts::OS == "linux";
+        for name in STEPS {
+            steps.run_judged(name, || {
+                if fail {
+                    Err(format!("[E-BENCH] {why}; the workflow installs it"))
+                } else {
+                    Ok(Done::Pending(why.clone()))
+                }
+            });
+        }
+        extra.insert("bench".into(), json!({ "pending": why }));
+        return extra;
+    }
+    // Everything the verdict trusts, read before any of the head's code runs.
+    let t = trusted(root, base_arg);
+    let mut head = None;
+    steps.run("head", || {
+        let counts = measure(root, root, "head")?;
+        let detail = format!(
+            "head {} (the working tree): {}",
+            short(&t.head),
+            listed(&counts)
+        );
+        head = Some(counts);
+        Ok(detail)
+    });
+    let mut base = None;
+    steps.run_judged("base", || {
+        let (sha, from) = t.base.clone()?;
+        if t.same {
+            return Ok(Done::Pending(format!("{SAME} ({from})")));
+        }
+        let counts = measure_base(root, &sha)?;
+        let detail = match &counts {
+            Some(counts) => format!("base {} ({from}): {}", short(&sha), listed(counts)),
+            None => format!("base {} ({from}) has no {BENCHES}", short(&sha)),
+        };
+        base = Some(counts);
+        Ok(Done::Pass(detail))
+    });
+    let mut rows = Vec::new();
+    steps.run_judged("bench", || {
+        if t.same {
+            return Ok(Done::Pending(SAME.into()));
+        }
+        let head = head.as_ref().ok_or("[E-BENCH] the head was not measured")?;
+        let counts = base.as_ref().ok_or("[E-BENCH] the base was not measured")?;
+        let adrs = t.adrs.as_ref().map_err(Clone::clone)?;
+        rows = compare(head, counts.as_deref().unwrap_or_default(), adrs);
+        let annotate = std::env::var_os("GITHUB_ACTIONS").is_some();
+        for line in warnings(&rows) {
+            println!("{}{line}", if annotate { "::warning::" } else { "" });
+        }
+        verdict(&rows)
+    });
+    let (base_sha, base_from) = t.base.clone().unwrap_or_default();
+    let benchmarks: Vec<Value> = rows
+        .iter()
+        .map(|r| {
+            json!({
+                "name": r.name, "head": r.head, "base": r.base,
+                "change_percent": r.change_percent(), "verdict": r.verdict(),
+            })
+        })
+        .collect();
+    let adrs: Vec<Value> = (t.adrs.as_deref().unwrap_or_default().iter())
+        .map(|a| {
+            let owners = a.owners.as_deref().is_some_and(accepted);
+            json!({ "path": a.path, "accepted": accepted(&a.text), "owners_accepted": owners })
+        })
+        .collect();
+    extra.insert(
+        "bench".into(),
+        json!({
+            "head": t.head, "base": base_sha, "base_from": base_from, "same": t.same,
+            "on_main": t.on_main, "origin_main": t.upstream,
+            "limit_percent": LIMIT_PERCENT, "added_adrs": adrs, "benchmarks": benchmarks,
+        }),
+    );
+    extra
+}
+
+/// What the verdict trusts, read before any of the head's code runs, since
+/// that code could rewrite refs and files: `HEAD` and `origin/main` as
+/// SHAs, whether the run is for `main`, the base, and the added ADRs with
+/// their `origin/main` copies read by that SHA.
+struct Trusted {
+    head: String,
+    on_main: bool,
+    upstream: Option<String>,
+    base: Result<(String, String), String>,
+    same: bool,
+    adrs: Result<Vec<Adr>, String>,
+}
+
+fn trusted(root: &Path, base_arg: Option<&str>) -> Trusted {
+    let head = bench_git::commit(root, "HEAD").unwrap_or_default();
+    let github_ref = std::env::var("GITHUB_REF").ok();
+    let on_main = bench_git::on_main(root, github_ref.as_deref());
+    let upstream = bench_git::commit(root, "origin/main").ok();
+    let event = std::env::var("ENG_BENCH_BASE").ok();
+    let request = bench_git::request(base_arg, event.as_deref());
+    let base = bench_git::resolve(root, &request, on_main);
+    let same = base.as_ref().is_ok_and(|(sha, _)| *sha == head) && !bench_git::dirty(root);
+    let adrs = match &base {
+        Ok((sha, _)) => push_adrs(root, sha, &head, on_main, upstream.as_deref()),
+        Err(e) => Err(e.clone()),
+    };
+    Trusted {
+        head,
+        on_main,
+        upstream,
+        base,
+        same,
+        adrs,
+    }
+}
+
