index 0000000000000000000000000000000000000000..ad2d6b09afac9c7f389d4597d6a086651c9b6603
--- /dev/null
+++ b/xtask/src/bench_git.rs
@@ -0,0 +1,182 @@
+//! The bench job's git side (`bench.rs`): which commit is the base, the
+//! ADRs the push adds, and the base's checkout.
+
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+/// Where performance ADRs live: `docs/adr/NNNN-*.md`.
+pub const ADRS: &str = "docs/adr/";
+
+/// Where the base comes from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Request {
+    Given(String),
+    Event(String),
+    MergeBase,
+}
+
+/// Which base to look for: `--base`, else the push's `before`, unless it is
+/// empty or all zeros (a new branch), else a merge base with `main`.
+pub fn request(arg: Option<&str>, event: Option<&str>) -> Request {
+    if let Some(rev) = arg {
+        return Request::Given(rev.to_string());
+    }
+    match event.map(str::trim) {
+        Some(sha) if !sha.is_empty() && !sha.bytes().all(|b| b == b'0') => {
+            Request::Event(sha.to_string())
+        }
+        _ => Request::MergeBase,
+    }
+}
+
+/// `git <args>` in `dir`: its stdout as it is, or its stderr.
+fn raw(dir: &Path, args: &[&str]) -> Result<String, String> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(args)
+        .output()
+        .map_err(|e| format!("git: {e}"))?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+    } else {
+        Err(format!(
+            "git {}: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&out.stderr).trim()
+        ))
+    }
+}
+
+/// `git <args>` in `dir`: its trimmed stdout, or its stderr.
+pub fn git(dir: &Path, args: &[&str]) -> Result<String, String> {
+    raw(dir, args).map(|s| s.trim().to_string())
+}
+
+/// The commit `rev` names, as a full SHA.
+pub fn commit(dir: &Path, rev: &str) -> Result<String, String> {
+    let spec = format!("{rev}^{{commit}}");
+    git(dir, &["rev-parse", "--verify", "--quiet", &spec])
+}
+
+/// `path`'s bytes in the commit `sha`'s tree, exactly, if it has the file.
+pub fn blob(root: &Path, sha: &str, path: &str) -> Option<String> {
+    raw(root, &["cat-file", "-p", &format!("{sha}:{path}")]).ok()
+}
+
+/// Whether this run is for `main`, which only the owner pushes (ADR-0018):
+/// `github_ref` (CI's `GITHUB_REF`) is `refs/heads/main`, or, off CI, the
+/// branch checked out is `main`.
+pub fn on_main(root: &Path, github_ref: Option<&str>) -> bool {
+    match github_ref {
+        Some(r) => r == "refs/heads/main",
+        None => {
+            git(root, &["symbolic-ref", "--quiet", "--short", "HEAD"]).is_ok_and(|b| b == "main")
+        }
+    }
+}
+
+/// Whether tracked files differ from `HEAD` in the working tree at `root`.
+pub fn dirty(root: &Path) -> bool {
+    !git(root, &["status", "--porcelain", "--untracked-files=no"]).is_ok_and(|s| s.is_empty())
+}
+
+/// The base commit for `request`, and where it came from. Off `main`
+/// (`on_main` false) the push's `before` is the branch's own previous tip,
+/// so the base is the merge base of `HEAD` with `origin/main`: a second push
+/// cannot hide a regression the first brought. On `main`, a `before` the
+/// clone lacks, or that is not an ancestor of `HEAD` (a force-push), gives
+/// way to that merge base too. `--base` is taken as given.
+pub fn resolve(root: &Path, request: &Request, on_main: bool) -> Result<(String, String), String> {
+    let merge_base = |note: &str| -> Result<(String, String), String> {
+        let main = ["origin/main", "main"]
+            .into_iter()
+            .find(|m| commit(root, m).is_ok())
+            .ok_or("[E-BENCH] no origin/main or main to take a merge base with; pass --base REV")?;
+        let sha = git(root, &["merge-base", "HEAD", main])?;
+        Ok((sha, format!("{note}the merge base of HEAD with {main}")))
+    };
+    match request {
+        Request::Given(rev) => commit(root, rev)
+            .map(|sha| (sha, format!("--base {rev}")))
+            .map_err(|_| format!("[E-BENCH] --base {rev} is not a commit here")),
+        Request::Event(_) if !on_main => merge_base("off main, not the push's before: "),
+        Request::Event(sha) => match commit(root, sha) {
+            Ok(full) if git(root, &["merge-base", "--is-ancestor", &full, "HEAD"]).is_ok() => {
+                Ok((full, "the push's before (ENG_BENCH_BASE)".into()))
+            }
+            Ok(_) => merge_base(&format!("{sha} is not an ancestor of HEAD; ")),
+            Err(_) => merge_base(&format!("{sha} is not in this clone; ")),
+        },
+        Request::MergeBase => merge_base(""),
+    }
+}
+
+/// Whether `path` names an ADR: `docs/adr/NNNN-<title>.md`.
+pub fn is_adr_file(path: &str) -> bool {
+    let Some(name) = path.strip_prefix(ADRS) else {
+        return false;
+    };
+    let b = name.as_bytes();
+    !name.contains('/')
+        && name.len() > "0000-.md".len()
+        && b[..4].iter().all(u8::is_ascii_digit)
+        && b[4] == b'-'
+        && name.ends_with(".md")
+}
+
+/// The ADRs (`docs/adr/NNNN-*.md`) added between the commits `base` and
+/// `head`, absent from `base`, each with its bytes at `head`. Other files
+/// there do not count, nor a renamed or changed ADR.
+pub fn added_adrs(root: &Path, base: &str, head: &str) -> Result<Vec<(String, String)>, String> {
+    let names = git(
+        root,
+        &[
+            "diff",
+            "--name-only",
+            "--diff-filter=A",
+            "--find-renames",
+            "-z",
+            base,
+            head,
+            "--",
+            ADRS,
+        ],
+    )?;
+    names
+        .split('\0')
+        .filter(|path| is_adr_file(path) && blob(root, base, path).is_none())
+        .map(|path| {
+            let text =
+                blob(root, head, path).ok_or(format!("[E-BENCH] {head}:{path} unreadable"))?;
+            Ok((path.to_string(), text))
+        })
+        .collect()
+}
+
+/// Runs `f` in a detached worktree of `sha` at `target/bench/tree`, removed
+/// again afterwards. Its checkout runs no hooks.
+pub fn in_worktree<T>(
+    root: &Path,
+    sha: &str,
+    f: impl FnOnce(&Path) -> Result<T, String>,
+) -> Result<T, String> {
+    let dir = root.join("target/bench/tree");
+    let path = dir.to_string_lossy().into_owned();
+    let _ = git(root, &["worktree", "remove", "--force", &path]);
+    let _ = fs::remove_dir_all(&dir);
+    git(root, &["worktree", "prune"])?;
+    let hooks = "core.hooksPath=/dev/null";
+    let add = [
+        "-c", hooks, "worktree", "add", "--detach", "--force", &path, sha,
+    ];
+    git(root, &add)?;
+    let result = f(&dir);
+    let _ = git(root, &["worktree", "remove", "--force", &path]);
+    result
+}
+
+#[cfg(test)]
+#[path = "bench_git_tests.rs"]
+mod tests;
