@@ -0,0 +1,266 @@
+//! The bench job's git side (`bench_git.rs`): which files are ADRs, the
+//! choice of base, the ADRs a push adds and whose acceptance counts
+//! (`bench_adr.rs`), from temporary repositories.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+use super::*;
+use crate::bench_adr::{Excuse, excuse, names_benchmark, push_adrs};
+
+/// An ADR's text, with `status`, naming each of `named` in backticks.
+fn adr_text(status: &str, named: &[&str]) -> String {
+    let names: Vec<String> = named.iter().map(|n| format!("`{n}`")).collect();
+    format!(
+        "# ADR-0099: Slower\n\n- **Status:** {status}\n- **Date:** 2026-11-07\n\nSlower: {}.\n",
+        names.join(", ")
+    )
+}
+#[test]
+fn only_numbered_markdown_files_in_docs_adr_are_adrs() {
+    for yes in ["docs/adr/0025-perf.md", "docs/adr/0100-a-b.md"] {
+        assert!(is_adr_file(yes), "{yes}");
+    }
+    for no in [
+        "docs/adr/0025-perf.txt",
+        "docs/adr/README.md",
+        "docs/adr/025-perf.md",
+        "docs/adr/0025perf.md",
+        "docs/adr/0025-.md",
+        "docs/adr/old/0025-perf.md",
+        "docs/0025-perf.md",
+        "docs/adr/",
+    ] {
+        assert!(!is_adr_file(no), "{no}");
+    }
+}
+
+#[test]
+fn the_base_is_the_argument_then_the_push_then_a_merge_base() {
+    let sha = "0123456789abcdef0123456789abcdef01234567";
+    let zeros = "0000000000000000000000000000000000000000";
+    assert_eq!(request(Some("v1"), Some(sha)), Request::Given("v1".into()));
+    assert_eq!(request(None, Some(sha)), Request::Event(sha.into()));
+    assert_eq!(
+        request(None, Some(&format!(" {sha}\n"))),
+        Request::Event(sha.into())
+    );
+    for new_branch in [Some(zeros), Some(""), Some("  "), None] {
+        assert_eq!(
+            request(None, new_branch),
+            Request::MergeBase,
+            "{new_branch:?}"
+        );
+    }
+}
+
+/// How an added, Accepted ADR naming `a::slow` is judged, from a
+/// repository: on a push to `main`; off it, when `origin/main` already has
+/// it, byte for byte; when the push marked it Accepted itself; when
+/// `origin/main` has it Accepted but the push edited it to name `a::slow`;
+/// and when the pushed file differs from `origin/main`'s by one byte.
+#[test]
+fn only_the_owners_acceptance_excuses() {
+    let dir = repo();
+    let fork = git(&dir, &["rev-parse", "HEAD"]);
+    let slow = adr_text("Accepted", &["a::slow"]);
+    // `origin/main` has 0096 and 0098 as the branch will, 0097 naming
+    // `a::other` only.
+    commit(&dir, "docs/adr/0096-spaced.md", &slow);
+    let other = adr_text("Accepted", &["a::other"]);
+    commit(&dir, "docs/adr/0097-edited.md", &other);
+    commit(&dir, "docs/adr/0098-upstream.md", &slow);
+    let upstream = git(&dir, &["rev-parse", "HEAD"]);
+    // The agent branch adds all four, each naming `a::slow`.
+    git(&dir, &["checkout", "-q", "-b", "agent/x", &fork]);
+    commit(&dir, "docs/adr/0096-spaced.md", &format!("{slow}\n"));
+    commit(&dir, "docs/adr/0097-edited.md", &slow);
+    commit(&dir, "docs/adr/0098-upstream.md", &slow);
+    let head = commit(&dir, "docs/adr/0099-mine.md", &slow);
+    let judged = |on_main: bool| -> Vec<Option<Excuse>> {
+        let adrs = push_adrs(&dir, &fork, &head, on_main, Some(&upstream)).unwrap();
+        assert_eq!(adrs.len(), 4);
+        adrs.iter()
+            .map(|a| excuse(std::slice::from_ref(a), "a::slow"))
+            .collect()
+    };
+    let (yes, wait) = (Excuse::Accepted, Excuse::Unconfirmed);
+    let path = |p: &str| format!("docs/adr/{p}.md");
+    assert_eq!(
+        judged(false),
+        [
+            Some(wait(path("0096-spaced"))),
+            Some(wait(path("0097-edited"))),
+            Some(yes(path("0098-upstream"))),
+            Some(wait(path("0099-mine"))),
+        ],
+        "off main, only origin/main's identical copy counts"
+    );
+    assert_eq!(
+        judged(true).into_iter().flatten().collect::<Vec<_>>(),
+        ["0096-spaced", "0097-edited", "0098-upstream", "0099-mine"].map(|p| yes(path(p))),
+        "a push to main is the owner's"
+    );
+    let adrs = push_adrs(&dir, &fork, &head, false, Some(&upstream)).unwrap();
+    assert_eq!(
+        excuse(&adrs, "a::other"),
+        None,
+        "not what the pushed 0097 names"
+    );
+    // An ADR already in the base excuses nothing, even on main: from
+    // origin/main's commit only 0099 is new.
+    let new = push_adrs(&dir, &upstream, &head, true, Some(&upstream)).unwrap();
+    let paths: Vec<&str> = new.iter().map(|a| a.path.as_str()).collect();
+    assert_eq!(paths, [path("0099-mine")]);
+    // Which runs are for main: CI's ref, else the branch checked out.
+    assert!(on_main(&dir, Some("refs/heads/main")));
+    for other in [
+        "refs/heads/agent/x",
+        "refs/pull/7/merge",
+        "refs/heads/main2",
+    ] {
+        assert!(!on_main(&dir, Some(other)), "{other}");
+    }
+    assert!(!on_main(&dir, None), "agent/x is checked out");
+    git(&dir, &["checkout", "-q", "main"]);
+    assert!(on_main(&dir, None));
+    let _ = fs::remove_dir_all(&dir);
+}
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(["-c", "user.name=t", "-c", "user.email=t@t"])
+        .args(["-c", "commit.gpgsign=false"])
+        .args(args)
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+/// A repository on `main` with one commit holding an ADR.
+fn repo() -> PathBuf {
+    static NEXT: AtomicU32 = AtomicU32::new(0);
+    let n = NEXT.fetch_add(1, Ordering::Relaxed);
+    let dir = std::env::temp_dir().join(format!("xtask-bench-{}-{n}", std::process::id()));
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(dir.join("docs/adr/old")).unwrap();
+    // `-b`: git's default branch depends on the machine (Xcode's git: main).
+    git(&dir, &["init", "-q", "-b", "main"]);
+    commit(&dir, "docs/adr/0001-old.md", "# Old\n`a::old`\n");
+    dir
+}
+
+fn commit(dir: &Path, file: &str, text: &str) -> String {
+    fs::write(dir.join(file), text).unwrap();
+    git(dir, &["add", "-A"]);
+    git(dir, &["commit", "-q", "-m", file]);
+    git(dir, &["rev-parse", "HEAD"])
+}
+
+#[test]
+fn the_added_adrs_are_the_numbered_files_added_in_the_range() {
+    let dir = repo();
+    let base = git(&dir, &["rev-parse", "HEAD"]);
+    commit(
+        &dir,
+        "docs/adr/0001-old.md",
+        "# Old\n`a::old` `a::changed`\n",
+    );
+    commit(&dir, "docs/adr/0099-perf.md", "# Perf\nSlower: `a::new`.\n");
+    commit(&dir, "docs/adr/0100-perf.txt", "`a::new`\n");
+    commit(&dir, "docs/adr/old/0101-perf.md", "`a::new`\n");
+    commit(&dir, "notes.md", "`a::notes`\n");
+    let adrs = added_adrs(&dir, &base, "HEAD").unwrap();
+    let paths: Vec<&str> = adrs.iter().map(|(p, _)| p.as_str()).collect();
+    assert_eq!(
+        paths,
+        ["docs/adr/0099-perf.md"],
+        "changed and other files do not count"
+    );
+    assert!(names_benchmark(&adrs[0].1, "a::new"));
+    assert!(added_adrs(&dir, "HEAD", "HEAD").unwrap().is_empty());
+    assert!(!dirty(&dir));
+    fs::write(dir.join("notes.md"), "changed\n").unwrap();
+    assert!(dirty(&dir), "a changed tracked file");
+    let _ = fs::remove_dir_all(&dir);
+}
+
+/// On `main`: the push's `before` when it is an ancestor of `HEAD`, else
+/// the merge base. `resolve` runs on whatever is checked out; `on_main` is
+/// given, as CI's `GITHUB_REF` gives it.
+#[test]
+fn on_main_the_base_is_the_before_unless_it_is_off_the_branch() {
+    let dir = repo();
+    let fork = git(&dir, &["rev-parse", "HEAD"]);
+    let moved = commit(&dir, "docs/adr/0002-main.md", "main moved on\n");
+    git(&dir, &["checkout", "-q", "-b", "agent/x", &fork]);
+    let tip = commit(&dir, "work.md", "the branch\n");
+    let (sha, from) = resolve(&dir, &Request::MergeBase, true).unwrap();
+    assert_eq!(sha, fork);
+    assert_eq!(from, "the merge base of HEAD with main");
+    let absent = "0123456789abcdef0123456789abcdef01234567";
+    let (sha, from) = resolve(&dir, &Request::Event(absent.into()), true).unwrap();
+    assert_eq!(sha, fork);
+    assert!(
+        from.starts_with(&format!("{absent} is not in this clone; ")),
+        "{from}"
+    );
+    // A force-push: the old tip is here but not under HEAD.
+    let (sha, from) = resolve(&dir, &Request::Event(moved.clone()), true).unwrap();
+    assert_eq!(sha, fork);
+    assert!(
+        from.starts_with(&format!("{moved} is not an ancestor of HEAD; ")),
+        "{from}"
+    );
+    let (sha, from) = resolve(&dir, &Request::Event(fork.clone()), true).unwrap();
+    assert_eq!(
+        (sha.as_str(), from.as_str()),
+        (fork.as_str(), "the push's before (ENG_BENCH_BASE)")
+    );
+    assert_eq!(
+        resolve(&dir, &Request::Given("HEAD".into()), true)
+            .unwrap()
+            .0,
+        tip
+    );
+    assert!(resolve(&dir, &Request::Given("nothing".into()), true).is_err());
+    let _ = fs::remove_dir_all(&dir);
+}
+
+/// Off `main` the push's `before` is the branch's own last tip, so the base
+/// is always the merge base with `origin/main`: a second push that leaves
+/// a regression in place is still compared with main.
+#[test]
+fn off_main_the_base_is_the_merge_base_with_origin_main() {
+    let dir = repo();
+    let fork = git(&dir, &["rev-parse", "HEAD"]);
+    commit(&dir, "docs/adr/0002-main.md", "main moved on\n");
+    git(&dir, &["update-ref", "refs/remotes/origin/main", "HEAD"]);
+    git(&dir, &["checkout", "-q", "-b", "agent/x", &fork]);
+    let first = commit(&dir, "slow.md", "the regression\n");
+    commit(&dir, "more.md", "a second push\n");
+    let (sha, from) = resolve(&dir, &Request::Event(first.clone()), false).unwrap();
+    assert_eq!(sha, fork, "not the first push's tip {first}");
+    assert_eq!(
+        from,
+        "off main, not the push's before: the merge base of HEAD with origin/main"
+    );
+    assert_eq!(resolve(&dir, &Request::MergeBase, false).unwrap().0, fork);
+    assert_eq!(
+        resolve(&dir, &Request::Given(first.clone()), false)
+            .unwrap()
+            .0,
+        first,
+        "--base is taken as given"
+    );
+    let _ = fs::remove_dir_all(&dir);
+}
