+//! The bench job's rules (`bench.rs`, `bench_adr.rs`): reading gungraun's
+//! summaries, the 5% limit, the owner-accepted ADR exception, when the job
+//! is pending, and the workflow that runs it. The git side, from temporary
+//! repositories, is `bench_git_tests.rs`.
+
+use std::fs;
+use std::path::Path;
+
+use super::*;
+use crate::bench_adr::{Adr, Excuse, accepted, excuse, names_benchmark};
+
+fn count(name: &str, instructions: u64) -> Count {
+    Count {
+        name: name.into(),
+        instructions,
+    }
+}
+
+const PERF: &str = "docs/adr/0099-perf.md";
+
+/// An ADR's text, with `status`, naming each of `named` in backticks.
+fn adr_text(status: &str, named: &[&str]) -> String {
+    let names: Vec<String> = named.iter().map(|n| format!("`{n}`")).collect();
+    format!(
+        "# ADR-0099: Slower\n\n- **Status:** {status}\n- **Date:** 2026-11-07\n\nSlower: {}.\n",
+        names.join(", ")
+    )
+}
+
+/// An added ADR at `path` whose text is the owner's (`owners`), as on a
+/// push to `main`.
+fn adr(path: &str, status: &str, named: &[&str]) -> Adr {
+    let text = adr_text(status, named);
+    Adr {
+        path: path.into(),
+        owners: Some(text.clone()),
+        text,
+    }
+}
+
+fn accepted_naming(named: &[&str]) -> Vec<Adr> {
+    vec![adr(PERF, "Accepted", named)]
+}
+
+/// The verdict's detail, which must be a pass.
+fn passed(rows: &[Row]) -> String {
+    match verdict(rows) {
+        Ok(Done::Pass(detail)) => detail,
+        other => panic!("not a pass: {other:?}"),
+    }
+}
+
+#[test]
+fn the_limit_is_five_percent_in_integers() {
+    assert!(!over_limit(105, 100), "exactly 5% passes");
+    assert!(over_limit(106, 100));
+    assert!(!over_limit(2_100_000, 2_000_000));
+    assert!(over_limit(2_100_001, 2_000_000), "one instruction over");
+    assert!(!over_limit(0, 0));
+    assert!(over_limit(1, 0), "anything over a zero count");
+    assert!(!over_limit(u64::MAX, u64::MAX), "no overflow");
+}
+
+#[test]
+fn a_slower_benchmark_fails_unless_an_accepted_adr_names_it() {
+    let base = [count("a::slow", 1000), count("a::same", 1000)];
+    let head = [count("a::slow", 1051), count("a::same", 1050)];
+    let rows = compare(&head, &base, &[]);
+    assert!(rows[0].flagged && rows[0].excuse.is_none());
+    assert!(!rows[1].flagged);
+    let error = verdict(&rows).unwrap_err();
+    assert!(
+        error.contains("[E-BENCH]") && error.contains("a::slow"),
+        "{error}"
+    );
+    assert!(!error.contains("a::same,"), "{error}");
+    assert!(
+        error.contains("a::slow: 1000 -> 1051 (+5.10%), over"),
+        "{error}"
+    );
+    assert!(warnings(&rows).is_empty());
+
+    let rows = compare(&head, &base, &accepted_naming(&["a::slow"]));
+    assert_eq!(rows[0].excuse, Some(Excuse::Accepted(PERF.into())));
+    let detail = passed(&rows);
+    assert!(
+        detail.contains("a::slow: 1000 -> 1051 (+5.10%), over, excused by docs/adr/0099-perf.md"),
+        "{detail}"
+    );
+    assert!(
+        detail.contains("a::same: 1000 -> 1050 (+5.00%), within"),
+        "{detail}"
+    );
+    let warned = "[W-BENCH-EXCUSED] a::slow +5.10% excused by docs/adr/0099-perf.md";
+    assert_eq!(warnings(&rows), [warned]);
+    assert!(
+        detail.ends_with(warned),
+        "the excuse is the detail's last line: {detail}"
+    );
+}
+
+#[test]
+fn a_proposed_adr_does_not_excuse_and_says_the_owner_must_accept_it() {
+    let rows = compare(
+        &[count("a::slow", 2000)],
+        &[count("a::slow", 1000)],
+        &[adr(PERF, "Proposed", &["a::slow"])],
+    );
+    assert_eq!(rows[0].excuse, Some(Excuse::NotAccepted(PERF.into())));
+    let error = verdict(&rows).unwrap_err();
+    assert!(
+        error.contains(
+            "docs/adr/0099-perf.md names it but is not Accepted: the owner must accept it"
+        ),
+        "{error}"
+    );
+    assert!(warnings(&rows).is_empty());
+    let both = [
+        adr("docs/adr/0098-draft.md", "Proposed", &["a::slow"]),
+        adr(PERF, "Accepted", &["a::slow"]),
+    ];
+    assert_eq!(
+        excuse(&both, "a::slow"),
+        Some(Excuse::Accepted(PERF.into()))
+    );
+}
+
+/// Off `main`, an ADR the push marked Accepted itself excuses nothing yet:
+/// the step is pending until the owner accepts it on `main`.
+#[test]
+fn a_self_accepted_adr_off_main_leaves_the_step_pending() {
+    let base = [count("a::slow", 1000), count("a::fine", 10)];
+    let head = [count("a::slow", 2000), count("a::fine", 10)];
+    let mine = Adr {
+        owners: None,
+        ..adr(PERF, "Accepted", &["a::slow"])
+    };
+    let rows = compare(&head, &base, std::slice::from_ref(&mine));
+    assert_eq!(rows[0].excuse, Some(Excuse::Unconfirmed(PERF.into())));
+    // Accepted on origin/main without the name, the name added by the push.
+    let edited = Adr {
+        owners: Some(adr_text("Accepted", &["a::other"])),
+        ..mine.clone()
+    };
+    assert_eq!(
+        excuse(std::slice::from_ref(&edited), "a::slow"),
+        Some(Excuse::Unconfirmed(PERF.into()))
+    );
+    assert_eq!(
+        excuse(&[edited], "a::other"),
+        Some(Excuse::Accepted(PERF.into())),
+        "what origin/main's copy names"
+    );
+    let warned = "[W-BENCH-EXCUSED] a::slow +100.00% excused once the owner accepts \
+                  docs/adr/0099-perf.md on main";
+    assert_eq!(warnings(&rows), [warned]);
+    match verdict(&rows) {
+        Ok(Done::Pending(detail)) => {
+            assert!(
+                detail.contains("a::slow excused once the owner accepts"),
+                "{detail}"
+            );
+            assert!(detail.ends_with(warned), "{detail}");
+        }
+        other => panic!("not pending: {other:?}"),
+    }
+    // A failure elsewhere still fails the step.
+    let worse = [count("a::slow", 2000), count("a::fine", 20)];
+    assert!(verdict(&compare(&worse, &base, &[mine])).is_err());
+}
+
+#[test]
+fn the_status_line_must_read_accepted() {
+    let status = |line: &str| format!("# ADR-0099: X\n\n{line}\n- **Date:** 2026-11-07\n");
+    assert!(accepted(&status("- **Status:** Accepted")));
+    assert!(accepted(&status(
+        "- **Status:** Accepted; its push rule is amended by ADR-0018 (2026-11-01)"
+    )));
+    assert!(accepted(&status("- **Status:**  Accepted (the owner, G4)")));
+    for no in [
+        "- **Status:** Proposed",
+        "- **Status:** Superseded by ADR-0030",
+        "- **Status:** Acceptedish",
+        "- **Status:** Not Accepted",
+        "Status: Accepted",
+        "",
+    ] {
+        assert!(!accepted(&status(no)), "{no:?}");
+    }
+    let later = "# X\n\n- **Status:** Proposed\n\n- **Status:** Accepted\n";
+    assert!(!accepted(later), "the first status line counts");
+}
+
+#[test]
+fn an_adr_excuses_only_what_is_flagged() {
+    let rows = compare(
+        &[count("a::fast", 10)],
+        &[count("a::fast", 20)],
+        &accepted_naming(&["a::fast"]),
+    );
+    assert_eq!(rows[0].excuse, None);
+    assert!(passed(&rows).contains("(-50.00%), within"));
+    assert!(warnings(&rows).is_empty());
+}
+
+#[test]
+fn new_benchmarks_pass_and_removed_ones_fail_unless_named() {
+    let base = [count("a::kept", 7), count("a::gone", 9)];
+    let head = [count("a::new", 3), count("a::kept", 7)];
+    let rows = compare(&head, &base, &[]);
+    let names: Vec<&str> = rows.iter().map(|r| r.name.as_str()).collect();
+    assert_eq!(
+        names,
+        ["a::new", "a::kept", "a::gone"],
+        "head order, then the base's"
+    );
+    assert_eq!((rows[0].head, rows[0].base), (Some(3), None));
+    assert!(!rows[0].flagged);
+    assert_eq!((rows[2].head, rows[2].base), (None, Some(9)));
+    let error = verdict(&rows).unwrap_err();
+    assert!(error.contains("a::gone: 9 -> -, removed"), "{error}");
+    assert!(error.contains("a::new: - -> 3, new"), "{error}");
+    let rows = compare(&head, &base, &accepted_naming(&["a::gone"]));
+    passed(&rows);
+    assert_eq!(
+        warnings(&rows),
+        ["[W-BENCH-EXCUSED] a::gone removed excused by docs/adr/0099-perf.md"]
+    );
+}
+
+#[test]
+fn a_base_without_benchmarks_makes_every_one_new() {
+    let rows = compare(&[count("a::b", 5)], &[], &[]);
+    let detail = passed(&rows);
+    assert!(
+        detail.starts_with("1 benchmarks, none more than 5% over"),
+        "{detail}"
+    );
+    assert!(detail.contains("a::b: - -> 5, new"), "{detail}");
+}
+
+#[test]
+fn an_adr_names_a_benchmark_only_in_backticks_and_whole() {
+    let text = "Slower `sim::tick::room::walk` and sim::build::room_build, for the new grid.";
+    assert!(names_benchmark(text, "sim::tick::room::walk"));
+    assert!(
+        !names_benchmark(text, "sim::build::room_build"),
+        "not in backticks"
+    );
+    assert!(!names_benchmark(text, "sim::tick::room"), "a prefix");
+    assert!(!names_benchmark(text, "tick::room::walk"), "a suffix");
+}
+
+#[test]
+fn it_is_pending_off_linux_and_without_the_tools() {
+    let valgrind = Some("valgrind-3.22.0");
+    let runner = Some("gungraun-runner 0.20.0");
+    assert_eq!(missing("linux", valgrind, runner), None);
+    let mac = missing("macos", valgrind, runner).unwrap();
+    assert!(mac.contains("Linux") && mac.contains("macos"), "{mac}");
+    let no_valgrind = missing("linux", None, runner).unwrap();
+    assert!(
+        no_valgrind.contains("valgrind is not installed"),
+        "{no_valgrind}"
+    );
+    let no_runner = missing("linux", valgrind, None).unwrap();
+    assert!(
+        no_runner.contains("cargo install --locked gungraun-runner@0.20.0"),
+        "{no_runner}"
+    );
+    let old = missing("linux", valgrind, Some("gungraun-runner 0.19.1")).unwrap();
+    assert!(old.contains("0.19.1") && old.contains("--force"), "{old}");
+    assert!(missing("linux", valgrind, Some("gungraun-runner 0.20.0.1")).is_some());
+}
+
+#[test]
+fn the_command_line_takes_only_a_base() {
+    assert_eq!(parse(&[]), Ok(None));
+    assert_eq!(parse(&["--base", "abc"]), Ok(Some("abc".into())));
+    for bad in [
+        &["--base"][..],
+        &["abc"],
+        &["--base", "--x"],
+        &["--base", "a", "b"],
+    ] {
+        assert!(parse(bad).is_err(), "{bad:?}");
+    }
+}
+
+/// Two summaries as gungraun 0.20.0 printed them with
+/// `GUNGRAUN_OUTPUT_FORMAT=json` in T17's Docker run (Linux x64) of the
+/// final layout, each cut to its names and two of its metrics; one with an
+/// `id` and one without, and a line of other output between.
+const SUMMARIES: &str = include_str!("bench_tests.jsonl");
+
+#[test]
+fn counts_come_from_gungraun_json_lines() {
+    let counts = parse_counts(SUMMARIES).unwrap();
+    let names: Vec<&str> = counts.iter().map(|c| c.name.as_str()).collect();
+    assert_eq!(names, ["sim::tick::room::walk", "sim::build::room_build"]);
+    assert!(counts.iter().all(|c| c.instructions > 1000), "{counts:?}");
+    let old = r#"{"module_path":"a::b","profiles":[{"tool":"Callgrind","data":{"total":{"metrics":{"Ir":{"values":{"new":7,"old":9}}}}}}]}"#;
+    assert_eq!(
+        parse_counts(old).unwrap(),
+        [count("a::b", 7)],
+        "this run's count, not gungraun's previous one"
+    );
+}
+
+#[test]
+fn a_summary_without_a_count_or_a_repeated_name_is_an_error() {
+    let first = SUMMARIES.lines().find(|l| l.starts_with('{')).unwrap();
+    let twice = format!("{first}\n{first}\n");
+    let error = parse_counts(&twice).unwrap_err();
+    assert!(
+        error.contains("two benchmarks are named sim::tick::room::walk"),
+        "{error}"
+    );
+    let empty = r#"{"module_path": "a::b", "id": "c", "profiles": []}"#;
+    let error = parse_counts(empty).unwrap_err();
+    assert!(error.contains("a::b::c: no callgrind Ir"), "{error}");
+    assert_eq!(parse_counts("running 0 tests\n{not json\n"), Ok(Vec::new()));
+}
+
+/// The workflow's job runs on pushes and pull requests only, installs the
+/// runner of eng-bench's gungraun, fetches the history the base needs and
+/// passes the push's `before`; the summary collects its report, and the
+/// gate lets it be skipped only where its `if` skips it
+/// (`t17-workflow-bench.patch`, beside this one).
+#[test]
+fn the_workflow_and_the_workspace_agree_with_the_job() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask sits in the repo root");
+    let workflow = fs::read_to_string(root.join(".github/workflows/ci.yml")).unwrap();
+    let job = |name: &str| {
+        workflow
+            .split(&format!("\n  {name}:\n"))
+            .nth(1)
+            .and_then(|rest| rest.split("\n\n  ").next())
+            .unwrap_or_else(|| panic!("ci.yml has a {name} job"))
+            .to_string()
+    };
+    let bench = job("bench");
+    for wanted in [
+        "if: github.event_name == 'push' || github.event_name == 'pull_request'",
+        "runs-on: ubuntu-24.04",
+        "fetch-depth: 0",
+        "apt-get install -y -qq valgrind",
+        &format!("cargo install --locked gungraun-runner@{RUNNER_VERSION}"),
+        "ENG_BENCH_BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}",
+        "run: cargo xtask ci --job bench",
+        "name: report-bench",
+    ] {
+        assert!(bench.contains(wanted), "the bench job has no `{wanted}`");
+    }
+    for name in ["summary", "ci"] {
+        let needs = job(name);
+        let list = needs
+            .split("needs: [")
+            .nth(1)
+            .and_then(|r| r.split(']').next());
+        assert!(
+            list.is_some_and(|l| l.split(", ").any(|j| j == "bench")),
+            "{name} does not wait for bench"
+        );
+    }
+    assert!(job("ci").contains("BENCH: ${{ needs.bench.result }}"));
+    let manifest = fs::read_to_string(root.join("Cargo.toml")).unwrap();
+    assert!(
+        manifest.contains(&format!("\ngungraun = \"={RUNNER_VERSION}\"\n")),
+        "the workspace's gungraun is not {RUNNER_VERSION}"
+    );
+}
