@@ -0,0 +1,95 @@
+//! The bench job's exception (`bench.rs`): a performance ADR the push adds
+//! excuses a benchmark it names, once the owner has accepted it.
+//!
+//! An agent's push can write an ADR's status line and the names in it, so
+//! the excuse is read only from text an agent cannot have written. The ADR
+//! must be new in the push (absent from its base). On a run for `main`,
+//! which only the owner pushes (ADR-0018), the file as pushed counts;
+//! elsewhere only `origin/main`'s copy does, and only when the pushed file
+//! is byte for byte that copy: its status and the benchmark's name are read
+//! from it. Off `main`, an ADR whose pushed text alone is Accepted and names
+//! the benchmark (self-accepted, or an accepted one edited to name it)
+//! leaves the benchmark excused once the owner accepts it on `main`, and
+//! the `bench` step pending. `bench.rs` reads all of it before any of the
+//! head's code runs.
+
+use std::path::Path;
+
+use crate::bench_git;
+
+/// An ADR the push adds (`bench_git::added_adrs`): its text as pushed, and
+/// the text the owner stands behind (`owners`): the pushed one on a run for
+/// `main`; elsewhere `origin/main`'s copy, if the pushed file is that copy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Adr {
+    pub path: String,
+    pub text: String,
+    pub owners: Option<String>,
+}
+
+/// What the push's added ADRs say for a flagged benchmark.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Excuse {
+    /// An ADR the owner accepted names it: it passes.
+    Accepted(String),
+    /// An ADR this push marked Accepted, off `main`, names it: pending
+    /// until the owner accepts it on `main`.
+    Unconfirmed(String),
+    /// Only ADRs not marked Accepted name it: it fails.
+    NotAccepted(String),
+}
+
+/// The ADRs added between the commits `base` and `head`, with `owners` set
+/// as [`Adr`] says: `on_main` is `bench_git::on_main`'s answer, `upstream`
+/// the commit `origin/main` named when the job started.
+pub fn push_adrs(
+    root: &Path,
+    base: &str,
+    head: &str,
+    on_main: bool,
+    upstream: Option<&str>,
+) -> Result<Vec<Adr>, String> {
+    let added = bench_git::added_adrs(root, base, head)?;
+    Ok(added
+        .into_iter()
+        .map(|(path, text)| {
+            let owners = if on_main {
+                Some(text.clone())
+            } else {
+                let copy = upstream.and_then(|sha| bench_git::blob(root, sha, &path));
+                copy.filter(|copy| *copy == text)
+            };
+            Adr { path, text, owners }
+        })
+        .collect())
+}
+
+/// Whether an ADR's status line, its first `- **Status:**` line, reads
+/// Accepted (perhaps with more after it, as ADR-0014's does).
+pub fn accepted(text: &str) -> bool {
+    let status = text.lines().find_map(|l| l.strip_prefix("- **Status:**"));
+    status.is_some_and(|s| {
+        let after = s.trim_start().strip_prefix("Accepted");
+        after.is_some_and(|rest| !rest.starts_with(char::is_alphanumeric))
+    })
+}
+
+/// Whether an ADR's text names `benchmark`: in backticks, exactly.
+pub fn names_benchmark(text: &str, benchmark: &str) -> bool {
+    text.contains(&format!("`{benchmark}`"))
+}
+
+/// The excuse `adrs` give `name`: an ADR whose owner's text is Accepted and
+/// names it; else one whose pushed text alone does (pending); else one
+/// whose pushed text names it unaccepted (failed).
+pub fn excuse(adrs: &[Adr], name: &str) -> Option<Excuse> {
+    let says = |text: &str| accepted(text) && names_benchmark(text, name);
+    if let Some(adr) = adrs.iter().find(|a| a.owners.as_deref().is_some_and(says)) {
+        return Some(Excuse::Accepted(adr.path.clone()));
+    }
+    if let Some(adr) = adrs.iter().find(|a| says(&a.text)) {
+        return Some(Excuse::Unconfirmed(adr.path.clone()));
+    }
+    let naming = adrs.iter().find(|a| names_benchmark(&a.text, name));
+    naming.map(|a| Excuse::NotAccepted(a.path.clone()))
+}
