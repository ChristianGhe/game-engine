+//! Unit tests for docs-lint on synthetic docs, trees and usage texts. The
+//! code scan skips this file: its fixtures name what must not exist.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use super::known::{PROBE_USAGE, probe_usage, tree};
+use super::usage::Usage;
+use super::*;
+
+const DOC: &str = "\
+# Doc
+
+See `docs/adr/`, `docs/gone.md`, `crates/<name>/Cargo.toml` and `tests/shots.rs`;
+`flip/<shot>.png`, `target/agent-logs/` and `fn(&mut World)` are not checked.
+Set ENG_REQUIRE_GPU=1 (not MY_ENG_X) and grep `[E-ARCH-*]` or [W-GONE].
+
+```sh
+cargo xtask quick              # fmt, clippy; `replay dump r.rec` prints it
+cargo run --release -p game-testbed -- dump-world --at-tick N \\
+    --input crates/a/scenarios/<name>.input.toml --out a.json
+ENG_REQUIRE_GPU=1 game-testbed run --ticks 5 && cargo run -p game-testbed-client -- x
+```
+
+A span that `cargo xtask ci
+--job lint` goes on; `cargo xtask` alone and `cargo xtask <cmd>` name none,
+nor do `run` alone or `git status --short`; `play --bindings` is a command.
+";
+
+/// What a review planted and the first docs-lint missed.
+const PLANTED: &str = "\
+Spans: `replay dumpx`, `dump-wrld --at-tick N`, `game-testbed run --tickz 5`.
+
+```sh
+cargo run --release -p game-testbed -- shoot --frob
+cargo run -q -p game-testbed -- shoot   # then `replay dumpx r.rec`
+```
+";
+
+/// The fixture tree: files, and directories with a trailing `/`.
+const TREE: &str = ".claude/ Cargo.toml crates/ crates/a/ crates/a/Cargo.toml crates/a/scenarios/
+    crates/a/scenarios/walk.input.toml crates/a/tests/ crates/a/tests/shots.rs docs/ docs/adr/
+    docs/adr/0001-x.md docs/rungs/ docs/rungs/2/ docs/rungs/2/plan.md";
+
+fn fixture() -> Known {
+    known(&TREE.split_whitespace().collect::<Vec<_>>())
+}
+
+/// A probe's `args.rs`, as [`PROBE_USAGE`] holds it.
+const PROBE_SOURCE: &str = r#"use std::path::PathBuf;
+
+pub(crate) const USAGE: &str = "\
+<game> run --headless --ticks N [--seed S]
+           [--report report.json]
+<game> replay verify <recording> [--report report.json]
+<game> replay dump <recording> [--out recording.json]
+<game> dump-world --at-tick N --out world.json [--input script.toml]
+<game> play [--ticks N] [--bindings bindings.toml]
+<game> --version [--json]
+<game> help
+
+run and dump-world take [--map NAME]: the game's first map by default.";
+"#;
+
+fn known(tree: &[&str]) -> Known {
+    let probe = probe_usage(PROBE_SOURCE).expect("the fixture's USAGE");
+    let mut xtask = Usage::parse(crate::USAGE, "cargo xtask ");
+    xtask.restrict("ci", Some("--job"), &crate::ci::JOBS, "a CI job");
+    xtask.restrict("selftest", None, &crate::selftest::CASES, "a selftest case");
+    Known {
+        tree: tree.iter().map(|p| p.to_string()).collect(),
+        xtask,
+        probe: Usage::parse(&probe, "<game> "),
+        vars: ["ENG_REQUIRE_GPU".to_string()].into(),
+        tags: ["[E-ARCH-FLOOR]".to_string(), "[E-DESYNC]".to_string()].into(),
+        ..Known::default()
+    }
+}
+
+fn verdict(known: &Known, kind: Kind, text: &str) -> Option<Result<(), String>> {
+    known.verdict(&Ref {
+        line: 1,
+        kind,
+        text: text.into(),
+    })
+}
+
+fn scratch(what: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("xtask-docs-lint-{what}-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).expect("scratch");
+    dir
+}
+
+#[test]
+fn references_come_from_spans_fences_comments_and_the_text() {
+    let refs = refs(DOC);
+    let of = |kind: Kind| -> Vec<(usize, &str)> {
+        refs.iter()
+            .filter(|r| r.kind == kind)
+            .map(|r| (r.line, r.text.as_str()))
+            .collect()
+    };
+    assert_eq!(
+        of(Kind::Path { short: true }),
+        [
+            (3, "docs/adr/"),
+            (3, "docs/gone.md"),
+            (3, "crates/<name>/Cargo.toml"),
+            (3, "tests/shots.rs"),
+            (4, "flip/<shot>.png"),
+            (4, "target/agent-logs/"),
+            (16, "run"),
+        ]
+    );
+    let code = of(Kind::Path { short: false });
+    assert!(
+        code.contains(&(10, "crates/a/scenarios/<name>.input.toml")),
+        "{code:?}"
+    );
+    assert!(code.contains(&(10, "a.json")), "{code:?}");
+    // A bare `cargo xtask` names none; another package is not the probe.
+    assert_eq!(of(Kind::Xtask), [(8, "quick"), (14, "ci --job lint")]);
+    assert_eq!(
+        of(Kind::Probe),
+        [
+            (
+                9,
+                "dump-world --at-tick N --input crates/a/scenarios/<name>.input.toml --out a.json"
+            ),
+            (11, "run --ticks 5"),
+        ]
+    );
+    // A comment's spans are read; its bare words are not.
+    assert_eq!(
+        of(Kind::Command),
+        [
+            (8, "replay dump r.rec"),
+            (16, "git status --short"),
+            (16, "play --bindings")
+        ]
+    );
+    assert_eq!(
+        of(Kind::Var),
+        [(5, "ENG_REQUIRE_GPU"), (11, "ENG_REQUIRE_GPU")]
+    );
+    assert_eq!(of(Kind::Tag), [(5, "[E-ARCH-*]"), (5, "[W-GONE]")]);
+}
+
+#[test]
+fn a_stale_reference_fails_with_its_file_and_line() {
+    let (checked, stale) = lint("DOC.md", DOC, &fixture());
+    assert_eq!(
+        stale,
+        [
+            "[E-DOCS-STALE] DOC.md:3: `docs/gone.md`: no such file or directory in the tree",
+            "[E-DOCS-STALE] DOC.md:5: `[W-GONE]` is in no .rs file under crates/ or xtask/",
+        ]
+    );
+    // 4 spans, 4 names, 2 xtask and 2 probe commands, 2 command spans, a
+    // path in code; `run` alone and `git status --short` are not checked.
+    assert_eq!(checked, 15);
+}
+
+#[test]
+fn what_a_review_planted_now_fails() {
