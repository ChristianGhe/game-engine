+//! Docs-lint (rung 2, decision 16; spec 7.4 and the plan's difference 8):
+//! every `cargo xtask` command, probe command, repo path, `ENG_*` variable
+//! and `[E-*]` or `[W-*]` tag that `AGENTS.md`, `docs/ARCHITECTURE.md` and
+//! `.claude/skills/*/SKILL.md` name must exist. `docs-check` runs it, and
+//! each stale reference fails as `[E-DOCS-STALE] <file>:<line>: <what>`.
+//!
+//! - **Commands**, read from code: inline spans, the lines of fenced blocks
+//!   (a line ending in `\` goes on), and the spans in a fenced line's `#`
+//!   comment. A command is `cargo xtask <cmd> ...`; `cargo run [flags]
+//!   -p game-testbed [flags] -- <cmd> ...` (or `--package`, `--bin`); or
+//!   `game-testbed <cmd> ...`, after any `NAME=value`. Each must be in the
+//!   usage text of xtask or the probe (read from `PROBE_USAGE`, not run):
+//!   the command, its flags, how many arguments it takes, `ci --job`'s jobs,
+//!   `selftest`'s cases and `hook`'s choices. Every probe command also takes
+//!   the flags its parser matches that the usage leaves out (the test-only
+//!   `--panic-at-tick`). A span of two or more words whose first word is a
+//!   command of either usage (`replay verify`, `dump-world --at-tick N`)
+//!   passes if either accepts it; one whose first word is no command but
+//!   that has a `--flag` fails, unless the word is in [`OTHER_PROGRAMS`]. A
+//!   word alone (`run`, `dump-world`) and a bare list in prose or a comment
+//!   (`# the rest: docs-check, size-check`) are not checked.
+//! - **Paths**, tokens of path characters, where `<name>` stands for part of
+//!   a segment and `*` and `**` glob. A path whose first segment is at the
+//!   root (`docs/adr/`, `Cargo.toml`; a bare word such as `xtask` is prose),
+//!   or that starts with `**/`, must match something in the tree: a
+//!   directory if it ends in `/`, and a `:N` or `:N-M` suffix must be lines
+//!   of a file it matches. An inline span that is one shorter path ending in
+//!   a source extension (`SOURCE`: `tests/shots.rs`, `crash_json.rs`) must
+//!   end some file's path. Other short names (`flip/<shot>.png`,
+//!   `version.json`, `agent/<name>`) are outputs or not paths, and `target/`
+//!   holds outputs: neither is checked.
+//! - **Variables** (`ENG_X`) and **tags** (`[E-X]`, `[W-X]`, or `[E-X-*]`
+//!   for a family), anywhere in the text, must be named in the code: the
+//!   `.rs` files under `crates/` and `xtask/`, except this lint's tests,
+//!   whose fixtures name what must not exist.
+//!
+//! The tree is what git would commit, compared case for case as on Linux:
+//! `git ls-files --cached --others --exclude-standard`, so an ignored file
+//! (`target/`, `.claude/guard-unlock`) never counts, and a new file counts
+//! before `git add` (as under jj). Without git, a walk of the directory. A
+//! doc may name what does not exist only through [`ALLOWED`], with a reason.
+
+use std::fs;
+use std::path::Path;
+
+#[path = "docs_lint_known.rs"]
+mod known;
+pub use known::Known;
+
+#[path = "docs_lint_usage.rs"]
+mod usage;
+use usage::{flag, placeholder, word};
+
+/// Starts each stale reference's line.
+pub const TAG: &str = "[E-DOCS-STALE]";
+
+/// What to do about a stale reference: the line after the list.
+pub const HINT: &str = "docs-lint: fix the doc; write `<name>` for a part that varies \
+     (`crates/<name>/`); `ALLOWED` and `OTHER_PROGRAMS` in xtask/src/docs_lint.rs are the owner's";
+
+/// References the docs may make to what does not exist, as written, and why.
+pub const ALLOWED: &[(&str, &str)] = &[
+    (
+        ".claude/guard-unlock",
+        "the owner's unlock file: git-ignored, it exists only while the owner lifts the guard",
+    ),
+    (
+        "CLAUDE.md",
+        "absent by design: spec 7.4 allows at most a pointer to AGENTS.md, and none is committed",
+    ),
+];
+
+/// Programs other than xtask and the probe that a span may show with flags
+/// (`git status --porcelain`, `cargo test -p eng-math --test known_answers`).
+pub const OTHER_PROGRAMS: &[&str] = &[
+    "awk", "bash", "cargo", "cat", "cd", "cmp", "cp", "curl", "diff", "docker", "echo", "find",
+    "gh", "git", "grep", "jj", "ls", "mv", "open", "python3", "rm", "rustc", "rustup", "sed", "sh",
+    "tar", "typos", "unzip", "xvfb-run", "zsh",
+];
+
+/// What ends a simple command on a shell line.
+const BREAKS: [&str; 7] = ["|", "||", "&&", ";", "&", ">", ">>"];
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// A path; `short` if an inline span is all of it, so that it may also
+    /// be a short path.
+    Path {
+        short: bool,
+    },
+    /// The arguments of `cargo xtask`.
+    Xtask,
+    /// The probe's arguments, after `cargo run ... --` or `game-testbed`.
+    Probe,
+    /// A span of words that may be a command of either usage.
+    Command,
+    Var,
+    Tag,
+}
+
+/// A name a doc uses, at its 1-based line.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Ref {
+    pub line: usize,
+    pub kind: Kind,
+    pub text: String,
+}
+
+/// What a docs-lint run found: how many references it checked in how many
+/// files, and one line for each stale one.
+#[derive(Debug, Default)]
+pub struct Report {
+    pub files: usize,
+    pub refs: usize,
+    pub stale: Vec<String>,
+}
+
+/// Lints the docs under `docs` against the tree, code and usage texts at
+/// `root`: the same directory, except in `selftest docs-stale-path`, which
+/// goes through `docs::check_docs` as `docs-check` does.
+pub fn check(root: &Path, docs: &Path) -> Result<Report, String> {
+    let known = Known::read(root)?;
+    let mut report = Report::default();
+    for name in doc_names(docs) {
+        let text =
+            fs::read_to_string(docs.join(&name)).map_err(|e| format!("[E-DOCS] {name}: {e}"))?;
+        let (refs, stale) = lint(&name, &text, &known);
+        report.files += 1;
+        report.refs += refs;
+        report.stale.extend(stale);
+    }
+    Ok(report)
+}
+
+/// The docs docs-lint reads under `docs`, repo-relative.
+pub fn doc_names(docs: &Path) -> Vec<String> {
+    let mut names = vec!["AGENTS.md".to_string(), "docs/ARCHITECTURE.md".to_string()];
+    names.extend(skill_names(docs));
+    names
+}
+
+/// `.claude/skills/*/SKILL.md` under `docs`, sorted.
+pub fn skill_names(docs: &Path) -> Vec<String> {
+    let mut skills: Vec<String> = fs::read_dir(docs.join(".claude/skills"))
+        .map(|dir| {
+            dir.flatten()
+                .map(|e| {
+                    format!(
+                        ".claude/skills/{}/SKILL.md",
+                        e.file_name().to_string_lossy()
+                    )
+                })
+                .filter(|rel| docs.join(rel).is_file())
+                .collect()
+        })
+        .unwrap_or_default();
+    skills.sort();
+    skills
+}
+
+/// How many references of `text` it checked, and a line for each stale one.
+pub fn lint(name: &str, text: &str, known: &Known) -> (usize, Vec<String>) {
+    let mut checked = 0;
+    let mut stale = Vec::new();
+    for r in refs(text) {
+        if ALLOWED.iter().any(|(allowed, _)| *allowed == r.text) {
+            continue;
+        }
+        let Some(verdict) = known.verdict(&r) else {
+            continue;
+        };
+        checked += 1;
+        if let Err(why) = verdict {
+            let line = format!("{TAG} {name}:{}: {why}", r.line);
+            if !stale.contains(&line) {
+                stale.push(line);
+            }
+        }
+    }
+    (checked, stale)
+}
+
+/// Every reference `text` makes, by line.
+pub fn refs(text: &str) -> Vec<Ref> {
+    let lines: Vec<&str> = text.lines().collect();
+    let mut out = Vec::new();
+    let mut fenced = false;
+    // An inline span left open at a line's end goes on, up to a blank line.
+    let mut span: Option<(usize, String)> = None;
+    let mut i = 0;
+    while i < lines.len() {
+        let line = lines[i];
+        names(i + 1, line, &mut out);
+        if line.trim_start().starts_with("```") {
+            fenced = !fenced;
+            span = None;
+            i += 1;
+            continue;
+        }
+        if fenced {
+            let first = i + 1;
+            let (code, comment) = split_comment(line);
+            let mut comments = vec![(first, comment)];
+            code_paths(first, code, &mut out);
+            let mut code = code.to_string();
+            while code.trim_end().ends_with('\\')
+                && i + 1 < lines.len()
+                && !lines[i + 1].trim_start().starts_with("```")
+            {
+                i += 1;
+                names(i + 1, lines[i], &mut out);
+                let (next, comment) = split_comment(lines[i]);
+                comments.push((i + 1, comment));
+                code_paths(i + 1, next, &mut out);
+                code = format!("{} {next}", code.trim_end().trim_end_matches('\\'));
+            }
+            commands(first, &code, &mut out);
+            for (line, comment) in comments {
+                comment_spans(line, comment, &mut out);
+            }
+            i += 1;
+            continue;
+        }
+        if line.trim().is_empty() {
+            span = None;
+        }
+        for c in line.chars() {
+            if c == '`' {
+                match span.take() {
+                    Some((start, content)) => inline(start, &content, &mut out),
+                    None => span = Some((i + 1, String::new())),
+                }
+            } else if let Some((_, content)) = span.as_mut() {
+                content.push(c);
+            }
+        }
+        if let Some((_, content)) = span.as_mut() {
+            content.push(' ');
+        }
+        i += 1;
+    }
+    out.sort_by_key(|r| r.line);
+    out
+}
+
+/// A shell line's code and its comment, which starts at a `#` that begins
+/// the line or follows a space.
+fn split_comment(line: &str) -> (&str, &str) {
+    if let Some(comment) = line.trim_start().strip_prefix('#') {
+        return ("", comment);
+    }
+    match line.find(" #") {
+        Some(at) => (&line[..at], &line[at + 2..]),
+        None => (line, ""),
+    }
+}
+
+/// The inline spans of a comment, which end with its line.
+fn comment_spans(line: usize, comment: &str, out: &mut Vec<Ref>) {
+    let parts: Vec<&str> = comment.split('`').collect();
+    // Odd parts are inside backticks; an unclosed last one is not a span.
+    for (i, part) in parts.iter().enumerate() {
+        if i % 2 == 1 && i + 1 < parts.len() {
+            inline(line, part, out);
+        }
+    }
+}
+
+/// An inline span: commands, and the path it is or the paths it holds.
+fn inline(line: usize, content: &str, out: &mut Vec<Ref>) {
+    let content = content.trim();
+    commands(line, content, out);
+    let tokens: Vec<&str> = content.split_whitespace().collect();
+    match tokens.as_slice() {
+        [one] => {
+            if path_parts(one).is_some() {
+                out.push(Ref {
+                    line,
+                    kind: Kind::Path { short: true },
+                    text: content.into(),
+                });
+            }
+        }
+        [first, _, ..] => {
+            if word(first) && *first != "cargo" && !testbed(first) {
+                out.push(Ref {
+                    line,
+                    kind: Kind::Command,
+                    text: tokens.join(" "),
+                });
+            }
+            code_paths(line, content, out);
+        }
+        [] => {}
+    }
+}
+
+/// The path-like tokens of a code line, with quotes, brackets and a
+/// `NAME=` or `--flag=` prefix taken off.
+fn code_paths(line: usize, code: &str, out: &mut Vec<Ref>) {
+    for token in code.split_whitespace() {
+        let token = token.rsplit('=').next().unwrap_or(token);
+        let token = token.trim_start_matches(['(', '"', '\'']);
+        let token = token.trim_end_matches([')', ',', ';', '.', '"', '\'']);
+        if path_parts(token).is_some() {
+            out.push(Ref {
+                line,
+                kind: Kind::Path { short: false },
+                text: token.into(),
+            });
+        }
+    }
+}
+
+/// The xtask and probe commands of a code line: each simple command, after
+/// its `NAME=value` assignments.
+fn commands(line: usize, code: &str, out: &mut Vec<Ref>) {
+    let tokens: Vec<&str> = code.split_whitespace().collect();
+    for command in tokens.split(|t| BREAKS.contains(t)) {
+        let start = command.iter().take_while(|t| assignment(t)).count();
+        let (kind, args) = match &command[start..] {
+            ["cargo", "xtask", args @ ..] => (Kind::Xtask, args.to_vec()),
+            ["cargo", "run", args @ ..] => match probe_args(args) {
+                Some(args) => (Kind::Probe, args),
+                None => continue,
+            },
+            [program, args @ ..] if testbed(program) => (Kind::Probe, args.to_vec()),
+            _ => continue,
+        };
+        if args
+            .first()
+            .is_some_and(|t| !placeholder(t) && (word(t) || t.starts_with('-')))
+        {
+            out.push(Ref {
+                line,
+                kind,
+                text: args.join(" "),
+            });
+        }
+    }
+}
+
+/// The probe's arguments in `cargo run`'s, if its package or binary is
+/// `game-testbed`: what follows `--`.
+fn probe_args<'a>(args: &[&'a str]) -> Option<Vec<&'a str>> {
+    let dashes = args.iter().position(|t| *t == "--")?;
+    let cargo = &args[..dashes];
+    let named = cargo.iter().enumerate().any(|(i, t)| {
+        let value = match *t {
+            "-p" | "--package" | "--bin" => cargo.get(i + 1).copied(),
+            t => t
+                .strip_prefix("--package=")
+                .or_else(|| t.strip_prefix("--bin="))
+                .or_else(|| t.strip_prefix("-p").filter(|v| !v.starts_with('-'))),
+        };
+        value == Some("game-testbed")
+    });
+    named.then(|| args[dashes + 1..].to_vec())
+}
+
+/// `game-testbed`, or a path to it, as a program.
+fn testbed(program: &str) -> bool {
+    program == "game-testbed" || program.ends_with("/game-testbed")
+}
+
+/// `NAME=value`, as a shell sets a variable for one command.
+fn assignment(token: &str) -> bool {
+    token.split_once('=').is_some_and(|(name, _)| {
+        name.starts_with(|c: char| c.is_ascii_alphabetic() || c == '_')
+            && name.chars().all(|c| c.is_ascii_alphanumeric() || c == '_')
+    })
+}
+
+/// The `ENG_*` variables and `[E-*]`/`[W-*]` tags on a line.
+fn names(line: usize, text: &str, out: &mut Vec<Ref>) {
+    for name in vars(text) {
+        out.push(Ref {
+            line,
+            kind: Kind::Var,
+            text: name,
+        });
+    }
+    for name in tags(text) {
+        out.push(Ref {
+            line,
+            kind: Kind::Tag,
+            text: name,
+        });
+    }
+}
+
+/// `ENG_X` names in `text`: `ENG_`, then capitals, digits and `_`.
+pub fn vars(text: &str) -> Vec<String> {
+    let bytes = text.as_bytes();
+    let name_byte = |b: u8| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_';
+    let mut out = Vec::new();
+    let mut i = 0;
+    while let Some(at) = text[i..].find("ENG_").map(|at| at + i) {
+        let mut end = at + 4;
+        while end < bytes.len() && name_byte(bytes[end]) {
+            end += 1;
+        }
+        let name = text[at..end].trim_end_matches('_');
+        let whole = at == 0 || !(bytes[at - 1].is_ascii_alphanumeric() || bytes[at - 1] == b'_');
+        if whole && name.len() > 4 {
+            out.push(name.to_string());
+        }
+        i = end;
+    }
+    out
+}
+
+/// `[E-X]` and `[W-X]` tags in `text`, and `[E-X-*]` families.
+pub fn tags(text: &str) -> Vec<String> {
+    let bytes = text.as_bytes();
+    let tag_byte = |b: u8| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'-';
+    let mut out = Vec::new();
+    for (at, _) in text.match_indices('[') {
+        let rest = &bytes[at + 1..];
+        if !(rest.starts_with(b"E-") || rest.starts_with(b"W-")) {
+            continue;
+        }
+        let mut end = 2;
+        while end < rest.len() && tag_byte(rest[end]) {
+            end += 1;
+        }
+        if rest.get(end) == Some(&b'*') {
+            end += 1;
+        }
+        if end > 2 && rest.get(end) == Some(&b']') {
+            out.push(text[at..at + end + 2].to_string());
+        }
+    }
+    out
+}
+
+/// A path and its line range, if `token` is made of path characters with
+/// whole `<placeholders>` and an optional `:N` or `:N-M` suffix.
+fn path_parts(token: &str) -> Option<(&str, Option<(usize, usize)>)> {
+    let (path, lines) = match token.rsplit_once(':') {
+        Some((path, lines)) => {
+            let (from, to) = lines.split_once('-').unwrap_or((lines, lines));
+            (path, Some((from.parse().ok()?, to.parse().ok()?)))
+        }
+        None => (token, None),
+    };
+    let chars = path
+        .chars()
+        .all(|c| c.is_ascii_alphanumeric() || "_.-/*<>".contains(c));
+    let mut open = false;
+    let placeholders = path.chars().all(|c| match c {
+        '<' if !open => {
+            open = true;
+            true
+        }
+        '>' if open => {
+            open = false;
+            true
+        }
+        '<' | '>' => false,
+        '/' => !open,
+        _ => true,
+    }) && !open;
+    let ok = chars
+        && placeholders
+        && !path.is_empty()
+        && !path.starts_with('-')
+        && !path.contains("..")
+        && !path.contains("//");
+    ok.then_some((path, lines))
+}
+
