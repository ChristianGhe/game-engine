@@ -0,0 +1,383 @@
+//! Docs-lint (rung 2, decision 16; spec 7.4 and the plan's difference 8):
+//! every `cargo xtask` command, probe command, repo path, `ENG_*` variable
+//! and `[E-*]` or `[W-*]` tag that `AGENTS.md`, `docs/ARCHITECTURE.md` and
+//! `.claude/skills/*/SKILL.md` name must exist. `docs-check` runs it, and
+//! each stale reference fails as `[E-DOCS-STALE] <file>:<line>: <what>`.
+//!
+//! - **Commands**, read from code only: inline spans, and the lines of
+//!   fenced blocks (a line ending in `\` goes on; ` #` starts a comment).
+//!   `cargo xtask <cmd> ...` must be a command of xtask's usage text, with
+//!   its flags, `ci --job`'s jobs, `selftest`'s cases and `hook`'s choices.
+//!   `cargo run -p game-testbed [...] -- <cmd> ...` must be a command of the
+//!   probe's usage text, with its flags; that text is read from
+//!   [`PROBE_USAGE`](known::PROBE_USAGE), not run.
+//! - **Paths**, tokens of path characters, where `<name>` stands for part of
+//!   a segment and `*` and `**` glob. A path whose first segment is at the
+//!   root (`docs/adr/`, `Cargo.toml`; a bare word such as `xtask` is prose),
+//!   or that starts with `**/`, must match something in the tree: a
+//!   directory if it ends in `/`, and a `:N` or `:N-M` suffix must be lines
+//!   of the file. An inline span that is one shorter path ending in a source
+//!   extension ([`SOURCE`](known::SOURCE): `tests/shots.rs`, `crash_json.rs`)
+//!   must end some file's path. Other short names (`flip/<shot>.png`,
+//!   `version.json`, `agent/<name>`) are outputs or not paths, and `target/`
+//!   holds outputs: neither is checked.
+//! - **Variables** (`ENG_X`) and **tags** (`[E-X]`, `[W-X]`, or `[E-X-*]`
+//!   for a family), anywhere in the text, must be named in the code: the
+//!   `.rs` files under `crates/` and `xtask/`, except this lint's tests,
+//!   whose fixtures name what must not exist.
+//!
+//! The tree is every file and directory under the root but `.git`, `.jj`,
+//! `target` and nested checkouts, compared case for case as on Linux. A
+//! doc may name what does not exist only through [`ALLOWED`], with a reason.
+
+use std::fs;
+use std::path::Path;
+
+#[path = "docs_lint_known.rs"]
+mod known;
+pub use known::Known;
+
+/// Starts each stale reference's line.
+pub const TAG: &str = "[E-DOCS-STALE]";
+
+const XTASK: &str = "cargo xtask";
+const PROBE: &str = "cargo run -p game-testbed";
+
+/// References the docs may make to what does not exist, as written, and why.
+pub const ALLOWED: &[(&str, &str)] = &[(
+    ".claude/guard-unlock",
+    "the owner's unlock file: git-ignored, it exists only while the owner lifts the guard",
+)];
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// A path; `short` if an inline span is all of it, so that it may also
+    /// be a short path.
+    Path {
+        short: bool,
+    },
+    /// `cargo xtask` and what follows.
+    Xtask,
+    /// The probe command after `cargo run -p game-testbed ... --`.
+    Probe,
+    Var,
+    Tag,
+}
+
+/// A name a doc uses, at its 1-based line.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Ref {
+    pub line: usize,
+    pub kind: Kind,
+    pub text: String,
+}
+
+/// What a docs-lint run found: how many references it checked in how many
+/// files, and one line for each stale one.
+#[derive(Debug, Default)]
+pub struct Report {
+    pub files: usize,
+    pub refs: usize,
+    pub stale: Vec<String>,
+}
+
+/// Lints the docs under `docs` against the tree, code and usage texts at
+/// `root` (the same directory, except for `selftest docs-stale-path`).
+pub fn check(root: &Path, docs: &Path) -> Result<Report, String> {
+    let known = Known::read(root)?;
+    let mut report = Report::default();
+    for name in doc_names(docs) {
+        let text =
+            fs::read_to_string(docs.join(&name)).map_err(|e| format!("[E-DOCS] {name}: {e}"))?;
+        let (refs, stale) = lint(&name, &text, &known);
+        report.files += 1;
+        report.refs += refs;
+        report.stale.extend(stale);
+    }
+    Ok(report)
+}
+
+/// The docs docs-lint reads under `docs`, repo-relative.
+pub fn doc_names(docs: &Path) -> Vec<String> {
+    let mut skills: Vec<String> = fs::read_dir(docs.join(".claude/skills"))
+        .map(|dir| {
+            dir.flatten()
+                .map(|e| {
+                    format!(
+                        ".claude/skills/{}/SKILL.md",
+                        e.file_name().to_string_lossy()
+                    )
+                })
+                .filter(|rel| docs.join(rel).is_file())
+                .collect()
+        })
+        .unwrap_or_default();
+    skills.sort();
+    let mut names = vec!["AGENTS.md".to_string(), "docs/ARCHITECTURE.md".to_string()];
+    names.extend(skills);
+    names
+}
+
+/// How many references of `text` it checked, and a line for each stale one.
+pub fn lint(name: &str, text: &str, known: &Known) -> (usize, Vec<String>) {
+    let mut checked = 0;
+    let mut stale = Vec::new();
+    for r in refs(text) {
+        if ALLOWED.iter().any(|(allowed, _)| *allowed == r.text) {
+            continue;
+        }
+        let Some(verdict) = known.verdict(&r) else {
+            continue;
+        };
+        checked += 1;
+        if let Err(why) = verdict {
+            let line = format!("{TAG} {name}:{}: {why}", r.line);
+            if !stale.contains(&line) {
+                stale.push(line);
+            }
+        }
+    }
+    (checked, stale)
+}
+
+/// Every reference `text` makes, by line.
+pub fn refs(text: &str) -> Vec<Ref> {
+    let lines: Vec<&str> = text.lines().collect();
+    let mut out = Vec::new();
+    let mut fenced = false;
+    // An inline span left open at a line's end goes on, up to a blank line.
+    let mut span: Option<(usize, String)> = None;
+    let mut i = 0;
+    while i < lines.len() {
+        let line = lines[i];
+        names(i + 1, line, &mut out);
+        if line.trim_start().starts_with("```") {
+            fenced = !fenced;
+            span = None;
+            i += 1;
+            continue;
+        }
+        if fenced {
+            let first = i + 1;
+            let mut code = comment_cut(line).to_string();
+            code_paths(first, &code, &mut out);
+            while code.trim_end().ends_with('\\')
+                && i + 1 < lines.len()
+                && !lines[i + 1].trim_start().starts_with("```")
+            {
+                i += 1;
+                names(i + 1, lines[i], &mut out);
+                let next = comment_cut(lines[i]);
+                code_paths(i + 1, next, &mut out);
+                code = format!("{} {next}", code.trim_end().trim_end_matches('\\'));
+            }
+            commands(first, &code, &mut out);
+            i += 1;
+            continue;
+        }
+        if line.trim().is_empty() {
+            span = None;
+        }
+        for c in line.chars() {
+            if c == '`' {
+                match span.take() {
+                    Some((start, content)) => inline(start, &content, &mut out),
+                    None => span = Some((i + 1, String::new())),
+                }
+            } else if let Some((_, content)) = span.as_mut() {
+                content.push(c);
+            }
+        }
+        if let Some((_, content)) = span.as_mut() {
+            content.push(' ');
+        }
+        i += 1;
+    }
+    out.sort_by_key(|r| r.line);
+    out
+}
+
+/// A code line without its shell comment.
+fn comment_cut(line: &str) -> &str {
+    if line.trim_start().starts_with('#') {
+        return "";
+    }
+    line.find(" #").map_or(line, |at| &line[..at])
+}
+
+/// An inline span: commands, and the path it is or the paths it holds.
+fn inline(line: usize, content: &str, out: &mut Vec<Ref>) {
+    let content = content.trim();
+    commands(line, content, out);
+    if content.split_whitespace().count() == 1 {
+        if path_parts(content).is_some() {
+            out.push(Ref {
+                line,
+                kind: Kind::Path { short: true },
+                text: content.into(),
+            });
+        }
+    } else {
+        code_paths(line, content, out);
+    }
+}
+
+/// The path-like tokens of a code line, with quotes, brackets and a
+/// `NAME=` or `--flag=` prefix taken off.
+fn code_paths(line: usize, code: &str, out: &mut Vec<Ref>) {
+    for token in code.split_whitespace() {
+        let token = token.rsplit('=').next().unwrap_or(token);
+        let token = token.trim_start_matches(['(', '"', '\'']);
+        let token = token.trim_end_matches([')', ',', ';', '.', '"', '\'']);
+        if path_parts(token).is_some() {
+            out.push(Ref {
+                line,
+                kind: Kind::Path { short: false },
+                text: token.into(),
+            });
+        }
+    }
+}
+
+/// `cargo xtask ...` and `cargo run -p game-testbed ... -- ...` in code, up
+/// to the end of the command.
+fn commands(line: usize, code: &str, out: &mut Vec<Ref>) {
+    for (prefix, kind) in [(XTASK, Kind::Xtask), (PROBE, Kind::Probe)] {
+        let mut rest = code;
+        while let Some(at) = rest.find(prefix) {
+            rest = &rest[at + prefix.len()..];
+            if !(rest.is_empty() || rest.starts_with(char::is_whitespace)) {
+                continue;
+            }
+            let mut tokens: Vec<&str> = rest
+                .split_whitespace()
+                .take_while(|t| !["|", "||", "&&", ";", "&", ">", ">>"].contains(t))
+                .collect();
+            if kind == Kind::Probe {
+                let Some(dashes) = tokens.iter().position(|t| *t == "--") else {
+                    continue;
+                };
+                tokens.drain(..=dashes);
+            }
+            if tokens.first().is_some_and(|t| !placeholder(t)) {
+                out.push(Ref {
+                    line,
+                    kind,
+                    text: tokens.join(" "),
+                });
+            }
+        }
+    }
+}
+
+/// The `ENG_*` variables and `[E-*]`/`[W-*]` tags on a line.
+fn names(line: usize, text: &str, out: &mut Vec<Ref>) {
+    for name in vars(text) {
+        out.push(Ref {
+            line,
+            kind: Kind::Var,
+            text: name,
+        });
+    }
+    for name in tags(text) {
+        out.push(Ref {
+            line,
+            kind: Kind::Tag,
+            text: name,
+        });
+    }
+}
+
+/// `ENG_X` names in `text`: `ENG_`, then capitals, digits and `_`.
+pub fn vars(text: &str) -> Vec<String> {
+    let bytes = text.as_bytes();
+    let name_byte = |b: u8| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_';
+    let mut out = Vec::new();
+    let mut i = 0;
+    while let Some(at) = text[i..].find("ENG_").map(|at| at + i) {
+        let mut end = at + 4;
+        while end < bytes.len() && name_byte(bytes[end]) {
+            end += 1;
+        }
+        let name = text[at..end].trim_end_matches('_');
+        let whole = at == 0 || !(bytes[at - 1].is_ascii_alphanumeric() || bytes[at - 1] == b'_');
+        if whole && name.len() > 4 {
+            out.push(name.to_string());
+        }
+        i = end;
+    }
+    out
+}
+
+/// `[E-X]` and `[W-X]` tags in `text`, and `[E-X-*]` families.
+pub fn tags(text: &str) -> Vec<String> {
+    let bytes = text.as_bytes();
+    let tag_byte = |b: u8| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'-';
+    let mut out = Vec::new();
+    for (at, _) in text.match_indices('[') {
+        let rest = &bytes[at + 1..];
+        if !(rest.starts_with(b"E-") || rest.starts_with(b"W-")) {
+            continue;
+        }
+        let mut end = 2;
+        while end < rest.len() && tag_byte(rest[end]) {
+            end += 1;
+        }
+        if rest.get(end) == Some(&b'*') {
+            end += 1;
+        }
+        if end > 2 && rest.get(end) == Some(&b']') {
+            out.push(text[at..at + end + 2].to_string());
+        }
+    }
+    out
+}
+
+/// A path and its line range, if `token` is made of path characters with
+/// whole `<placeholders>` and an optional `:N` or `:N-M` suffix.
+fn path_parts(token: &str) -> Option<(&str, Option<(usize, usize)>)> {
+    let (path, lines) = match token.rsplit_once(':') {
+        Some((path, lines)) => {
+            let (from, to) = lines.split_once('-').unwrap_or((lines, lines));
+            (path, Some((from.parse().ok()?, to.parse().ok()?)))
+        }
+        None => (token, None),
+    };
+    let chars = path
+        .chars()
+        .all(|c| c.is_ascii_alphanumeric() || "_.-/*<>".contains(c));
+    let mut open = false;
+    let placeholders = path.chars().all(|c| match c {
+        '<' if !open => {
+            open = true;
+            true
+        }
+        '>' if open => {
+            open = false;
+            true
+        }
+        '<' | '>' => false,
+        '/' => !open,
+        _ => true,
+    }) && !open;
+    let ok = chars
+        && placeholders
+        && !path.is_empty()
+        && !path.starts_with('-')
+        && !path.contains("..")
+        && !path.contains("//");
+    ok.then_some((path, lines))
+}
+
+/// `<name>`, `[--flag]`, `{a,b}`, `N`, `DIR...`: not a literal word.
+fn placeholder(token: &str) -> bool {
+    token.starts_with(['<', '[', '{'])
+        || token.contains("...")
+        || token
+            .chars()
+            .all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == '_')
+}
+
+#[cfg(test)]
+#[path = "docs_lint_tests.rs"]
+mod tests;
