index 0000000000000000000000000000000000000000..ad44bd9e321f19fb2a40667201b6061127f98f0d
--- /dev/null
+++ b/xtask/src/selftest_docs.rs
@@ -0,0 +1,118 @@
+//! `cargo xtask selftest docs-stale-path` (rung 2, criteria 16 and 20): a
+//! stale path in a scratch copy of AGENTS.md, of docs/ARCHITECTURE.md and of
+//! a skill must each fail docs-check.
+//!
+//! 1. AGENTS.md, docs/ARCHITECTURE.md and every skill are copied to
+//!    `target/selftest/docs-stale-path/`.
+//! 2. In the copies of AGENTS.md, ARCHITECTURE.md and the first skill, the
+//!    first backticked path from the root that exists, as docs-lint reads
+//!    it, gains `-gone`: before its extension, or before its trailing `/`.
+//! 3. `docs::check_docs`, the entry `docs-check` itself runs, must fail on
+//!    the copies, against the real tree, with those three lines and no
+//!    other error.
+
+use std::fs;
+use std::path::Path;
+
+use crate::docs;
+use crate::docs_lint::{self, Kind, Known};
+
+pub fn run(root: &Path) -> Result<String, String> {
+    let ws = root.join("target/selftest/docs-stale-path");
+    let _ = fs::remove_dir_all(&ws);
+    let skills = docs_lint::skill_names(root);
+    let Some(skill) = skills.first() else {
+        return Err("selftest setup: no .claude/skills/*/SKILL.md to plant a stale path in".into());
+    };
+    let mut names = vec!["AGENTS.md".to_string(), "docs/ARCHITECTURE.md".to_string()];
+    names.extend(skills.iter().cloned());
+    for name in &names {
+        let dest = ws.join(name);
+        fs::create_dir_all(dest.parent().expect("has parent")).map_err(|e| e.to_string())?;
+        fs::copy(root.join(name), &dest).map_err(|e| format!("{name}: {e}"))?;
+    }
+    let known = Known::read(root)?;
+    let mut expect = Vec::new();
+    for name in ["AGENTS.md", "docs/ARCHITECTURE.md", skill.as_str()] {
+        expect.push(plant(&ws, name, &known)?);
+    }
+    let found = match docs::check_docs(root, &ws) {
+        Ok(passed) => return Err(format!("docs-check accepted the stale paths: {passed}")),
+        Err(found) => found,
+    };
+    let errors: Vec<&str> = found.lines().filter(|l| l.starts_with("[E-")).collect();
+    let all = expect
+        .iter()
+        .all(|e| errors.iter().any(|l| l.starts_with(e.as_str())));
+    if all && errors.len() == expect.len() {
+        Ok(format!("rejected: {}", errors.join("; ")))
+    } else {
+        Err(format!(
+            "docs-check must fail with exactly:\n{}\nit failed with:\n{found}",
+            expect.join("\n")
+        ))
+    }
+}
+
+/// Renames the first existing path from the root that the copy of `name`
+/// names in backticks; the start of the line docs-lint must give for it.
+fn plant(ws: &Path, name: &str, known: &Known) -> Result<String, String> {
+    let path = ws.join(name);
+    let text = fs::read_to_string(&path).map_err(|e| format!("{name}: {e}"))?;
+    let Some(named) = docs_lint::refs(&text)
+        .into_iter()
+        .find(|r| r.kind == Kind::Path { short: true } && known.exists_from_root(&r.text))
+    else {
+        return Err(format!(
+            "selftest setup: {name} names no path from the root that exists"
+        ));
+    };
+    let stale = gone(&named.text);
+    let mut lines: Vec<String> = text.lines().map(String::from).collect();
+    let line = &mut lines[named.line - 1];
+    let span = format!("`{}`", named.text);
+    if !line.contains(&span) {
+        return Err(format!(
+            "selftest setup: {name}:{} does not contain {span}",
+            named.line
+        ));
+    }
+    *line = line.replacen(&span, &format!("`{stale}`"), 1);
+    fs::write(&path, lines.join("\n") + "\n").map_err(|e| format!("{name}: {e}"))?;
+    Ok(format!(
+        "{} {name}:{}: `{stale}`",
+        docs_lint::TAG,
+        named.line
+    ))
+}
+
+/// `path` renamed so that it no longer exists: `a/b-gone.md`, `a/b-gone/`.
+pub fn gone(path: &str) -> String {
+    if let Some(dir) = path.strip_suffix('/') {
+        return format!("{dir}-gone/");
+    }
+    let (parent, last) = path.rsplit_once('/').map_or(("", path), |(p, l)| (p, l));
+    let renamed = match last.rsplit_once('.') {
+        Some((stem, ext)) if !stem.is_empty() => format!("{stem}-gone.{ext}"),
+        _ => format!("{last}-gone"),
+    };
+    if parent.is_empty() {
+        renamed
+    } else {
+        format!("{parent}/{renamed}")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::gone;
+
+    #[test]
+    fn a_path_gone_keeps_its_shape() {
+        assert_eq!(gone("docs/a/b.md"), "docs/a/b-gone.md");
+        assert_eq!(gone("docs/adr/"), "docs/adr-gone/");
+        assert_eq!(gone("Cargo.toml"), "Cargo-gone.toml");
+        assert_eq!(gone("xtask/src"), "xtask/src-gone");
+        assert_eq!(gone(".cargo/config.toml"), ".cargo/config-gone.toml");
+    }
+}
