+#[test]
+fn a_span_of_words_is_a_command_of_either_program_or_of_another() {
+    let k = known(&[]);
+    let command = |text: &str| verdict(&k, Kind::Command, text);
+    // `replay` is the probe's and xtask's: either may accept it.
+    for ok in [
+        "replay verify",
+        "replay --regen",
+        "dump-world --at-tick N",
+        "ci --job",
+    ] {
+        assert_eq!(command(ok), Some(Ok(())), "{ok}");
+    }
+    // Another program's, or words with no flag: not checked.
+    for skipped in [
+        "git status --porcelain",
+        "cargo test -p x --test y",
+        "dirty unknown",
+    ] {
+        assert_eq!(command(skipped), None, "{skipped}");
+    }
