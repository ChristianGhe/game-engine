+//! Unit tests for docs-lint on synthetic docs, trees and usage texts. The
+//! code scan skips this file: its fixtures name what must not exist.
+
+use std::fs;
+use std::path::Path;
+
+use super::known::{PROBE_USAGE, Usage, probe_usage};
+use super::*;
+
+const DOC: &str = "\
+# Doc
+
+See `docs/adr/`, `docs/gone.md`, `crates/<name>/Cargo.toml` and `tests/shots.rs`;
+`flip/<shot>.png`, `target/agent-logs/` and `fn(&mut World)` are not checked.
+Set ENG_REQUIRE_GPU=1 (not MY_ENG_X) and grep `[E-ARCH-*]` or [W-GONE].
+
+```sh
+cargo xtask quick              # and `cargo xtask nothing`, a comment
+cargo run -p game-testbed -- dump-world --at-tick N \\
+    --input crates/a/scenarios/<name>.input.toml --out a.json
+```
+
+A span that `cargo xtask ci
+--job lint` goes on; `cargo xtask` alone and `cargo xtask <cmd>` name none.
+";
+
+const TREE: &[&str] = &[
+    ".claude/",
+    "Cargo.toml",
+    "crates/",
+    "crates/a/",
+    "crates/a/Cargo.toml",
+    "crates/a/scenarios/",
+    "crates/a/scenarios/walk.input.toml",
+    "crates/a/tests/",
+    "crates/a/tests/shots.rs",
+    "docs/",
+    "docs/adr/",
+    "docs/adr/0001-x.md",
+    "docs/rungs/",
+    "docs/rungs/2/",
+    "docs/rungs/2/plan.md",
+];
+
+/// A probe's `args.rs`, as [`PROBE_USAGE`] holds it.
+const PROBE_SOURCE: &str = r#"use std::path::PathBuf;
+
+pub(crate) const USAGE: &str = "\
+<game> run --headless --ticks N [--seed S]
+           [--report report.json]
+<game> replay verify <recording> [--report report.json]
+<game> replay dump <recording> [--out recording.json]
+<game> dump-world --at-tick N --out world.json [--input script.toml]
+<game> --version [--json]
+<game> help
+
+run and dump-world take [--map NAME]: the game's first map by default.";
+"#;
+
+fn known(tree: &[&str]) -> Known {
+    let probe = probe_usage(PROBE_SOURCE).expect("the fixture's USAGE");
+    Known {
+        tree: tree.iter().map(|p| p.to_string()).collect(),
+        xtask: Usage::parse(crate::USAGE, "cargo xtask "),
+        probe: Usage::parse(&probe, "<game> "),
+        vars: ["ENG_REQUIRE_GPU".to_string()].into(),
+        tags: ["[E-ARCH-FLOOR]".to_string(), "[E-DESYNC]".to_string()].into(),
+        ..Known::default()
+    }
+}
+
+fn verdict(known: &Known, kind: Kind, text: &str) -> Option<Result<(), String>> {
+    known.verdict(&Ref {
+        line: 1,
+        kind,
+        text: text.into(),
+    })
+}
+
+#[test]
+fn references_come_from_spans_fences_and_the_text() {
+    let refs = refs(DOC);
+    let of = |kind: Kind| -> Vec<(usize, &str)> {
+        refs.iter()
+            .filter(|r| r.kind == kind)
+            .map(|r| (r.line, r.text.as_str()))
+            .collect()
+    };
+    assert_eq!(
+        of(Kind::Path { short: true }),
+        [
+            (3, "docs/adr/"),
+            (3, "docs/gone.md"),
+            (3, "crates/<name>/Cargo.toml"),
+            (3, "tests/shots.rs"),
+            (4, "flip/<shot>.png"),
+            (4, "target/agent-logs/"),
+        ]
+    );
+    let code = of(Kind::Path { short: false });
+    assert!(
+        code.contains(&(10, "crates/a/scenarios/<name>.input.toml")),
+        "{code:?}"
+    );
+    assert!(code.contains(&(10, "a.json")), "{code:?}");
+    // The comment's command is not read; a bare `cargo xtask` names none.
+    assert_eq!(of(Kind::Xtask), [(8, "quick"), (13, "ci --job lint")]);
+    assert_eq!(
+        of(Kind::Probe),
+        [(
+            9,
+            "dump-world --at-tick N --input crates/a/scenarios/<name>.input.toml --out a.json"
+        )]
+    );
+    assert_eq!(of(Kind::Var), [(5, "ENG_REQUIRE_GPU")]);
+    assert_eq!(of(Kind::Tag), [(5, "[E-ARCH-*]"), (5, "[W-GONE]")]);
+}
+
+#[test]
+fn a_stale_reference_fails_with_its_file_and_line() {
+    let (checked, stale) = lint("DOC.md", DOC, &known(TREE));
+    assert_eq!(
+        stale,
+        [
+            "[E-DOCS-STALE] DOC.md:3: `docs/gone.md`: no such file or directory in the tree",
+            "[E-DOCS-STALE] DOC.md:5: `[W-GONE]` is in no .rs file under crates/ or xtask/",
+        ]
+    );
+    // 4 spans, 3 names, 2 xtask commands, 1 probe command, 1 path in code.
+    assert_eq!(checked, 11);
+}
+
+#[test]
+fn each_stale_line_is_said_once_and_the_allowed_are_spared() {
+    let doc = "`docs/gone.md` and `docs/gone.md`\n\nUnlock with `.claude/guard-unlock`.\n";
+    let (checked, stale) = lint("AGENTS.md", doc, &known(TREE));
+    assert_eq!(
+        stale,
+        ["[E-DOCS-STALE] AGENTS.md:1: `docs/gone.md`: no such file or directory in the tree"]
+    );
+    assert_eq!(checked, 2);
+    for (name, why) in ALLOWED {
+        assert!(!name.is_empty() && why.len() > 20, "{name}: say why");
+    }
+}
+
+#[test]
+fn xtask_commands_must_be_in_its_usage_with_their_flags_and_values() {
+    let k = known(&[]);
+    for ok in [
+        "quick",
+        "help",
+        "replay --regen",
+        "ci --job lint",
+        "ci --job <job>",
+        "selftest",
+        "selftest [CASE]",
+        "selftest golden-edit",
+        "selftest docs-stale-path",
+        "hook guard",
+        "install-hooks --if-stale",
+        "push --dry-run name",
+        "compare-hashes DIR DIR...",
+    ] {
+        assert_eq!(verdict(&k, Kind::Xtask, ok), Some(Ok(())), "{ok}");
+    }
+    for (bad, why) in [
+        ("frobnicate", "no command `frobnicate`"),
+        ("replay --bless", "`replay` takes no `--bless`"),
+        ("ci --job nightly", "no CI job `nightly`"),
+        ("selftest no-such-case", "no selftest case `no-such-case`"),
+        ("hook nap", "`hook` takes one of guard verify"),
+    ] {
+        let err = verdict(&k, Kind::Xtask, bad).expect("checked").unwrap_err();
+        assert!(
+            err.starts_with(&format!("`cargo xtask {bad}`: {why}")),
+            "{err}"
+        );
+    }
+}
+
+#[test]
+fn probe_commands_must_be_in_its_usage_with_their_flags() {
+    let k = known(&[]);
+    for ok in [
+        "run --headless --ticks 120 --seed 1 --report r.json --map room",
+        "replay verify rec.rec",
+        "replay dump rec.rec --out r.json",
+        "replay",
+        "replay <verify|dump>",
+        "dump-world --at-tick 60 --out world.json",
+        "--version --json",
+        "help",
+    ] {
+        assert_eq!(verdict(&k, Kind::Probe, ok), Some(Ok(())), "{ok}");
+    }
+    for (bad, why) in [
+        ("shoot --at-tick 1", "no command `shoot`"),
+        ("replay check r.rec", "no command `replay check`"),
+        ("run --tick 5", "`run` takes no `--tick`"),
+        (
+            "replay verify r.rec --out x",
+            "`replay verify` takes no `--out`",
+        ),
+        ("--version --yaml", "`--version` takes no `--yaml`"),
+    ] {
+        let err = verdict(&k, Kind::Probe, bad).expect("checked").unwrap_err();
+        let shown = format!("`cargo run -p game-testbed -- {bad}`: {why}");
+        assert!(err.starts_with(&shown), "{err}");
+    }
+}
+
+/// The probe's usage is read from eng-cli's source: this finds it there.
+#[test]
+fn the_probe_usage_is_where_docs_lint_reads_it() {
+    let root = crate::util::find_root(Path::new(env!("CARGO_MANIFEST_DIR"))).expect("root");
+    let source = fs::read_to_string(root.join(PROBE_USAGE)).expect(PROBE_USAGE);
+    let usage = Usage::parse(&probe_usage(&source).expect("const USAGE"), "<game> ");
+    for command in [
+        &["run"][..],
+        &["replay", "verify"],
+        &["dump-world"],
+        &["help"],
+    ] {
+        assert_eq!(usage.check(command), Ok(()), "{command:?}");
+    }
+}
+
+#[test]
+fn paths_from_the_root_must_exist_and_short_ones_must_end_one() {
+    let k = known(TREE);
+    let path = |text: &str, short: bool| verdict(&k, Kind::Path { short }, text);
+    for short in [true, false] {
+        for ok in [
+            "Cargo.toml",
+            "docs/adr/",
+            "docs/adr",
+            "docs/adr/0001-x.md",
+            "docs/rungs/<rung>/plan.md",
+            "crates/*/tests/shots.rs",
+            "**/scenarios/*.input.toml",
+        ] {
+            assert_eq!(path(ok, short), Some(Ok(())), "{ok}");
+        }
+        for bad in [
+            "docs/adr/0002-y.md",
+            "docs/adr/0001-x.md/",
+            "crates/<name>/src/",
+        ] {
+            let err = path(bad, short).expect("checked").unwrap_err();
+            assert!(err.starts_with(&format!("`{bad}`: no such")), "{err}");
+        }
+    }
+    // A whole span with a source extension must end a path in the tree.
+    assert_eq!(path("tests/shots.rs", true), Some(Ok(())));
+    assert_eq!(path("shots.rs", true), Some(Ok(())));
+    assert_eq!(path("*.input.toml", true), Some(Ok(())));
+    assert!(path("tests/gone.rs", true).expect("checked").is_err());
+    // Not from the root otherwise: outputs, branches, code.
+    for skipped in [
+        ("tests/gone.rs", false),
+        ("flip/<shot>.png", true),
+        ("agent/<name>", true),
+        ("version.json", true),
+        ("target/agent-logs/", true),
+        ("target/gone.rs", true),
+        ("eng_math::sqrt", true),
+        ("docs", true),
+        ("a/../b.rs", true),
+        ("<a", true),
+    ] {
+        assert_eq!(path(skipped.0, skipped.1), None, "{skipped:?}");
+    }
+}
+
+#[test]
+fn a_line_suffix_must_be_lines_of_the_file() {
+    let dir = std::env::temp_dir().join(format!("xtask-docs-lint-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(dir.join("src")).expect("scratch");
+    fs::write(dir.join("src/a.rs"), "1\n2\n3\n").expect("scratch");
+    let mut k = known(&["src/", "src/a.rs"]);
+    k.root = dir.clone();
+    let path = |text: &str| verdict(&k, Kind::Path { short: true }, text).expect("checked");
+    assert_eq!(path("src/a.rs:3"), Ok(()));
+    assert_eq!(path("src/a.rs:2-3"), Ok(()));
+    for bad in ["src/a.rs:4", "src/a.rs:0", "src/a.rs:3-2", "src/a.rs:2-9"] {
+        assert_eq!(path(bad), Err(format!("`{bad}`: src/a.rs has 3 lines")));
+    }
+    let _ = fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn variables_and_tags_are_whole_names_and_tags_may_be_families() {
+    assert_eq!(
+        vars("ENG_A=1 MY_ENG_B $ENG_C_ ENG_ x`ENG_D` ▶ENG_E"),
+        ["ENG_A", "ENG_C", "ENG_D", "ENG_E"]
+    );
+    assert_eq!(
+        tags("[E-X] [W-Y-Z] [E-ARCH-*] [E-] [I-NO] [E-lower] ─[E-*]"),
+        ["[E-X]", "[W-Y-Z]", "[E-ARCH-*]", "[E-*]"]
+    );
+    let k = known(&[]);
+    assert_eq!(verdict(&k, Kind::Tag, "[E-ARCH-*]"), Some(Ok(())));
+    assert_eq!(verdict(&k, Kind::Tag, "[E-DESYNC]"), Some(Ok(())));
+    assert!(
+        verdict(&k, Kind::Tag, "[E-GPU-*]")
+            .expect("checked")
+            .is_err()
+    );
+    assert!(
+        verdict(&k, Kind::Var, "ENG_GONE")
+            .expect("checked")
+            .is_err()
+    );
+}
