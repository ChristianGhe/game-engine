index 0000000000000000000000000000000000000000..efea3ea6d74f364052714a3b9950898059bdd6e1
--- /dev/null
+++ b/xtask/src/docs_lint_known.rs
@@ -0,0 +1,360 @@
+//! What docs-lint holds the docs' references against (`docs_lint.rs` says
+//! what it reads): the tree, the names in the code, and the usage texts of
+//! xtask and the probe.
+
+use std::collections::BTreeSet;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use super::{Kind, PROBE, Ref, XTASK, path_parts, placeholder, tags, vars};
+use crate::{ci, glob, selftest, util};
+
+/// The probe's usage text, a `const USAGE` of `<game> <command> ...` lines.
+pub const PROBE_USAGE: &str = "crates/eng-cli/src/args.rs";
+
+/// The extensions of files a doc names by a short path.
+pub const SOURCE: [&str; 5] = ["rs", "wgsl", "toml", "md", "yml"];
+
+/// Directories that are not the tree: version control and build outputs.
+const SKIP: [&str; 3] = [".git", ".jj", "target"];
+
+/// This lint's tests, whose fixtures name what must not exist.
+const OWN_TESTS: &str = "xtask/src/docs_lint_tests.rs";
+
+/// What the docs may name: the tree, the code's names and the usage texts.
+#[derive(Debug, Default)]
+pub struct Known {
+    pub root: PathBuf,
+    /// Repo-relative files, and directories with a trailing `/`.
+    pub tree: BTreeSet<String>,
+    pub xtask: Usage,
+    pub probe: Usage,
+    pub vars: BTreeSet<String>,
+    pub tags: BTreeSet<String>,
+}
+
+impl Known {
+    pub fn read(root: &Path) -> Result<Known, String> {
+        let source = fs::read_to_string(root.join(PROBE_USAGE))
+            .map_err(|e| format!("[E-DOCS] {PROBE_USAGE}: {e}"))?;
+        let probe = probe_usage(&source).ok_or_else(|| {
+            format!(
+                "[E-DOCS] {PROBE_USAGE}: no `const USAGE`, the probe's usage that docs-lint reads"
+            )
+        })?;
+        let mut known = Known {
+            root: root.to_path_buf(),
+            tree: tree(root),
+            xtask: Usage::parse(crate::USAGE, "cargo xtask "),
+            probe: Usage::parse(&probe, "<game> "),
+            ..Known::default()
+        };
+        let code = known.tree.iter().filter(|rel| {
+            (rel.starts_with("crates/") || rel.starts_with("xtask/"))
+                && rel.ends_with(".rs")
+                && rel.as_str() != OWN_TESTS
+        });
+        let (mut found_vars, mut found_tags) = (BTreeSet::new(), BTreeSet::new());
+        for rel in code {
+            if let Ok(text) = fs::read_to_string(root.join(rel)) {
+                found_vars.extend(vars(&text));
+                found_tags.extend(tags(&text).into_iter().filter(|t| !t.ends_with("*]")));
+            }
+        }
+        known.vars = found_vars;
+        known.tags = found_tags;
+        Ok(known)
+    }
+
+    /// Whether `path` is a literal path from the root that exists.
+    pub fn exists_from_root(&self, path: &str) -> bool {
+        let first = path.split('/').next().unwrap_or(path);
+        path_parts(path).is_some_and(|(_, lines)| lines.is_none())
+            && !path.contains(['*', '<'])
+            && first != "target"
+            && self.tree.contains(path)
+    }
+
+    fn at_root(&self, first: &str) -> bool {
+        self.tree.contains(first) || self.tree.contains(&format!("{first}/"))
+    }
+
+    /// `None` if docs-lint does not check `r`.
+    pub fn verdict(&self, r: &Ref) -> Option<Result<(), String>> {
+        let text = r.text.as_str();
+        let tokens: Vec<&str> = text.split_whitespace().collect();
+        let verdict = match r.kind {
+            Kind::Path { short } => return self.path(text, short),
+            Kind::Xtask => self
+                .xtask
+                .check(&tokens)
+                .and_then(|()| xtask_values(&tokens))
+                .map_err(|why| format!("`{XTASK} {text}`: {why} (`{XTASK} help`)")),
+            Kind::Probe => self.probe.check(&tokens).map_err(|why| {
+                format!("`{PROBE} -- {text}`: {why} (the probe's usage, {PROBE_USAGE})")
+            }),
+            Kind::Var if self.vars.contains(text) => Ok(()),
+            Kind::Var => Err(format!(
+                "`{text}` is named in no .rs file under crates/ or xtask/"
+            )),
+            Kind::Tag => {
+                let found = match text.strip_suffix("*]") {
+                    Some(family) => self.tags.iter().any(|t| t.starts_with(family)),
+                    None => self.tags.contains(text),
+                };
+                if found {
+                    Ok(())
+                } else {
+                    Err(format!(
+                        "`{text}` is in no .rs file under crates/ or xtask/"
+                    ))
+                }
+            }
+        };
+        Some(verdict)
+    }
+
+    fn path(&self, text: &str, short: bool) -> Option<Result<(), String>> {
+        let (path, lines) = path_parts(text)?;
+        let first = path.split('/').next().unwrap_or(path);
+        // A bare word such as `xtask` or `docs` is prose, not a path.
+        let rooted = path.starts_with("**/")
+            || (!first.contains(['*', '<']) && path.contains(['/', '.']) && self.at_root(first));
+        let last = path
+            .trim_end_matches('/')
+            .rsplit('/')
+            .next()
+            .unwrap_or(path);
+        let source = last
+            .rsplit_once('.')
+            .is_some_and(|(stem, ext)| !stem.is_empty() && SOURCE.contains(&ext));
+        let pattern = match (rooted, short && source) {
+            _ if first == "target" => return None,
+            (true, _) => path.to_string(),
+            (false, true) => format!("**/{path}"),
+            (false, false) => return None,
+        };
+        let pattern = glob_of(&pattern);
+        let dir = path.ends_with('/');
+        let found: Vec<&String> = self
+            .tree
+            .iter()
+            .filter(|e| (!dir || e.ends_with('/')) && glob::matches(&pattern, e))
+            .collect();
+        let Some(file) = found.first() else {
+            let what = if dir {
+                "directory"
+            } else {
+                "file or directory"
+            };
+            return Some(Err(format!("`{text}`: no such {what} in the tree")));
+        };
+        if let Some((from, to)) = lines
+            && found.len() == 1
+            && !file.ends_with('/')
+        {
+            let count = fs::read_to_string(self.root.join(file.as_str()))
+                .map(|t| t.lines().count())
+                .unwrap_or(0);
+            if from == 0 || from > to || to > count {
+                return Some(Err(format!("`{text}`: {file} has {count} lines")));
+            }
+        }
+        Some(Ok(()))
+    }
+}
+
+/// A usage text's commands: `<prefix><words> [flags...]` lines, with
+/// indented lines going on, and flags on other lines that every command
+/// takes (the probe's `--map`).
+#[derive(Debug, Default)]
+pub struct Usage {
+    entries: Vec<Entry>,
+    shared: BTreeSet<String>,
+}
+
+#[derive(Debug, Default)]
+struct Entry {
+    words: Vec<String>,
+    flags: BTreeSet<String>,
+    /// `<a|b|c>` after the words: the values it takes.
+    choices: Vec<String>,
+}
+
+impl Usage {
+    pub fn parse(text: &str, prefix: &str) -> Usage {
+        let mut usage = Usage::default();
+        for line in text.lines() {
+            let flags = |text: &str| -> Vec<String> {
+                text.split_whitespace()
+                    .filter_map(flag)
+                    .map(String::from)
+                    .collect()
+            };
+            if let Some(rest) = line.strip_prefix(prefix) {
+                // Two spaces start xtask's description of the command.
+                let head = rest.split("  ").next().unwrap_or(rest);
+                let tokens: Vec<&str> = head.split_whitespace().collect();
+                let n = 1 + tokens.iter().skip(1).take_while(|t| word(t)).count();
+                let choices = tokens
+                    .get(n)
+                    .and_then(|t| t.strip_prefix('<')?.strip_suffix('>'))
+                    .filter(|t| t.contains('|'))
+                    .map(|t| t.split('|').map(String::from).collect())
+                    .unwrap_or_default();
+                usage.entries.push(Entry {
+                    words: tokens.iter().take(n).map(|t| t.to_string()).collect(),
+                    flags: flags(head).into_iter().collect(),
+                    choices,
+                });
+            } else if line.starts_with(char::is_whitespace)
+                && let Some(last) = usage.entries.last_mut()
+            {
+                last.flags.extend(flags(line));
+            } else {
+                usage.shared.extend(flags(line));
+            }
+        }
+        usage
+    }
+
+    /// Whether `tokens` (a command and its arguments) is one of the usage's
+    /// commands, with flags and a value that command takes.
+    pub fn check(&self, tokens: &[&str]) -> Result<(), String> {
+        let first = tokens.first().copied().unwrap_or_default();
+        let mut named = false;
+        for entry in self.entries.iter().filter(|e| e.words[0] == first) {
+            named = true;
+            let fits = entry.words.iter().enumerate().skip(1).all(|(i, w)| {
+                tokens
+                    .get(i)
+                    .is_none_or(|t| placeholder(t) || *t == w.as_str())
+            });
+            if !fits {
+                continue;
+            }
+            // `--version` is a command that is also a flag.
+            for token in tokens.iter().skip(usize::from(!first.starts_with("--"))) {
+                if let Some(flag) = flag(token)
+                    && !entry.flags.contains(flag)
+                    && !self.shared.contains(flag)
+                {
+                    return Err(format!("`{}` takes no `{flag}`", entry.words.join(" ")));
+                }
+            }
+            if let Some(value) = tokens.get(entry.words.len())
+                && word(value)
+                && !entry.choices.is_empty()
+                && !entry.choices.iter().any(|c| c == value)
+            {
+                return Err(format!(
+                    "`{first}` takes one of {}, not `{value}`",
+                    entry.choices.join(" ")
+                ));
+            }
+            return Ok(());
+        }
+        let shown: Vec<&str> = tokens
+            .iter()
+            .take(if named { 2 } else { 1 })
+            .copied()
+            .collect();
+        Err(format!("no command `{}`", shown.join(" ")))
+    }
+}
+
+/// A command word: lower-case letters, digits and `-`, not a flag.
+fn word(token: &str) -> bool {
+    !token.is_empty()
+        && !token.starts_with('-')
+        && token
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-')
+}
+
+/// The `--flag` a token names, without brackets, punctuation or `=value`.
+fn flag(token: &str) -> Option<&str> {
+    let token = token.trim_matches(|c: char| "[](),.;:`|".contains(c));
+    let token = token.split('=').next().unwrap_or(token);
+    let name = token.strip_prefix("--")?;
+    let ok = !name.is_empty()
+        && name
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-');
+    ok.then_some(token)
+}
+
+/// The values xtask's own lists give: `ci --job`'s jobs, `selftest`'s cases.
+fn xtask_values(tokens: &[&str]) -> Result<(), String> {
+    let job = tokens.iter().position(|t| *t == "--job");
+    if tokens.first() == Some(&"ci")
+        && let Some(job) = job.and_then(|at| tokens.get(at + 1))
+        && word(job)
+        && !ci::JOBS.contains(job)
+    {
+        return Err(format!("no CI job `{job}`"));
+    }
+    if let ["selftest", case, ..] = tokens
+        && word(case)
+        && !selftest::CASES.contains(case)
+    {
+        return Err(format!("no selftest case `{case}`"));
+    }
+    Ok(())
+}
+
+/// `<name>` placeholders as `*`, for [`glob::matches`].
+fn glob_of(path: &str) -> String {
+    let mut out = String::new();
+    let mut open = false;
+    for c in path.chars() {
+        match c {
+            '<' => {
+                open = true;
+                out.push('*');
+            }
+            '>' => open = false,
+            c if !open => out.push(c),
+            _ => {}
+        }
+    }
+    out
+}
+
+/// The probe's usage text: the string of `const USAGE` in [`PROBE_USAGE`].
+pub fn probe_usage(source: &str) -> Option<String> {
+    let marker = "const USAGE: &str = \"";
+    let body = &source[source.find(marker)? + marker.len()..];
+    let body = body.strip_prefix("\\\n").unwrap_or(body);
+    let end = body.find("\";")?;
+    Some(body[..end].replace("\\\"", "\""))
+}
+
+/// Every file and directory (with a trailing `/`) under `root`, but [`SKIP`]
+/// and nested checkouts.
+fn tree(root: &Path) -> BTreeSet<String> {
+    let mut out = BTreeSet::new();
+    let mut stack = vec![root.to_path_buf()];
+    while let Some(dir) = stack.pop() {
+        let Ok(entries) = fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if name == ".git" {
+                continue;
+            }
+            let rel = util::rel(root, &path);
+            if path.is_dir() {
+                if !SKIP.contains(&name.as_str()) && !path.join(".git").exists() {
+                    out.insert(format!("{rel}/"));
+                    stack.push(path);
+                }
+            } else {
+                out.insert(rel);
+            }
+        }
+    }
+    out
+}
