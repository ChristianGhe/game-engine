new file mode 100644
index 0000000000000000000000000000000000000000..f59e5395f28b14fdea678b3c1f24ca4e390d6e40
--- /dev/null
+++ b/xtask/src/docs_lint_usage.rs
@@ -0,0 +1,277 @@
+//! The usage texts docs-lint reads (`docs_lint.rs` says how): xtask's own
+//! and the probe's, as commands, their flags and their arguments.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+/// A usage text's commands: `<prefix><words> [args...]` lines, with
+/// indented lines going on, and flags on other lines that every command
+/// takes (the probe's `--map`).
+#[derive(Debug, Default)]
+pub struct Usage {
+    entries: Vec<Entry>,
+    /// The shared flags, and whether a value follows each.
+    shared: BTreeMap<String, bool>,
+}
+
+#[derive(Debug, Default)]
+struct Entry {
+    words: Vec<String>,
+    /// The flags, and whether a value follows each.
+    flags: BTreeMap<String, bool>,
+    /// The positional arguments, and what each must be, if anything.
+    slots: Vec<Option<Choice>>,
+    /// The last slot repeats (`DIR...`).
+    repeats: bool,
+    /// What a flag's value must be (`ci --job`).
+    values: BTreeMap<String, Choice>,
+}
+
+/// The values an argument takes, and how to name them.
+#[derive(Debug, Clone)]
+struct Choice {
+    values: Vec<String>,
+    what: String,
+}
+
+impl Usage {
+    pub fn parse(text: &str, prefix: &str) -> Usage {
+        let mut usage = Usage::default();
+        for line in text.lines() {
+            let tokens: Vec<&str> = line.split_whitespace().collect();
+            if let Some(rest) = line.strip_prefix(prefix) {
+                // Two spaces start xtask's description of the command.
+                let head: Vec<&str> = rest
+                    .split("  ")
+                    .next()
+                    .unwrap_or(rest)
+                    .split_whitespace()
+                    .collect();
+                let n = 1 + head.iter().skip(1).take_while(|t| word(t)).count();
+                let mut entry = Entry {
+                    words: head.iter().take(n).map(|t| t.to_string()).collect(),
+                    ..Entry::default()
+                };
+                entry.arguments(head.get(n..).unwrap_or_default());
+                usage.entries.push(entry);
+            } else if line.starts_with(char::is_whitespace)
+                && let Some(last) = usage.entries.last_mut()
+            {
+                last.arguments(&tokens);
+            } else {
+                for (i, token) in tokens.iter().enumerate() {
+                    if let Some(name) = flag(token) {
+                        let value = takes_value(token, tokens.get(i + 1));
+                        usage.shared.insert(name.into(), value);
+                    }
+                }
+            }
+        }
+        usage
+    }
+
+    /// `command`'s `flag` value, or its first positional argument, must be
+    /// one of `values`.
+    pub fn restrict(&mut self, command: &str, flag: Option<&str>, values: &[&str], what: &str) {
+        let choice = Choice {
+            values: values.iter().map(|v| v.to_string()).collect(),
+            what: what.into(),
+        };
+        for entry in self.entries.iter_mut().filter(|e| e.words[0] == command) {
+            match flag {
+                Some(flag) => {
+                    entry.values.insert(flag.into(), choice.clone());
+                }
+                None => {
+                    if let Some(slot) = entry.slots.first_mut() {
+                        *slot = Some(choice.clone());
+                    }
+                }
+            }
+        }
+    }
+
+    /// Flags that the parser in `source` matches (`"--x"`) but the usage
+    /// text leaves out, such as the probe's test-only `--panic-at-tick`:
+    /// every command takes them.
+    pub fn hidden_flags(&mut self, source: &str) {
+        let named: BTreeSet<&str> = self
+            .entries
+            .iter()
+            .flat_map(|e| e.flags.keys().chain(e.words.iter()))
+            .chain(self.shared.keys())
+            .map(String::as_str)
+            .collect();
+        let mut hidden = Vec::new();
+        for (at, _) in source.match_indices("\"--") {
+            let rest = &source[at + 1..];
+            let end = rest[2..]
+                .find(|c: char| !(c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-'))
+                .map_or(rest.len(), |end| end + 2);
+            let name = &rest[..end];
+            if name.len() > 2 && rest[end..].starts_with('"') && !named.contains(name) {
+                hidden.push(name.to_string());
+            }
+        }
+        for name in hidden {
+            self.shared.insert(name, true);
+        }
+    }
+
+    /// Whether `first` is a command of this usage.
+    pub fn has(&self, first: &str) -> bool {
+        self.entries.iter().any(|e| e.words[0] == first)
+    }
+
+    /// Whether `tokens` (a command and its arguments) is one of the usage's
+    /// commands, with flags and arguments that command takes.
+    pub fn check(&self, tokens: &[&str]) -> Result<(), String> {
+        let first = tokens.first().copied().unwrap_or_default();
+        // Both programs print their usage for these.
+        if matches!(first, "--help" | "-h") {
+            return Ok(());
+        }
+        let mut refusal = None;
+        for entry in self.entries.iter().filter(|e| e.words[0] == first) {
+            let fits = entry.words.iter().enumerate().skip(1).all(|(i, w)| {
+                tokens
+                    .get(i)
+                    .is_none_or(|t| placeholder(t) || *t == w.as_str())
+            });
+            if !fits {
+                continue;
+            }
+            let args = tokens.get(entry.words.len()..).unwrap_or_default();
+            match entry.accepts(args, &self.shared) {
+                Ok(()) => return Ok(()),
+                Err(why) => {
+                    refusal.get_or_insert(why);
+                }
+            }
+        }
+        if let Some(why) = refusal {
+            return Err(why);
+        }
+        let shown: Vec<&str> = tokens
+            .iter()
+            .take(if self.has(first) { 2 } else { 1 })
+            .copied()
+            .collect();
+        Err(format!("no command `{}`", shown.join(" ")))
+    }
+}
+
+impl Entry {
+    /// Reads flags, their values and positional slots, up to a plain word
+    /// (xtask's description of the command).
+    fn arguments(&mut self, tokens: &[&str]) {
+        let mut i = 0;
+        while i < tokens.len() {
+            let token = tokens[i];
+            if let Some(name) = flag(token) {
+                let value = takes_value(token, tokens.get(i + 1));
+                self.flags.insert(name.into(), value);
+                i += usize::from(value);
+            } else if word(token) {
+                break;
+            } else {
+                let inner = token.trim_matches(['[', ']', '<', '>']);
+                let choice = (token.starts_with('<') && inner.contains('|')).then(|| Choice {
+                    values: inner.split('|').map(String::from).collect(),
+                    what: format!("one of {}", inner.replace('|', " ")),
+                });
+                self.repeats = token.contains("...");
+                self.slots.push(choice);
+            }
+            i += 1;
+        }
+    }
+
+    fn accepts(&self, args: &[&str], shared: &BTreeMap<String, bool>) -> Result<(), String> {
+        let name = self.words.join(" ");
+        let mut slot = 0;
+        let mut i = 0;
+        while i < args.len() {
+            let token = args[i];
+            i += 1;
+            if token == "--" || !token.chars().any(|c| c.is_ascii_alphanumeric()) {
+                continue;
+            }
+            if let Some(flag) = flag(token) {
+                let Some(&value) = self.flags.get(flag).or_else(|| shared.get(flag)) else {
+                    return Err(format!("`{name}` takes no `{flag}`"));
+                };
+                if value
+                    && !token.contains('=')
+                    && let Some(next) = args.get(i)
+                    && self::flag(next).is_none()
+                {
+                    i += 1;
+                    if let Some(choice) = self.values.get(flag) {
+                        choice.check(next)?;
+                    }
+                }
+                continue;
+            }
+            let last = if self.repeats {
+                self.slots.last()
+            } else {
+                None
+            };
+            let Some(choice) = self.slots.get(slot).or(last) else {
+                return Err(format!("`{name}` takes no `{token}`"));
+            };
+            if let Some(choice) = choice {
+                choice.check(token)?;
+            }
+            slot += 1;
+        }
+        Ok(())
+    }
+}
+
+impl Choice {
+    fn check(&self, value: &str) -> Result<(), String> {
+        if !word(value) || self.values.iter().any(|v| v == value) {
+            Ok(())
+        } else {
+            Err(format!("`{value}` is not {}", self.what))
+        }
+    }
+}
+
+/// Whether a value follows the flag `token` in a usage text: the next token
+/// is no flag, and the flag's own `[...]` does not close.
+fn takes_value(token: &str, next: Option<&&str>) -> bool {
+    !token.ends_with(']') && !token.contains('=') && next.is_some_and(|n| flag(n).is_none())
+}
+
+/// `<name>`, `[--flag]`, `{a,b}`, `N`, `DIR...`: not a literal word.
+pub fn placeholder(token: &str) -> bool {
+    token.starts_with(['<', '[', '{'])
+        || token.contains("...")
+        || token
+            .chars()
+            .all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == '_')
+}
+
+/// A command word: lower-case letters, digits and `-`, not a flag.
+pub fn word(token: &str) -> bool {
+    !token.is_empty()
+        && !token.starts_with('-')
+        && token.chars().any(|c| c.is_ascii_lowercase())
+        && token
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-')
+}
+
+/// The `--flag` a token names, without brackets, punctuation or `=value`.
+pub fn flag(token: &str) -> Option<&str> {
+    let token = token.trim_matches(|c: char| "[](),.;:`|".contains(c));
+    let token = token.split('=').next().unwrap_or(token);
+    let name = token.strip_prefix("--")?;
+    let ok = !name.is_empty()
+        && name
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-');
+    ok.then_some(token)
+}
