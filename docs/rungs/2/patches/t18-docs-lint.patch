+#[test]
+fn each_stale_line_is_said_once_and_the_allowed_are_spared() {
+    let doc = "`docs/gone.md` and `docs/gone.md`\n\n`.claude/guard-unlock`, `CLAUDE.md`.\n";
+    let (checked, stale) = lint("AGENTS.md", doc, &fixture());
