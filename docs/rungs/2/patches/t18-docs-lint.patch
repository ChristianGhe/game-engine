+#[test]
+fn xtask_commands_must_be_in_its_usage_with_their_flags_and_arguments() {
+    let k = known(&[]);
+    for ok in [
+        "quick",
+        "help",
+        "--help",
+        "-h",
+        "replay --regen",
+        "replay --target x86_64-unknown-linux-gnu --out DIR",
+        "ci --job lint",
+        "ci --job <job>",
+        "ci --job",
+        "selftest",
