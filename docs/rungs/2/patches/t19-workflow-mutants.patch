+  # Mutation testing (rung 2, decision 15): cargo-mutants over the core
+  # crates' changed code, in four shards, each held by xtask to a time box
+  # (budgets.toml [ci] mutants_shard_minutes, else 20 minutes). `in-diff`
+  # mutates the diff from the push's base: on main the push's `before`;
+  # elsewhere, and for a `before` off the branch, the merge base with
+  # origin/main, so the whole history is fetched. It is pending when no core
+  # crate changed, and on the schedule and a dispatch, which run `rung-diff`
+  # instead: the diff from the commit that added the current rung's
+  # plan.md, pending on every other run. A missed mutant fails unless
+  # .cargo/mutants.toml excludes it. The job has no `if`: it runs on every
+  # event, as the `ci` gate expects.
+  mutants:
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [0, 1, 2, 3]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 40
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+      # Before the install: rust-cache restores ~/.cargo/bin, and an
+      # installed cargo-mutants of the same version is kept.
+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
+        with:
+          save-if: ${{ github.ref == 'refs/heads/main' }}
+      - name: cargo-mutants 27.1.0
+        run: cargo install --locked cargo-mutants@27.1.0
+      # Incremental builds here, unlike the workflow's default: each mutant
+      # rebuilds one crate, in half the time so (0.9 s against 1.7 s on a
+      # Mac, T19; the tests take longer). The 20-minute box is unproven on
+      # these 4-vCPU runners: shard 3/4 of rung 2's diff, 194 mutants, took
+      # 10 minutes on an M-series Mac.
+      - name: cargo xtask ci --job mutants
+        env:
+          CARGO_INCREMENTAL: "1"
+          ENG_MUTANTS_BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}
+          ENG_MUTANTS_SHARD: ${{ matrix.shard }}/4
+        run: cargo xtask ci --job mutants
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        if: always()
+        with:
+          name: report-mutants-${{ matrix.shard }}
+          path: target/ci/reports/
+      # cargo-mutants' own output (the missed, caught and timed-out lists,
+      # outcomes.json, each mutant's diff and log), for the test-auditor
+      # subagent.
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        if: always()
+        with:
+          name: mutants-out-${{ matrix.shard }}
+          path: target/mutants/
+          if-no-files-found: ignore
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        if: always()
+        with:
+          name: logs-mutants-${{ matrix.shard }}
+          path: target/agent-logs/
+
