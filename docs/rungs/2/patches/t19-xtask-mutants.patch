+//! How a mutants step is judged (`mutants.rs`): cargo-mutants' `outcomes.json`,
+//! as far as a run got, counted, and the step's verdict from the counts.
+
+use serde_json::{Value, json};
+
+use crate::util::Done;
+
+/// A mutant the tests missed: cargo-mutants' name for it
+/// (`file:line:column: replace … in function`) and its kind of change.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Missed {
+    pub name: String,
+    pub file: String,
+    pub line: u64,
+    pub genre: String,
+}
+
+/// What cargo-mutants' `outcomes.json` says.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Tally {
+    /// The unmutated tree's outcome (`Success` when its tests pass).
+    pub baseline: Option<String>,
+    pub tested: u64,
+    pub caught: u64,
+    pub timeout: u64,
+    pub unviable: u64,
+    pub missed: Vec<Missed>,
+}
+
+impl Tally {
+    pub fn to_json(&self) -> Value {
+        let missed: Vec<Value> = self
+            .missed
+            .iter()
+            .map(|m| json!({"name": m.name, "file": m.file, "line": m.line, "genre": m.genre}))
+            .collect();
+        json!({
+            "baseline": self.baseline, "tested": self.tested, "caught": self.caught,
+            "timeout": self.timeout, "unviable": self.unviable, "missed": missed,
+        })
+    }
+}
+
+/// Reads `outcomes.json`: the baseline, then one outcome per mutant tested
+/// (as far as an interrupted run got).
+pub fn tally(outcomes: &Value) -> Tally {
+    let mut tally = Tally::default();
+    let list = outcomes["outcomes"]
+        .as_array()
+        .map(Vec::as_slice)
+        .unwrap_or_default();
+    for outcome in list {
+        let summary = outcome["summary"].as_str().unwrap_or("?").to_string();
+        let Some(mutant) = outcome["scenario"].get("Mutant") else {
+            tally.baseline = Some(summary);
+            continue;
+        };
+        tally.tested += 1;
+        match summary.as_str() {
+            "CaughtMutant" => tally.caught += 1,
+            "Timeout" => tally.timeout += 1,
+            "Unviable" => tally.unviable += 1,
+            _ => tally.missed.push(Missed {
+                name: mutant["name"].as_str().unwrap_or("?").to_string(),
+                file: mutant["file"].as_str().unwrap_or("?").to_string(),
+                line: mutant["span"]["start"]["line"].as_u64().unwrap_or(0),
+                genre: mutant["genre"].as_str().unwrap_or("?").to_string(),
+            }),
+        }
+    }
+    tally
+}
+
+/// A step's verdict from its tally: `planned` mutants on the shard,
+/// cargo-mutants' exit `code`, and whether the time box of `minutes`
+/// `stopped` it. Every miss fails the step, each listed on its own line
+/// and the counts last (a report keeps a step's last lines).
+pub fn verdict(
+    tally: &Tally,
+    planned: u64,
+    code: Option<i32>,
+    stopped: bool,
+    minutes: u64,
+) -> Result<Done, String> {
+    let Tally {
+        tested,
+        caught,
+        timeout,
+        unviable,
+        ..
+    } = *tally;
+    let missed = tally.missed.len();
+    let untested = planned.saturating_sub(tested);
+    let counts = format!(
+        "{tested} of {planned} mutants tested: {caught} caught, {missed} missed, \
+         {timeout} timed out (caught), {unviable} unviable"
+    );
+    let time_box = format!("stopped at the {minutes}-minute time box with {untested} untested");
+    match tally.baseline.as_deref() {
+        Some("Success") => {}
+        Some(other) => {
+            return Err(format!(
+                "[E-MUTANTS] the unmutated tree's tests did not pass (baseline: {other}), \
+                 so no mutant was tested"
+            ));
+        }
+        None if stopped => return Err(format!("[E-MUTANTS-TIME] the baseline {time_box}")),
+        None => {
+            return Err(format!(
+                "[E-MUTANTS] cargo-mutants (exit {code:?}) ran no baseline"
+            ));
+        }
+    }
+    if missed > 0 {
+        let mut lines: Vec<String> = tally
+            .missed
+            .iter()
+            .map(|m| format!("{} [{}]", m.name, m.genre))
+            .collect();
+        let stop = if stopped {
+            format!("; {time_box}")
+        } else {
+            String::new()
+        };
+        lines.push(format!(
+            "[E-MUTANT-MISSED] {missed} missed, none excluded by .cargo/mutants.toml: \
+             {counts}{stop}"
+        ));
+        return Err(lines.join("\n"));
+    }
+    if stopped {
+        return Err(format!("[E-MUTANTS-TIME] {counts}; {time_box}"));
+    }
+    if untested > 0 || !matches!(code, Some(0 | 3)) {
+        return Err(format!(
+            "[E-MUTANTS] cargo-mutants exited {code:?}: {counts}, {untested} untested"
+        ));
+    }
+    Ok(Done::Pass(format!("{counts}; none missed")))
+}
diff --git a/xtask/src/mutants_skip.rs b/xtask/src/mutants_skip.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7132b1db79700103ecb2f237f877e17286a8a3b3
--- /dev/null
+++ b/xtask/src/mutants_skip.rs
@@ -0,0 +1,60 @@
+//! Exclusions live only in `.cargo/mutants.toml`, the owner's (`mutants.rs`).
+//! cargo-mutants 27.1.0 also honours `#[mutants::skip]` in source, and
+//! inside a `cfg_attr` with a bare condition: `#[cfg_attr(miri,
+//! mutants::skip)]` compiles without the `mutants` crate and still exempts
+//! the function, so an ordinary change could add one. So before a step runs,
+//! the core crates' Rust files are scanned for the path `mutants::skip` in
+//! code, and any use fails the step with `[E-MUTANTS-SKIP]`.
+//!
+//! The scan reads `arch_scan`'s tokens: a mention in a comment or a string
+//! literal exempts nothing and does not count, and spaces or line breaks
+//! inside the path do not hide it. A `use` of the path counts too.
+
+use std::fs;
+use std::path::Path;
+
+use crate::{arch_scan, util};
+
+/// The line of each `mutants::skip` path in `src`'s code.
+pub fn skips(src: &str) -> Vec<usize> {
+    let toks = arch_scan::tokens(src);
+    let text = |i: usize| toks.get(i).map_or("", |t| t.text.as_str());
+    (0..toks.len())
+        .filter(|&i| {
+            text(i) == "mutants"
+                && text(i + 1) == ":"
+                && text(i + 2) == ":"
+                && text(i + 3) == "skip"
+        })
+        .map(|i| toks[i].line)
+        .collect()
+}
+
+/// Fails with one `[E-MUTANTS-SKIP] file:line` line for each
+/// `mutants::skip` in a Rust file under one of the `core` crates'
+/// directories (`crates/<name>/`, its tests too).
+pub fn check(root: &Path, core: &[String]) -> Result<(), String> {
+    let mut found = Vec::new();
+    for name in core {
+        for file in util::walk(&root.join("crates").join(name)) {
+            if file.extension().is_none_or(|e| e != "rs") {
+                continue;
+            }
+            let Ok(src) = fs::read_to_string(&file) else {
+                continue;
+            };
+            for line in skips(&src) {
+                found.push(format!(
+                    "[E-MUTANTS-SKIP] {}:{line}: `mutants::skip` exempts code from mutation \
+                     testing; exclude it in .cargo/mutants.toml (the owner's) instead",
+                    util::rel(root, &file)
+                ));
+            }
+        }
+    }
+    if found.is_empty() {
+        Ok(())
+    } else {
+        Err(found.join("\n"))
+    }
+}
