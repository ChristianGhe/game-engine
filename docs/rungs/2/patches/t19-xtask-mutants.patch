+//! The mutants job's git side (`mutants.rs`): the base of `in-diff` (the
+//! push's, taken as the bench job takes it), the base of `rung-diff` (the
+//! commit that added the current rung's `plan.md`), and the diff from a
+//! base to the working tree over the core crates.
+
+use std::path::Path;
+use std::process::Command;
+
+/// Where the `in-diff` base comes from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Request {
+    /// `--base REV`.
+    Given(String),
+    /// The push's `before`, or a pull request's base (`ENG_MUTANTS_BASE`).
+    Event(String),
+    /// Neither: the merge base of `HEAD` with `origin/main`.
+    MergeBase,
+}
+
+/// Which base to look for: `--base`, else the push's `before`, unless it is
+/// empty or all zeros (a new branch), else a merge base with `main`.
+pub fn request(arg: Option<&str>, event: Option<&str>) -> Request {
+    if let Some(rev) = arg {
+        return Request::Given(rev.to_string());
+    }
+    match event.map(str::trim) {
+        Some(sha) if !sha.is_empty() && !sha.bytes().all(|b| b == b'0') => {
+            Request::Event(sha.to_string())
+        }
+        _ => Request::MergeBase,
+    }
+}
+
+/// `git <args>` in `dir`: its stdout as it is, or its stderr.
+fn raw(dir: &Path, args: &[&str]) -> Result<String, String> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(args)
+        .output()
+        .map_err(|e| format!("git: {e}"))?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+    } else {
+        Err(format!(
+            "git {}: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&out.stderr).trim()
+        ))
+    }
+}
+
+/// `git <args>` in `dir`: its trimmed stdout, or its stderr.
+pub fn git(dir: &Path, args: &[&str]) -> Result<String, String> {
+    raw(dir, args).map(|s| s.trim().to_string())
+}
+
+/// The commit `rev` names, as a full SHA.
+pub fn commit(dir: &Path, rev: &str) -> Result<String, String> {
+    let spec = format!("{rev}^{{commit}}");
+    git(dir, &["rev-parse", "--verify", "--quiet", &spec])
+}
+
+/// Whether this run is for `main`, which only the owner pushes (ADR-0018):
+/// `github_ref` (CI's `GITHUB_REF`) is `refs/heads/main`, or, off CI, the
+/// branch checked out is `main`.
+pub fn on_main(root: &Path, github_ref: Option<&str>) -> bool {
+    match github_ref {
+        Some(r) => r == "refs/heads/main",
+        None => {
+            git(root, &["symbolic-ref", "--quiet", "--short", "HEAD"]).is_ok_and(|b| b == "main")
+        }
+    }
+}
+
+/// A shallow clone has neither the merge base nor the commit that added a
+/// file: its oldest commit seems to add every file it holds.
+fn whole_history(root: &Path) -> Result<(), String> {
+    match git(root, &["rev-parse", "--is-shallow-repository"]) {
+        Ok(shallow) if shallow == "false" => Ok(()),
+        Ok(_) => Err(
+            "[E-MUTANTS] this clone is shallow; fetch the whole history (CI: `fetch-depth: 0`)"
+                .into(),
+        ),
+        Err(e) => Err(format!("[E-MUTANTS] not a git checkout: {e}")),
+    }
+}
+
+/// The `in-diff` base for `request`, and where it came from. Off `main`
+/// (`on_main` false) the push's `before` is the branch's own previous tip,
+/// so the base is the merge base of `HEAD` with `origin/main`: a second push
+/// cannot hide a miss the first brought. On `main`, a `before` the clone
+/// lacks, or that is not an ancestor of `HEAD` (a force-push), gives way to
+/// that merge base too. `--base` is taken as given.
+pub fn resolve(root: &Path, request: &Request, on_main: bool) -> Result<(String, String), String> {
+    whole_history(root)?;
+    let merge_base = |note: &str| -> Result<(String, String), String> {
+        let main = ["origin/main", "main"]
+            .into_iter()
+            .find(|m| commit(root, m).is_ok())
+            .ok_or(
+                "[E-MUTANTS] no origin/main or main to take a merge base with; pass --base REV",
+            )?;
+        let sha = git(root, &["merge-base", "HEAD", main])?;
+        Ok((sha, format!("{note}the merge base of HEAD with {main}")))
+    };
+    match request {
+        Request::Given(rev) => commit(root, rev)
+            .map(|sha| (sha, format!("--base {rev}")))
+            .map_err(|_| format!("[E-MUTANTS] --base {rev} is not a commit here")),
+        Request::Event(_) if !on_main => merge_base("off main, not the push's before: "),
+        Request::Event(sha) => match commit(root, sha) {
+            Ok(full) if git(root, &["merge-base", "--is-ancestor", &full, "HEAD"]).is_ok() => {
+                Ok((full, "the push's before (ENG_MUTANTS_BASE)".into()))
+            }
+            Ok(_) => merge_base(&format!("{sha} is not an ancestor of HEAD; ")),
+            Err(_) => merge_base(&format!("{sha} is not in this clone; ")),
+        },
+        Request::MergeBase => merge_base(""),
+    }
+}
+
+/// The `rung-diff` base: the first commit that added
+/// `docs/rungs/<rung>/plan.md`, which holds every change of the rung.
+pub fn rung_start(root: &Path, rung: &str) -> Result<(String, String), String> {
+    whole_history(root)?;
+    let plan = format!("docs/rungs/{rung}/plan.md");
+    let added = git(
+        root,
+        &[
+            "log",
+            "--reverse",
+            "--diff-filter=A",
+            "--format=%H",
+            "--",
+            &plan,
+        ],
+    )?;
+    let sha = added
+        .lines()
+        .next()
+        .ok_or(format!("[E-MUTANTS] no commit here adds {plan}"))?;
+    Ok((sha.to_string(), format!("the commit that added {plan}")))
+}
+
+/// `crates/<name>/` for each core crate, the pathspecs of a core change.
+fn crate_dirs(core: &[String]) -> Vec<String> {
+    core.iter().map(|c| format!("crates/{c}/")).collect()
+}
+
+/// The tracked files that differ between `base` and the working tree under
+/// a core crate's directory, sorted.
+pub fn core_changes(root: &Path, base: &str, core: &[String]) -> Result<Vec<String>, String> {
+    let dirs = crate_dirs(core);
+    let mut args = vec!["diff", "--name-only", "--no-renames", "-z", base, "--"];
+    args.extend(dirs.iter().map(String::as_str));
+    let names = git(root, &args)?;
+    let mut files: Vec<String> = names
+        .split('\0')
+        .filter(|name| !name.is_empty())
+        .map(str::to_string)
+        .collect();
+    files.sort();
+    Ok(files)
+}
+
+/// The diff cargo-mutants reads (`--in-diff`): from `base` to the working
+/// tree, which is what it copies and mutates, so the line numbers agree;
+/// the core crates' Rust files only (in a pathspec `*` also matches `/`).
+/// Fixed prefixes and no colour, renames or external tools, whatever the
+/// git settings.
+pub fn rust_diff(root: &Path, base: &str, core: &[String]) -> Result<String, String> {
+    let globs: Vec<String> = core.iter().map(|c| format!("crates/{c}/*.rs")).collect();
+    let mut args = vec![
+        "diff",
+        "--no-color",
+        "--no-ext-diff",
+        "--no-textconv",
+        "--no-renames",
+        "--src-prefix=a/",
+        "--dst-prefix=b/",
+        base,
+        "--",
+    ];
+    args.extend(globs.iter().map(String::as_str));
+    raw(root, &args)
+}
+
