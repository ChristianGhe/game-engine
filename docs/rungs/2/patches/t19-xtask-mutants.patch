+++ b/xtask/src/mutants.rs
@@ -0,0 +1,483 @@
+//! `cargo xtask mutants` and `ci --job mutants` (rung 2, decision 15; spec
+//! 7.2): cargo-mutants over the core crates' changed code.
+//!
+//! - `in-diff` mutates what a push changed: the diff from the push's base
+//!   (`mutants_git::resolve`, taken as the bench job takes it) to the working
+//!   tree, over the core crates' Rust files. When no core crate changed the
+//!   step is pending (1b's X2): not a pass, and it fails no job.
+//! - `rung-diff` mutates the current rung's core changes: the diff from the
+//!   commit that added `docs/rungs/<rung>/plan.md`. `ci --job mutants` runs
+//!   it on the weekly schedule and a manual dispatch (`GITHUB_EVENT_NAME`
+//!   `schedule` or `workflow_dispatch`) and leaves it pending on every other
+//!   run; `in-diff` is pending on those two.
+//! - A missed mutant fails its step. Exclusions are the owner's, in
+//!   `.cargo/mutants.toml`, which cargo-mutants reads itself: it never makes
+//!   an excluded mutant, so every miss it reports is one no exclusion covers.
+//!   A mutant that times out is caught; one that does not build is unviable.
+//!   Exclusions live there only: a step fails first on any `mutants::skip`
+//!   attribute in a core crate (`[E-MUTANTS-SKIP]`, `mutants_skip.rs`),
+//!   which cargo-mutants would honour without the owner.
+//! - The job runs in shards (`ENG_MUTANTS_SHARD`, `k/n` with `k` from 0, as
+//!   cargo-mutants slices them), each held to a time box (`budgets.toml [ci]
+//!   mutants_shard_minutes`, else [`DEFAULT_MINUTES`]). A shard that reaches
+//!   it is interrupted and fails, with what it missed so far and how many it
+//!   left untested.
+//!
+//! Only the mutated package's tests run for each mutant (cargo-mutants'
+//! default), with proptest's seed fixed ([`PROPTEST_SEED`]), so that a
+//! verdict repeats on every run and machine. The step's report lists every
+//! missed mutant by file, line and operator; the full output is in
+//! `target/mutants/<step>/mutants.out/`, which the `test-auditor` subagent
+//! reads.
+
+use std::fs::{self, File};
+use std::io::Write;
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+use serde_json::{Map, Value, json};
+
+use crate::mutants_git as git;
+use crate::util::{self, Done, Steps};
+use crate::{acceptance, ci};
+
+/// The cargo-mutants the workflow installs (`cargo install --locked`):
+/// the output files read here are this version's.
+pub const VERSION: &str = "27.1.0";
+/// How to install it.
+pub const INSTALL: &str = "cargo install --locked cargo-mutants@27.1.0";
+/// The workflow's shards (`matrix.shard`, `ENG_MUTANTS_SHARD`).
+pub const SHARDS: u32 = 4;
+/// A shard's time box when `budgets.toml [ci]` sets none (decision 15).
+pub const DEFAULT_MINUTES: u64 = 20;
+/// How long an interrupted cargo-mutants gets to stop its tests.
+const GRACE: Duration = Duration::from_secs(60);
+/// `PROPTEST_RNG_SEED` for every run. With random seeds a property test
+/// caught a mutant on one run and missed it on the next (eng-collision-grid's
+/// oracle, T19), so a step's verdict would change with no change to the code.
+pub const PROPTEST_SEED: &str = "1";
+
+/// Which diff a step mutates.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Scope {
+    /// From the push's base.
+    InDiff,
+    /// From the commit that added the current rung's `plan.md`.
+    RungDiff,
+}
+
+impl Scope {
+    /// The step's name in the job's report (`acceptance.json`'s checks).
+    pub fn step(self) -> &'static str {
+        match self {
+            Scope::InDiff => "in-diff",
+            Scope::RungDiff => "rung-diff",
+        }
+    }
+}
+
+/// One of `n` slices of the mutants, `k` counted from 0 (cargo-mutants'
+/// `--shard k/n`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Shard {
+    pub k: u32,
+    pub n: u32,
+}
+
+impl Shard {
+    pub const WHOLE: Shard = Shard { k: 0, n: 1 };
+
+    /// `k/n`, with `k < n`.
+    pub fn parse(text: &str) -> Result<Shard, String> {
+        let bad = || format!("[E-MUTANTS] shard {text:?}: k/n with 0 <= k < n, such as 0/{SHARDS}");
+        let (k, n) = text.trim().split_once('/').ok_or_else(bad)?;
+        let (k, n) = (k.parse::<u32>(), n.parse::<u32>());
+        match (k, n) {
+            (Ok(k), Ok(n)) if k < n => Ok(Shard { k, n }),
+            _ => Err(bad()),
+        }
+    }
+}
+
+impl std::fmt::Display for Shard {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}/{}", self.k, self.n)
+    }
+}
+
+/// `cargo xtask mutants`'s command line.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Options {
+    pub scope: Scope,
+    pub base: Option<String>,
+    pub shard: Shard,
+    pub minutes: Option<u64>,
+}
+
+/// `[--in-diff | --rung-diff] [--base REV] [--shard K/N] [--time-box MINUTES]`.
+pub fn parse(args: &[&str]) -> Result<Options, String> {
+    const USAGE: &str = "cargo xtask mutants [--in-diff | --rung-diff] [--base REV] \
+                         [--shard K/N] [--time-box MINUTES]";
+    let mut opts = Options {
+        scope: Scope::InDiff,
+        base: None,
+        shard: Shard::WHOLE,
+        minutes: None,
+    };
+    let mut rest = args.iter();
+    while let Some(&arg) = rest.next() {
+        let mut value = || {
+            rest.next()
+                .copied()
+                .ok_or(format!("{arg} needs a value\n{USAGE}"))
+        };
+        match arg {
+            "--in-diff" => opts.scope = Scope::InDiff,
+            "--rung-diff" => opts.scope = Scope::RungDiff,
+            "--base" => opts.base = Some(value()?.to_string()),
+            "--shard" => opts.shard = Shard::parse(value()?)?,
+            "--time-box" => {
+                let text = value()?;
+                let minutes = text.parse::<u64>().ok().filter(|m| *m > 0);
+                opts.minutes = Some(minutes.ok_or(format!("--time-box {text}: whole minutes"))?);
+            }
+            other => return Err(format!("unknown argument {other:?}\n{USAGE}")),
+        }
+    }
+    if opts.scope == Scope::RungDiff && opts.base.is_some() {
+        return Err(format!(
+            "--base is for --in-diff; rung-diff's base is the rung's plan\n{USAGE}"
+        ));
+    }
+    Ok(opts)
+}
+
+/// `cargo xtask mutants`: one step, real whatever the event.
+pub fn run(root: &Path, opts: &Options) -> Result<String, String> {
+    let minutes = opts.minutes.unwrap_or_else(|| time_box_minutes(root));
+    let step = opts.scope.step();
+    let mut steps = Steps::default();
+    steps.run_judged(step, || {
+        real_step(root, opts.scope, opts.base.as_deref(), opts.shard, minutes).0
+    });
+    let result = &steps.results[0];
+    let out = util::rel(root, &root.join("target/mutants").join(step));
+    if result.ok {
+        Ok(format!("{}\noutput: {out}", result.detail))
+    } else if result.pending {
+        Ok(format!("{step}: pending, not a pass"))
+    } else {
+        Err(format!("{step} failed; output: {out}"))
+    }
+}
+
+/// Why `scope` waits on a run of `event` (`GITHUB_EVENT_NAME`), or `None`
+/// when it runs: `rung-diff` on the schedule and a dispatch, `in-diff` on
+/// every other run.
+pub fn wait_reason(scope: Scope, event: Option<&str>) -> Option<String> {
+    let scheduled = matches!(event, Some("schedule" | "workflow_dispatch"));
+    let run = event.map_or("a local".to_string(), |e| format!("a {e}"));
+    match (scope, scheduled) {
+        (Scope::InDiff, true) => Some(format!(
+            "{run} run has no push to diff: in-diff runs on pushes and pull requests, \
+             rung-diff on this run (decision 15)"
+        )),
+        (Scope::RungDiff, false) => Some(format!(
+            "{run} run: rung-diff runs on the weekly schedule and a manual dispatch \
+             (decision 15); `cargo xtask mutants --rung-diff` runs it anywhere"
+        )),
+        _ => None,
+    }
+}
+
+/// `ci --job mutants`: both steps, one of them real by the event, on the
+/// shard `ENG_MUTANTS_SHARD` names (all of them when unset). Returns the
+/// report's `mutants` key.
+pub fn steps_into(root: &Path, steps: &mut Steps) -> Map<String, Value> {
+    let env = |key: &str| std::env::var(key).ok().filter(|v| !v.trim().is_empty());
+    let event = env("GITHUB_EVENT_NAME");
+    let shard = env("ENG_MUTANTS_SHARD").map_or(Ok(Shard::WHOLE), |s| Shard::parse(&s));
+    let minutes = time_box_minutes(root);
+    let mut summaries = Map::new();
+    for scope in [Scope::InDiff, Scope::RungDiff] {
+        let mut summary = Value::Null;
+        steps.run_judged(scope.step(), || {
+            let shard = shard.clone()?;
+            if let Some(why) = wait_reason(scope, event.as_deref()) {
+                return Ok(Done::Pending(why));
+            }
+            let (done, found) = real_step(root, scope, None, shard, minutes);
+            summary = found;
+            done
+        });
+        summaries.insert(scope.step().into(), summary);
+    }
+    let mut extra = Map::new();
+    extra.insert(
+        "mutants".into(),
+        json!({
+            "cargo_mutants": VERSION,
+            "event": event,
+            "shard": shard.as_ref().map(Shard::to_string).ok(),
+            "time_box_minutes": minutes,
+            "steps": summaries,
+        }),
+    );
+    extra
+}
+
+/// A shard's time box: `budgets.toml [ci] mutants_shard_minutes`, else
+/// [`DEFAULT_MINUTES`].
+pub fn time_box_minutes(root: &Path) -> u64 {
+    fs::read_to_string(root.join("budgets.toml"))
+        .ok()
+        .and_then(|text| minutes_in(&text))
+        .unwrap_or(DEFAULT_MINUTES)
+}
+
+/// `[ci] mutants_shard_minutes` in `budgets.toml`'s text, if positive.
+pub fn minutes_in(budgets: &str) -> Option<u64> {
+    let table: toml::Table = budgets.parse().ok()?;
+    let minutes = table
+        .get("ci")?
+        .get("mutants_shard_minutes")?
+        .as_integer()?;
+    u64::try_from(minutes).ok().filter(|m| *m > 0)
+}
+
+/// One step, run for real: its base, then [`diff_step`]. Returns how it
+/// ended and what it found, for the report.
+fn real_step(
+    root: &Path,
+    scope: Scope,
+    base: Option<&str>,
+    shard: Shard,
+    minutes: u64,
+) -> (Result<Done, String>, Value) {
+    let mut found = Map::new();
+    let result = (|| {
+        let (sha, from) = match scope {
+            Scope::InDiff => {
+                let event = std::env::var("ENG_MUTANTS_BASE").ok();
+                let github_ref = std::env::var("GITHUB_REF").ok();
+                let on_main = git::on_main(root, github_ref.as_deref());
+                git::resolve(root, &git::request(base, event.as_deref()), on_main)?
+            }
+            Scope::RungDiff => git::rung_start(root, &acceptance::current_rung(root)?)?,
+        };
+        diff_step(
+            root,
+            scope.step(),
+            (&sha, &from),
+            shard,
+            minutes,
+            &mut found,
+        )
+    })();
+    (result, Value::Object(found))
+}
+
+/// cargo-mutants on `shard` of the mutants in the core crates' diff from
+/// `base` (its SHA, and where it came from) to the working tree, held to
+/// `minutes`; `found` gets the counts and the misses. Pending when no core
+/// crate changed; failed by any `mutants::skip` in one, changed or not. The
+/// selftest `mutant-missed` runs this as the job does.
+pub(crate) fn diff_step(
+    root: &Path,
+    step: &str,
+    (base, from): (&str, &str),
+    shard: Shard,
+    minutes: u64,
+    found: &mut Map<String, Value>,
+) -> Result<Done, String> {
+    let short = &base[..base.len().min(12)];
+    let base_line = format!("base {short}, {from}");
+    found.insert("base".into(), json!(base));
+    found.insert("base_from".into(), json!(from));
+    found.insert("shard".into(), json!(shard.to_string()));
+    let core = ci::core_crates(root)?;
+    crate::mutants_skip::check(root, &core)?;
+    let changed = git::core_changes(root, base, &core)?;
+    found.insert("core_files_changed".into(), json!(changed.len()));
+    if changed.is_empty() {
+        return Ok(Done::Pending(format!(
+            "no core crate changed ({base_line}): nothing to mutate (decision 15)"
+        )));
+    }
+    let out = root.join("target/mutants").join(step);
+    let _ = fs::remove_dir_all(&out);
+    fs::create_dir_all(&out).map_err(|e| format!("{}: {e}", out.display()))?;
+    let diff = git::rust_diff(root, base, &core)?;
+    if diff.trim().is_empty() {
+        found.insert("mutants".into(), json!(0));
+        return Ok(Done::Pass(format!(
+            "{} core files changed, none of them Rust: no mutants; {base_line}",
+            changed.len()
+        )));
+    }
+    let diff_file = out.join("core.diff");
+    fs::write(&diff_file, &diff).map_err(|e| format!("{}: {e}", diff_file.display()))?;
+    match version(root) {
+        Some(installed) if installed == VERSION => {}
+        Some(other) => {
+            return Err(format!(
+                "[E-MUTANTS] cargo-mutants {VERSION} is required, not {other}: {INSTALL}"
+            ));
+        }
+        None => {
+            return Err(format!(
+                "[E-MUTANTS] cargo-mutants is not installed: {INSTALL}"
+            ));
+        }
+    }
+    let planned = list(root, step, &diff_file, &core, shard)?;
+    found.insert("mutants".into(), json!(planned));
+    if planned == 0 {
+        return Ok(Done::Pass(format!(
+            "shard {shard} has none of the diff's mutants; {base_line}"
+        )));
+    }
+    let mut cmd = command(root, &diff_file, &core, shard);
+    cmd.arg("--output").arg(&out);
+    let started = Instant::now();
+    let limit = Duration::from_secs(minutes * 60);
+    let (code, stopped) = run_bounded(root, &format!("mutants-{step}"), &mut cmd, limit)?;
+    found.insert("seconds".into(), json!(started.elapsed().as_secs_f64()));
+    found.insert("time_box_reached".into(), json!(stopped));
+    let outcomes = out.join("mutants.out/outcomes.json");
+    let log = util::rel(
+        root,
+        &root.join(format!("target/agent-logs/xtask-mutants-{step}.log")),
+    );
+    let tally = fs::read_to_string(&outcomes)
+        .ok()
+        .and_then(|text| serde_json::from_str::<Value>(&text).ok())
+        .map(|value| tally(&value))
+        .ok_or(format!(
+            "[E-MUTANTS] cargo-mutants (exit {code:?}) wrote no {}; see {log}",
+            util::rel(root, &outcomes)
+        ))?;
+    found.insert("tally".into(), tally.to_json());
+    verdict(&tally, planned, code, stopped, minutes)
+        .map_err(|e| format!("{e}; {base_line}"))
+        .map(|done| match done {
+            Done::Pass(d) => Done::Pass(format!("{d}; {base_line}")),
+            other => other,
+        })
+}
+
+/// The installed cargo-mutants' version, if any.
+pub fn version(root: &Path) -> Option<String> {
+    let out = util::cargo(root)
+        .args(["mutants", "--version"])
+        .output()
+        .ok()?;
+    let text = String::from_utf8_lossy(&out.stdout);
+    let found = text.trim().strip_prefix("cargo-mutants ")?;
+    out.status.success().then(|| found.to_string())
+}
+
+/// `cargo mutants` over the core crates' mutants in `diff`, on `shard`.
+fn command(root: &Path, diff: &Path, core: &[String], shard: Shard) -> Command {
+    let mut cmd = util::cargo(root);
+    cmd.arg("mutants").arg("--in-diff").arg(diff);
+    cmd.env("PROPTEST_RNG_SEED", PROPTEST_SEED);
+    // A deny lint must not make a mutant unviable (`unused_must_use`).
+    cmd.args(["--colors", "never", "--cap-lints", "true"]);
+    for name in core {
+        cmd.args(["--package", name]);
+    }
+    if shard.n > 1 {
+        cmd.args(["--shard", &shard.to_string()]);
+    }
+    if util::on_ci() {
+        cmd.arg("--cargo-arg=--locked");
+    }
+    cmd
+}
+
+/// How many mutants `shard` has, from cargo-mutants' own list.
+fn list(
+    root: &Path,
+    step: &str,
+    diff: &Path,
+    core: &[String],
+    shard: Shard,
+) -> Result<u64, String> {
+    let mut cmd = command(root, diff, core, shard);
+    cmd.args(["--list", "--json"]);
+    let text = util::run_quiet(root, &format!("mutants-{step}-list"), &mut cmd)?;
+    let list: Value = serde_json::from_str(text.trim())
+        .map_err(|e| format!("[E-MUTANTS] cargo mutants --list --json: {e}"))?;
+    let list = list
+        .as_array()
+        .ok_or("[E-MUTANTS] cargo mutants --list --json: not a list")?;
+    Ok(list.len() as u64)
+}
+
+/// Runs `cmd` with its output in `target/agent-logs/xtask-<name>.log`, and
+/// interrupts it at `limit`, as Ctrl-C would, so that it stops its tests
+/// and keeps the outcomes so far. Returns its exit code and whether the
+/// limit stopped it.
+fn run_bounded(
+    root: &Path,
+    name: &str,
+    cmd: &mut Command,
+    limit: Duration,
+) -> Result<(Option<i32>, bool), String> {
+    let dir = root.join("target/agent-logs");
+    let _ = fs::create_dir_all(&dir);
+    let path = dir.join(format!("xtask-{name}.log"));
+    let mut log = File::create(&path).map_err(|e| format!("{}: {e}", path.display()))?;
+    let _ = writeln!(log, "$ {cmd:?}");
+    let err = log.try_clone().map_err(|e| e.to_string())?;
+    cmd.stdin(Stdio::null()).stdout(log).stderr(err);
+    let mut child = cmd
+        .spawn()
+        .map_err(|e| format!("cannot start {cmd:?}: {e}"))?;
+    let deadline = Instant::now() + limit;
+    if let Some(code) = wait_until(&mut child, deadline)? {
+        return Ok((code, false));
+    }
+    interrupt(&child);
+    if let Some(code) = wait_until(&mut child, Instant::now() + GRACE)? {
+        return Ok((code, true));
+    }
+    let _ = child.kill();
+    let status = child.wait().map_err(|e| e.to_string())?;
+    Ok((status.code(), true))
+}
+
+/// The child's exit code once it ends, or `None` at `deadline`.
+fn wait_until(child: &mut Child, deadline: Instant) -> Result<Option<Option<i32>>, String> {
+    loop {
+        if let Some(status) = child.try_wait().map_err(|e| e.to_string())? {
+            return Ok(Some(status.code()));
+        }
+        if Instant::now() >= deadline {
+            return Ok(None);
+        }
+        std::thread::sleep(Duration::from_millis(250));
+    }
+}
+
+/// SIGINT on Unix, where cargo runs cargo-mutants in its own process;
+/// elsewhere the grace period ends in a kill.
+fn interrupt(child: &Child) {
+    if cfg!(unix) {
+        let _ = Command::new("kill")
+            .args(["-INT", &child.id().to_string()])
+            .status();
+    }
+}
