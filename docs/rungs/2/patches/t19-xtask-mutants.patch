+//! The mutants job (`mutants.rs`, `mutants_git.rs`): its command line, which
+//! step a run makes real, the time box, how cargo-mutants' outcomes are
+//! judged, the selftest's verdict and the workflow; the git side is in
+//! `mutants_git_tests.rs`.
+
+use std::fs;
+use std::path::Path;
+
+use serde_json::json;
+
+use super::*;
+use crate::mutants_git::{Request, request};
+
+#[test]
+fn a_shard_is_k_of_n_counted_from_zero() {
+    assert_eq!(Shard::parse("0/4"), Ok(Shard { k: 0, n: 4 }));
+    assert_eq!(Shard::parse(" 3/4\n"), Ok(Shard { k: 3, n: 4 }));
+    assert_eq!(Shard::parse("0/1"), Ok(Shard::WHOLE));
+    for bad in ["4/4", "1/0", "0/0", "1", "a/4", "-1/4", "1/4/4", ""] {
+        assert!(Shard::parse(bad).is_err(), "{bad:?}");
+    }
+    assert_eq!(Shard { k: 2, n: 4 }.to_string(), "2/4");
+}
+
+#[test]
+fn the_command_line_picks_a_scope_a_base_a_shard_and_a_time_box() {
+    let default = Options {
+        scope: Scope::InDiff,
+        base: None,
+        shard: Shard::WHOLE,
+        minutes: None,
+    };
+    assert_eq!(parse(&[]), Ok(default.clone()));
+    assert_eq!(parse(&["--in-diff"]), Ok(default.clone()));
+    assert_eq!(
+        parse(&["--rung-diff", "--shard", "1/4", "--time-box", "5"]),
+        Ok(Options {
+            scope: Scope::RungDiff,
+            shard: Shard { k: 1, n: 4 },
+            minutes: Some(5),
+            ..default.clone()
+        })
+    );
+    assert_eq!(
+        parse(&["--base", "HEAD~2"]),
+        Ok(Options {
+            base: Some("HEAD~2".into()),
+            ..default
+        })
+    );
+    for bad in [
+        &["--rung-diff", "--base", "HEAD~2"][..],
+        &["--time-box", "0"],
+        &["--time-box", "ten"],
+        &["--shard"],
+        &["--shard", "4/4"],
+        &["--all"],
+    ] {
+        assert!(parse(bad).is_err(), "{bad:?}");
+    }
+    assert_eq!(Scope::InDiff.step(), "in-diff");
+    assert_eq!(Scope::RungDiff.step(), "rung-diff");
+}
+
+/// Decision 15: `rung-diff` is real on the weekly schedule and a manual
+/// dispatch, pending on pushes, pull requests and local runs; `in-diff`
+/// the other way round.
+#[test]
+fn rung_diff_runs_on_the_schedule_and_a_dispatch_and_in_diff_on_the_rest() {
+    for event in [Some("schedule"), Some("workflow_dispatch")] {
+        assert_eq!(wait_reason(Scope::RungDiff, event), None, "{event:?}");
+        let why = wait_reason(Scope::InDiff, event).expect("in-diff waits");
+        assert!(why.contains("no push to diff"), "{why}");
+    }
+    for event in [Some("push"), Some("pull_request"), None] {
+        assert_eq!(wait_reason(Scope::InDiff, event), None, "{event:?}");
+        let why = wait_reason(Scope::RungDiff, event).expect("rung-diff waits");
+        assert!(
+            why.contains("weekly schedule and a manual dispatch"),
+            "{why}"
+        );
+    }
+    assert!(
+        wait_reason(Scope::RungDiff, None)
+            .unwrap()
+            .starts_with("a local run")
+    );
+}
+
+#[test]
+fn the_time_box_is_the_budget_else_twenty_minutes() {
+    let budget = "[ci]\npr_tier_minutes = 15\nmutants_shard_minutes = 25\n";
+    assert_eq!(minutes_in(budget), Some(25));
+    for none in [
+        "[ci]\npr_tier_minutes = 15\n",
+        "[ci]\nmutants_shard_minutes = 0\n",
+        "[ci]\nmutants_shard_minutes = -3\n",
+        "[ci]\nmutants_shard_minutes = \"20\"\n",
+        "not toml [",
+    ] {
+        assert_eq!(minutes_in(none), None, "{none}");
+    }
+    assert_eq!(DEFAULT_MINUTES, 20);
+}
+
+/// One mutant's outcome as cargo-mutants 27.1.0 writes it in
+/// `outcomes.json` (fields it adds that are not read here left out).
+fn mutant(line: u64, op: &str, summary: &str) -> serde_json::Value {
+    let name = format!("crates/kit-fps/src/ground.rs:{line}:26: replace {op} in travel");
+    json!({
+        "scenario": {"Mutant": {
+            "name": name, "package": "kit-fps", "file": "crates/kit-fps/src/ground.rs",
+            "function": {"function_name": "travel", "return_type": "-> f64"},
+            "span": {"start": {"line": line, "column": 26}, "end": {"line": line, "column": 27}},
+            "replacement": "+", "genre": "BinaryOperator",
+        }},
+        "summary": summary,
+        "log_path": "log/x.log",
+    })
+}
+
+fn outcomes(baseline: &str, mutants: &[serde_json::Value]) -> serde_json::Value {
+    let mut list = vec![json!({"scenario": "Baseline", "summary": baseline})];
+    list.extend(mutants.iter().cloned());
+    json!({"outcomes": list, "total_mutants": mutants.len(), "cargo_mutants_version": VERSION})
+}
+
+#[test]
+fn a_tally_counts_each_outcome_and_lists_the_misses() {
+    let found = tally(&outcomes(
+        "Success",
+        &[
+            mutant(176, "- with +", "CaughtMutant"),
+            mutant(177, "+ with -", "MissedMutant"),
+            mutant(178, "* with /", "Timeout"),
+            mutant(179, "* with +", "Unviable"),
+        ],
+    ));
+    assert_eq!(found.baseline.as_deref(), Some("Success"));
+    assert_eq!(
+        (found.tested, found.caught, found.timeout, found.unviable),
+        (4, 1, 1, 1)
+    );
+    assert_eq!(
+        found.missed,
+        [Missed {
+            name: "crates/kit-fps/src/ground.rs:177:26: replace + with - in travel".into(),
+            file: "crates/kit-fps/src/ground.rs".into(),
+            line: 177,
+            genre: "BinaryOperator".into(),
+        }]
+    );
+    assert_eq!(tally(&json!({})), Tally::default(), "no outcomes yet");
+}
+
+#[test]
+fn every_miss_fails_the_step_by_file_line_and_operator() {
+    let all_caught = tally(&outcomes(
+        "Success",
+        &[
+            mutant(176, "- with +", "CaughtMutant"),
+            mutant(178, "* with /", "Timeout"),
+        ],
+    ));
+    // A timeout is caught: cargo-mutants exits 3 for it.
+    for code in [Some(0), Some(3)] {
+        let Ok(Done::Pass(detail)) = verdict(&all_caught, 2, code, false, 20) else {
+            panic!("{code:?}: all caught must pass");
+        };
+        assert!(detail.contains("2 of 2 mutants tested"), "{detail}");
+    }
+    let missed = tally(&outcomes(
+        "Success",
+        &[
+            mutant(176, "- with +", "MissedMutant"),
+            mutant(177, "+ with -", "MissedMutant"),
+        ],
+    ));
+    let detail = verdict(&missed, 2, Some(2), false, 20).unwrap_err();
+    let lines: Vec<&str> = detail.lines().collect();
+    assert_eq!(
+        lines[..2],
+        [
+            "crates/kit-fps/src/ground.rs:176:26: replace - with + in travel [BinaryOperator]",
+            "crates/kit-fps/src/ground.rs:177:26: replace + with - in travel [BinaryOperator]",
+        ]
+    );
+    assert!(
+        lines[2].starts_with("[E-MUTANT-MISSED] 2 missed"),
+        "{detail}"
+    );
+    // The time box: misses so far still fail; none missed fails too, with
+    // the untested count.
+    let detail = verdict(&missed, 9, None, true, 20).unwrap_err();
+    assert!(detail.contains("time box with 7 untested"), "{detail}");
+    assert!(detail.contains("[E-MUTANT-MISSED]"), "{detail}");
+    let detail = verdict(&all_caught, 9, Some(1), true, 20).unwrap_err();
+    assert!(detail.starts_with("[E-MUTANTS-TIME]"), "{detail}");
+    assert!(
+        detail.contains("20-minute time box with 7 untested"),
+        "{detail}"
+    );
+    // An error part way, a failing baseline, or no baseline at all.
+    let detail = verdict(&all_caught, 9, Some(1), false, 20).unwrap_err();
+    assert!(detail.contains("7 untested"), "{detail}");
+    let failed = tally(&outcomes("Failure", &[]));
+    let detail = verdict(&failed, 9, Some(4), false, 20).unwrap_err();
+    assert!(detail.contains("baseline: Failure"), "{detail}");
+    let detail = verdict(&Tally::default(), 9, Some(1), false, 20).unwrap_err();
+    assert!(detail.contains("ran no baseline"), "{detail}");
+    let detail = verdict(&Tally::default(), 9, None, true, 20).unwrap_err();
+    assert!(
+        detail.starts_with("[E-MUTANTS-TIME] the baseline"),
+        "{detail}"
+    );
+}
+
+#[test]
+fn the_selftest_wants_the_planted_gap_missed() {
+    use crate::selftest_mutants::judge;
+    let missed = "crates/eng-net-transport/src/lib.rs:70:5: replace selftest_planted_gap -> \
+                  bool with true [FnValue]\n[E-MUTANT-MISSED] 1 missed";
+    assert!(judge(&Err(missed.into())).unwrap().starts_with("rejected"));
+    let other = "crates/eng-net-transport/src/lib.rs:9:5: replace send with () [FnValue]\n\
+                 [E-MUTANT-MISSED] 1 missed";
+    assert!(
+        judge(&Err(other.into())).is_err(),
+        "another function's miss"
+    );
+    assert!(judge(&Err("[E-MUTANTS] not installed".into())).is_err());
+    assert!(judge(&Ok(Done::Pass("none missed".into()))).is_err());
+    assert!(judge(&Ok(Done::Pending("no core crate changed".into()))).is_err());
+}
+
+#[test]
+fn the_in_diff_base_is_the_argument_then_the_push_then_a_merge_base() {
+    let sha = "0123456789abcdef0123456789abcdef01234567";
+    let zeros = "0000000000000000000000000000000000000000";
+    assert_eq!(request(Some("v1"), Some(sha)), Request::Given("v1".into()));
+    assert_eq!(request(None, Some(sha)), Request::Event(sha.into()));
+    assert_eq!(
+        request(None, Some(&format!(" {sha}\n"))),
+        Request::Event(sha.into())
+    );
+    for new_branch in [Some(zeros), Some(""), Some("  "), None] {
+        assert_eq!(
+            request(None, new_branch),
+            Request::MergeBase,
+            "{new_branch:?}"
+        );
+    }
+}
+
+/// The workflow runs the job as xtask expects: four shards named as
+/// `ENG_MUTANTS_SHARD` reads them, the whole history, this cargo-mutants in
+/// the mutants and selftest jobs, the schedule and a dispatch, and the
+/// summary and the `ci` gate waiting for it.
+#[test]
+fn the_workflow_runs_four_shards_with_this_cargo_mutants() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let workflow = fs::read_to_string(root.join(".github/workflows/ci.yml"))
+        .unwrap()
+        .replace("\r\n", "\n");
+    let job = workflow
+        .split("\n  mutants:\n")
+        .nth(1)
+        .and_then(|rest| rest.split("\n\n  ").next())
+        .expect("ci.yml has a mutants job");
+    let shards: Vec<String> = (0..SHARDS).map(|k| k.to_string()).collect();
+    for wanted in [
+        format!("shard: [{}]", shards.join(", ")),
+        format!("ENG_MUTANTS_SHARD: ${{{{ matrix.shard }}}}/{SHARDS}"),
+        "fetch-depth: 0".into(),
+        "cargo xtask ci --job mutants".into(),
+        "report-mutants-${{ matrix.shard }}".into(),
+    ] {
+        assert!(job.contains(&wanted), "the mutants job has no `{wanted}`");
+    }
+    let install = format!("cargo install --locked cargo-mutants@{VERSION}");
+    assert!(job.contains(&install), "the mutants job has no `{install}`");
+    let selftest = workflow.split("\n  selftest:\n").nth(1).unwrap();
+    let selftest = selftest.split("\n\n  ").next().unwrap();
+    assert!(
+        selftest.contains(&install),
+        "the selftest job has no `{install}`"
+    );
+    let on = workflow.split("\njobs:\n").next().unwrap();
+    assert!(
+        on.contains("\n  schedule:\n") && on.contains("\n  workflow_dispatch:"),
+        "{on}"
+    );
+    for waiting in ["\n  summary:\n", "\n  ci:\n"] {
+        let needs = workflow
+            .split(waiting)
+            .nth(1)
+            .unwrap()
+            .lines()
+            .next()
+            .unwrap();
+        assert!(needs.contains("mutants"), "{waiting:?} {needs}");
+    }
+}
+/// `mutants::skip` in code counts in every form cargo-mutants honours or
+/// that could hide it (spaces, line breaks, a raw identifier, a `use`); a
+/// mention in a comment or a string literal exempts nothing and does not.
+#[test]
+fn a_mutants_skip_in_code_counts_and_one_in_a_comment_or_string_does_not() {
+    use crate::mutants_skip::skips;
+    let counted = "\
+#[mutants::skip]
+fn a() {}
+#[cfg_attr(miri, mutants::skip)]
+fn b() {}
+#[cfg_attr(
+    test,
+    mutants :: skip
+)]
+fn c() {}
+use ::mutants::skip;
+#[r#mutants::skip]
+fn d() {}
+";
+    assert_eq!(skips(counted), [1, 3, 7, 10, 11]);
+    let not_counted = r####"
+// #[mutants::skip] in a line comment
+/// and a doc comment: #[cfg_attr(miri, mutants::skip)]
+/* a block /* nested */ #[mutants::skip] */
+const A: &str = "#[mutants::skip]";
+const B: &str = r#"#[mutants::skip]"#;
+fn mutants_skip() {}
+#[mutants::skipped]
+fn e() {}
+"####;
+    assert_eq!(skips(not_counted), Vec::<usize>::new());
+}
+
+/// Only the core crates' Rust files are scanned, their tests included, and
+/// each use is named by file and line.
+#[test]
+fn the_skip_scan_reads_the_core_crates_rust_files() {
+    let dir = std::env::temp_dir().join(format!("xtask-mutants-skip-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&dir);
+    let write = |file: &str, text: &str| {
+        let path = dir.join(file);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(path, text).unwrap();
+    };
+    write(
+        "crates/core-a/src/lib.rs",
+        "//! A.\n\n#[mutants::skip]\npub fn a() {}\n",
+    );
+    write(
+        "crates/core-a/tests/t.rs",
+        "#[cfg_attr(miri, mutants::skip)]\nfn t() {}\n",
+    );
+    write("crates/core-a/notes.txt", "#[mutants::skip]\n");
+    write(
+        "crates/render/src/lib.rs",
+        "#[mutants::skip]\npub fn r() {}\n",
+    );
+    let core = ["core-a".to_string(), "core-b".to_string()];
+    let found = crate::mutants_skip::check(&dir, &core).unwrap_err();
+    let lines: Vec<&str> = found.lines().collect();
+    assert_eq!(lines.len(), 2, "{found}");
+    assert!(
+        lines[0].starts_with("[E-MUTANTS-SKIP] crates/core-a/src/lib.rs:3: "),
+        "{found}"
+    );
+    assert!(
+        lines[1].starts_with("[E-MUTANTS-SKIP] crates/core-a/tests/t.rs:1: "),
+        "{found}"
+    );
+    assert!(lines[0].ends_with("exclude it in .cargo/mutants.toml (the owner's) instead"));
+    assert_eq!(crate::mutants_skip::check(&dir, &core[1..]), Ok(()));
+    let _ = fs::remove_dir_all(&dir);
+}
