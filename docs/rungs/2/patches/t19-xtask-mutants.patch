+//! The mutants job's git side (`mutants_git.rs`) and its pending step, from
+//! temporary repositories.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+use serde_json::Map;
+
+use super::*;
+use crate::mutants::{Shard, diff_step};
+use crate::util::Done;
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(["-c", "user.name=t", "-c", "user.email=t@t"])
+        .args(["-c", "commit.gpgsign=false"])
+        .args(args)
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+fn commit(dir: &Path, file: &str, text: &str) -> String {
+    write(dir, file, text);
+    git(dir, &["add", "-A"]);
+    git(dir, &["commit", "-q", "-m", file]);
+    git(dir, &["rev-parse", "HEAD"])
+}
+
+fn write(dir: &Path, file: &str, text: &str) {
+    let path = dir.join(file);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+/// A repository on `main`: two core crates and one other, as
+/// `architecture.toml` lists them.
+fn repo() -> PathBuf {
+    static NEXT: AtomicU32 = AtomicU32::new(0);
+    let n = NEXT.fetch_add(1, Ordering::Relaxed);
+    let dir = std::env::temp_dir().join(format!("xtask-mutants-{}-{n}", std::process::id()));
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+    // `-b`: git's default branch depends on the machine (Xcode's git: main).
+    git(&dir, &["init", "-q", "-b", "main"]);
+    write(
+        &dir,
+        "architecture.toml",
+        "[crates.core-a]\ncore = true\n[crates.core-b]\ncore = true\n[crates.render]\n",
+    );
+    write(
+        &dir,
+        "crates/core-a/src/lib.rs",
+        "pub fn a() -> u32 {\n    1\n}\n",
+    );
+    write(&dir, "crates/core-b/src/lib.rs", "pub fn b() {}\n");
+    commit(&dir, "crates/render/src/lib.rs", "pub fn r() {}\n");
+    dir
+}
+
+#[test]
+fn the_diff_is_the_core_crates_rust_files_from_the_base_to_the_working_tree() {
+    let dir = repo();
+    let base = git(&dir, &["rev-parse", "HEAD"]);
+    let core = vec!["core-a".to_string(), "core-b".to_string()];
+    assert!(core_changes(&dir, &base, &core).unwrap().is_empty());
+    commit(
+        &dir,
+        "crates/render/src/lib.rs",
+        "pub fn r() -> u8 {\n    0\n}\n",
+    );
+    commit(&dir, "crates/core-a/Cargo.toml", "[package]\n");
+    write(
+        &dir,
+        "crates/core-a/src/lib.rs",
+        "pub fn a() -> u32 {\n    2\n}\n",
+    );
+    write(&dir, "crates/core-b/src/deep/mod.rs", "untracked\n");
+    assert_eq!(
+        core_changes(&dir, &base, &core).unwrap(),
+        ["crates/core-a/Cargo.toml", "crates/core-a/src/lib.rs"],
+        "tracked core files, the working tree's edit included"
+    );
+    // Prefixes and colour stay put whatever the repository's settings.
+    git(&dir, &["config", "diff.noprefix", "true"]);
+    git(&dir, &["config", "color.diff", "always"]);
+    let diff = rust_diff(&dir, &base, &core).unwrap();
+    assert!(diff.contains("--- a/crates/core-a/src/lib.rs\n"), "{diff}");
+    assert!(diff.contains("+++ b/crates/core-a/src/lib.rs\n"), "{diff}");
+    assert!(diff.contains("+    2\n"), "{diff}");
+    assert!(
+        !diff.contains("Cargo.toml") && !diff.contains("render"),
+        "{diff}"
+    );
+    assert!(!diff.contains('\u{1b}'), "no colour codes");
+    let _ = fs::remove_dir_all(&dir);
+}
+
+/// "A push with no core change writes a pending step", and a core change
+/// with no Rust in it has no mutants: neither needs cargo-mutants.
+#[test]
+fn a_diff_without_core_changes_is_pending_and_one_without_rust_has_no_mutants() {
+    let dir = repo();
+    let base = git(&dir, &["rev-parse", "HEAD"]);
+    let head = commit(
+        &dir,
+        "crates/render/src/lib.rs",
+        "pub fn r() -> u8 {\n    0\n}\n",
+    );
+    let mut found = Map::new();
+    let step = diff_step(
+        &dir,
+        "in-diff",
+        (&base, "a test"),
+        Shard::WHOLE,
+        1,
+        &mut found,
+    );
+    let Ok(Done::Pending(why)) = step else {
+        panic!("{step:?}");
+    };
+    assert!(why.starts_with("no core crate changed"), "{why}");
+    assert_eq!(found["core_files_changed"], 0);
+    commit(&dir, "crates/core-b/README.md", "notes\n");
+    let step = diff_step(
+        &dir,
+        "in-diff",
+        (&head, "a test"),
+        Shard::WHOLE,
+        1,
+        &mut found,
+    );
+    let Ok(Done::Pass(detail)) = step else {
+        panic!("{step:?}");
+    };
+    assert!(detail.contains("none of them Rust: no mutants"), "{detail}");
+    // A `mutants::skip` in a core crate fails the step, even one that would
+    // be pending: only the owner's file excludes.
+    let skip = "#[cfg_attr(miri, mutants::skip)]\npub fn b() {}\n";
+    let last = commit(&dir, "crates/core-b/src/lib.rs", skip);
+    let step = diff_step(
+        &dir,
+        "in-diff",
+        (&last, "a test"),
+        Shard::WHOLE,
+        1,
+        &mut found,
+    );
+    let detail = step.unwrap_err();
+    assert!(
+        detail.starts_with("[E-MUTANTS-SKIP] crates/core-b/src/lib.rs:1: "),
+        "{detail}"
+    );
+    let _ = fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn rung_diff_starts_at_the_commit_that_added_the_plan() {
+    let dir = repo();
+    let added = commit(&dir, "docs/rungs/2/plan.md", "# Rung 2\n");
+    commit(&dir, "docs/rungs/2/plan.md", "# Rung 2, revised\n");
+    commit(
+        &dir,
+        "crates/core-a/src/lib.rs",
+        "pub fn a() -> u32 {\n    3\n}\n",
+    );
+    let (sha, from) = rung_start(&dir, "2").unwrap();
+    assert_eq!(sha, added, "the add, not a later edit");
+    assert_eq!(from, "the commit that added docs/rungs/2/plan.md");
+    let missing = rung_start(&dir, "3").unwrap_err();
+    assert!(
+        missing.contains("no commit here adds docs/rungs/3/plan.md"),
+        "{missing}"
+    );
+    // A shallow clone seems to add every file in its one commit.
+    let shallow = dir.with_extension("shallow");
+    let _ = fs::remove_dir_all(&shallow);
+    // `--no-local`: a local clone ignores `--depth`.
+    let (from, to) = (dir.to_string_lossy(), shallow.to_string_lossy());
+    let parent = dir.parent().unwrap();
+    git(
+        parent,
+        &["clone", "-q", "--no-local", "--depth", "1", &from, &to],
+    );
+    assert!(rung_start(&shallow, "2").unwrap_err().contains("shallow"));
+    let _ = fs::remove_dir_all(&shallow);
+    let _ = fs::remove_dir_all(&dir);
+}
+
+/// On `main` the push's `before`, when it is an ancestor of `HEAD`; off it,
+/// or for a `before` off the branch, the merge base with `main`.
+#[test]
+fn the_in_diff_base_on_and_off_main() {
+    let dir = repo();
+    let fork = git(&dir, &["rev-parse", "HEAD"]);
+    commit(&dir, "crates/core-a/src/main.rs", "fn main() {}\n");
+    git(&dir, &["checkout", "-q", "-b", "agent/x", &fork]);
+    let before = commit(
+        &dir,
+        "crates/core-b/src/lib.rs",
+        "pub fn b() -> u8 {\n    0\n}\n",
+    );
+    commit(
+        &dir,
+        "crates/core-b/src/lib.rs",
+        "pub fn b() -> u8 {\n    1\n}\n",
+    );
+    let event = Request::Event(before.clone());
+    assert_eq!(
+        resolve(&dir, &event, true).unwrap(),
+        (
+            before.clone(),
+            "the push's before (ENG_MUTANTS_BASE)".into()
+        )
+    );
+    let (sha, from) = resolve(&dir, &event, false).unwrap();
+    assert_eq!(sha, fork, "an agent branch's whole change");
+    assert_eq!(
+        from,
+        "off main, not the push's before: the merge base of HEAD with main"
+    );
+    let absent = "0123456789abcdef0123456789abcdef01234567";
+    let (sha, from) = resolve(&dir, &Request::Event(absent.into()), true).unwrap();
+    assert_eq!(sha, fork);
+    assert!(
+        from.starts_with(&format!("{absent} is not in this clone")),
+        "{from}"
+    );
+    let main = git(&dir, &["rev-parse", "main"]);
+    let (sha, from) = resolve(&dir, &Request::Event(main.clone()), true).unwrap();
+    assert_eq!(sha, fork, "main's tip is off this branch");
+    assert!(from.contains("is not an ancestor of HEAD"), "{from}");
+    assert_eq!(
+        resolve(&dir, &Request::Given("HEAD~1".into()), false).unwrap(),
+        (before, "--base HEAD~1".into())
+    );
+    assert!(resolve(&dir, &Request::Given("nope".into()), false).is_err());
+    let _ = fs::remove_dir_all(&dir);
+}
