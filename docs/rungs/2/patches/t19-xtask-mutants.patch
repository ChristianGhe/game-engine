+++ b/xtask/src/selftest_mutants.rs
@@ -0,0 +1,122 @@
+//! `cargo xtask selftest mutant-missed` (rung 2, criterion 20): a test gap
+//! planted in a scratch copy must fail the mutants job's `in-diff` step.
+//!
+//! 1. The fresh copy of the workspace (`selftest.rs`), with
+//!    `.cargo/mutants.toml` when there is one, becomes a git repository of
+//!    one commit, the step's base.
+//! 2. A function that no test calls is added to `eng-net-transport`: a core
+//!    crate with no dependencies, whose tests take under a second.
+//! 3. The `in-diff` step runs as `ci --job mutants` runs it
+//!    (`mutants::diff_step`): cargo-mutants must report the function's
+//!    mutants missed, and the step must fail with `[E-MUTANT-MISSED]`
+//!    naming it, which fails the job (`Steps::ok`).
+//!
+//! Without cargo-mutants the case could not run ([`NOT_RUN`]): a failure on
+//! CI, never a pass.
+
+use std::fs;
+use std::path::Path;
+
+use serde_json::Map;
+
+use crate::mutants::{self, Shard};
+use crate::selftest::NOT_RUN;
+use crate::util::{self, Done};
+
+/// Where the gap is planted, and its name.
+const FILE: &str = "crates/eng-net-transport/src/lib.rs";
+const PLANTED: &str = "selftest_planted_gap";
+/// The case's own time box: a baseline and five mutants of one small crate.
+const MINUTES: u64 = 10;
+
+pub fn run(root: &Path, ws: &Path) -> Result<String, String> {
+    if mutants::version(ws).is_none() {
+        return Err(format!(
+            "{NOT_RUN} mutant-missed could not run: cargo-mutants is not installed \
+             ({}, as CI's selftest job has it)",
+            mutants::INSTALL
+        ));
+    }
+    let config = root.join(".cargo/mutants.toml");
+    if config.is_file() {
+        let _ = fs::create_dir_all(ws.join(".cargo"));
+        fs::copy(&config, ws.join(".cargo/mutants.toml"))
+            .map_err(|e| format!("{}: {e}", config.display()))?;
+    }
+    let base = commit_all(ws)?;
+    let path = ws.join(FILE);
+    let mut text = fs::read_to_string(&path).map_err(|e| format!("{FILE}: {e}"))?;
+    text.push_str(&format!(
+        "\n/// Planted by `cargo xtask selftest mutant-missed`: no test calls it.\n\
+         pub fn {PLANTED}(bytes: usize) -> bool {{\n    bytes > MAX_DATAGRAM\n}}\n"
+    ));
+    fs::write(&path, text).map_err(|e| format!("{FILE}: {e}"))?;
+    let mut found = Map::new();
+    let from = "the selftest copy's one commit";
+    let result = mutants::diff_step(
+        ws,
+        "in-diff",
+        (&base, from),
+        Shard::WHOLE,
+        MINUTES,
+        &mut found,
+    );
+    judge(&result)
+}
+
+/// Whether the step failed for the planted gap's mutants.
+pub(crate) fn judge(result: &Result<Done, String>) -> Result<String, String> {
+    match result {
+        Err(detail) if detail.contains("[E-MUTANT-MISSED]") && detail.contains(PLANTED) => {
+            let missed = detail.lines().filter(|l| l.contains(PLANTED)).count();
+            Ok(format!(
+                "rejected: [E-MUTANT-MISSED], {missed} mutants of {PLANTED} missed"
+            ))
+        }
+        Err(detail) => Err(format!(
+            "failed, but not with [E-MUTANT-MISSED] for {PLANTED}:\n{}",
+            util::tail(detail, 15)
+        )),
+        Ok(done) => Err(format!(
+            "the in-diff step let the planted gap through: {done:?}"
+        )),
+    }
+}
+
+/// `git init` and one commit of everything in `ws`; its SHA. No hooks,
+/// signing or identity from this machine's settings.
+fn commit_all(ws: &Path) -> Result<String, String> {
+    let git = |args: &[&str]| -> Result<String, String> {
+        let out = std::process::Command::new("git")
+            .arg("-C")
+            .arg(ws)
+            .args([
+                "-c",
+                "core.hooksPath=/dev/null",
+                "-c",
+                "commit.gpgsign=false",
+            ])
+            .args([
+                "-c",
+                "user.name=xtask selftest",
+                "-c",
+                "user.email=selftest@invalid",
+            ])
+            .args(args)
+            .output()
+            .map_err(|e| format!("git: {e}"))?;
+        if out.status.success() {
+            Ok(String::from_utf8_lossy(&out.stdout).trim().to_string())
+        } else {
+            Err(format!(
+                "selftest setup: git {}: {}",
+                args.join(" "),
+                String::from_utf8_lossy(&out.stderr).trim()
+            ))
+        }
+    };
+    git(&["init", "-q", "-b", "main"])?;
+    git(&["add", "-A"])?;
+    git(&["commit", "-q", "-m", "selftest base"])?;
+    git(&["rev-parse", "HEAD"])
+}
