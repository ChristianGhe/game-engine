+/// Every cargo-mutants run fixes proptest's seed, packages the core crates
+/// and caps lints; a shard is passed only when there is more than one.
+#[test]
+fn cargo_mutants_runs_with_a_fixed_proptest_seed() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let core = ["kit-fps".to_string()];
+    let cmd = command(root, Path::new("core.diff"), &core, Shard { k: 1, n: 4 });
+    let seed = cmd
+        .get_envs()
+        .find(|(key, _)| *key == "PROPTEST_RNG_SEED")
+        .and_then(|(_, value)| value);
+    assert_eq!(seed, Some(std::ffi::OsStr::new(PROPTEST_SEED)));
+    let args: Vec<String> = cmd.get_args().map(|a| a.to_string_lossy().into()).collect();
+    let args = args.join(" ");
+    assert!(args.starts_with("mutants --in-diff core.diff "), "{args}");
+    for wanted in ["--cap-lints true", "--package kit-fps", "--shard 1/4"] {
+        assert!(args.contains(wanted), "{args}");
+    }
+    let whole = command(root, Path::new("core.diff"), &core, Shard::WHOLE);
+    assert!(!whole.get_args().any(|a| a == "--shard"));
