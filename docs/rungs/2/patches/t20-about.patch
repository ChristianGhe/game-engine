diff --git a/about.hbs b/about.hbs
new file mode 100644
index 0000000000000000000000000000000000000000..e5a18401a2761b9ab61102ba6c842a834d0345e9
--- /dev/null
+++ b/about.hbs
@@ -0,0 +1,36 @@
+{{!-
+  The third-party notices (rung 2, decision 17): plain text, rendered by
+  cargo-about from about.toml. PROTECTED (G5). `cargo xtask notices` reads
+  the "Crates" list, the "Licence texts" heading and each text's "=== " and
+  "Used by: " lines, so keep their form. Triple braces: plain text, so no
+  HTML escapes (a BSD licence's name has quotes).
+-}}
+Third-party notices for game-testbed
+====================================
+
+The game-testbed binary contains the third-party Rust crates listed below.
+Each line gives a crate, its version and the licence expression it is
+published under. Each licence text that follows names the crates used
+under it; where a crate offers a choice of licences, the first one on the
+project's accepted list is used.
+
+The list covers the playable targets (x86_64-unknown-linux-gnu,
+x86_64-pc-windows-msvc and aarch64-apple-darwin) and leaves out crates used
+only to build or test. It is generated by cargo-about (`cargo xtask
+notices`).
+
+Crates
+------
+{{#each crates}}
+{{package.name}} {{package.version}}: {{{license}}}
+{{/each}}
+
+Licence texts
+-------------
+{{#each licenses}}
+
+=== {{{name}}} ({{id}})
+Used by: {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}
+
+{{{text}}}
+{{/each}}
diff --git a/about.toml b/about.toml
new file mode 100644
index 0000000000000000000000000000000000000000..df8e26b5c24f70ee56826779949b0b24888e5c25
--- /dev/null
+++ b/about.toml
@@ -0,0 +1,33 @@
+# cargo-about 0.9.3 (rung 2, decision 17): the third-party notices of the
+# testbed binary, which `cargo xtask notices` writes to
+# target/notices/THIRD-PARTY-NOTICES.txt with the template about.hbs, and
+# `cargo xtask dist` puts in each archive. PROTECTED (G5): the owner
+# approves changes.
+#
+# xtask fails unless `accepted` is deny.toml's [licenses] `allow` in the
+# same order (here also the order of preference: an `A OR B` crate is
+# listed under the first one it offers), and `targets` the three playable
+# targets (spec D16).
+accepted = [
+  "MIT",
+  "Apache-2.0",
+  "Apache-2.0 WITH LLVM-exception",
+  "BSD-2-Clause",
+  "BSD-3-Clause",
+  "ISC",
+  "Zlib",
+  "Unicode-3.0",
+  "CC0-1.0",
+  "BSL-1.0",
+]
+targets = [
+  "x86_64-unknown-linux-gnu",
+  "x86_64-pc-windows-msvc",
+  "aarch64-apple-darwin",
+]
+# What is linked into the binary: no build scripts' or tests' crates.
+ignore-build-dependencies = true
+ignore-dev-dependencies = true
+ignore-transitive-dependencies = false
+# Our own crates are unpublished; their licence is the workspace's.
+private = { ignore = true }
