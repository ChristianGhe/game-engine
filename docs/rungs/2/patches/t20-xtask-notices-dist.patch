+/// A PE file's COFF symbol count, the 4 bytes 16 past the `PE\0\0` that
+/// offset 0x3c points at.
+#[test]
+fn pe_coff_symbols_are_counted() {
+    let pe = |symbols: u32| {
+        let mut bytes = vec![0u8; 0x80];
+        bytes[..2].copy_from_slice(b"MZ");
+        bytes[0x3c..0x40].copy_from_slice(&0x40u32.to_le_bytes());
+        bytes[0x40..0x44].copy_from_slice(b"PE\0\0");
+        bytes[0x50..0x54].copy_from_slice(&symbols.to_le_bytes());
+        bytes
+    };
+    assert_eq!(pe_symbols(&pe(0)).unwrap(), 0);
+    assert_eq!(pe_symbols(&pe(7)).unwrap(), 7);
+    let mut not_pe = pe(0);
+    not_pe[0x40] = b'X';
+    assert!(pe_symbols(&not_pe).is_err());
+    assert!(pe_symbols(b"MZ").is_err(), "cut short");
+}
