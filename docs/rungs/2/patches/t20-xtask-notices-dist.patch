@@ -0,0 +1,339 @@
+//! `cargo xtask notices` and the lint job's `notices` step (rung 2,
+//! decision 17, criterion 17; spec 4 and 8.4): the third-party notices of
+//! the testbed binary, from cargo-about.
+//!
+//! - **The config:** `about.toml` and its template `about.hbs` at the repo
+//!   root (protected from G5). Their accepted licences are `deny.toml`'s
+//!   `[licenses] allow`, in the same order, and their targets the three
+//!   playable ones ([`PLAYABLE`], spec D16), with build and dev
+//!   dependencies left out: what is linked into the binary. xtask fails if
+//!   either list drifts from what it should be, or if `about.toml` has any
+//!   other key (a crate's own table could accept a licence off the list).
+//!   The template ends with fixed text for Rust's standard library, which
+//!   cargo-about cannot see.
+//! - **The run:** `cargo fetch`, then cargo-about =0.9.3 with `--offline`
+//!   (licence files come from the crates' own sources, never from a
+//!   repository fetched at run time), `--fail`, and `deny.toml`'s
+//!   `confidence-threshold`. A crate whose licence is off the list fails
+//!   the run (`[E-NOTICES]`).
+//! - **The check:** every third-party crate that `cargo tree` puts in the
+//!   testbed's normal dependency graph on one of the three targets is
+//!   listed, and each listed crate is in some licence text's `Used by:`
+//!   line. cargo-about evaluates the three targets together, so it may list
+//!   a few crates that no one target builds; extra entries are harmless.
+//!
+//! The notices go to [`OUTPUT`]; `cargo xtask dist` copies them into its
+//! folder.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use crate::{ci, util};
+
+/// The playable builds' targets (spec D16): what the notices cover and
+/// what `dist` packages on CI.
+pub const PLAYABLE: [&str; 3] = [
+    "x86_64-unknown-linux-gnu",
+    "x86_64-pc-windows-msvc",
+    "aarch64-apple-darwin",
+];
+
+/// The notices file, also its name in a dist folder.
+pub const FILE: &str = "THIRD-PARTY-NOTICES.txt";
+pub const OUTPUT: &str = "target/notices/THIRD-PARTY-NOTICES.txt";
+
+/// The binary whose graph the notices cover.
+const PACKAGE: &str = "game-testbed";
+const MANIFEST: &str = "crates/game-testbed/Cargo.toml";
+
+/// cargo-about's version, and how to get it (its binary needs `cli`).
+pub const ABOUT_VERSION: &str = "0.9.3";
+const INSTALL: &str = "cargo install --locked cargo-about@0.9.3 --features cli";
+
+/// The template's markers that [`check`] reads.
+const CRATES_HEADING: &str = "Crates\n------\n";
+const TEXTS_HEADING: &str = "Licence texts\n-------------\n";
+const USED_BY: &str = "Used by: ";
+const LICENCE: &str = "=== ";
+
+/// `cargo xtask notices`.
+pub fn run(root: &Path) -> Result<String, String> {
+    generate(root).map(|(_, summary)| summary)
+}
+
+/// Writes [`OUTPUT`] and checks it; returns its path and a one-line
+/// summary.
+pub fn generate(root: &Path) -> Result<(PathBuf, String), String> {
+    let deny = read(&root.join("deny.toml"))?;
+    let about = read(&root.join("about.toml"))?;
+    let threshold = config(&deny, &about)?;
+    about_version(root)?;
+    ci::cargo_step(root, "notices-fetch", &["fetch"])?;
+    let out = root.join(OUTPUT);
+    if let Some(dir) = out.parent() {
+        fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    }
+    let _ = fs::remove_file(&out);
+    let threshold = threshold.to_string();
+    let output = out.display().to_string();
+    let mut args = vec!["about", "generate", "--offline", "--fail"];
+    if util::on_ci() {
+        args.push("--locked");
+    }
+    args.extend([
+        "--threshold",
+        &threshold,
+        "-c",
+        "about.toml",
+        "-m",
+        MANIFEST,
+        "-o",
+        &output,
+        "about.hbs",
+    ]);
+    let mut cmd = util::cargo(root);
+    cmd.args(&args);
+    util::run_quiet(root, "notices", &mut cmd).map_err(|e| about_failed(&e))?;
+    let notices = read(&out)?;
+    let mut graph = BTreeSet::new();
+    for target in PLAYABLE {
+        let args = [
+            "tree", "-p", PACKAGE, "-e", "normal", "--target", target, "--prefix", "none",
+            "--format", "{p}",
+        ];
+        let mut cmd = ci::cargo_command(root, &args);
+        let tree = util::run_quiet(root, &format!("notices-tree-{target}"), &mut cmd)?;
+        let crates = third_party(&tree);
+        if crates.is_empty() {
+            return Err(format!(
+                "[E-NOTICES] cargo tree gave no third-party crates for {target}: has its output \
+                 changed?"
+            ));
+        }
+        graph.extend(crates);
+    }
+    let summary = check(&notices, &graph)?;
+    Ok((out, format!("{summary}; {OUTPUT}")))
+}
+
+fn read(path: &Path) -> Result<String, String> {
+    fs::read_to_string(path).map_err(|e| format!("{}: {e}", path.display()))
+}
+
+/// The `[E-NOTICES]` error for a failed cargo-about run (`log`: what
+/// [`util::run_quiet`] returned): a licence off the list, or another
+/// failure.
+pub(crate) fn about_failed(log: &str) -> String {
+    if log.contains("failed to satisfy license requirements") {
+        format!("[E-NOTICES] a crate's licence is off deny.toml's list: {log}")
+    } else {
+        format!("[E-NOTICES] cargo-about failed: {log}")
+    }
+}
+
+/// The keys `about.toml` may have. Anything else is refused: a crate's own
+/// table (`[name]`, with `accepted` or `clarify`) or `workarounds` could
+/// let a licence off deny.toml's list through, and `max-depth` could hide
+/// licence files.
+const ABOUT_KEYS: [&str; 6] = [
+    "accepted",
+    "targets",
+    "ignore-build-dependencies",
+    "ignore-dev-dependencies",
+    "ignore-transitive-dependencies",
+    "private",
+];
+
+/// Holds `about.toml` (`about`) to `deny.toml` (`deny`): only the keys of
+/// [`ABOUT_KEYS`]; the same licences in the same order; the playable
+/// targets; no build or dev dependencies, every transitive one; our own
+/// crates ignored, and nothing else in `private`. Returns `deny.toml`'s
+/// confidence threshold.
+pub(crate) fn config(deny: &str, about: &str) -> Result<f64, String> {
+    let deny: toml::Table = deny.parse().map_err(|e| format!("deny.toml: {e}"))?;
+    let about: toml::Table = about.parse().map_err(|e| format!("about.toml: {e}"))?;
+    let unknown: Vec<&str> = about
+        .keys()
+        .map(String::as_str)
+        .filter(|key| !ABOUT_KEYS.contains(key))
+        .collect();
+    if !unknown.is_empty() {
+        return Err(format!(
+            "[E-NOTICES] about.toml may set only {ABOUT_KEYS:?}, not {unknown:?}: per-crate \
+             tables, `workarounds` or `max-depth` could let a licence off deny.toml's list \
+             through or hide licence files"
+        ));
+    }
+    let licences = deny
+        .get("licenses")
+        .ok_or("[E-NOTICES] deny.toml has no [licenses] table")?;
+    let strings = |value: Option<&toml::Value>| -> Vec<String> {
+        value
+            .and_then(toml::Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter_map(toml::Value::as_str)
+            .map(String::from)
+            .collect()
+    };
+    let allow = strings(licences.get("allow"));
+    let accepted = strings(about.get("accepted"));
+    if allow.is_empty() || accepted != allow {
+        return Err(format!(
+            "[E-NOTICES] about.toml's `accepted` must be deny.toml's [licenses] `allow`, in its \
+             order: {accepted:?} against {allow:?}"
+        ));
+    }
+    let targets = strings(about.get("targets"));
+    if targets != PLAYABLE {
+        return Err(format!(
+            "[E-NOTICES] about.toml's `targets` must be the playable targets {PLAYABLE:?}, not \
+             {targets:?}"
+        ));
+    }
+    let flag = |key: &str| about.get(key).and_then(toml::Value::as_bool);
+    let private = about.get("private").and_then(toml::Value::as_table);
+    let private_ok = private.is_some_and(|p| {
+        p.len() == 1 && p.get("ignore").and_then(toml::Value::as_bool) == Some(true)
+    });
+    if flag("ignore-build-dependencies") != Some(true)
+        || flag("ignore-dev-dependencies") != Some(true)
+        || flag("ignore-transitive-dependencies").unwrap_or(false)
+        || !private_ok
+    {
+        return Err(
+            "[E-NOTICES] about.toml must set ignore-build-dependencies and \
+             ignore-dev-dependencies, keep transitive dependencies, and set only `ignore = true` \
+             in `private`: the notices cover what is linked into the binary"
+                .into(),
+        );
+    }
+    licences
+        .get("confidence-threshold")
+        .and_then(toml::Value::as_float)
+        .ok_or_else(|| "[E-NOTICES] deny.toml has no [licenses] confidence-threshold".into())
+}
+
+/// cargo-about is installed, at [`ABOUT_VERSION`].
+fn about_version(root: &Path) -> Result<(), String> {
+    let mut cmd = util::cargo(root);
+    cmd.args(["about", "--version"]);
+    let found = cmd
+        .output()
+        .ok()
+        .filter(|out| out.status.success())
+        .map(|out| String::from_utf8_lossy(&out.stdout).trim().to_string());
+    match found {
+        Some(line) if line == format!("cargo-about {ABOUT_VERSION}") => Ok(()),
+        Some(line) => Err(format!(
+            "[E-NOTICES] {line} is installed, not cargo-about {ABOUT_VERSION} ({INSTALL})"
+        )),
+        None => Err(format!(
+            "[E-NOTICES] cargo-about is not installed ({INSTALL})"
+        )),
+    }
+}
+
+/// The third-party crates in `cargo tree --prefix none --format {p}`
+/// output, as `name version`: our own crates (with a path) are left out.
+pub(crate) fn third_party(tree: &str) -> BTreeSet<String> {
+    tree.lines()
+        .filter_map(|line| {
+            let mut words = line.split_whitespace();
+            let name = words.next()?;
+            let version = words.next()?.strip_prefix('v')?;
+            let rest: Vec<&str> = words.collect();
+            let local = rest
+                .iter()
+                .any(|w| w.starts_with('(') && !matches!(*w, "(proc-macro)" | "(*)"));
+            (!local).then(|| format!("{name} {version}"))
+        })
+        .collect()
+}
+
+/// The notices hold every crate of `graph` and a licence text for every
+/// crate they list. Returns the counts, with the crates per licence.
+pub(crate) fn check(notices: &str, graph: &BTreeSet<String>) -> Result<String, String> {
+    // A checkout with CRLF line ends renders the template with them.
+    let notices = &notices.replace("\r\n", "\n");
+    let listed = listed(notices)?;
+    let missing: Vec<&str> = graph
+        .iter()
+        .filter(|krate| !listed.contains(*krate))
+        .map(String::as_str)
+        .collect();
+    if !missing.is_empty() {
+        return Err(format!(
+            "[E-NOTICES] {} crates of the testbed's graph are not in the notices: {}",
+            missing.len(),
+            missing.join(", ")
+        ));
+    }
+    let texts = used_by(notices);
+    let covered: BTreeSet<&str> = texts.values().flatten().map(String::as_str).collect();
+    let bare: Vec<&str> = listed
+        .iter()
+        .map(String::as_str)
+        .filter(|krate| !covered.contains(krate))
+        .collect();
+    if !bare.is_empty() {
+        return Err(format!(
+            "[E-NOTICES] no licence text names {}",
+            bare.join(", ")
+        ));
+    }
+    let counts: Vec<String> = texts
+        .iter()
+        .map(|(id, crates)| format!("{id} {}", crates.len()))
+        .collect();
+    Ok(format!(
+        "{} crates listed ({} in the testbed's graph for {}), {} licences: {}",
+        listed.len(),
+        graph.len(),
+        PLAYABLE.join(", "),
+        texts.len(),
+        counts.join(", ")
+    ))
+}
+
+/// The crates the notices list, as `name version`: the lines between the
+/// two headings, each `name version: expression`.
+fn listed(notices: &str) -> Result<BTreeSet<String>, String> {
+    let start = notices
+        .find(CRATES_HEADING)
+        .ok_or("[E-NOTICES] the notices have no crate list (about.hbs)")?;
+    let body = &notices[start + CRATES_HEADING.len()..];
+    let end = body
+        .find(TEXTS_HEADING)
+        .ok_or("[E-NOTICES] the notices have no licence texts (about.hbs)")?;
+    Ok(body[..end]
+        .lines()
+        .filter_map(|line| line.split_once(": ").map(|(krate, _)| krate.trim()))
+        .filter(|krate| krate.split(' ').count() == 2)
+        .map(String::from)
+        .collect())
+}
+
+/// Each licence id, with the crates its texts' `Used by:` lines name.
+fn used_by(notices: &str) -> BTreeMap<String, BTreeSet<String>> {
+    let mut texts: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
+    let mut current = None;
+    for line in notices.lines() {
+        if let Some(heading) = line.strip_prefix(LICENCE) {
+            // `=== <name> (<id>)`
+            current = heading
+                .rsplit_once(" (")
+                .and_then(|(_, id)| id.strip_suffix(')'))
+                .map(String::from);
+        } else if let (Some(list), Some(id)) = (line.strip_prefix(USED_BY), &current) {
+            let crates = list.split(", ").map(|krate| krate.trim().to_string());
+            texts.entry(id.clone()).or_default().extend(crates);
+        }
+    }
+    texts
+}
+
+#[cfg(test)]
+#[path = "dist_notices_tests.rs"]
+mod tests;
