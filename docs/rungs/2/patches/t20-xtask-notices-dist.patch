+++ b/xtask/src/dist_notices_tests.rs
@@ -0,0 +1,282 @@
+//! The notices' config against deny.toml, and the check of cargo-about's
+//! output against the testbed's graph.
+
+use std::collections::BTreeSet;
+use std::path::Path;
+
+use super::{PLAYABLE, about_failed, check, config, third_party};
+
+fn root() -> &'static Path {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask sits in the repo root")
+}
+
+fn read(name: &str) -> String {
+    std::fs::read_to_string(root().join(name)).unwrap()
+}
+
+/// The committed about.toml takes deny.toml's licences, in order, and the
+/// playable targets, and the threshold comes from deny.toml.
+#[test]
+fn about_toml_follows_deny_toml() {
+    let threshold = config(&read("deny.toml"), &read("about.toml")).unwrap();
+    assert_eq!(threshold, 0.93);
+}
+
+/// A licence added, dropped or moved in one file only fails, as do other
+/// targets and a graph with build or dev dependencies.
+#[test]
+fn about_toml_drifting_from_deny_toml_fails() {
+    let deny = read("deny.toml");
+    let about = read("about.toml");
+    let cases = [
+        about.replace("  \"Zlib\",\n", ""),
+        about.replace(
+            "  \"MIT\",\n  \"Apache-2.0\",\n",
+            "  \"Apache-2.0\",\n  \"MIT\",\n",
+        ),
+        about.replace("  \"BSL-1.0\",\n", "  \"BSL-1.0\",\n  \"MPL-2.0\",\n"),
+        about.replace("  \"aarch64-apple-darwin\",\n", ""),
+        about.replace(
+            "ignore-build-dependencies = true",
+            "ignore-build-dependencies = false",
+        ),
+        about.replace("ignore-dev-dependencies = true", ""),
+        about.replace("private = { ignore = true }", ""),
+    ];
+    for (i, case) in cases.iter().enumerate() {
+        assert_ne!(case, &about, "case {i} changed nothing");
+        let err = config(&deny, case).expect_err(&format!("case {i} passed"));
+        assert!(err.contains("[E-NOTICES]"), "case {i}: {err}");
+    }
+    // deny.toml's side counts the same.
+    let narrower = deny.replacen("  \"BSL-1.0\",\n", "", 1);
+    assert_ne!(narrower, deny);
+    assert!(config(&narrower, &about).is_err());
+}
+
+/// Only the known keys: a crate's own table could accept a licence off
+/// the list for that crate (cargo-about appends it to the global list),
+/// and `workarounds`, `clarify` or `max-depth` change what is read.
+#[test]
+fn about_toml_with_any_other_key_fails() {
+    let deny = read("deny.toml");
+    let about = read("about.toml");
+    let cases = [
+        format!("{about}\n[ring]\naccepted = [\"OpenSSL\"]\n"),
+        format!("{about}\n[foldhash.clarify]\nlicense = \"MIT\"\n"),
+        format!("workarounds = [\"ring\"]\n{about}"),
+        format!("max-depth = 1\n{about}"),
+        about.replace(
+            "ignore-transitive-dependencies = false",
+            "ignore-transitive-dependencies = true",
+        ),
+        about.replace(
+            "private = { ignore = true }",
+            "private = { ignore = true, registries = [\"sauce\"] }",
+        ),
+    ];
+    for (i, case) in cases.iter().enumerate() {
+        assert_ne!(case, &about, "case {i} changed nothing");
+        let err = config(&deny, case).expect_err(&format!("case {i} passed"));
+        assert!(err.contains("[E-NOTICES]"), "case {i}: {err}");
+    }
+    let err = config(&deny, &cases[0]).unwrap_err();
+    assert!(err.contains("\"ring\""), "names the key: {err}");
+    // Leaving the transitive flag out is the same as false.
+    let without = about.replace("ignore-transitive-dependencies = false\n", "");
+    assert_ne!(without, about);
+    assert!(config(&deny, &without).is_ok());
+}
+
+/// A deny.toml without its [licenses] table is an error, not a panic.
+#[test]
+fn deny_toml_without_licences_fails() {
+    let about = read("about.toml");
+    let err = config("[bans]\nmultiple-versions = \"warn\"\n", &about).unwrap_err();
+    assert!(err.contains("no [licenses] table"), "{err}");
+    let err = config("[licenses]\nallow = []\n", &about).unwrap_err();
+    assert!(err.contains("[E-NOTICES]"), "{err}");
+}
+
+/// cargo-about's own words for an off-list licence become that error; any
+/// other failure says cargo-about failed. Both keep the log's text. (The
+/// mapping is a function so this runs without cargo-about failing for
+/// real; the lint step's own failure was checked by hand, with Zlib taken
+/// off both lists.)
+#[test]
+fn a_failed_cargo_about_run_names_its_cause() {
+    let off = "notices failed (exit status: 1); full log: x.log\nerror: failed to satisfy \
+               license requirements\n  foldhash-0.2.0/Cargo.toml:40:12";
+    let err = about_failed(off);
+    assert!(
+        err.starts_with("[E-NOTICES] a crate's licence is off deny.toml's list: "),
+        "{err}"
+    );
+    assert!(err.contains("foldhash-0.2.0"), "{err}");
+    let other = about_failed("cannot start \"cargo\" \"about\": No such file");
+    assert!(
+        other.starts_with("[E-NOTICES] cargo-about failed: cannot start"),
+        "{other}"
+    );
+}
+
+#[test]
+fn the_playable_targets_are_spec_d16s() {
+    assert_eq!(
+        PLAYABLE,
+        [
+            "x86_64-unknown-linux-gnu",
+            "x86_64-pc-windows-msvc",
+            "aarch64-apple-darwin"
+        ]
+    );
+}
+
+/// `cargo tree --prefix none --format {p}`: registry crates count, our own
+/// (with a path) do not; proc-macro and repeat marks are dropped.
+#[test]
+fn third_party_crates_come_from_cargo_tree() {
+    let tree = "\
+game-testbed v0.1.0 (/work/crates/game-testbed)
+eng-app v0.1.0 (/work/crates/eng-app)
+eng-gpu v0.1.0 (C:\\work\\crates\\eng-gpu)
+wgpu v30.0.1
+serde_derive v1.0.229 (proc-macro)
+bitflags v2.13.2
+bitflags v2.13.2 (*)
+eng-math v0.1.0 (/work/crates/eng-math) (*)
+ash v0.38.0+1.3.281
+
+";
+    let found: Vec<String> = third_party(tree).into_iter().collect();
+    assert_eq!(
+        found,
+        [
+            "ash 0.38.0+1.3.281",
+            "bitflags 2.13.2",
+            "serde_derive 1.0.229",
+            "wgpu 30.0.1"
+        ]
+    );
+}
+
+const NOTICES: &str = "\
+Third-party notices for game-testbed
+
+Crates
+------
+adler2 2.0.1: 0BSD OR MIT OR Apache-2.0
+dpi 0.1.2: Apache-2.0 AND MIT
+foldhash 0.2.0: Zlib
+
+Licence texts
+-------------
+
+=== MIT License (MIT)
+Used by: adler2 2.0.1, dpi 0.1.2
+
+Permission is hereby granted, free of charge, ...
+
+=== Apache License 2.0 (Apache-2.0)
+Used by: dpi 0.1.2
+
+                                 Apache License
+
+=== zlib License (Zlib)
+Used by: foldhash 0.2.0
+
+This software is provided 'as-is', ...
+";
+
+fn graph(crates: &[&str]) -> BTreeSet<String> {
+    crates.iter().map(|c| (*c).to_string()).collect()
+}
+
+#[test]
+fn notices_that_list_every_crate_with_a_text_pass() {
+    let summary = check(NOTICES, &graph(&["adler2 2.0.1", "foldhash 0.2.0"])).unwrap();
+    assert!(
+        summary.starts_with("3 crates listed (2 in the testbed's graph for "),
+        "{summary}"
+    );
+    assert!(
+        summary.ends_with("3 licences: Apache-2.0 1, MIT 2, Zlib 1"),
+        "{summary}"
+    );
+}
+
+/// A Windows checkout with CRLF line ends renders the template with them.
+#[test]
+fn notices_with_crlf_line_ends_pass_too() {
+    let crlf = NOTICES.replace('\n', "\r\n");
+    assert!(check(&crlf, &graph(&["adler2 2.0.1", "foldhash 0.2.0"])).is_ok());
+}
+
+#[test]
+fn a_crate_of_the_graph_missing_from_the_notices_fails() {
+    let err = check(NOTICES, &graph(&["adler2 2.0.1", "winit 0.30.13"])).unwrap_err();
+    assert!(
+        err.contains("[E-NOTICES] 1 crates") && err.contains("winit 0.30.13"),
+        "{err}"
+    );
+    // Another version of a listed crate is another crate.
+    let err = check(NOTICES, &graph(&["adler2 2.0.2"])).unwrap_err();
+    assert!(err.contains("adler2 2.0.2"), "{err}");
+}
+
+#[test]
+fn a_listed_crate_without_a_licence_text_fails() {
+    let notices = NOTICES.replace("Used by: foldhash 0.2.0", "Used by: adler2 2.0.1");
+    let err = check(&notices, &graph(&[])).unwrap_err();
+    assert!(
+        err.contains("no licence text names foldhash 0.2.0"),
+        "{err}"
+    );
+}
+
+#[test]
+fn notices_without_the_templates_headings_fail() {
+    let err = check("adler2 2.0.1: MIT\n", &graph(&[])).unwrap_err();
+    assert!(err.contains("no crate list"), "{err}");
+    let cut = &NOTICES[..NOTICES.find("Licence texts").unwrap()];
+    assert!(
+        check(cut, &graph(&[]))
+            .unwrap_err()
+            .contains("no licence texts")
+    );
+}
+
+/// The template writes what `check` reads: the two headings, a crate per
+/// line as `name version: expression`, and each text's heading and
+/// `Used by:` line. The licence texts are not HTML-escaped.
+#[test]
+fn the_template_writes_what_the_check_reads() {
+    let template = read("about.hbs");
+    for marker in [
+        super::CRATES_HEADING,
+        "{{#each crates}}\n{{package.name}} {{package.version}}: {{{license}}}\n{{/each}}",
+        super::TEXTS_HEADING,
+        "=== {{{name}}} ({{id}})\nUsed by: {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}\n",
+        "{{{text}}}",
+    ] {
+        assert!(template.contains(marker), "about.hbs lacks {marker:?}");
+    }
+    // Fixed text before the crate list or after the licence texts (the
+    // standard library's section, a default the owner may drop) must not
+    // look like a licence heading or a `Used by:` line.
+    let head = &template[..template.find(super::CRATES_HEADING).unwrap()];
+    let texts = template.find("{{#each licenses}}").unwrap();
+    let end = texts + template[texts..].find("\n{{/each}}").unwrap() + "\n{{/each}}".len();
+    let tail = &template[end..];
+    for (part, text) in [("header", head), ("tail", tail)] {
+        for line in text.lines() {
+            let marker = line.starts_with(super::LICENCE) || line.starts_with(super::USED_BY);
+            assert!(
+                !marker,
+                "about.hbs's {part} has a line the check reads: {line:?}"
+            );
+        }
+    }
+}
