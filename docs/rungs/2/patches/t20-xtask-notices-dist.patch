new file mode 100644
index 0000000000000000000000000000000000000000..b5139f2637f4c1ad726d6d0d324458d9728cd2b9
--- /dev/null
+++ b/xtask/src/dist.rs
@@ -0,0 +1,286 @@
+//! `cargo xtask dist [--target T]` (rung 2, decision 17, criterion 18;
+//! spec 8.4 describes rung 7's playable builds): the testbed's release
+//! binary, stripped, with its debug info beside it, its `version.json`
+//! (the binary's own `--version --json`) and the third-party notices, in
+//! `target/dist/<target>/`, and the same files as
+//! `target/dist/game-testbed-<target>.tar.gz` under
+//! `game-testbed-<target>/` (`dist_tar.rs`). A build folder that CI keeps
+//! as an artifact, not a release: no tags, signing or upload (ADR-0001).
+//!
+//! The build is `cargo build --release --target <target>` with the
+//! stripping and debug info set by `--config profile.release.*` on cargo's
+//! command line, so the root manifest's `[profile]` tables stay as they
+//! are. `debug = "limited"` (line tables and functions, no types or
+//! variables) is enough to symbolize a backtrace. Per target:
+//!
+//! | Targets | split-debuginfo | strip | Debug info |
+//! |---|---|---|---|
+//! | `*-apple-darwin` | packed | symbols | `game-testbed.dSYM/`: rustc runs dsymutil before it strips |
+//! | `*-windows-msvc` | packed | none | `game_testbed.pdb`: the linker never puts debug info in the `.exe`, and a `strip` value would drop the PDB too (`/DEBUG:NONE`) |
+//! | `*-linux-*` | off | none | `game-testbed.debug`: `objcopy --only-keep-debug`, then `objcopy --strip-all --add-gnu-debuglink` |
+//!
+//! On Linux the toolchain's split DWARF (`packed`, a `.dwp`) leaves the
+//! line tables and the address table in the binary, and a stripped binary
+//! loses them, so the `.dwp` alone could not be read: hence objcopy, from
+//! the binutils that link the binary anyway. Debuggers and Rust's own
+//! backtraces find each kind of debug info beside the binary.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use crate::{ci, dist_notices, dist_tar, replay, stamp, util};
+
+/// The binary `dist` packages.
+pub const GAME: &str = "game-testbed";
+
+/// Where a target's debug info goes.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DebugInfo {
+    /// `game-testbed.dSYM/`.
+    Dsym,
+    /// `game_testbed.pdb`, the name the `.exe` records.
+    Pdb,
+    /// `game-testbed.debug`, which the binary's `.gnu_debuglink` names.
+    Debuglink,
+}
+
+/// How one target is built and what its folder holds.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Plan {
+    pub target: String,
+    pub debug_info: DebugInfo,
+    /// cargo's `--config` arguments.
+    pub config: Vec<String>,
+    /// The binary's file name.
+    pub binary: String,
+    /// The debug info's file or directory name.
+    pub debug: String,
+}
+
+/// The plan for `target`: the Apple, Windows MSVC and Linux targets.
+pub fn plan(target: &str) -> Result<Plan, String> {
+    let (debug_info, split, strip) = if target.ends_with("-apple-darwin") {
+        (DebugInfo::Dsym, "packed", "symbols")
+    } else if target.ends_with("-windows-msvc") {
+        (DebugInfo::Pdb, "packed", "none")
+    } else if target.contains("-linux-") {
+        (DebugInfo::Debuglink, "off", "none")
+    } else {
+        return Err(format!(
+            "[E-DIST] no dist settings for {target}: only Apple, Windows MSVC and Linux targets"
+        ));
+    };
+    let config = [
+        ("debug", "limited"),
+        ("split-debuginfo", split),
+        ("strip", strip),
+    ]
+    .iter()
+    .map(|(key, value)| format!("profile.release.{key}=\"{value}\""))
+    .collect();
+    let windows = debug_info == DebugInfo::Pdb;
+    let binary = if windows {
+        format!("{GAME}.exe")
+    } else {
+        GAME.to_string()
+    };
+    let debug = match debug_info {
+        DebugInfo::Dsym => format!("{GAME}.dSYM"),
+        DebugInfo::Pdb => format!("{}.pdb", GAME.replace('-', "_")),
+        DebugInfo::Debuglink => format!("{GAME}.debug"),
+    };
+    Ok(Plan {
+        target: target.to_string(),
+        debug_info,
+        config,
+        binary,
+        debug,
+    })
+}
+
+/// What [`build`] made.
+#[derive(Debug)]
+pub struct Built {
+    pub plan: Plan,
+    pub dir: PathBuf,
+    pub archive: PathBuf,
+}
+
+impl Built {
+    /// The folder's name in the archive.
+    pub fn top(&self) -> String {
+        format!("{GAME}-{}", self.plan.target)
+    }
+}
+
+/// `cargo xtask dist`'s arguments: the target, if one is named. A target
+/// is a triple, never a path: its name becomes a directory that `dist`
+/// empties.
+pub fn parse(args: &[&str]) -> Result<Option<String>, String> {
+    let triple = |t: &str| {
+        let word = |c: char| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.');
+        !t.starts_with(['-', '.']) && !t.contains("..") && t.chars().all(word)
+    };
+    match args {
+        [] => Ok(None),
+        ["--target", target] if triple(target) => Ok(Some((*target).to_string())),
+        _ => Err("usage: cargo xtask dist [--target T]".into()),
+    }
+}
+
+/// `cargo xtask dist [--target T]`: the host's target unless one is named.
+pub fn run(root: &Path, target: Option<&str>) -> Result<String, String> {
+    let target = match target {
+        Some(target) => target.to_string(),
+        None => replay::host_triple(root)?,
+    };
+    let built = build(root, &target)?;
+    Ok(summary(root, &built))
+}
+
+/// Builds `target`'s folder and archive, replacing any earlier ones.
+pub fn build(root: &Path, target: &str) -> Result<Built, String> {
+    let plan = plan(target)?;
+    let (notices, _) = dist_notices::generate(root)?;
+    let dist = root.join("target/dist");
+    let dir = dist.join(target);
+    let archive = dist.join(format!("{GAME}-{target}.tar.gz"));
+    let _ = fs::remove_dir_all(&dir);
+    let _ = fs::remove_file(&archive);
+    if dir.exists() || archive.exists() {
+        return Err(format!(
+            "[E-DIST] {} or its archive could not be removed: a file in use?",
+            dir.display()
+        ));
+    }
+    fs::create_dir_all(&dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let mut args = vec![
+        "build",
+        "--release",
+        "-p",
+        GAME,
+        "--bin",
+        GAME,
+        "--target",
+        target,
+    ];
+    for config in &plan.config {
+        args.extend(["--config", config]);
+    }
+    ci::cargo_step(root, "dist-build", &args)?;
+    let release = root.join("target").join(target).join("release");
+    let built_binary = release.join(&plan.binary);
+    match plan.debug_info {
+        DebugInfo::Dsym | DebugInfo::Pdb => {
+            copy(&built_binary, &dir.join(&plan.binary))?;
+            copy(&release.join(&plan.debug), &dir.join(&plan.debug))?;
+        }
+        DebugInfo::Debuglink => {
+            let source = built_binary.display().to_string();
+            let link = format!("--add-gnu-debuglink={}", plan.debug);
+            let keep = ["--only-keep-debug", &source, &plan.debug];
+            objcopy(root, &dir, "dist-objcopy-debug", &keep)?;
+            let strip = ["--strip-all", &link, &source, &plan.binary];
+            objcopy(root, &dir, "dist-objcopy-strip", &strip)?;
+        }
+    }
+    let mut version = Command::new(dir.join(&plan.binary));
+    version
+        .current_dir(&dir)
+        .args(["--version", "--json"])
+        .env("ENG_AGENT_LOG_DIR", root.join("target/agent-logs"));
+    let json = util::run_quiet(root, "dist-version", &mut version).map_err(|e| {
+        format!("[E-DIST] the {target} binary did not run here, so it has no version.json: {e}")
+    })?;
+    fs::write(dir.join("version.json"), json).map_err(|e| format!("version.json: {e}"))?;
+    copy(&notices, &dir.join(dist_notices::FILE))?;
+    let built = Built { plan, dir, archive };
+    let binary = built.plan.binary.as_str();
+    dist_tar::write(
+        &built.dir,
+        &built.top(),
+        source_date_epoch(root),
+        &[binary],
+        &built.archive,
+    )?;
+    Ok(built)
+}
+
+/// The archive's mtime: `SOURCE_DATE_EPOCH` as the stamp has it (the
+/// commit's time), else 0.
+fn source_date_epoch(root: &Path) -> u64 {
+    stamp::vars(root)
+        .iter()
+        .find(|(name, _)| *name == "SOURCE_DATE_EPOCH")
+        .and_then(|(_, value)| value.parse().ok())
+        .unwrap_or(0)
+}
+
+/// GNU objcopy (binutils) in `dir`.
+fn objcopy(root: &Path, dir: &Path, log: &str, args: &[&str]) -> Result<(), String> {
+    let mut cmd = Command::new("objcopy");
+    cmd.current_dir(dir).args(args);
+    util::run_quiet(root, log, &mut cmd)
+        .map(|_| ())
+        .map_err(|e| format!("[E-DIST] objcopy (binutils) splits Linux debug info: {e}"))
+}
+
+/// Copies a file, or a directory and everything in it.
+fn copy(from: &Path, to: &Path) -> Result<(), String> {
+    let fail = |e: std::io::Error| format!("{} -> {}: {e}", from.display(), to.display());
+    if from.is_dir() {
+        fs::create_dir_all(to).map_err(fail)?;
+        for entry in fs::read_dir(from).map_err(fail)? {
+            let entry = entry.map_err(fail)?;
+            copy(&entry.path(), &to.join(entry.file_name()))?;
+        }
+        Ok(())
+    } else {
+        fs::copy(from, to).map(|_| ()).map_err(fail)
+    }
+}
+
+/// The archive, its size and what it holds, in one line.
+pub fn summary(root: &Path, built: &Built) -> String {
+    let size = |path: &Path| -> u64 {
+        if path.is_dir() {
+            util::walk_all(path)
+                .iter()
+                .filter_map(|p| fs::metadata(p).ok())
+                .map(|m| m.len())
+                .sum()
+        } else {
+            fs::metadata(path).map(|m| m.len()).unwrap_or(0)
+        }
+    };
+    let files = [
+        built.plan.binary.as_str(),
+        built.plan.debug.as_str(),
+        "version.json",
+        dist_notices::FILE,
+    ];
+    let parts: Vec<String> = files
+        .iter()
+        .map(|name| format!("{name} {}", megabytes(size(&built.dir.join(name)))))
+        .collect();
+    format!(
+        "{} ({}): {}",
+        util::rel(root, &built.archive),
+        megabytes(size(&built.archive)),
+        parts.join(", ")
+    )
+}
+
+/// Bytes as megabytes with one decimal, or kilobytes under one megabyte.
+pub(crate) fn megabytes(bytes: u64) -> String {
+    if bytes < 1_000_000 {
+        format!("{} kB", bytes.div_ceil(1000))
+    } else {
+        format!("{}.{} MB", bytes / 1_000_000, (bytes % 1_000_000) / 100_000)
+    }
+}
+
+#[cfg(test)]
+#[path = "dist_tests.rs"]
+mod tests;
diff --git a/xtask/src/dist_check.rs b/xtask/src/dist_check.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bfb690c27ef679457ef592e74f1d277436522219
--- /dev/null
+++ b/xtask/src/dist_check.rs
@@ -0,0 +1,334 @@
+//! The native job's `dist` step (rung 2, criterion 18) on the runners of
+//! the playable targets (`dist_notices::PLAYABLE`): `cargo xtask dist` for
+//! the host, then the archive checked as someone who downloads it would
+//! use it.
+//!
+//! 1. The archive holds the binary, its debug info, `version.json` and the
+//!    notices, under one folder (read with `dist_tar::members`).
+//! 2. The system's `tar` unpacks it into a fresh directory under the OS's
+//!    temporary directory, outside the repo (on Windows the built-in
+//!    `tar.exe`, which `Command` finds in System32 before `PATH`).
+//! 3. The unpacked binary is stripped: an ELF binary has no `.symtab` and
+//!    no `.debug_*` section and names its `.debug` file in
+//!    `.gnu_debuglink`; a Mach-O binary has no debug map (STABS entries)
+//!    and no local symbols; a Windows `.exe` names the PDB beside it. The
+//!    debug info is there: DWARF sections in the `.debug` file or the
+//!    dSYM, the PDB's MSF header.
+//! 4. The unpacked binary, run from its folder: `--version` and
+//!    `--version --json` give a full release stamp for the host (as the
+//!    `version` step checks it, the run's commit on GitHub) equal to
+//!    `version.json`, and `run --headless --ticks 60` runs its 60 ticks.
+
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+use serde_json::Value;
+
+use crate::dist::{self, Built, DebugInfo};
+use crate::util::{self, Done};
+use crate::{ci_verdicts as verdicts, dist_notices, dist_tar, replay};
+
+/// The step.
+pub fn step(root: &Path) -> Result<Done, String> {
+    let host = replay::host_triple(root)?;
+    let built = dist::build(root, &host)?;
+    let members = dist_tar::members(&built.archive, false)?;
+    let paths: Vec<&str> = members.iter().map(|m| m.path.as_str()).collect();
+    holds(&built, &paths)?;
+    let scratch = std::env::temp_dir().join(format!("eng-dist-check-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&scratch);
+    fs::create_dir_all(&scratch).map_err(|e| format!("{}: {e}", scratch.display()))?;
+    let checked = unpacked(root, &built, &scratch);
+    let _ = fs::remove_dir_all(&scratch);
+    let checked = checked?;
+    Ok(Done::Pass(format!(
+        "{}; {} members; {checked}",
+        dist::summary(root, &built),
+        members.len()
+    )))
+}
+
+/// The archive's paths hold the folder's four kinds of file. A dSYM's
+/// DWARF file is named after the binary dsymutil read (`game_testbed-<hash>`
+/// in `deps/`); lldb and Rust's backtraces match it by UUID, not by name.
+pub(crate) fn holds(built: &Built, paths: &[&str]) -> Result<(), String> {
+    let top = built.top();
+    let debug = match built.plan.debug_info {
+        DebugInfo::Dsym => format!("{}/{DWARF}", built.plan.debug),
+        DebugInfo::Pdb | DebugInfo::Debuglink => built.plan.debug.clone(),
+    };
+    let wanted = [
+        built.plan.binary.as_str(),
+        debug.as_str(),
+        "version.json",
+        dist_notices::FILE,
+    ];
+    let found = |name: &str| {
+        let path = format!("{top}/{name}");
+        if name.ends_with('/') {
+            paths
+                .iter()
+                .any(|p| p.starts_with(&path) && !p.ends_with('/'))
+        } else {
+            paths.contains(&path.as_str())
+        }
+    };
+    let missing: Vec<&str> = wanted.into_iter().filter(|name| !found(name)).collect();
+    if paths.first() != Some(&format!("{top}/").as_str()) || !missing.is_empty() {
+        return Err(format!(
+            "[E-DIST] the archive should hold {top}/ with {}; it lacks {missing:?}",
+            wanted.join(", ")
+        ));
+    }
+    Ok(())
+}
+
+/// Where a dSYM keeps its one DWARF file.
+const DWARF: &str = "Contents/Resources/DWARF/";
+
+/// Unpacks the archive in `scratch` with the system's `tar` and checks
+/// and runs what it holds.
+fn unpacked(root: &Path, built: &Built, scratch: &Path) -> Result<String, String> {
+    let name = built.archive.file_name().ok_or("the archive has no name")?;
+    fs::copy(&built.archive, scratch.join(name)).map_err(|e| format!("copy: {e}"))?;
+    let mut tar = Command::new("tar");
+    tar.current_dir(scratch).arg("-xzf").arg(name);
+    util::run_quiet(root, "dist-unpack", &mut tar)?;
+    let folder = scratch.join(built.top());
+    let binary = folder.join(&built.plan.binary);
+    let bytes = fs::read(&binary).map_err(|e| format!("{}: {e}", binary.display()))?;
+    let debug = folder.join(&built.plan.debug);
+    let stripped = match built.plan.debug_info {
+        DebugInfo::Debuglink => {
+            let sections = elf_sections(&bytes)?;
+            let kept = elf_unstripped(&sections);
+            if !kept.is_empty() || !sections.iter().any(|s| s == ".gnu_debuglink") {
+                return Err(format!(
+                    "[E-DIST] the binary keeps {kept:?}, or names no .debug file (.gnu_debuglink)"
+                ));
+            }
+            let debug = fs::read(&debug).map_err(|e| format!("{}: {e}", debug.display()))?;
+            if !elf_sections(&debug)?.iter().any(|s| s == ".debug_line") {
+                return Err(format!("[E-DIST] {} has no line tables", built.plan.debug));
+            }
+            "ELF: no .symtab or .debug_* sections, .gnu_debuglink set".to_string()
+        }
+        DebugInfo::Dsym => {
+            let (stabs, locals) = macho_symbols(&bytes)?;
+            if stabs + locals > 0 {
+                return Err(format!(
+                    "[E-DIST] the binary keeps {stabs} debug-map entries and {locals} local symbols"
+                ));
+            }
+            let dwarf = util::walk_all(&debug.join(DWARF))
+                .into_iter()
+                .next()
+                .ok_or_else(|| format!("[E-DIST] {} has no DWARF file", built.plan.debug))?;
+            let dwarf = fs::read(&dwarf).map_err(|e| format!("{}: {e}", dwarf.display()))?;
+            if macho_symbols(&dwarf).is_err() || !contains(&dwarf, b"__debug_line") {
+                return Err(format!(
+                    "[E-DIST] {} holds no line tables",
+                    built.plan.debug
+                ));
+            }
+            "Mach-O: no debug map or local symbols; the dSYM has DWARF".to_string()
+        }
+        DebugInfo::Pdb => {
+            let pdb = fs::read(&debug).map_err(|e| format!("{}: {e}", debug.display()))?;
+            if !pdb.starts_with(b"Microsoft C/C++ MSF 7.00\r\n") {
+                return Err(format!("[E-DIST] {} is not a PDB", built.plan.debug));
+            }
+            if !contains(&bytes, built.plan.debug.as_bytes()) {
+                return Err(format!(
+                    "[E-DIST] the .exe does not name {}",
+                    built.plan.debug
+                ));
+            }
+            let symbols = pe_symbols(&bytes)?;
+            if symbols > 0 {
+                return Err(format!("[E-DIST] the .exe keeps {symbols} COFF symbols"));
+            }
+            format!(
+                "PE: no COFF symbols, names {}, an MSF 7.00 PDB",
+                built.plan.debug
+            )
+        }
+    };
+    let plain = probe(root, &binary, &folder, &["--version"])?;
+    let json = probe(root, &binary, &folder, &["--version", "--json"])?;
+    let archived = fs::read_to_string(folder.join("version.json"))
+        .map_err(|e| format!("version.json: {e}"))?;
+    if json != archived {
+        return Err("[E-DIST] --version --json differs from the archive's version.json".into());
+    }
+    let stamp = release_stamp(&json, &built.plan.target)?;
+    verdicts::version(
+        &plain,
+        &json,
+        github_run().as_ref().map(|(s, r)| (s.as_str(), r.as_str())),
+    )?;
+    let ran = probe(
+        root,
+        &binary,
+        &folder,
+        &["run", "--headless", "--ticks", "60"],
+    )?;
+    let line = ran.lines().next().unwrap_or_default();
+    if !line.contains(" 60 of 60 ticks") {
+        return Err(format!(
+            "[E-DIST] run --headless --ticks 60 printed {line:?}"
+        ));
+    }
+    Ok(format!("unpacked with tar: {stripped}; {stamp}; {line}"))
+}
+
+/// The commit and run the stamp must name on GitHub.
+fn github_run() -> Option<(String, String)> {
+    let [sha, id, attempt] =
+        ["GITHUB_SHA", "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT"].map(|v| std::env::var(v).ok());
+    Some((sha?, format!("github-{}/{}", id?, attempt?)))
+}
+
+/// `binary args`, run in `folder` with its logs in `target/agent-logs`.
+fn probe(root: &Path, binary: &Path, folder: &Path, args: &[&str]) -> Result<String, String> {
+    let mut cmd = Command::new(binary);
+    cmd.current_dir(folder)
+        .args(args)
+        .env("ENG_AGENT_LOG_DIR", root.join("target/agent-logs"));
+    util::run_quiet(root, &format!("dist-{}", args.join("-")), &mut cmd)
+}
+
+/// The stamp is a release build for `target`, without debug assertions.
+pub(crate) fn release_stamp(json: &str, target: &str) -> Result<String, String> {
+    let stamp: Value =
+        serde_json::from_str(json).map_err(|e| format!("[E-VERSION] --version --json: {e}"))?;
+    let build = &stamp["build"];
+    let release = build["profile"] == "release" && build["debug_assertions"] == false;
+    if !release || build["target"] != target {
+        return Err(format!(
+            "[E-DIST] the stamp says {} {} (debug assertions {}), not a release build for \
+             {target}",
+            build["target"], build["profile"], build["debug_assertions"]
+        ));
+    }
+    Ok(format!(
+        "a release build for {target} of {}",
+        build["engine_sha"].as_str().unwrap_or("?")
+    ))
+}
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    haystack.windows(needle.len()).any(|w| w == needle)
+}
+
+fn u16_at(bytes: &[u8], at: usize) -> Result<u16, String> {
+    let b = bytes.get(at..at + 2).ok_or("cut short")?;
+    Ok(u16::from_le_bytes([b[0], b[1]]))
+}
+
+fn u32_at(bytes: &[u8], at: usize) -> Result<u32, String> {
+    let b = bytes.get(at..at + 4).ok_or("cut short")?;
+    Ok(u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn u64_at(bytes: &[u8], at: usize) -> Result<u64, String> {
+    let b = bytes.get(at..at + 8).ok_or("cut short")?;
+    let mut word = [0u8; 8];
+    word.copy_from_slice(b);
+    Ok(u64::from_le_bytes(word))
+}
+
+fn index(value: u64) -> Result<usize, String> {
+    usize::try_from(value).map_err(|e| e.to_string())
+}
+
+/// The section names of a 64-bit little-endian ELF file.
+pub(crate) fn elf_sections(bytes: &[u8]) -> Result<Vec<String>, String> {
+    if !bytes.starts_with(b"\x7fELF\x02\x01") {
+        return Err("[E-DIST] not a 64-bit little-endian ELF file".into());
+    }
+    let offset = index(u64_at(bytes, 0x28)?)?;
+    let size = usize::from(u16_at(bytes, 0x3a)?);
+    let count = usize::from(u16_at(bytes, 0x3c)?);
+    let names_at = usize::from(u16_at(bytes, 0x3e)?);
+    let section = |i: usize| -> Result<(u32, usize, usize), String> {
+        let at = offset + i * size;
+        Ok((
+            u32_at(bytes, at)?,
+            index(u64_at(bytes, at + 0x18)?)?,
+            index(u64_at(bytes, at + 0x20)?)?,
+        ))
+    };
+    let (_, names_offset, names_size) = section(names_at)?;
+    let names = bytes
+        .get(names_offset..names_offset + names_size)
+        .ok_or("[E-DIST] the ELF section names are cut short")?;
+    (0..count)
+        .map(|i| {
+            let start = section(i)?.0 as usize;
+            let rest = names
+                .get(start..)
+                .ok_or("[E-DIST] a section name past the table")?;
+            let end = rest.iter().position(|&b| b == 0).unwrap_or(rest.len());
+            Ok(String::from_utf8_lossy(&rest[..end]).into_owned())
+        })
+        .collect()
+}
+
+/// A PE file's COFF symbol count (`NumberOfSymbols`), 0 in an image the
+/// MSVC linker wrote: its debug info is all in the PDB.
+pub(crate) fn pe_symbols(bytes: &[u8]) -> Result<u32, String> {
+    let pe = u32_at(bytes, 0x3c)? as usize;
+    if !bytes.starts_with(b"MZ") || bytes.get(pe..pe + 4) != Some(b"PE\0\0") {
+        return Err("[E-DIST] not a PE file".into());
+    }
+    u32_at(bytes, pe + 4 + 12)
+}
+
+/// The sections of a stripped ELF binary that should be gone: the symbol
+/// table and debug info. `.debug_gdb_scripts` stays: rustc's pointer to
+/// its gdb pretty-printers, loaded with the program (`SHF_ALLOC`), so
+/// `--strip-all` keeps it.
+pub(crate) fn elf_unstripped(sections: &[String]) -> Vec<&str> {
+    sections
+        .iter()
+        .map(String::as_str)
+        .filter(|s| *s == ".symtab" || s.starts_with(".debug_") || s.starts_with(".zdebug_"))
+        .filter(|s| *s != ".debug_gdb_scripts")
+        .collect()
+}
+
+/// A 64-bit little-endian Mach-O file's debug-map (STABS) entries and
+/// local defined symbols, from its `LC_SYMTAB`.
+pub(crate) fn macho_symbols(bytes: &[u8]) -> Result<(usize, usize), String> {
+    if u32_at(bytes, 0)? != 0xfeed_facf {
+        return Err("[E-DIST] not a 64-bit little-endian Mach-O file".into());
+    }
+    let commands = u32_at(bytes, 16)?;
+    let mut at = 32;
+    for _ in 0..commands {
+        let (cmd, cmdsize) = (u32_at(bytes, at)?, u32_at(bytes, at + 4)? as usize);
+        if cmd == 2 {
+            let symbols = u32_at(bytes, at + 8)? as usize;
+            let count = u32_at(bytes, at + 12)? as usize;
+            let (mut stabs, mut locals) = (0, 0);
+            for i in 0..count {
+                let kind = *bytes
+                    .get(symbols + 16 * i + 4)
+                    .ok_or("[E-DIST] symbols cut short")?;
+                if kind & 0xe0 != 0 {
+                    stabs += 1;
+                } else if kind & 0x0e == 0x0e && kind & 0x01 == 0 {
+                    locals += 1;
+                }
+            }
+            return Ok((stabs, locals));
+        }
+        if cmdsize == 0 {
+            break;
+        }
+        at += cmdsize;
+    }
+    Ok((0, 0))
+}
