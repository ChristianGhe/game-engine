+/// A minimal Mach-O file with one `LC_SYMTAB` over `kinds` (`n_type`s).
+fn macho(kinds: &[u8]) -> Vec<u8> {
+    let symbols = 32 + 24;
+    let mut bytes = vec![0u8; symbols + 16 * kinds.len()];
+    bytes[..4].copy_from_slice(&0xfeed_facfu32.to_le_bytes());
+    bytes[16..20].copy_from_slice(&1u32.to_le_bytes());
+    bytes[32..36].copy_from_slice(&2u32.to_le_bytes());
+    bytes[36..40].copy_from_slice(&24u32.to_le_bytes());
+    bytes[40..44].copy_from_slice(&(symbols as u32).to_le_bytes());
+    bytes[44..48].copy_from_slice(&(kinds.len() as u32).to_le_bytes());
+    for (i, kind) in kinds.iter().enumerate() {
+        bytes[symbols + 16 * i + 4] = *kind;
+    }
+    bytes
+}
+
+#[test]
+fn macho_debug_maps_and_local_symbols_are_counted() {
+    // N_OSO and N_FUN stabs; a local N_SECT; an external N_SECT; undefined.
+    assert_eq!(
+        macho_symbols(&macho(&[0x66, 0x24, 0x0e, 0x0f, 0x01])).unwrap(),
+        (2, 1)
+    );
+    assert_eq!(macho_symbols(&macho(&[0x0f, 0x01])).unwrap(), (0, 0));
+    assert!(macho_symbols(b"\x7fELF").is_err());
+}
