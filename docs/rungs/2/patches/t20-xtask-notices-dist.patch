index 0000000000000000000000000000000000000000..e2c45e8ac2a56293518c0a394fefd3cf19c0c595
--- /dev/null
+++ b/xtask/src/dist_tar.rs
@@ -0,0 +1,313 @@
+//! The dist archive (rung 2, decision 17): a POSIX ustar archive, gzipped
+//! through `flate2`, that xtask writes itself. Windows 10 and later unpack
+//! it with the built-in `tar`, as do GNU tar and bsdtar.
+//!
+//! - Every member sits under one top-level directory, `<name>/`.
+//! - Members come in byte order of their paths, so a directory comes
+//!   before what it holds, and the order never depends on the file system.
+//! - Every member has the same mtime (the caller's: `SOURCE_DATE_EPOCH`),
+//!   owner and group 0 and no user or group names. Directories and the
+//!   named executables get mode 0755, every other file 0644. The gzip
+//!   header's time is 0 and its OS byte 255 (unknown).
+//!
+//! Two runs over the same files give the same bytes. Links and special
+//! files are refused; a path that ustar cannot hold (over 255 bytes, or
+//! with no `/` to split it at) is an error.
+
+use std::fs::{self, File};
+use std::io::{self, BufWriter, Read, Write};
+use std::path::{Path, PathBuf};
+
+use flate2::read::GzDecoder;
+use flate2::{Compression, GzBuilder};
+
+const BLOCK: usize = 512;
+/// What tar pads an archive to: a record of 20 blocks.
+const RECORD: u64 = 20 * BLOCK as u64;
+
+/// A member as [`members`] reads it back.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Member {
+    /// The path in the archive; a directory's ends in `/`.
+    pub path: String,
+    pub mode: u32,
+    pub mtime: u64,
+    pub size: u64,
+    /// The bytes, if [`members`] was asked to keep them.
+    pub data: Vec<u8>,
+}
+
+/// Writes `dir` and everything under it to `out`, a `.tar.gz`, under
+/// `name/`. `executables` are names of files directly in `dir`. Returns
+/// the archive's size in bytes.
+pub fn write(
+    dir: &Path,
+    name: &str,
+    mtime: u64,
+    executables: &[&str],
+    out: &Path,
+) -> Result<u64, String> {
+    let mut entries = vec![(format!("{name}/"), None)];
+    collect(dir, name, &mut entries)?;
+    entries.sort();
+    let file = File::create(out).map_err(|e| format!("{}: {e}", out.display()))?;
+    let gz = GzBuilder::new()
+        .mtime(0)
+        .operating_system(255)
+        .write(BufWriter::new(file), Compression::default());
+    let mut tar = Counting {
+        inner: gz,
+        count: 0,
+    };
+    let fail = |e: io::Error| format!("{}: {e}", out.display());
+    for (path, source) in &entries {
+        match source {
+            None => tar
+                .write_all(&header(path, 0o755, 0, mtime, b'5')?)
+                .map_err(fail)?,
+            Some(source) => {
+                let size = fs::metadata(source)
+                    .map_err(|e| format!("{}: {e}", source.display()))?
+                    .len();
+                let top = path.strip_prefix(&format!("{name}/")).unwrap_or(path);
+                let mode = if executables.contains(&top) {
+                    0o755
+                } else {
+                    0o644
+                };
+                tar.write_all(&header(path, mode, size, mtime, b'0')?)
+                    .map_err(fail)?;
+                let mut file =
+                    File::open(source).map_err(|e| format!("{}: {e}", source.display()))?;
+                let copied = io::copy(&mut (&mut file).take(size), &mut tar).map_err(fail)?;
+                if copied != size {
+                    return Err(format!(
+                        "{} changed while it was archived",
+                        source.display()
+                    ));
+                }
+                tar.write_all(&vec![0; padding(size)]).map_err(fail)?;
+            }
+        }
+    }
+    // The end: two zero blocks, then zeros up to a whole record.
+    let end = tar.count + 2 * BLOCK as u64;
+    let total = end.div_ceil(RECORD) * RECORD;
+    let zeros = usize::try_from(total - tar.count).map_err(|e| e.to_string())?;
+    tar.write_all(&vec![0; zeros]).map_err(fail)?;
+    let mut buffered = tar.inner.finish().map_err(fail)?;
+    buffered.flush().map_err(fail)?;
+    drop(buffered);
+    fs::metadata(out)
+        .map(|m| m.len())
+        .map_err(|e| format!("{}: {e}", out.display()))
+}
+
+/// Every file and directory below `dir`, as archive paths under `prefix`,
+/// with the file to read for each file.
+fn collect(
+    dir: &Path,
+    prefix: &str,
+    out: &mut Vec<(String, Option<PathBuf>)>,
+) -> Result<(), String> {
+    let entries = fs::read_dir(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    for entry in entries {
+        let entry = entry.map_err(|e| format!("{}: {e}", dir.display()))?;
+        let path = entry.path();
+        let name = entry
+            .file_name()
+            .into_string()
+            .map_err(|name| format!("{}: a name that is not UTF-8: {name:?}", dir.display()))?;
+        let kind = entry
+            .file_type()
+            .map_err(|e| format!("{}: {e}", path.display()))?;
+        let inside = format!("{prefix}/{name}");
+        if kind.is_dir() {
+            out.push((format!("{inside}/"), None));
+            collect(&path, &inside, out)?;
+        } else if kind.is_file() {
+            out.push((inside, Some(path)));
+        } else {
+            return Err(format!(
+                "{}: not a file or directory; dist archives hold no links",
+                path.display()
+            ));
+        }
+    }
+    Ok(())
+}
+
+/// The zeros after `size` bytes of data, up to a whole block.
+fn padding(size: u64) -> usize {
+    let rest = (size % BLOCK as u64) as usize;
+    if rest == 0 { 0 } else { BLOCK - rest }
+}
+
+/// A ustar header block. `kind` is `b'0'` for a file, `b'5'` for a
+/// directory.
+pub(crate) fn header(
+    path: &str,
+    mode: u32,
+    size: u64,
+    mtime: u64,
+    kind: u8,
+) -> Result<[u8; BLOCK], String> {
+    let mut block = [0u8; BLOCK];
+    let (prefix, name) = split(path)?;
+    block[..name.len()].copy_from_slice(name.as_bytes());
+    octal(&mut block[100..108], u64::from(mode), path)?;
+    octal(&mut block[108..116], 0, path)?;
+    octal(&mut block[116..124], 0, path)?;
+    octal(&mut block[124..136], size, path)?;
+    octal(&mut block[136..148], mtime, path)?;
+    block[156] = kind;
+    block[257..263].copy_from_slice(b"ustar\0");
+    block[263..265].copy_from_slice(b"00");
+    octal(&mut block[329..337], 0, path)?;
+    octal(&mut block[337..345], 0, path)?;
+    block[345..345 + prefix.len()].copy_from_slice(prefix.as_bytes());
+    let sum = checksum(&block);
+    block[148..156].copy_from_slice(format!("{sum:06o}\0 ").as_bytes());
+    Ok(block)
+}
+
+/// The header's checksum: its bytes summed, the checksum field as spaces.
+fn checksum(block: &[u8; BLOCK]) -> u32 {
+    let spaces = 8 * u32::from(b' ');
+    let rest: u32 = block[..148]
+        .iter()
+        .chain(&block[156..])
+        .map(|&b| u32::from(b))
+        .sum();
+    rest + spaces
+}
+
+/// `path` as ustar's prefix (up to 155 bytes) and name (up to 100), split
+/// at a `/`.
+fn split(path: &str) -> Result<(&str, &str), String> {
+    if path.len() <= 100 {
+        return Ok(("", path));
+    }
+    let body = path.strip_suffix('/').unwrap_or(path);
+    body.char_indices()
+        .filter(|&(_, c)| c == '/')
+        .map(|(at, _)| (&path[..at], &path[at + 1..]))
+        .find(|(prefix, name)| prefix.len() <= 155 && name.len() <= 100 && !name.is_empty())
+        .ok_or_else(|| format!("{path}: too long for a ustar header"))
+}
+
+/// `value` as zero-padded octal filling `field` but its last byte, a NUL.
+fn octal(field: &mut [u8], value: u64, path: &str) -> Result<(), String> {
+    let digits = field.len() - 1;
+    let text = format!("{value:0digits$o}");
+    if text.len() > digits {
+        return Err(format!("{path}: {value} does not fit a ustar header"));
+    }
+    field[..digits].copy_from_slice(text.as_bytes());
+    field[digits] = 0;
+    Ok(())
+}
+
+/// The members of a `.tar.gz` that [`write`] wrote, in archive order, with
+/// their bytes if `keep` (else `data` stays empty). It reads ustar files
+/// and directories only, and checks each header's magic and checksum.
+pub fn members(archive: &Path, keep: bool) -> Result<Vec<Member>, String> {
+    let file = File::open(archive).map_err(|e| format!("{}: {e}", archive.display()))?;
+    let mut tar = GzDecoder::new(io::BufReader::new(file));
+    let fail = |e: io::Error| format!("{}: {e}", archive.display());
+    let mut out = Vec::new();
+    loop {
+        let mut block = [0u8; BLOCK];
+        tar.read_exact(&mut block).map_err(fail)?;
+        if block.iter().all(|&b| b == 0) {
+            // The rest, so the gzip trailer's CRC and length are checked.
+            io::copy(&mut tar, &mut io::sink()).map_err(fail)?;
+            return Ok(out);
+        }
+        let member = parse(&block).map_err(|e| format!("{}: {e}", archive.display()))?;
+        let padded = member.size + padding(member.size) as u64;
+        let mut data = Vec::new();
+        let read = if keep {
+            (&mut tar)
+                .take(padded)
+                .read_to_end(&mut data)
+                .map_err(fail)? as u64
+        } else {
+            io::copy(&mut (&mut tar).take(padded), &mut io::sink()).map_err(fail)?
+        };
+        if read != padded {
+            return Err(format!(
+                "{}: {} is cut short",
+                archive.display(),
+                member.path
+            ));
+        }
+        data.truncate(usize::try_from(member.size).unwrap_or(usize::MAX));
+        out.push(Member { data, ..member });
+    }
+}
+
+/// One header block, as a member without its data.
+fn parse(block: &[u8; BLOCK]) -> Result<Member, String> {
+    if &block[257..263] != b"ustar\0" {
+        return Err("a header that is not ustar".into());
+    }
+    let stored = number(&block[148..156])?;
+    if stored != u64::from(checksum(block)) {
+        return Err("a header whose checksum is wrong".into());
+    }
+    let name = text(&block[..100])?;
+    let prefix = text(&block[345..500])?;
+    let path = if prefix.is_empty() {
+        name
+    } else {
+        format!("{prefix}/{name}")
+    };
+    let size = number(&block[124..136])?;
+    match block[156] {
+        b'0' | 0 if !path.ends_with('/') => {}
+        b'5' if path.ends_with('/') && size == 0 => {}
+        kind => return Err(format!("{path}: member type {kind:?} is not written here")),
+    }
+    Ok(Member {
+        mode: u32::try_from(number(&block[100..108])?).map_err(|e| e.to_string())?,
+        mtime: number(&block[136..148])?,
+        size,
+        path,
+        data: Vec::new(),
+    })
+}
+
+/// A NUL-terminated (or full) string field.
+fn text(field: &[u8]) -> Result<String, String> {
+    let end = field.iter().position(|&b| b == 0).unwrap_or(field.len());
+    String::from_utf8(field[..end].to_vec()).map_err(|e| e.to_string())
+}
+
+/// An octal number field, ended by NUL or space.
+fn number(field: &[u8]) -> Result<u64, String> {
+    let digits: &[u8] = field
+        .split(|&b| b == 0 || b == b' ')
+        .find(|part| !part.is_empty())
+        .unwrap_or(&[]);
+    let digits = std::str::from_utf8(digits).map_err(|e| e.to_string())?;
+    u64::from_str_radix(digits, 8).map_err(|e| format!("octal field {digits:?}: {e}"))
+}
+
+/// A writer that counts what passes through it, for the end padding.
+struct Counting<W: Write> {
+    inner: W,
+    count: u64,
+}
+
+impl<W: Write> Write for Counting<W> {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        let n = self.inner.write(buf)?;
+        self.count += n as u64;
+        Ok(n)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.inner.flush()
+    }
+}
