+/// A minimal ELF64 file: the null section, `names` and the section-name
+/// table last.
+fn elf(names: &[&str]) -> Vec<u8> {
+    let mut table = vec![0u8];
+    let mut offsets = vec![0u32];
+    for name in names.iter().chain([&".shstrtab"]) {
+        offsets.push(table.len() as u32);
+        table.extend(name.as_bytes());
+        table.push(0);
+    }
+    let count = offsets.len();
+    let shoff = 64 + table.len();
+    let mut bytes = vec![0u8; shoff + 64 * count];
+    bytes[..6].copy_from_slice(b"\x7fELF\x02\x01");
+    bytes[0x28..0x30].copy_from_slice(&(shoff as u64).to_le_bytes());
+    bytes[0x3a..0x3c].copy_from_slice(&64u16.to_le_bytes());
+    bytes[0x3c..0x3e].copy_from_slice(&(count as u16).to_le_bytes());
+    bytes[0x3e..0x40].copy_from_slice(&((count - 1) as u16).to_le_bytes());
+    bytes[64..shoff].copy_from_slice(&table);
+    for (i, name) in offsets.iter().enumerate() {
+        let at = shoff + 64 * i;
+        bytes[at..at + 4].copy_from_slice(&name.to_le_bytes());
+    }
+    let last = shoff + 64 * (count - 1);
+    bytes[last + 0x18..last + 0x20].copy_from_slice(&64u64.to_le_bytes());
+    bytes[last + 0x20..last + 0x28].copy_from_slice(&(table.len() as u64).to_le_bytes());
+    bytes
+}
