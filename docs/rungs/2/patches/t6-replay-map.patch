 #[derive(Default)]
 pub struct Options {
     pub regen: bool,
@@ -166,6 +183,7 @@ pub fn run(root: &Path, opts: &Options) -> Result<String, String> {
                     "--seed",
                     &seed.to_string(),
                 ])
+                .args(sc.map_args())
                 .arg("--input")
                 .arg(scenarios.join(&sc.input))
                 .arg("--budgets")
@@ -305,3 +323,29 @@ pub fn compare_dirs(root: &Path, dirs: &[&str]) -> Result<String, String> {
         Err(diffs.join("\n"))
     }
 }
