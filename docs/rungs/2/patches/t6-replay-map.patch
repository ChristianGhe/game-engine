+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_scenario_may_name_its_map() {
+        let manifest: Manifest = toml::from_str(
+            "version = 1\n\
+             [[scenario]]\nname = \"dots\"\ninput = \"a.toml\"\nticks = 1\nseeds = [1]\n\
+             [[scenario]]\nname = \"room\"\nmap = \"room\"\ninput = \"b.toml\"\nticks = 1\n\
+             seeds = [1]\n",
+        )
+        .unwrap();
+        assert!(manifest.scenario[0].map_args().is_empty());
+        assert_eq!(manifest.scenario[1].map_args(), ["--map", "room"]);
+    }
+
+    #[test]
+    fn the_committed_manifest_parses() {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("..");
+        let text = fs::read_to_string(root.join(SCENARIOS).join("scenarios.toml")).unwrap();
+        let manifest: Manifest = toml::from_str(&text).unwrap();
+        assert!(!manifest.scenario.is_empty());
+    }
+}
