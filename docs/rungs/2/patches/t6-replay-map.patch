 //! Committed streams are change detectors, not oracles (spec 6.4): a
 //! simulation-changing PR regenerates them with `--regen` and the reviewer
 //! approves. Cross-architecture equality (`compare-hashes`) is always required.
+//!
+//! A scenario may name its map (`map = "room"`), which the run gets as
+//! `--map`; without one it runs on the game's first map, as every 1b
+//! scenario does (rung 2 plan, decision 1; ADR-0023). A map with sim data
+//! names it in its stream's header, so the comparisons cover it too.
 
 use std::collections::BTreeMap;
 use std::fs;
@@ -31,12 +36,24 @@ struct Manifest {
 #[serde(deny_unknown_fields)]
 struct Scenario {
     name: String,
+    /// The map, given to the run as `--map`; `None` is the game's first.
+    map: Option<String>,
     input: String,
     assert: Option<String>,
     ticks: u64,
     seeds: Vec<u64>,
 }
 
+impl Scenario {
+    /// `--map NAME` for a scenario that names its map, else nothing.
+    fn map_args(&self) -> Vec<&str> {
+        match &self.map {
+            Some(map) => vec!["--map", map],
+            None => Vec::new(),
+        }
+    }
+}
