+
+/// A copy is modified when it is made, not when its source was: cargo
+/// must not take a copy's crate for one built from another case's copy.
+#[test]
+fn a_copy_is_new_to_cargo() {
+    use std::time::{Duration, SystemTime};
+    let dir = std::env::temp_dir().join(format!("xtask-selftest-copy-{}", std::process::id()));
+    let (root, ws) = (dir.join("root"), dir.join("ws"));
+    std::fs::create_dir_all(root.join("crates")).unwrap();
+    let file = root.join("crates/old.rs");
+    std::fs::write(&file, "// old\n").unwrap();
+    let long_ago = SystemTime::UNIX_EPOCH + Duration::from_secs(1_000_000_000);
+    let source = std::fs::File::options().write(true).open(&file).unwrap();
+    source.set_modified(long_ago).unwrap();
+    let before = SystemTime::now() - Duration::from_secs(1);
+    super::copy(&root, &ws, &file).unwrap();
+    let copied = ws.join("crates/old.rs");
+    assert_eq!(std::fs::read_to_string(&copied).unwrap(), "// old\n");
+    let modified = std::fs::metadata(&copied).unwrap().modified().unwrap();
+    assert!(
+        modified >= before,
+        "{modified:?} is the source's {long_ago:?}"
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
