diff --git a/xtask/src/selftest_rules.rs b/xtask/src/selftest_rules.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ecc3287e063e0d8119938ca701f0a247fec050dd
--- /dev/null
+++ b/xtask/src/selftest_rules.rs
@@ -0,0 +1,273 @@
+//! `cargo xtask selftest rule-1`, `rule-2` and `rule-3` (rung 2, plan
+//! addition A2; acceptance `scene-rules`): each plants render bugs in a
+//! fresh copy of the workspace that break one of the room's rules for
+//! "proper" (`crates/game-testbed/scenes/room.rules.toml`), one at a time,
+//! and the scene-rules test (`crates/game-testbed/tests/scene_rules.rs`)
+//! must fail on that rule for each, naming the check, the shot, the object
+//! and the measure past its limit:
+//! - `rule-1`, two bugs in eng-render's `sprites.wgsl`:
+//!   - every thing drawn black, an albedo of 0. The marker still stands
+//!     out against the pillar, so only its light shows it: `rule-1
+//!     room-spawn marker`, `light` under the limit;
+//!   - every thing not drawn, each fragment discarded: `rule-1 room-spawn
+//!     marker`, `pixels` 0;
+//! - `rule-2`, two holes in the room's meshes (game-testbed-client's
+//!   `room/geometry.rs`):
+//!   - the hall's east wall north of the alcove left out: the sky shows
+//!     through it below the horizon, `rule-2-void room-spawn`, `pixels`
+//!     over the limit;
+//!   - the ceiling east of the skylight left out: the sky shows through it
+//!     above the horizon, where rule 3's upper third still passes (ceiling
+//!     and sky count together), `rule-2-sky room-spawn`, `pixels` over the
+//!     limit;
+//! - `rule-3`: the camera pitched 45 degrees further up than the player
+//!   looks (game-testbed-client's `room::camera`): room-spawn's lower third
+//!   shows no floor, `rule-3-floor room-spawn`, `share` under the limit.
+//!
+//! The test renders, so the case runs it with `ENG_REQUIRE_GPU=1`; with no
+//! adapter it could not run ([`NOT_RUN`]): a failure on CI or with
+//! `ENG_REQUIRE_GPU=1`, never a pass. Its builds share
+//! `target/selftest/target` with the other cases; the copy is new to cargo
+//! (`selftest.rs`'s `copy`), and each bug is taken out again before the
+//! next goes in, so no build of another bug is reused. That the unplanted
+//! tree passes is `ci --job native`'s `scene-rules` step.
+
+use std::fs;
+use std::path::Path;
+
+use crate::selftest::NOT_RUN;
+use crate::util;
+
+/// One bug: where it goes, and the failure it must cause.
+struct Plant {
+    /// The file, from the workspace root, and the text replaced in it.
+    file: &'static str,
+    from: &'static str,
+    to: &'static str,
+    /// What the bug is, for messages.
+    what: &'static str,
+    /// The failing check, shot and object (if any) the test must name.
+    check: &'static str,
+    shot: &'static str,
+    object: Option<&'static str>,
+    /// The measure that must be past its limit.
+    measure: &'static str,
+}
+
+const SPRITES: &str = "crates/eng-render/src/sprites.wgsl";
+const GEOMETRY: &str = "crates/game-testbed-client/src/room/geometry.rs";
+
+/// The bugs case `case` plants, one after another.
+fn plants(case: &str) -> Option<Vec<Plant>> {
+    Some(match case {
+        "rule-1" => vec![
+            Plant {
+                file: SPRITES,
+                from: "    out.albedo = vec4<f32>(colour.rgb, 1.0);\n",
+                to: "    out.albedo = vec4<f32>(colour.rgb * 0.0, 1.0);\n",
+                what: "every thing drawn black",
+                check: "rule-1",
+                shot: "room-spawn",
+                object: Some("marker"),
+                measure: "light",
+            },
+            Plant {
+                file: SPRITES,
+                from: "    if (material.flags & 1u) != 0u && colour.a < 0.5 {\n",
+                to: "    if true {\n",
+                what: "every thing not drawn",
+                check: "rule-1",
+                shot: "room-spawn",
+                object: Some("marker"),
+                measure: "pixels",
+            },
+        ],
+        "rule-2" => vec![
+            Plant {
+                file: GEOMETRY,
+                from: "        let (left, right) = normals(wall.a, wall.b);\n",
+                to: "        if wall.a.x == 12.0 && wall.b.x == 12.0 && wall.b.y == 9.0 {\n            \
+                     continue;\n        }\n        let (left, right) = normals(wall.a, wall.b);\n",
+                what: "the east wall left out of the room",
+                check: "rule-2-void",
+                shot: "room-spawn",
+                object: None,
+                measure: "pixels",
+            },
+            Plant {
+                file: GEOMETRY,
+                from: "            for (cell, centre) in self.cells(&slab.points) {\n",
+                to: "            for (cell, centre) in self.cells(&slab.points) {\n                \
+                     if !up && centre.x > 5.0 {\n                    continue;\n                \
+                     }\n",
+                what: "the ceiling east of the skylight left out",
+                check: "rule-2-sky",
+                shot: "room-spawn",
+                object: None,
+                measure: "pixels",
+            },
+        ],
+        "rule-3" => vec![Plant {
+            file: "crates/game-testbed-client/src/room.rs",
+            from: "        pitch: view.pitch,\n",
+            to: "        pitch: BAngle(view.pitch.0.wrapping_add(1 << 29)),\n",
+            what: "the camera pitched 45 degrees up",
+            check: "rule-3-floor",
+            shot: "room-spawn",
+            object: None,
+            measure: "share",
+        }],
+        _ => return None,
+    })
+}
+
+/// Runs case `case` against `ws`, a fresh copy of the workspace at `root`:
+/// each of its bugs in turn, each taken out again after its run.
+pub fn run(root: &Path, ws: &Path, case: &str) -> Result<String, String> {
+    let plants = plants(case).ok_or_else(|| format!("unknown case {case}"))?;
+    let rules = ws.join("crates/game-testbed/scenes/room.rules.toml");
+    if !rules.is_file() {
+        return Err(format!(
+            "the copy has no {}: with no rules the test judges nothing",
+            util::rel(ws, &rules)
+        ));
+    }
+    let mut caught = Vec::new();
+    for (index, plant) in plants.iter().enumerate() {
+        let path = ws.join(plant.file);
+        let read =
+            |path: &Path| fs::read_to_string(path).map_err(|e| format!("{}: {e}", plant.file));
+        let write = |text: &str| fs::write(&path, text).map_err(|e| format!("{}: {e}", plant.file));
+        let text = read(&path)?;
+        if text.matches(plant.from).count() != 1 {
+            return Err(format!(
+                "selftest setup: {} does not hold {:?} once",
+                plant.file, plant.from
+            ));
+        }
+        write(&text.replacen(plant.from, plant.to, 1))?;
+        let (succeeded, output) = scene_rules(root, ws, &format!("{case}-{}", index + 1))?;
+        write(&text)?;
+        caught.push(judge(plant, succeeded, &output)?);
+    }
+    Ok(caught.join("\n"))
+}
+
+/// The scene-rules test run in `ws`, requiring an adapter; whether it
+/// passed, and its output, which is also logged under `label`.
+fn scene_rules(root: &Path, ws: &Path, label: &str) -> Result<(bool, String), String> {
+    let mut cmd = util::cargo(ws);
+    cmd.args(["test", "-p", "game-testbed", "--test", "scene_rules"]);
+    if util::on_ci() {
+        cmd.arg("--locked");
+    }
+    cmd.arg("--target-dir")
+        .arg(root.join("target/selftest/target"))
+        .env("ENG_REQUIRE_GPU", "1")
+        .env_remove("ENG_RULES_DIR");
+    let out = cmd
+        .output()
+        .map_err(|e| format!("cannot run cargo test: {e}"))?;
+    let output = format!(
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let log = root.join(format!("target/agent-logs/xtask-selftest-{label}.log"));
+    let _ = fs::create_dir_all(log.parent().expect("has parent"));
+    let _ = fs::write(&log, &output);
+    Ok((out.status.success(), output))
+}
+
+/// Whether the run with `plant`'s bug failed as it must: on its check, for
+/// its shot and object, with its measure past the limit.
+fn judge(plant: &Plant, succeeded: bool, output: &str) -> Result<String, String> {
+    if succeeded {
+        return Err(format!("the scene-rules test passed with {}", plant.what));
+    }
+    if let Some(line) = output.lines().find(|l| l.contains("[E-NO-ADAPTER]")) {
+        return Err(format!(
+            "{NOT_RUN} {} could not run: the scene-rules test renders, and found no \
+             adapter: {}",
+            plant.check,
+            line.trim()
+        ));
+    }
+    let object = plant.object.map_or(String::new(), |o| format!(" {o}"));
+    let start = format!(
+        "[E-SCENE-RULE] {} {}{object} (tick ",
+        plant.check, plant.shot
+    );
+    // `<measure> <value> <` (or `>`): the measure past its limit.
+    let past = |line: &str| {
+        let Some((_, measures)) = line.split_once("): ") else {
+            return false;
+        };
+        measures.split(", ").any(|m| {
+            let words: Vec<&str> = m.split(' ').collect();
+            words.len() >= 3 && words[0] == plant.measure && matches!(words[2], "<" | ">")
+        })
+    };
+    let caught = output
+        .lines()
+        .map(str::trim)
+        .find(|l| l.starts_with(&start) && past(l));
+    match caught {
+        Some(line) => Ok(format!("rejected ({}): {line}", plant.what)),
+        None => Err(format!(
+            "failed, but not with `{start}…): {} … past its limit` ({}):\n{}",
+            plant.measure,
+            plant.what,
+            util::tail(output, 15)
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{judge, plants};
+
+    #[test]
+    fn a_bug_is_caught_only_by_its_own_check_shot_and_measure() {
+        let rule_1 = plants("rule-1").unwrap();
+        let line = "[E-SCENE-RULE] rule-1 room-spawn marker (tick 0): light 0.046 < 0.2, \
+                    pixels 1326 >= 50, contrast 0.5 >= 0.03 (colour ...)";
+        let caught = judge(&rule_1[0], false, &format!("noise\n  {line}\nmore")).unwrap();
+        assert!(caught.contains(line), "{caught}");
+        assert!(
+            judge(&rule_1[0], true, line)
+                .unwrap_err()
+                .contains("passed")
+        );
+        // Another shot, object, measure or rule: not this bug's catch.
+        for other in [
+            line.replace("room-spawn", "room-step"),
+            line.replace("marker", "barrel"),
+            line.replace("light 0.046 < 0.2", "light 0.5 >= 0.2"),
+            line.replace("rule-1", "rule-2-void"),
+            line.replace("[E-SCENE-RULE] ", ""),
+        ] {
+            let missed = judge(&rule_1[0], false, &other).unwrap_err();
+            assert!(missed.contains("failed, but not with"), "{missed}");
+        }
+        // The second bug is the pixels': a light failure is not its catch.
+        assert!(judge(&rule_1[1], false, line).is_err());
+        let gone = "[E-SCENE-RULE] rule-1 room-spawn marker (tick 0): pixels 0 < 50, contrast \
+                    none < 0.03, light none < 0.2 (colour none ...)";
+        assert!(judge(&rule_1[1], false, gone).is_ok());
+        let rule_2 = plants("rule-2").unwrap();
+        let void = "[E-SCENE-RULE] rule-2-void room-spawn (tick 0): pixels 412 > 0 (pixels ...)";
+        assert!(judge(&rule_2[0], false, void).is_ok());
+        let sky = void.replace("rule-2-void", "rule-2-sky");
+        assert!(judge(&rule_2[0], false, &sky).is_err());
+        assert!(judge(&rule_2[1], false, &sky).is_ok());
+        assert!(judge(&rule_2[1], false, void).is_err());
+        let rule_3 = plants("rule-3").unwrap();
+        let floor = "[E-SCENE-RULE] rule-3-floor room-spawn (tick 0): share 0 < 0.1 (of ...)";
+        assert!(judge(&rule_3[0], false, floor).is_ok());
+        assert!(judge(&rule_3[0], false, &floor.replace("-floor", "-above")).is_err());
+        let none = judge(&rule_3[0], false, "[E-NO-ADAPTER] no adapter").unwrap_err();
+        assert!(none.starts_with(crate::selftest::NOT_RUN), "{none}");
+        assert!(plants("rule-4").is_none());
+    }
+}
