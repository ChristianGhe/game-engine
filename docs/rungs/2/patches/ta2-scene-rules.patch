+# The room's rules for "proper" (rung 2, plan addition A2): what every
+# first-person shot of the room in shots.toml must show. PROTECTED, like
+# the scenarios' assertions: the owner changes it, with shots.toml when a
+# shot is added or renamed. `tests/scene_rules.rs` renders each shot and
+# eng-cli's `scene_rules` judges its frame record; the definitions are
+# there. Measured on the room's seven shots (Metal and the pinned
+# lavapipe, 2026-11-15), the least of each is in brackets.
+version = 1
+map = "room"
+
+# Rule 1: each object a shot names in `must_see` (the record's `name`) is
+# - present: at least `pixels` visible pixels [159, the barrel at spawn];
+# - distinct: its mean colour at least `contrast` from its surroundings'
+#   (the pixels within 4 of its screen box), as the OKLab distance of the
+#   two (deltaEOK; about 0.02 is just noticeable) [0.042, the barrel at
+#   spawn]. Colour counts: the red marker before the grey pillar has
+#   nearly the pillar's luminance, so a luminance contrast misses it;
+# - lit: its mean luminance at least `light` of the mean of every surface
+#   in view (the sky left out), so that one drawn black fails though it
+#   stands out [0.452, the crate in room-look-off; drawn black, the marker
+#   has 0.05].
+[rule-1]
+pixels = 50
+contrast = 0.03
+light = 0.2
+
+# Rule 2: nothing shows where the world should be. The sky pass covers
+# what no surface does, so the clear colour never shows: a hole shows the
+# sky. At most `void` pixels show it below the horizon, where the ground
+# always stands in front of the sky [0 on every shot], and at most `sky`
+# anywhere, so a missing ceiling face fails too [0 but where a shot's
+# exception gives the sky through the skylight].
+[rule-2]
+void = 0
+sky = 0
+
+# Rule 3: the floor covers at least `share` of the lower third, and the
+# ceiling and sky together at least `share` of the upper third [0.448,
+# room-look-off's floor; 0.294, room-step's ceiling]. A tenth of a third
+# is a band 8 rows deep at 320x240: a few stray pixels do not count.
+[rule-3]
+share = 0.1
+
+# Every first-person shot of the room, the objects it must see, and the
+# limits it is excused to, each with its reason: `except.<check> =
+# { pixels = N, why = "..." }` for rule-2-void or rule-2-sky, `{ share = S,
+# why = "..." }` for rule-3-floor or rule-3-above. An exception the shot no
+# longer needs fails. The sky's bounds are the pixels measured on both
+# adapters plus about 2% for edges that rasterize differently elsewhere.
+# The crate hides behind the pillar at spawn.
+[shot.room-spawn]
+must_see = ["marker", "barrel"]
+
+[shot.room-sprites]
+must_see = ["marker", "barrel"]
+
+[shot.room-step]
+must_see = ["barrel"]
+
+[shot.room-sky]
+must_see = []
+except.rule-2-sky = { pixels = 10300, why = "the sky through the skylight's shaft: 10,066 pixels" }
+except.rule-3-floor = { share = 0.0, why = "pitched 60 degrees up under the skylight: the lower third is ceiling and wall" }
+
+[shot.room-alcove]
+must_see = ["crate", "barrel"]
+
+[shot.room-ledge]
+must_see = []
+except.rule-3-above = { share = 0.0, why = "pitched 15 degrees down at the south wall 3.5 m away: the upper third is wall" }
+
+[shot.room-look-off]
+must_see = ["marker", "crate", "barrel"]
+except.rule-2-sky = { pixels = 2250, why = "the sky through the skylight, from the hall's far corner: 2,196 pixels" }
