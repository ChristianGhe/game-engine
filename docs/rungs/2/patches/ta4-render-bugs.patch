diff --git a/xtask/src/selftest_render.rs b/xtask/src/selftest_render.rs
new file mode 100644
index 0000000000000000000000000000000000000000..26a8e3b47f048a2ebb143a479bcb2b17a337db6c
--- /dev/null
+++ b/xtask/src/selftest_render.rs
@@ -0,0 +1,461 @@
+//! `cargo xtask selftest render-bug-<n>` (rung 2, addition A4, criterion
+//! `check-misses`): twelve planted render bugs, small mistakes a builder
+//! could make anywhere from the room's extraction to the palette, written by
+//! an agent that did not build the renderer. Each is a patch in
+//! `xtask/selftest/render-bugs/`, and exists nowhere else.
+//!
+//! A case copies the workspace to `target/selftest/render-bug-<n>/`,
+//! applies its bug there, and runs the bug's general checks in turn until
+//! one fails: tests whose verdict comes from a CPU model or a rule that
+//! holds for every scene, so they would catch the bug in a scene nobody
+//! prepared, not tests that know facts of the testbed's room (where an
+//! object is, which shot it is in, a golden). [`BUGS`] names them, from the
+//! bug-by-check run in `docs/rungs/2/PROGRESS.md` (TA4). The case passes
+//! when one of them fails as a test, and fails when all of them pass, or
+//! when the bug no longer applies or builds: refresh its patch with the
+//! code it plants into.
+//!
+//! A bug no general check catches is a **known miss**, listed with the
+//! reason, which the owner accepts by applying this file: its case runs the
+//! room's own checks that catch it instead, so that a miss is at least
+//! caught where the room is, and says it is a known miss.
+//!
+//! The checks pass on the tree itself (the `test` and `native` jobs run
+//! them), so a check that fails here fails for the bug. GPU checks run with
+//! `ENG_REQUIRE_GPU=1`; a case whose check finds no adapter could not run
+//! ([`NOT_RUN`]), a failure only in a strict run. Builds go to
+//! `target/selftest/target`, as the clippy cases' do, which the cases
+//! share: see `mark_planted` for what keeps one case's bug out of the
+//! next one's build.
+
+use std::fs;
+use std::path::Path;
+use std::time::SystemTime;
+
+use crate::selftest::NOT_RUN;
+use crate::util;
+
+#[path = "selftest_render_apply.rs"]
+mod patch_file;
+
+/// Where a check's test lives.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Target {
+    /// The package's library unit tests (`--lib`).
+    Lib,
+    /// An integration test target, `tests/<name>.rs` (`--test <name>`).
+    Test(&'static str),
+}
+
+/// One test that catches a bug: run as `cargo test -p <package> <target>
+/// -- --exact <test>`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Check {
+    pub package: &'static str,
+    pub target: Target,
+    /// The test's full name, as `--exact` matches it.
+    pub test: &'static str,
+}
+
+/// A planted bug and what catches it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Bug {
+    /// Its patch, in `xtask/selftest/render-bugs/`.
+    pub patch: &'static str,
+    /// What it breaks.
+    pub what: &'static str,
+    /// The checks the case runs, cheapest first: general ones, or for a
+    /// known miss the room's.
+    pub checks: &'static [Check],
+    /// Why no general check catches it, for a known miss.
+    pub known_miss: Option<&'static str>,
+}
+
+const fn lib(package: &'static str, test: &'static str) -> Check {
+    Check {
+        package,
+        target: Target::Lib,
+        test,
+    }
+}
+
+const fn test(package: &'static str, file: &'static str, test: &'static str) -> Check {
+    Check {
+        package,
+        target: Target::Test(file),
+        test,
+    }
+}
+
+const CLIENT: &str = "game-testbed-client";
+const RENDER: &str = "eng-render";
+
+/// The bugs, in the pipeline's order, `render-bug-<n>` at `n - 1`.
+pub(crate) const BUGS: [Bug; 12] = [
+    Bug {
+        patch: "01-thing-skipped.patch",
+        what: "the room's extraction drops its first thing (the marker)",
+        checks: &[lib(
+            CLIENT,
+            "room::tests::each_thing_is_a_sprite_in_the_region_its_feet_stand_in",
+        )],
+        known_miss: Some(
+            "what a scene should hold is the scene's own fact: only the room's tests, \
+             its pinned counters and its goldens know the marker is there",
+        ),
+    },
+    Bug {
+        patch: "02-slab-sides-inward.patch",
+        what: "slab sides face into the slab: the pillar is see-through from outside",
+        checks: &[lib(
+            CLIENT,
+            "room::geometry::tests::no_two_faces_facing_the_same_way_overlap_in_one_plane",
+        )],
+        known_miss: None,
+    },
+    Bug {
+        patch: "03-texture-tag-linear.patch",
