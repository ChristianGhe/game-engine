+/// The bug of case `render-bug-<n>`, if `case` is one.
+pub(crate) fn bug(case: &str) -> Option<(usize, &'static Bug)> {
+    let n: usize = case.strip_prefix("render-bug-")?.parse().ok()?;
+    let bug = BUGS.get(n.checked_sub(1)?)?;
+    Some((n, bug))
+}
+
+/// Runs case `render-bug-<n>` in `ws`, a fresh copy of the workspace.
+pub(crate) fn run(root: &Path, ws: &Path, case: &str) -> Result<String, String> {
+    let (n, bug) = bug(case).ok_or_else(|| format!("unknown case {case}"))?;
+    keep_times(root, ws)?;
+    mark_planted(root, ws)?;
+    apply(root, ws, bug.patch)?;
+    let mut passed = Vec::new();
+    for check in bug.checks {
+        let (succeeded, output) = run_check(root, ws, check)?;
+        match verdict(succeeded, &output, check) {
+            Verdict::Caught(why) => {
+                let check = name(check);
+                return Ok(match bug.known_miss {
+                    None => format!("caught by a general check: {check} ({why})"),
+                    Some(miss) => format!(
+                        "a known miss ({miss}), caught by the room's check: {check} ({why})"
+                    ),
+                });
+            }
+            Verdict::Passed => passed.push(name(check)),
+            Verdict::NoAdapter(why) => {
+                return Err(format!(
+                    "{NOT_RUN} {case} could not run here: {} needs a GPU adapter ({why})",
+                    name(check)
+                ));
+            }
+            Verdict::DidNotRun(why) => {
+                return Err(format!(
+                    "render bug {n} ({}): {} did not run: {why}",
+                    bug.patch,
+                    name(check)
+                ));
+            }
+        }
+    }
+    Err(format!(
+        "render bug {n} ({}: {}) passed {}",
+        bug.patch,
+        bug.what,
+        passed.join(", ")
+    ))
+}
+
+/// A check's name as the bug-by-check table gives it.
+fn name(check: &Check) -> String {
+    match check.target {
+        Target::Lib => format!("{} (lib) {}", check.package, check.test),
+        Target::Test(file) => format!("{} tests/{file}.rs {}", check.package, check.test),
+    }
+}
+
+/// The text of `xtask/selftest/render-bugs/<patch>`.
+fn read_patch(root: &Path, patch: &str) -> Result<String, String> {
+    let file = root.join("xtask/selftest/render-bugs").join(patch);
+    fs::read_to_string(&file).map_err(|e| format!("{}: {e}", file.display()))
+}
+
+/// Gives each file of the copy `ws` the modification time of its original
+/// in `root`, as `fs::copy` does on macOS but not on Linux, so that on
+/// every OS a case rebuilds only the crates [`mark_planted`] marks, and
+/// what depends on them, not the whole workspace.
+fn keep_times(root: &Path, ws: &Path) -> Result<(), String> {
+    for copied in util::walk_all(ws) {
+        let rel = copied.strip_prefix(ws).map_err(|e| e.to_string())?;
+        let modified = fs::metadata(root.join(rel))
+            .and_then(|m| m.modified())
+            .map_err(|e| format!("{}: {e}", rel.display()))?;
+        fs::File::options()
+            .write(true)
+            .open(&copied)
+            .and_then(|f| f.set_modified(modified))
+            .map_err(|e| format!("{}: {e}", copied.display()))?;
+    }
+    Ok(())
+}
+
+/// Marks, in the copy `ws`, every file that any bug plants into as changed
+/// now. Cargo knows a workspace member by its path inside the workspace,
+/// not by where the copy is, so in the shared target directory an earlier
+/// case's build of a crate, its bug in it, would otherwise pass for fresh
+/// wherever the copy has the tree's older times ([`keep_times`]). Only
+/// these files are ever planted into, so their crates are the only ones an
+/// earlier case can have built differently.
+fn mark_planted(root: &Path, ws: &Path) -> Result<(), String> {
+    let now = SystemTime::now();
+    for bug in &BUGS {
+        let text = read_patch(root, bug.patch)?;
+        for file in patch_file::parse(&text).map_err(|e| format!("{}: {e}", bug.patch))? {
+            let path = ws.join(&file.path);
+            fs::File::options()
+                .write(true)
+                .open(&path)
+                .and_then(|f| f.set_modified(now))
+                .map_err(|e| format!("{}: {e}", path.display()))?;
+        }
+    }
+    Ok(())
+}
+
+/// Plants `xtask/selftest/render-bugs/<patch>` in the copy `ws`
+/// (`selftest_render_apply.rs`).
+fn apply(root: &Path, ws: &Path, patch: &str) -> Result<(), String> {
+    let text = read_patch(root, patch)?;
+    patch_file::apply(ws, &text).map(|_| ()).map_err(|e| {
+        format!("{patch} no longer applies (refresh it against the code it plants into): {e}")
+    })
+}
+
+/// Runs one check in `ws`; returns whether it passed and its output.
+fn run_check(root: &Path, ws: &Path, check: &Check) -> Result<(bool, String), String> {
+    let mut cmd = util::cargo(ws);
+    cmd.args(["test", "-p", check.package]);
+    match check.target {
+        Target::Lib => cmd.arg("--lib"),
+        Target::Test(file) => cmd.args(["--test", file]),
+    };
+    if util::on_ci() {
+        cmd.arg("--locked");
+    }
+    cmd.arg("--target-dir")
+        .arg(root.join("target/selftest/target"))
+        .args(["--", "--exact", check.test])
+        .env("ENG_REQUIRE_GPU", "1");
+    let out = cmd
+        .output()
+        .map_err(|e| format!("cannot run cargo test: {e}"))?;
+    Ok((
+        out.status.success(),
+        format!(
+            "{}{}",
+            String::from_utf8_lossy(&out.stdout),
+            String::from_utf8_lossy(&out.stderr)
+        ),
+    ))
+}
+
+/// What one check's run says about the bug.
+#[derive(Debug, PartialEq, Eq)]
+enum Verdict {
+    /// The check failed as a test: the bug is caught. Its first lines.
+    Caught(String),
+    /// The check ran and passed.
+    Passed,
+    /// The check needs an adapter this machine lacks.
+    NoAdapter(String),
+    /// It did not run as a test: no build, or the test is gone.
+    DidNotRun(String),
+}
+
+fn verdict(succeeded: bool, output: &str, check: &Check) -> Verdict {
+    let ran = format!("test {} ... ", check.test);
+    let line = output.lines().find(|l| l.starts_with(&ran));
+    match (succeeded, line) {
+        (true, Some(l)) if l.ends_with("ok") => Verdict::Passed,
+        (true, _) => Verdict::DidNotRun(format!("`{}` is not a test of its target", check.test)),
+        (false, Some(l)) if l.ends_with("FAILED") => {
+            if let Some(why) = output.lines().find(|l| l.contains("[E-NO-ADAPTER]")) {
+                return Verdict::NoAdapter(why.trim().to_string());
+            }
+            Verdict::Caught(panic_message(output, check.test))
+        }
+        (false, _) => Verdict::DidNotRun(util::tail(output, 15)),
+    }
+}
+
+/// The panic message of `test` in a libtest output, one line.
+fn panic_message(output: &str, test: &str) -> String {
+    let header = format!("---- {test} stdout ----");
+    let mut lines = output.lines().skip_while(|l| l.trim() != header).skip(1);
+    let message: Vec<&str> = lines
+        .by_ref()
+        .skip_while(|l| !l.contains("panicked at"))
+        .skip(1)
+        .take_while(|l| !l.trim().is_empty() && !l.starts_with("note:"))
+        .take(2)
+        .collect();
+    let text = message.join(" ");
+    let text = text.trim();
+    if text.chars().count() > 160 {
+        format!("{}...", text.chars().take(160).collect::<String>())
+    } else {
+        text.to_string()
+    }
+}
