+/// Every `render-bug-<n>` case has its bug, and every bug its case, its
+/// patch and at least one check; every patch in the directory is a bug's.
+#[test]
+fn each_case_has_its_bug_its_patch_and_its_checks() {
+    let cases: Vec<&str> = CASES
+        .iter()
+        .copied()
+        .filter(|c| c.starts_with("render-bug-"))
+        .collect();
+    assert_eq!(cases.len(), BUGS.len());
+    for (i, case) in cases.iter().enumerate() {
+        let (n, found) = bug(case).unwrap_or_else(|| panic!("{case} has no bug"));
+        assert_eq!((n, found), (i + 1, &BUGS[i]), "{case}");
+    }
+    assert_eq!(bug("render-bug-0"), None);
+    assert_eq!(bug("render-bug-13"), None);
+    let dir = util::root().unwrap().join("xtask/selftest/render-bugs");
+    let on_disk: BTreeSet<String> = fs::read_dir(&dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    let named: BTreeSet<String> = BUGS.iter().map(|b| b.patch.to_string()).collect();
+    assert_eq!(on_disk, named, "the patches in {}", dir.display());
+    for (i, bug) in BUGS.iter().enumerate() {
+        assert!(
+            bug.patch.starts_with(&format!("{:02}-", i + 1)),
+            "{}",
+            bug.patch
+        );
+        assert!(!bug.checks.is_empty(), "{}", bug.patch);
+        let text = fs::read_to_string(dir.join(bug.patch)).unwrap();
+        let files = patch_file::parse(&text).unwrap_or_else(|e| panic!("{}: {e}", bug.patch));
+        assert!(
+            files.iter().all(|f| f.path.starts_with("crates/")),
+            "{}: a bug is planted in the crates only",
+            bug.patch
+        );
+    }
+}
