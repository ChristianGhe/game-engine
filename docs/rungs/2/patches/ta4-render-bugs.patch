+    #[test]
+    fn only_changes_to_files_that_exist_are_taken() {
+        let new_file = "--- /dev/null\n+++ b/crates/x/src/new.rs\n@@ -0,0 +1 @@\n+fn n() {}\n";
+        assert!(parse(new_file).unwrap_err().contains("a new file"));
+        let no_newline = PATCH.replace("     c\n", "     c\n\\ No newline at end of file\n");
+        assert!(parse(&no_newline).unwrap_err().contains("no newline"));
+        assert!(parse("just text\n").is_err());
