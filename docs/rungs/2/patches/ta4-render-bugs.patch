+/// The copy's files get their originals' times, which `fs::copy` keeps on
+/// macOS but not on Linux.
+#[test]
+fn the_copy_keeps_the_trees_times() {
+    let base = std::env::temp_dir().join(format!("xtask-render-times-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&base);
+    let (root, ws) = (base.join("root"), base.join("ws"));
+    let then = SystemTime::UNIX_EPOCH + Duration::from_secs(1_700_000_000);
+    for dir in [&root, &ws] {
+        fs::create_dir_all(dir.join("crates/x")).unwrap();
+        fs::write(dir.join("crates/x/lib.rs"), "fn a() {}\n").unwrap();
+    }
+    let original = fs::File::options()
+        .write(true)
+        .open(root.join("crates/x/lib.rs"))
+        .unwrap();
+    original.set_modified(then).unwrap();
+    keep_times(&root, &ws).unwrap();
+    let copied = fs::metadata(ws.join("crates/x/lib.rs")).unwrap();
+    assert_eq!(copied.modified().unwrap(), then);
+    let _ = fs::remove_dir_all(&base);
+}
