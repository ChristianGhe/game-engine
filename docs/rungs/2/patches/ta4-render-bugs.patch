+#[test]
+fn no_adapter_no_build_or_no_such_test_is_not_a_catch() {
+    let no_adapter = CAUGHT.replace(
+        "(12, 40) region 1: lit 9.1 nits, the CPU's 4.6",
+        "ENG_REQUIRE_GPU=1: [E-NO-ADAPTER] no GPU adapter matches ENG_GPU_ADAPTER=none",
+    );
+    assert!(matches!(
+        verdict(false, &no_adapter, &CHECK),
+        Verdict::NoAdapter(why) if why.contains("[E-NO-ADAPTER]")
+    ));
+    let no_build = "error[E0425]: cannot find value `width` in this scope\n\
+        error: could not compile `eng-render` (lib) due to 1 previous error";
+    assert!(matches!(
+        verdict(false, no_build, &CHECK),
+        Verdict::DidNotRun(why) if why.contains("could not compile")
+    ));
+    // `--exact` with a name that is no test runs nothing, and passes.
+    let none = "running 0 tests\n\ntest result: ok. 0 passed; 0 failed; 0 ignored";
+    assert!(matches!(verdict(true, none, &CHECK), Verdict::DidNotRun(_)));
+}
