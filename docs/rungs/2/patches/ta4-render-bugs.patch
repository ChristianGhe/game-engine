+//! How `selftest render-bug-<n>` plants its bug in the workspace copy: a
+//! unified diff applied in xtask, not by `git apply`, which run inside the
+//! copy would find the real tree's repository above it. Only what the bug
+//! patches need: changes to files that exist, each hunk found by its exact
+//! old lines (context and removed), wherever they now are in the file, and
+//! only if they are there once.
+
+use std::fs;
+use std::path::Path;
+
+/// One file's changes: its path from the workspace root, and its hunks as
+/// (old lines, new lines), each line with its newline.
+#[derive(Debug, PartialEq, Eq)]
+pub(super) struct FilePatch {
+    pub path: String,
+    pub hunks: Vec<(String, String)>,
+}
+
+/// The files and hunks of `patch`, a `git diff` of changes to existing
+/// files. Anything else (a new or deleted file, a line with no newline at
+/// the end of a file, a line that is not in a hunk's format) is refused.
+pub(super) fn parse(patch: &str) -> Result<Vec<FilePatch>, String> {
+    let mut files: Vec<FilePatch> = Vec::new();
+    let mut lines = patch.split_inclusive('\n').peekable();
+    while let Some(line) = lines.next() {
+        if let Some(path) = line.strip_prefix("+++ ") {
+            let path = path.trim_end();
+            let Some(path) = path.strip_prefix("b/") else {
+                return Err(format!("only changes to files that exist: +++ {path}"));
+            };
+            files.push(FilePatch {
+                path: path.to_string(),
+                hunks: Vec::new(),
+            });
+        } else if line.starts_with("--- ") && line.trim_end() == "--- /dev/null" {
+            return Err("only changes to files that exist: a new file".into());
+        } else if let Some(header) = line.strip_prefix("@@ -") {
+            let file = files
+                .last_mut()
+                .ok_or("a hunk before its file's +++ line")?;
+            let (old_lines, new_lines) = counts(header).ok_or_else(|| {
+                format!(
+                    "{}: a hunk header that does not parse: {}",
+                    file.path,
+                    line.trim_end()
+                )
+            })?;
+            let (mut old, mut new) = (String::new(), String::new());
+            let (mut o, mut n) = (0, 0);
+            while o < old_lines || n < new_lines {
+                let body = lines
+                    .next()
+                    .ok_or_else(|| format!("{}: a hunk cut short", file.path))?;
+                // An empty context line may come as a bare newline.
+                let context = body.strip_prefix(' ').or((body == "\n").then_some("\n"));
+                if let Some(text) = context {
+                    old.push_str(text);
+                    new.push_str(text);
+                    (o, n) = (o + 1, n + 1);
+                } else if let Some(text) = body.strip_prefix('-') {
+                    old.push_str(text);
+                    o += 1;
+                } else if let Some(text) = body.strip_prefix('+') {
+                    new.push_str(text);
+                    n += 1;
+                } else {
+                    return Err(format!("{}: not a hunk's line: {body:?}", file.path));
+                }
+            }
+            if (o, n) != (old_lines, new_lines) || lines.next_if(|l| l.starts_with('\\')).is_some()
+            {
+                return Err(format!(
+                    "{}: a hunk unlike its header, or a line with no newline at its end",
+                    file.path
+                ));
+            }
+            if old.is_empty() {
+                return Err(format!("{}: a hunk with no old lines", file.path));
+            }
+            file.hunks.push((old, new));
+        }
+    }
+    if files.is_empty() || files.iter().any(|f| f.hunks.is_empty()) {
+        return Err("the patch changes no file".into());
+    }
+    Ok(files)
+}
+
+/// The old and new line counts of a hunk header after its `@@ -`:
+/// `2,3 +2,4 @@ ...`, a count of 1 when it has no comma.
+fn counts(header: &str) -> Option<(usize, usize)> {
+    let mut parts = header.split(' ');
+    let count = |range: &str| match range.split_once(',') {
+        Some((_, n)) => n.parse().ok(),
+        None => range.parse::<usize>().ok().map(|_| 1),
+    };
+    let old = count(parts.next()?)?;
+    let new = count(parts.next()?.strip_prefix('+')?)?;
+    (parts.next() == Some("@@")).then_some((old, new))
+}
+
+/// `text` with `hunks` applied in turn: each one's old lines must appear in
+/// it exactly once, starting a line.
+pub(super) fn apply_hunks(
+    path: &str,
+    text: &str,
+    hunks: &[(String, String)],
+) -> Result<String, String> {
+    let mut text = text.to_string();
+    for (at, (old, new)) in hunks.iter().enumerate() {
+        let starts: Vec<usize> = text
+            .match_indices(old.as_str())
+            .map(|(i, _)| i)
+            .filter(|&i| i == 0 || text.as_bytes()[i - 1] == b'\n')
+            .collect();
+        match starts.as_slice() {
+            [start] => text.replace_range(*start..start + old.len(), new),
+            [] => return Err(format!("{path}: hunk {} no longer matches", at + 1)),
+            many => {
+                return Err(format!(
+                    "{path}: hunk {} matches {} places",
+                    at + 1,
+                    many.len()
+                ));
+            }
+        }
+    }
+    Ok(text)
+}
+
+/// Applies `patch` to the files under `ws`; returns the paths it changed.
+pub(super) fn apply(ws: &Path, patch: &str) -> Result<Vec<String>, String> {
+    let files = parse(patch)?;
+    let mut changed = Vec::new();
+    // Every file is patched in memory first, so that a refused hunk leaves
+    // the copy as it was.
+    let mut writes = Vec::new();
+    for file in &files {
+        if file
+            .path
+            .split('/')
+            .any(|part| part == ".." || part.is_empty())
+        {
+            return Err(format!("{}: not a path inside the workspace", file.path));
+        }
+        let at = ws.join(&file.path);
+        let text = fs::read_to_string(&at).map_err(|e| format!("{}: {e}", file.path))?;
+        let patched = apply_hunks(&file.path, &text, &file.hunks)?;
+        writes.push((at, patched));
+        changed.push(file.path.clone());
+    }
+    for (at, patched) in writes {
+        fs::write(&at, patched).map_err(|e| format!("{}: {e}", at.display()))?;
+    }
+    Ok(changed)
+}
+
