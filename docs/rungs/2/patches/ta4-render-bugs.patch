+#[test]
+fn a_check_that_fails_as_a_test_catches_the_bug() {
+    assert_eq!(
+        verdict(false, CAUGHT, &CHECK),
+        Verdict::Caught("(12, 40) region 1: lit 9.1 nits, the CPU's 4.6".into())
+    );
+    let passed = "test the_light_model_is_the_cpus_on_every_unambiguous_pixel ... ok\n\
+        test result: ok. 1 passed; 0 failed";
+    assert_eq!(verdict(true, passed, &CHECK), Verdict::Passed);
+}
