+/// A bug's patch applies to the copy and changes only what it names.
+#[test]
+fn a_bug_is_planted_in_the_copy_only() {
+    let ws = std::env::temp_dir().join(format!("xtask-render-bug-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&ws);
+    let file = ws.join("crates/x/src/lib.rs");
+    fs::create_dir_all(file.parent().unwrap()).unwrap();
+    fs::write(
+        &file,
+        "fn a() {\n    let b = 1;\n    let c = b + 1;\n    c\n}\n",
+    )
+    .unwrap();
+    let patch = "\
+--- a/crates/x/src/lib.rs
++++ b/crates/x/src/lib.rs
+@@ -2,3 +2,3 @@ fn a() {
+     let b = 1;
+-    let c = b + 1;
++    let c = b - 1;
+     c
+";
+    assert_eq!(
+        patch_file::apply(&ws, patch).unwrap(),
+        ["crates/x/src/lib.rs"]
+    );
+    assert_eq!(
+        fs::read_to_string(&file).unwrap(),
+        "fn a() {\n    let b = 1;\n    let c = b - 1;\n    c\n}\n"
+    );
+    // Applied twice, its old lines are gone: refused, and nothing written.
+    let again = patch_file::apply(&ws, patch).unwrap_err();
+    assert_eq!(again, "crates/x/src/lib.rs: hunk 1 no longer matches");
+    let outside = patch.replace("crates/x/", "../x/");
+    assert!(
+        patch_file::apply(&ws, &outside)
+            .unwrap_err()
+            .contains("not a path inside")
+    );
+    let _ = fs::remove_dir_all(&ws);
+}
